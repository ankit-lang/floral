  function getIntlDeliveryState() {
    const mode = localStorage.getItem('delivery_mode') || 'india';
    const country = (localStorage.getItem('user_country') || 'India').trim();
    const countryCode = (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
    const isIntl = (mode === 'international') && (country.toUpperCase() !== 'INDIA' && country.toUpperCase() !== 'IN');
    const isSundayAllowed = !isIntl || sundayAllowedCountries.includes(countryCode) || sundayAllowedCountries.includes(country.toUpperCase());

    return { isIntl, isSundayAllowed, country, countryCode };
