  // Rough pincode-prefix → city/state lookup, used only if the popup didn't save city/state
  function guessCityStateFromPincode(pin) {
    const p = String(pin || '');
    const map3 = {
      '400': ['Mumbai', 'Maharashtra'], '411': ['Pune', 'Maharashtra'], '500': ['Hyderabad', 'Telangana'],
      '560': ['Bangalore', 'Karnataka'], '600': ['Chennai', 'Tamil Nadu'], '700': ['Kolkata', 'West Bengal'],
      '380': ['Ahmedabad', 'Gujarat'], '302': ['Jaipur', 'Rajasthan'], '160': ['Chandigarh', 'Chandigarh'],
      '226': ['Lucknow', 'Uttar Pradesh'], '201': ['Noida', 'Uttar Pradesh'], '122': ['Gurugram', 'Haryana']
    };
    if (map3[p.substring(0, 3)]) return { city: map3[p.substring(0, 3)][0], state: map3[p.substring(0, 3)][1] };
    if (p.substring(0, 2) === '11') return { city: 'Delhi', state: 'Delhi' };
    return { city: '', state: '' };
  }

  function lockLocationWithPincode(pincodeData) {
    const intlState = getIntlDeliveryState();
    if (intlState.isIntl) {
      updatePDPLocationDisplay();
      return;
    }

    let pincode = (typeof pincodeData === 'object' && pincodeData) ? pincodeData.pincode : (pincodeData || getCookieVal('user_pincode') || localStorage.getItem('user_pincode'));
    let targetCity = (typeof pincodeData === 'object' && pincodeData && pincodeData.city) ? pincodeData.city : (getCookieVal('user_city') || localStorage.getItem('user_city'));
    let fullLocation = (typeof pincodeData === 'object' && pincodeData && pincodeData.location) ? pincodeData.location : (getCookieVal('user_location') || localStorage.getItem('user_location'));

    const promptEl = document.getElementById('no-pincode-prompt');
    const barEl = document.getElementById('active-pincode-bar');
    const cityEl = document.getElementById('delivery-location');
    const exactInputEl = document.getElementById('delivery-exact-location');

    if (!pincode && !targetCity) {
      updatePDPLocationDisplay();
      return;
    }

    // Create or update a hidden input to pass the pincode to the cart/checkout
    let hiddenPincodeInput = document.getElementById('hidden-pincode-property');
    if (!hiddenPincodeInput) {
      hiddenPincodeInput = document.createElement('input');
      hiddenPincodeInput.type = 'hidden';
      hiddenPincodeInput.id = 'hidden-pincode-property';
      hiddenPincodeInput.name = 'properties[_Pincode]';
      if (cityEl && cityEl.parentNode) cityEl.parentNode.appendChild(hiddenPincodeInput);
    }
    if (pincode) hiddenPincodeInput.value = pincode;

    if (exactInputEl && fullLocation) {
      exactInputEl.value = fullLocation;
    } else if (exactInputEl && pincode) {
      exactInputEl.value = `PIN: ${pincode}`;
    }

    let hiddenExactInput = document.getElementById('hidden-exact-location-property');
    if (!hiddenExactInput) {
      hiddenExactInput = document.createElement('input');
      hiddenExactInput.type = 'hidden';
      hiddenExactInput.id = 'hidden-exact-location-property';
      hiddenExactInput.name = 'properties[_Exact Location]';
      if (cityEl && cityEl.parentNode) cityEl.parentNode.appendChild(hiddenExactInput);
    }
    if (fullLocation) hiddenExactInput.value = fullLocation;
    else if (pincode) hiddenExactInput.value = `PIN: ${pincode}`;

    // State saved by the pincode popup (from India Post lookup)
    let targetState = (typeof pincodeData === 'object' && pincodeData && pincodeData.state)
      ? pincodeData.state
      : (getCookieVal('user_state') || localStorage.getItem('user_state') || '');

    // Fallback: derive city/state from pincode prefix when nothing was saved
    if (pincode && (!targetCity || !targetState)) {
      const guess = guessCityStateFromPincode(pincode);
      if (!targetCity) targetCity = guess.city;
      if (!targetState) targetState = guess.state;
    }

    // Lock the dropdown to the pincode's own city + state (single option, no stale choices)
    if (cityEl && (targetCity || targetState)) {
      const cityValue = targetCity || targetState;
      const sameName = targetState && cityValue.toLowerCase() === targetState.toLowerCase();
      const label = (targetState && !sameName) ? `${cityValue}, ${targetState}` : cityValue;

      cityEl.innerHTML = '';
      const opt = document.createElement('option');
      opt.value = cityValue;
      opt.textContent = label;
      opt.selected = true;
      cityEl.appendChild(opt);
      cityEl.disabled = true;
      cityEl.title = `${label} (PIN ${pincode || ''})`;

      // Disabled selects are not submitted, so pass the city via a hidden input
      const cityProp = document.getElementById('delivery-city-property');
      if (cityProp) cityProp.value = cityValue;
    }

    updateCountdown();
    updatePDPLocationDisplay();
  }

  function getCookieVal(name) {
    let nameEQ = name + "=";
    let ca = document.cookie.split(';');
    for(let i = 0; i < ca.length; i++) {
      let c = ca[i];
      while (c.charAt(0) == ' ') c = c.substring(1, c.length);
      if (c.indexOf(nameEQ) == 0) return decodeURIComponent(c.substring(nameEQ.length, c.length));
    }
    return null;
  }

