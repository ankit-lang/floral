    return days[d.getDay()] + ', ' + months[d.getMonth()] + ' ' + d.getDate();
  }
  function formatISODate(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
  }

  // ---- Populate tab labels ----
  document.querySelector('.today-date-display').textContent  = formatTabDate(today);
  document.querySelector('.tomorrow-date-display').textContent = formatTabDate(tomorrow);
  document.querySelector('.dayafter-date-display').textContent = formatTabDate(dayAfter);

