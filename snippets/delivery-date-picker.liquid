  // ---- Tab references ----
  const tabToday    = document.getElementById('tab-today');
  const tabTomorrow = document.getElementById('tab-tomorrow');
  const tabDayAfter = document.getElementById('tab-dayafter');
  const customBtn   = document.getElementById('custom-date-btn');
  const allQuickTabs = document.querySelectorAll('#delivery-date-tabs .date-tab:not(#custom-date-btn)');

  let fp = null;

  function getProductProcessingRules() {
    const container = document.querySelector('.delivery-picker-container');
    let advanceDays = container ? (parseInt(container.dataset.advanceDays, 10) || 0) : 0;
    let noSunday = container ? (container.dataset.noSunday === 'true') : false;

    const descEl = document.getElementById('tab-desc') || document.querySelector('.product-description');
    if (descEl) {
      const descText = descEl.textContent.toLowerCase();
      const advMatch = descText.match(/(\d+)\s*(?:-\s*\d+)?\s*(?:days?)?\s*advance/) || 
                       descText.match(/(\d+)\s*(?:-\s*\d+)?\s*days?\s*to\s*process/) ||
                       descText.match(/process(?:ing)?\s*(?:time|order)?\s*(?:is|:)?\s*(\d+)/);

      if (advMatch && advMatch[1]) {
        const parsed = parseInt(advMatch[1], 10);
        if (!isNaN(parsed) && parsed > advanceDays) {
          advanceDays = parsed;
        }
      }

      if (descText.includes('4-5 advance') || descText.includes('4-5 days advance')) advanceDays = Math.max(advanceDays, 4);
      else if (descText.includes('3-4 advance') || descText.includes('3-4 days advance')) advanceDays = Math.max(advanceDays, 3);
      else if (descText.includes('2-3 advance') || descText.includes('2-3 days advance')) advanceDays = Math.max(advanceDays, 2);
      else if (descText.includes('1-2 advance') || descText.includes('1-2 days advance')) advanceDays = Math.max(advanceDays, 1);

      if (descText.includes('sunday delivery not possible') || descText.includes('sundays non-delivery') || descText.includes('no sunday delivery')) {
        noSunday = true;
      }
    }

    return { advanceDays, noSunday };
  }

  function setupDateTabsAndRules() {
    const intlState = getIntlDeliveryState();
    const rules = getProductProcessingRules();
    let minAdv = rules.advanceDays;

    // ---- Diwali Idol: Tier-based delivery override ----
    const idolCourierNotice = document.getElementById('idol-courier-notice');
    const timeSelectContainer = document.getElementById('time-select-container');
    const timeSelectEl = document.getElementById('delivery-time-select');
    const dateTabsContainer = document.getElementById('delivery-date-tabs');
    const dateLabelContainer = document.querySelector('.delivery-picker-container > .flex.items-center.justify-between.mb-3');
    let isIdolCourier = false;

    if (isIdolProduct && !intlState.isIntl) {
      if (isUserInTier1City()) {
        // Tier 1: Same day / next day — normal delivery behavior
        isIdolCourier = false;
        if (idolCourierNotice) idolCourierNotice.classList.add('hidden');
        if (timeSelectContainer) timeSelectContainer.style.display = 'flex';
        if (timeSelectEl) timeSelectEl.setAttribute('required', 'required');
        if (dateTabsContainer) dateTabsContainer.style.display = 'flex';
        if (dateLabelContainer) dateLabelContainer.style.display = 'flex';
      } else {
        // Non-Tier 1: Courier 3-5 days
        isIdolCourier = true;

        // Show courier notice
        if (!idolCourierNotice) {
          const noticeDiv = document.createElement('div');
          noticeDiv.id = 'idol-courier-notice';
          noticeDiv.className = 'mb-4 p-3.5 rounded-2xl border border-amber-300 bg-amber-50/80 text-amber-900 text-xs leading-relaxed flex items-center gap-3 shadow-xs';
          noticeDiv.innerHTML = `
            <span class="text-xl shrink-0">📦</span>
            <div>
              <div class="font-bold text-amber-900">Courier Delivery (3–5 Business Days)</div>
              <div class="text-[11px] text-amber-700 mt-0.5">Same day/next day delivery is possible in Metro Cities (Other cities by courier 3-5 days).</div>
            </div>
          `;
          const container = document.querySelector('.delivery-picker-container');
          if (dateLabelContainer) {
            dateLabelContainer.parentNode.insertBefore(noticeDiv, dateLabelContainer);
          } else if (container) {
            container.insertBefore(noticeDiv, container.children[1]);
          }
        } else {
          idolCourierNotice.classList.remove('hidden');
        }

        // Ensure time slot selector is visible
        if (timeSelectContainer) timeSelectContainer.style.display = 'flex';
        if (timeSelectEl) timeSelectEl.setAttribute('required', 'required');
        
        // Set 3 day minimum advance for courier delivery
        minAdv = Math.max(minAdv, 3);
        
        // Ensure date tabs are visible
        if (dateTabsContainer) dateTabsContainer.style.display = 'flex';
        if (dateLabelContainer) dateLabelContainer.style.display = 'flex';
      }
    } else if (!isIdolProduct && idolCourierNotice) {
      idolCourierNotice.classList.add('hidden');
      if (dateTabsContainer) dateTabsContainer.style.display = 'flex';
      if (dateLabelContainer) dateLabelContainer.style.display = 'flex';
    }
    // ---- USA & London Cake Override ----
    const isCakeProduct = deliveryContainer && deliveryContainer.dataset.isCake === 'true';
    if (intlState.isIntl && isCakeProduct) {
      const userCountry = (intlState.country || '').toLowerCase().trim();
      const isUsaActive = userCountry.includes('usa') || userCountry.includes('united states');
      const isLondonActive = userCountry.includes('london') || userCountry.includes('uk') || userCountry.includes('united kingdom');
      if (isUsaActive || isLondonActive) {
        minAdv = Math.max(minAdv, 2);
      }
    }

    // ---- International: no same-day delivery (matches the cart) ----
    // London same-day (SDD-tagged) is re-enabled by the London rule below.
    if (intlState.isIntl) {
      minAdv = Math.max(minAdv, 1);
    }

    const pdpNoticeEl = document.getElementById('intl-delivery-pdp-notice');

    const ukLoc = checkUkDeliveryLocation();

    // London & SDD Delivery Rules:
    // • London: Same day delivery possible (minAdv = 0)
    // • Other part of UK: Next day delivery earliest (minAdv >= 1)
    if (isLondonSddProduct) {
      if (ukLoc.isUk && ukLoc.isOtherUk) {
        minAdv = Math.max(minAdv, 1);
      } else if (ukLoc.isUk && ukLoc.isLondon) {
        minAdv = 0;
      }
    }



    // Calculate earliest available date
    let earliestAvailableDate = new Date(today);
    if (minAdv > 0) {
      earliestAvailableDate.setDate(today.getDate() + minAdv);
    } else if (!todayAvailable) {
      earliestAvailableDate.setDate(today.getDate() + 1);
    }

    const userCountry = (intlState.country || '').toLowerCase().trim();
    const isLondon = intlState.isIntl && (userCountry.includes('london') || userCountry.includes('uk') || userCountry.includes('united kingdom') || (pdpNoticeEl && pdpNoticeEl.dataset.isLondon === 'true'));
    const isUsa = intlState.isIntl && (userCountry.includes('usa') || userCountry.includes('united states') || (pdpNoticeEl && pdpNoticeEl.dataset.isUsa === 'true'));

    // Saturday delivery is possible in UK (only block Sunday).
    // USA delivery blocks both Saturday and Sunday.
    const disallowSunday = (intlState.isIntl ? !intlState.isSundayAllowed : false) || rules.noSunday || isLondon || isUsa;
    const disallowSaturday = isUsa;

    while ((disallowSunday && earliestAvailableDate.getDay() === 0) || (disallowSaturday && earliestAvailableDate.getDay() === 6)) {
      earliestAvailableDate.setDate(earliestAvailableDate.getDate() + 1);
    }

    const earliestISO = formatISODate(earliestAvailableDate);
    const todayISO = formatISODate(today);
    const tomorrowISO = formatISODate(tomorrow);
    const dayAfterISO = formatISODate(dayAfter);

    // Disable quick-select date tabs earlier than earliestAvailableDate
    if (tabToday) {
      if (todayISO < earliestISO) {
        tabToday.disabled = true;
        tabToday.classList.add('opacity-40', 'cursor-not-allowed');
        if (isLondonSddProduct && ukLoc.isUk && ukLoc.isOtherUk) {
          tabToday.title = 'Same-day delivery is available for London only. Next-day delivery is available across other parts of the UK.';
        } else if (intlState.isIntl && minAdv === 1) {
          tabToday.title = 'Same-day delivery is not available for international orders. Earliest delivery is tomorrow.';
        } else {
          tabToday.title = isIdolCourier ? 'Courier delivery: 3-5 business days' : (minAdv > 0 ? `Requires ${minAdv} days advance order processing` : 'Same-day delivery cutoff (4 PM) has passed');
        }
      } else {
        tabToday.disabled = false;
        tabToday.classList.remove('opacity-40', 'cursor-not-allowed');
        tabToday.title = '';
      }
    }

    if (tabTomorrow) {
      if (tomorrowISO < earliestISO || (disallowSunday && tomorrow.getDay() === 0) || (disallowSaturday && tomorrow.getDay() === 6)) {
        tabTomorrow.disabled = true;
        tabTomorrow.classList.add('opacity-40', 'cursor-not-allowed');
        const dayName = tomorrow.getDay() === 0 ? 'Sunday' : 'Saturday';
        tabTomorrow.title = isIdolCourier ? 'Courier delivery: 3-5 business days' : ((tomorrowISO < earliestISO && minAdv > 0)
          ? `Requires ${minAdv} days advance order processing`
          : `${dayName} is a non-delivery day`);
      } else {
        tabTomorrow.disabled = false;
        tabTomorrow.classList.remove('opacity-40', 'cursor-not-allowed');
      }
    }

    if (tabDayAfter) {
      if (dayAfterISO < earliestISO || (disallowSunday && dayAfter.getDay() === 0) || (disallowSaturday && dayAfter.getDay() === 6)) {
        tabDayAfter.disabled = true;
        tabDayAfter.classList.add('opacity-40', 'cursor-not-allowed');
        const dayName = dayAfter.getDay() === 0 ? 'Sunday' : 'Saturday';
        tabDayAfter.title = isIdolCourier ? 'Courier delivery: 3-5 business days' : ((dayAfterISO < earliestISO && minAdv > 0)
          ? `Requires ${minAdv} days advance order processing`
          : `${dayName} is a non-delivery day`);
      } else {
        tabDayAfter.disabled = false;
        tabDayAfter.classList.remove('opacity-40', 'cursor-not-allowed');
      }
    }

    // Auto-select earliest available date
    if (earliestISO === todayISO && tabToday && !tabToday.disabled) {
      selectDate(today, tabToday);
    } else if (earliestISO === tomorrowISO && tabTomorrow && !tabTomorrow.disabled) {
      selectDate(tomorrow, tabTomorrow);
    } else if (earliestISO === dayAfterISO && tabDayAfter && !tabDayAfter.disabled) {
      selectDate(dayAfter, tabDayAfter);
    } else {
      allQuickTabs.forEach(function(t) {
        t.classList.remove('active', 'bg-primary', 'text-white');
        t.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
      });
      if (customBtn) {
        customBtn.classList.add('bg-primary', 'text-white');
        customBtn.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-500');
      }
      hiddenInput.value = earliestISO;
      document.dispatchEvent(new CustomEvent('deliveryDateChanged', { detail: earliestISO }));
    }

    // Display notice
    if (isIdolCourier) {
      showNotice(`📦 Courier Delivery: Same day/next day delivery is possible in Metro Cities (Other cities by courier 3-5 days). Earliest delivery: ${formatTabDate(earliestAvailableDate)}.`, 'info');
    }

    // Re-init Flatpickr with minDate set to earliestISO
    const maxDate = new Date(today);
    maxDate.setMonth(maxDate.getMonth() + 12);

    if (typeof flatpickr !== 'undefined') {
      if (fp) fp.destroy();

      const disableRules = [];
      if (disallowSunday || disallowSaturday) {
        disableRules.push(function(date) {
          if (disallowSunday && date.getDay() === 0) return true;
          if (disallowSaturday && date.getDay() === 6) return true;
          return false;
        });
      }

      fp = flatpickr('#custom-calendar-picker', {
        minDate: earliestISO,
        maxDate: maxDate,
        dateFormat: 'Y-m-d',
        disableMobile: true,
        disable: disableRules,
        defaultDate: earliestISO,
        onChange: function(selectedDates, dateStr) {
          if (selectedDates.length > 0) {
            allQuickTabs.forEach(function(t) {
              t.classList.remove('active', 'bg-primary', 'text-white');
              t.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
            });
            if (customBtn) {
              customBtn.classList.add('bg-primary', 'text-white');
              customBtn.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-500');
            }

            hiddenInput.value = dateStr;
            filterTimeSlots(dateStr);
            document.dispatchEvent(new CustomEvent('deliveryDateChanged', { detail: dateStr }));
            // Save to localStorage so cart page can read it
            try { localStorage.setItem('floral_pdp_delivery_date', dateStr); } catch(e) {}
          }
        }
      });
    }
  }

  // ---- Core: filter time slots based on selected date ----
  function filterTimeSlots(selectedDateISO) {
    const intlState = getIntlDeliveryState();

    if (intlState.isIntl) {
      hideNotice();
      return;
    }

    const isToday = (selectedDateISO === formatISODate(today));
    const options  = timeSelect.querySelectorAll('option');
    let allDisabled = true;
    let firstEnabled = null;

    options.forEach(function(opt) {
      if (!opt.value) return; // placeholder

      const slotStart  = parseInt(opt.dataset.start, 10);
      const isMidnight = opt.dataset.midnight === 'true';

      let disabled = false;
      let reason   = '';

      if (slotStart === 8 || opt.value.indexOf('08:00 AM') !== -1) {
        const parts = selectedDateISO.split('-');
        if (parts.length === 3) {
          const selY = parseInt(parts[0], 10);
          const selM = parseInt(parts[1], 10) - 1;
          const selD = parseInt(parts[2], 10);
          const morningCutoff = new Date(selY, selM, selD - 1, 19, 0, 0, 0);
          if (new Date() >= morningCutoff) {
            disabled = true;
            reason   = 'morning_cutoff';
          }
        }
      }

      if (intlState.isIntl && isMidnight) {
        disabled = true;
        reason   = 'intl_no_midnight';
      }

      if (isToday) {
        if (isMidnight) {
          const midnightCutoff = 22 - MIDNIGHT_HOURS;
          if (currentHour >= midnightCutoff) {
            disabled = true;
            reason   = 'midnight';
          }
        } else {
          if (currentHour + PREP_HOURS > slotStart) {
            disabled = true;
            reason   = 'prep';
          }
        }
      }

      opt.disabled = disabled;
      opt.style.color = disabled ? '#bbb' : '';

      if (!disabled && allDisabled) {
        allDisabled  = false;
        firstEnabled = opt;
      }
    });

    const currentOption = timeSelect.querySelector(`option[value="${CSS.escape(timeSelect.value)}"]`);
    if (!timeSelect.value || (currentOption && currentOption.disabled)) {
      timeSelect.value = '';
    }

    const morningOpt = timeSelect.querySelector('option[data-start="8"]');
    const morningBlocked = morningOpt && morningOpt.disabled;

    if (isToday) {
      const midnightOpt = timeSelect.querySelector('option[data-midnight="true"]');
      const midnightBlocked = midnightOpt && midnightOpt.disabled;

      if (allDisabled) {
        showNotice('⚠️ No delivery slots available today. Please select Tomorrow or a future date.', 'warning');
      } else if (midnightBlocked && currentHour >= (22 - MIDNIGHT_HOURS)) {
        showNotice('🌙 Midnight slot unavailable — must be ordered 6 hrs in advance (by 4 PM). Select tomorrow for midnight delivery.', 'info');
      } else {
        hideNotice();
      }
    } else if (morningBlocked && currentHour >= 19 && selectedDateISO === formatISODate(tomorrow)) {
      showNotice('🌅 Morning slot (8:00 AM – 10:00 AM) closed — must be ordered before 7:00 PM on the previous day.', 'info');
    } else {
      hideNotice();
    }
  }

  // Global validation function to force alert before any submit or click action
  window.checkDeliveryTimeBeforeSubmit = function(e) {
    const intlState = getIntlDeliveryState();
    if (intlState.isIntl) {
      // Time slots not required for International Delivery
      return true;
    }

    const select = document.getElementById('delivery-time-select');
    if (!select || !select.value || select.value.trim() === '') {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
      }
      alert('Please select time of delivery');
      if (select) select.focus();
      return false;
    }
    return true;
  };

  const addToCartBtn = document.getElementById('add-to-cart-btn');
  if (addToCartBtn) {
    addToCartBtn.addEventListener('click', window.checkDeliveryTimeBeforeSubmit, true);
  }

  const productForm = timeSelect ? timeSelect.closest('form') : document.querySelector('form[action*="/cart/add"]');
  if (productForm) {
    productForm.addEventListener('submit', window.checkDeliveryTimeBeforeSubmit, true);
  }

  function showNotice(msg, type) {
    noticeText.textContent = msg;
    notice.classList.remove('hidden');
    if (type === 'warning') {
      notice.classList.remove('bg-blue-50', 'border-blue-200', 'text-blue-700');
      notice.classList.add('bg-amber-50', 'border-amber-200', 'text-amber-700');
    } else {
      notice.classList.remove('bg-amber-50', 'border-amber-200', 'text-amber-700');
      notice.classList.add('bg-blue-50', 'border-blue-200', 'text-blue-700');
    }
  }

  function hideNotice() {
    notice.classList.add('hidden');
  }

  // ---- Activate tab visually ----
  function activateTab(tab) {
    if (!tab) return;
    allQuickTabs.forEach(function(t) {
      t.classList.remove('active', 'bg-primary', 'text-white');
      t.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
    });
    if (customBtn) {
      customBtn.classList.remove('bg-primary', 'text-white');
      customBtn.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-500');
    }

    tab.classList.add('active', 'bg-primary', 'text-white');
    tab.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700');
  }

  // ---- Set date & update slots ----
  function selectDate(dateObj, tabEl) {
    const isoDate = formatISODate(dateObj);
    hiddenInput.value = isoDate;
    activateTab(tabEl);
    filterTimeSlots(isoDate);
    document.dispatchEvent(new CustomEvent('deliveryDateChanged', { detail: isoDate }));
    // Save to localStorage so cart page can read it
    try { localStorage.setItem('floral_pdp_delivery_date', isoDate); } catch(e) {}
  }

  // Initial Date Setup
  setupDateTabsAndRules();

  // ---- Tab click logic ----
  if (tabToday) {
    tabToday.addEventListener('click', function(e) {
      e.preventDefault();
      if (!this.disabled) selectDate(today, this);
    });
  }
  if (tabTomorrow) {
    tabTomorrow.addEventListener('click', function(e) {
      e.preventDefault();
      if (!this.disabled) selectDate(tomorrow, this);
    });
  }
  if (tabDayAfter) {
    tabDayAfter.addEventListener('click', function(e) {
      e.preventDefault();
      if (!this.disabled) selectDate(dayAfter, this);
    });
  }

  // Save time to localStorage whenever it changes
  if (timeSelect) {
    timeSelect.addEventListener('change', function() {
      try { localStorage.setItem('floral_pdp_delivery_time', this.value); } catch(e) {}
    });
  }

  if (customBtn) {
    customBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (fp) {
        fp.open();
      } else {
        const picker = document.getElementById('custom-calendar-picker');
        if (picker) {
          picker.type = 'date';
          picker.focus();
          if (typeof picker.showPicker === 'function') picker.showPicker();
        }
      }
    });
  }

  // ---- Countdown Timer ----
  function updateCountdown() {
    const el = document.getElementById('delivery-countdown');
    if (!el) return;

    const intlState = getIntlDeliveryState();
    const ukLoc = checkUkDeliveryLocation();
    const isLondonSdd = isLondonSddProduct && ukLoc.isUk && ukLoc.isLondon;

    if (intlState.isIntl && !isLondonSdd) {
      el.style.display = 'none';
      return;
    }

    const tabToday = document.getElementById('tab-today');
    if (tabToday && tabToday.disabled) {
      el.style.display = 'none';
      return;
    }

    el.style.display = 'inline';

    const cutoff = new Date(now.getFullYear(), now.getMonth(), now.getDate(), SAMEDAY_CUTOFF, 0, 0);
    const diff   = cutoff - new Date();

    if (diff > 0) {
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      el.innerHTML = '<span class="text-secondary font-bold">' + h + 'h ' + m + 'm ' + s + 's</span> left for today';
    } else {
      el.innerHTML = '<span class="text-rose-600 font-bold">Today\'s delivery closed</span>';
    }
  }
  updateCountdown();
  setInterval(updateCountdown, 1000);
});
</script>
