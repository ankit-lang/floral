{% comment %}
  Delivery Date & Time Picker
  - Green pill tab design matching the Floral India wireframes
  - Quick-select: Today / Tomorrow / Day After / Custom Calendar
  - Flatpickr calendar restricted to 3 months max
  - Countdown timer for same-day delivery cutoff
  - Rules:
      • 3-hour prep: Only show slots starting 3+ hrs from now (Today only)
      • Midnight slot (10 PM – 12 AM): Requires 6 hrs advance → cutoff 4 PM
      • 5 PM cutoff: No same-day delivery after 5 PM; auto-jump to Tomorrow
{% endcomment %}

{%- assign title_lc = product.title | downcase -%}
{%- assign type_lc = product.type | downcase -%}
{%- assign tags_lc = product.tags | join: ',' | downcase -%}
{%- assign is_intl_eligible = false -%}

{%- assign is_domestic_only = false -%}
{%- if tags_lc contains 'domestic' or tags_lc contains 'india only' or tags_lc contains 'india-only' or title_lc contains 'carlton london' or tags_lc contains 'carlton london' -%}
  {%- assign is_domestic_only = true -%}
{%- endif -%}

{%- assign is_london_product = false -%}
{%- unless is_domestic_only -%}
  {%- for tag in product.tags -%}
    {%- assign tag_lower = tag | downcase | strip -%}
    {%- if tag_lower == 'london' or tag_lower == 'uk' or tag_lower == 'united kingdom' -%}
      {%- assign is_london_product = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endunless -%}

{%- assign has_sdd_tag = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_clean = tag | downcase | strip -%}
  {%- if tag_clean == 'sdd' -%}
    {%- assign has_sdd_tag = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign is_usa_product = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_lower = tag | downcase | strip -%}
  {%- if tag_lower == 'usa' or tag_lower == 'us' or tag_lower == 'united states' -%}
    {%- assign is_usa_product = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- assign is_in_flower_collection = false -%}
{%- if collection and collection.handle contains 'flower' -%}
  {%- assign is_in_flower_collection = true -%}
{%- endif -%}
{%- for c in product.collections -%}
  {%- assign c_handle = c.handle | downcase -%}
  {%- if c_handle contains 'flower' -%}
    {%- assign is_in_flower_collection = true -%}
  {%- endif -%}
{%- endfor -%}

{%- if is_london_product or is_usa_product or tags_lc contains 'international' or tags_lc contains 'worldwide' or tags_lc contains 'dubai' or tags_lc contains 'uae' or tags_lc contains 'canada' or tags_lc contains 'australia' or title_lc contains 'usa' or title_lc contains 'international' or title_lc contains 'worldwide' or tags_lc contains 'balloon' or title_lc contains 'balloon' or type_lc contains 'balloon' or is_in_flower_collection or title_lc contains 'flower' or title_lc contains 'cake' or title_lc contains 'rose' or title_lc contains 'bouquet' or title_lc contains 'bloom' or title_lc contains 'blossom' or title_lc contains 'carnation' or title_lc contains 'lily' or title_lc contains 'orchid' or title_lc contains 'tulip' or title_lc contains 'gerbera' or title_lc contains 'sunflower' or title_lc contains 'hydrangea' or title_lc contains 'iris' or title_lc contains 'peony' or title_lc contains 'bunch' or title_lc contains 'vase' or type_lc contains 'flowers' or type_lc contains 'cakes' or tags_lc contains 'flowers' or tags_lc contains 'cakes' -%}
  {%- unless is_domestic_only -%}
    {%- assign is_intl_eligible = true -%}
  {%- endunless -%}
{%- endif -%}

{%- assign is_in_plant_collection = false -%}
{%- if collection and collection.handle contains 'plant' -%}
  {%- assign is_in_plant_collection = true -%}
{%- endif -%}
{%- for c in product.collections -%}
  {%- assign c_handle = c.handle | downcase -%}
  {%- if c_handle contains 'plant' -%}
    {%- assign is_in_plant_collection = true -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} ABSOLUTE EXCLUSION: Plants, Hampers, Gifts, Sweets, Mugs, Teddy Bears are ALWAYS INDIA DELIVERY ONLY unless explicitly tagged with country {%- endcomment -%}
{%- assign prod_desc_lc = product.description | strip_html | downcase -%}
{%- assign advance_days = 0 -%}

{%- if prod_desc_lc contains 'advance' or prod_desc_lc contains 'process' -%}
  {%- if prod_desc_lc contains '4-5 advance' or prod_desc_lc contains '4 to 5 advance' or prod_desc_lc contains '4-5 days advance' or prod_desc_lc contains '5 days advance' or prod_desc_lc contains '5-day advance' -%}
    {%- assign advance_days = 5 -%}
  {%- elsif prod_desc_lc contains '3-4 advance' or prod_desc_lc contains '3 to 4 advance' or prod_desc_lc contains '4 days advance' or prod_desc_lc contains '4-day advance' -%}
    {%- assign advance_days = 4 -%}
  {%- elsif prod_desc_lc contains '2-3 advance' or prod_desc_lc contains '2 to 3 advance' or prod_desc_lc contains '2-3 days advance' or prod_desc_lc contains '3 days advance' or prod_desc_lc contains '3-day advance' or prod_desc_lc contains '3 days process' -%}
    {%- assign advance_days = 2 -%}
  {%- elsif prod_desc_lc contains '1-2 days advance' or prod_desc_lc contains '1-2 day advance' or prod_desc_lc contains '1-2 advance' or prod_desc_lc contains '1 to 2 days advance' or prod_desc_lc contains '1 to 2 advance' -%}
    {%- comment -%} '1-2 days' means next-day delivery is possible {%- endcomment -%}
    {%- assign advance_days = 1 -%}
  {%- elsif prod_desc_lc contains '2 days advance' or prod_desc_lc contains '2-day advance' or prod_desc_lc contains '2 days process' -%}
    {%- assign advance_days = 2 -%}
  {%- elsif prod_desc_lc contains '1 day advance' or prod_desc_lc contains '1-day advance' or prod_desc_lc contains '1 day process' -%}
    {%- assign advance_days = 1 -%}
  {%- endif -%}
{%- endif -%}

{%- for tag in product.tags -%}
  {%- assign tag_lc = tag | downcase | strip -%}
  {%- if tag_lc == '2-days-advance' or tag_lc == '2 days advance' or tag_lc == '2-advance' -%}
    {%- assign advance_days = 2 -%}
  {%- elsif tag_lc == '3-days-advance' or tag_lc == '3 days advance' or tag_lc == '3-advance' -%}
    {%- assign advance_days = 3 -%}
  {%- elsif tag_lc == '4-days-advance' or tag_lc == '4 days advance' or tag_lc == '4-advance' -%}
    {%- assign advance_days = 4 -%}
  {%- endif -%}
{%- endfor -%}

{%- assign desc_no_sunday = false -%}
{%- if prod_desc_lc contains 'sunday delivery not possible' or prod_desc_lc contains 'sundays non-delivery' or prod_desc_lc contains 'no sunday' or prod_desc_lc contains 'sunday closed' -%}
  {%- assign desc_no_sunday = true -%}
{%- endif -%}

{%- assign has_choc = false -%}
{%- assign has_gifting = false -%}
{%- assign is_exotic = false -%}
{%- for tag in product.tags -%}
  {%- assign tag_clean = tag | downcase | strip -%}
  {%- if tag_clean == 'chocolate' or tag_clean == 'chocolates' -%}
    {%- assign has_choc = true -%}
  {%- endif -%}
  {%- if tag_clean == 'gifting' -%}
    {%- assign has_gifting = true -%}
  {%- endif -%}
  {%- if tag_clean contains 'exotic' -%}
    {%- assign is_exotic = true -%}
  {%- endif -%}
{%- endfor -%}
{%- assign is_choc_gifting = false -%}
{%- if has_choc and has_gifting -%}
  {%- assign is_choc_gifting = true -%}
  {%- if advance_days < 1 -%}
    {%- assign advance_days = 1 -%}
  {%- endif -%}
{%- endif -%}
{%- if is_exotic -%}
  {%- if advance_days < 2 -%}
    {%- assign advance_days = 2 -%}
  {%- endif -%}
{%- endif -%}

{%- assign is_karwa_chauth = false -%}
{%- if collection and collection.handle contains 'karwa-chauth' -%}
  {%- assign is_karwa_chauth = true -%}
{%- endif -%}
{%- capture kc_flag -%}{%- render 'karwa-chauth-check', product: product -%}{%- endcapture -%}
{%- if kc_flag contains 'true' -%}
  {%- assign is_karwa_chauth = true -%}
{%- endif -%}
{%- if is_karwa_chauth -%}
  {%- if advance_days < 3 -%}
    {%- assign advance_days = 3 -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%} Tier-Based Delivery Logic Detection (Diwali Idols & Fruit Hampers) {%- endcomment -%}
{%- assign is_tier_restricted = false -%}
{%- if title_lc contains 'idol' or title_lc contains 'statue' or title_lc contains 'murti' or tags_lc contains 'idol' or tags_lc contains 'diwali idol' or type_lc contains 'idol' or title_lc contains 'fruit hamper' or type_lc contains 'fruit hamper' or tags_lc contains 'fruit hamper' -%}
  {%- assign is_tier_restricted = true -%}
{%- else -%}
  {%- for c in product.collections -%}
    {%- assign c_handle = c.handle | downcase -%}
    {%- if c_handle contains 'idol' or c_handle contains 'diwali-idol' or c_handle contains 'fruit-hampers' or c_handle == 'fruit hampers' -%}
      {%- assign is_tier_restricted = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- assign is_cake = false -%}
{%- if title_lc contains 'cake' or type_lc contains 'cake' or type_lc contains 'cakes' or tags_lc contains 'cake' or tags_lc contains 'cakes' -%}
  {%- assign is_cake = true -%}
{%- endif -%}

<div class="delivery-picker-container mb-6" data-advance-days="{{ advance_days }}" data-no-sunday="{{ desc_no_sunday }}" data-is-idol="{{ is_tier_restricted }}" data-is-cake="{{ is_cake }}" data-is-choc-gifting="{{ is_choc_gifting }}" data-is-exotic="{{ is_exotic }}" data-is-london="{{ is_london_product }}" data-has-sdd="{{ has_sdd_tag }}">

  <!-- International Delivery PDP Notice -->
  <div id="intl-delivery-pdp-notice" data-intl-eligible="{{ is_intl_eligible }}" data-domestic-only="{{ is_domestic_only }}" data-is-london="{{ is_london_product }}" data-is-usa="{{ is_usa_product }}" data-has-sdd="{{ has_sdd_tag }}" class="hidden mb-4 p-3.5 rounded-2xl border text-xs leading-relaxed">
    <!-- Populated dynamically via JS -->
  </div>

  <!-- City / Location Row -->
  <div class="mb-4 rounded-lg overflow-hidden border border-gray-200 shadow-2xs" id="delivery-location-container">
    
    <!-- State 1: Displayed when NO pincode is selected (India Mode) -->
    <div id="no-pincode-prompt" onclick="openPincodeModal('india')" class="w-full px-4 py-3 bg-gray-50 hover:bg-gray-100 transition-colors flex items-center justify-between cursor-pointer border-dashed border-2 border-primary/30 rounded-lg group/prompt">
      <div class="flex items-center gap-2 text-primary font-semibold text-xs">
        <svg class="w-4 h-4 text-primary shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>Select City / Enter Pincode for Delivery</span>
      </div>
      <span class="text-xs font-bold bg-primary text-white px-3 py-1 rounded-full shadow-2xs group-hover/prompt:bg-primary-600 transition-colors">Enter Pincode</span>
    </div>

    <!-- State 2: Displayed when an Indian Pincode IS selected -->
    <div id="active-pincode-bar" class="hidden flex w-full flex-col sm:flex-row">
      {%- comment -%} Options are generated from the saved pincode (city + state) by lockLocationWithPincode() {%- endcomment -%}
      <select id="delivery-location" autocomplete="off" disabled
        class="px-3.5 py-2.5 bg-primary text-white text-sm font-bold border-none outline-none shrink-0"
        style="min-width: 120px;">
        <option value="">Select Pincode</option>
      </select>
      <input type="hidden" name="properties[City]" id="delivery-city-property" value="">

      <div class="flex-1 flex items-center bg-white px-3.5 py-2 gap-2 border-t sm:border-t-0 sm:border-l border-gray-200">
        <input type="text" id="delivery-exact-location" name="properties[Exact Location]" placeholder="House No / Street Address (optional)"
          class="flex-1 text-xs text-gray-800 bg-transparent border-none outline-none placeholder-gray-400 font-medium truncate">
        <button type="button" id="change-pincode-btn" class="text-[11px] font-bold text-primary shrink-0 whitespace-nowrap bg-primary/10 hover:bg-primary hover:text-white px-2.5 py-1 rounded-md transition-colors cursor-pointer">
          Change Pincode
        </button>
      </div>
    </div>

    <!-- State 3: Displayed when International Delivery Mode is active -->
    <div id="intl-active-location-bar" class="hidden flex w-full items-center justify-between bg-gradient-to-r from-amber-500 to-pink-600 text-white p-2.5 px-3.5 rounded-lg shadow-2xs">
      <div class="flex items-center gap-2 text-xs font-bold min-w-0 truncate">
        <span class="text-base shrink-0">🌐</span>
        <span class="truncate">Delivering to: <strong id="pdp-intl-location-display" class="underline underline-offset-2">USA</strong></span>
      </div>
      <button type="button" onclick="openPincodeModal('international')" class="text-[11px] font-bold bg-white text-amber-900 hover:bg-amber-100 px-3 py-1 rounded-full transition-colors cursor-pointer shrink-0 ml-2">
        Change Location
      </button>
    </div>

  </div>

  <!-- Date & Time of Delivery Label + Countdown -->
  <div class="flex items-center justify-between mb-3">
    <label class="text-xs font-bold text-gray-500 uppercase tracking-widest">Date and Time of Delivery</label>
    <span id="delivery-countdown" class="text-xs font-semibold text-secondary"></span>
  </div>

  {%- if item_advance_days > 0 -%}
    <div class="mb-3 p-2 bg-amber-50 border border-amber-200 rounded-md text-amber-800 text-[11px] flex items-start gap-2">
      <span class="text-base leading-none shrink-0">⏳</span>
      <span><strong>Please note:</strong> This item requires advance preparation ({{ item_advance_days }} day{% if item_advance_days > 1 %}s{% endif %}), so the earliest delivery date has been automatically adjusted.</span>
    </div>
  {%- endif -%}

  <!-- Quick-Select Date Tabs (Green Pill Design) -->
  <div class="flex gap-2 mb-4" id="delivery-date-tabs">
    <button type="button"
      class="date-tab flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md"
      data-date="today" id="tab-today">
      <span class="block font-bold today-label">Today</span>
      <span class="block text-[10px] opacity-90 today-date-display"></span>
    </button>
    <button type="button"
      class="date-tab flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md"
      data-date="tomorrow" id="tab-tomorrow">
      <span class="block font-bold">Tomorrow</span>
      <span class="block text-[10px] text-gray-400 tomorrow-date-display"></span>
    </button>
    <button type="button"
      class="date-tab flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md"
      data-date="dayafter" id="tab-dayafter">
      <span class="block font-bold">Day After</span>
      <span class="block text-[10px] text-gray-400 dayafter-date-display"></span>
    </button>
    <button type="button"
      class="date-tab w-12 py-2.5 rounded-lg bg-white border border-gray-200 text-gray-500 text-center transition-all hover:border-primary hover:shadow-md flex items-center justify-center"
      id="custom-date-btn" title="Choose your own date">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
      </svg>
    </button>
  </div>

  <!-- Hidden date value -->
  <input type="hidden" name="properties[Delivery Date]" id="selected-delivery-date" value="" required>

  <!-- Hidden Flatpickr input -->
  <input type="text" id="custom-calendar-picker" class="sr-only" tabindex="-1">

  <!-- Peak Surcharge Notice (hidden by default) -->
  <div id="peak-surcharge-notice" class="hidden mb-3 p-3 bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold rounded-lg flex items-center gap-2">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
    <span></span>
  </div>

  <!-- Time Slot Info Notice -->
  <div id="timeslot-notice" class="hidden mb-2 px-3 py-2 bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold rounded-lg flex items-center gap-2">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
    <span id="timeslot-notice-text"></span>
  </div>

  <!-- Time Slot Dropdown -->
  <div id="time-select-container" class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 bg-white transition-all">
    <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
    </svg>
    <select name="properties[Delivery Time]" id="delivery-time-select" class="flex-1 text-sm text-gray-700 bg-transparent border-none outline-none cursor-pointer font-medium" required>
      <option value="" selected disabled>Select favourable time of delivery</option>
      <option value="08:00 AM - 10:00 AM" data-start="8">08:00 AM - 10:00 AM</option>
      <option value="10:00 AM - 1:00 PM" data-start="10">10:00 AM - 1:00 PM</option>
      <option value="1:00 PM - 4:00 PM" data-start="13">1:00 PM - 4:00 PM</option>
      <option value="4:00 PM - 7:00 PM" data-start="16">4:00 PM - 7:00 PM</option>
      <option value="7:00 PM - 10:00 PM" data-start="19">7:00 PM - 10:00 PM</option>
      <option value="10:00 PM - 12:00 AM (Midnight)" data-start="22" data-midnight="true">10:00 PM - 12:00 AM (Midnight)</option>
    </select>
    <svg class="w-4 h-4 text-gray-400 flex-shrink-0 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </div>
</div>

<!-- Flatpickr CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script>
window.checkDeliveryTimeBeforeSubmit = function(e) {
  const select = document.getElementById('delivery-time-select');
  if (!select || !select.value || select.value.trim() === '') {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();
    }
    alert('Please select time of delivery');
    if (select) select.focus();
    return false;
  }
  return true;
};

document.addEventListener('DOMContentLoaded', function() {

  // ---- Constants ----
  const PREP_HOURS      = 3;   // minimum prep time before any slot
  const MIDNIGHT_HOURS  = 6;   // advance notice required for midnight slot
  const SAMEDAY_CUTOFF  = 16;  // 4 PM — no same-day delivery after this hour

  // ---- Helper: UK & London Location Classifier ----
  function checkUkDeliveryLocation() {
    const mode = localStorage.getItem('delivery_mode') || 'india';
    const country = (localStorage.getItem('user_country') || 'India').toLowerCase().trim();
    const countryCode = (localStorage.getItem('user_country_code') || 'IN').toLowerCase().trim();
    const locality = (localStorage.getItem('user_intl_locality') || '').toLowerCase().trim();
    const city = (localStorage.getItem('user_city') || '').toLowerCase().trim();
    const zip = (localStorage.getItem('user_intl_zip') || '').toLowerCase().trim();

    const isIntl = (mode === 'international') && (country !== 'india' && country !== 'in');
    const isUk = isIntl && (
      country.includes('uk') ||
      country.includes('united kingdom') ||
      country.includes('britain') ||
      country.includes('london') ||
      countryCode === 'gb' ||
      countryCode === 'uk'
    );

    if (!isUk) {
      return { isUk: false, isLondon: false, isOtherUk: false };
    }

    const nonLondonCities = [
      'manchester', 'birmingham', 'edinburgh', 'glasgow', 'bristol', 
      'leeds', 'liverpool', 'sheffield', 'newcastle', 'nottingham', 
      'cardiff', 'belfast', 'southampton', 'oxford', 'cambridge', 
      'york', 'brighton', 'leicester', 'coventry', 'hull', 'bradford'
    ];

    const isExplicitNonLondon = nonLondonCities.some(function(c) {
      return locality.includes(c) || city.includes(c);
    });

    const isLondonPostcode = /^(e|ec|n|nw|se|sw|w|wc)\d/i.test(zip);

    const isLondonKeyword = 
      locality.includes('london') || 
      city.includes('london') ||
      country.includes('london') ||
      locality.includes('westminster') ||
      locality.includes('belgravia') ||
      locality.includes('chelsea') ||
      locality.includes('kensington') ||
      locality.includes('mayfair') ||
      locality.includes('soho') ||
      locality.includes('camden') ||
      locality.includes('islington') ||
      locality.includes('greenwich') ||
      locality.includes('hackney') ||
      locality.includes('canary wharf') ||
      locality.includes('farringdon') ||
      locality.includes('barbican') ||
      city.includes('westminster') ||
      city.includes('kensington');

    let isLondon = false;
    if (isExplicitNonLondon) {
      isLondon = false;
    } else if (isLondonKeyword || isLondonPostcode) {
      isLondon = true;
    } else if (!locality && !city && !zip) {
      isLondon = true;
    } else if (zip && !isLondonPostcode) {
      isLondon = false;
    } else {
      isLondon = false;
    }

    return {
      isUk: true,
      isLondon: isLondon,
      isOtherUk: !isLondon
    };
  }

  // ---- Diwali Idol Tier-Based Delivery Logic ----
  const deliveryContainer = document.querySelector('.delivery-picker-container');
  const isIdolProduct = deliveryContainer && deliveryContainer.dataset.isIdol === 'true';

  // London + SDD-tagged product flag (shared by date rules and countdown timer)
  const pdpIntlNoticeEl = document.getElementById('intl-delivery-pdp-notice');
  const isLondonSddProduct =
    ((deliveryContainer && deliveryContainer.dataset.isLondon === 'true') ||
     (pdpIntlNoticeEl && pdpIntlNoticeEl.dataset.isLondon === 'true')) &&
    (deliveryContainer && deliveryContainer.dataset.hasSdd === 'true');

  // Metro cities where same day / next day delivery is possible for idols
  const METRO_CITIES = [
    'mumbai', 'delhi', 'new delhi', 'bangalore', 'bengaluru', 'hyderabad',
    'chennai', 'kolkata', 'pune', 'ahmedabad', 'noida', 'gurgaon', 'gurugram', 
    'faridabad', 'ghaziabad', 'navi mumbai', 'thane'
  ];

  function isUserInTier1City() {
    const savedCity = (localStorage.getItem('user_city') || '').toLowerCase().trim();
    // Strictly check by city name to ensure only true Metro Cities get same-day idol delivery
    if (savedCity && METRO_CITIES.some(c => savedCity.includes(c))) return true;
    return false;
  }

  const now     = new Date();
  const today   = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const tomorrow  = new Date(today); tomorrow.setDate(tomorrow.getDate() + 1);
  const dayAfter  = new Date(today); dayAfter.setDate(dayAfter.getDate() + 2);

  // ---- Format helpers ----
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
