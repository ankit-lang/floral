{%- comment -%}
  Newsletter Popup Snippet
  Triggers after a delay on the page to capture emails for the Welcome Series.
  Uses localStorage to ensure it only shows once every few days if dismissed.
{%- endcomment -%}

<div id="newsletter-popup" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-500">
  <div class="bg-white rounded-3xl shadow-2xl max-w-4xl w-full flex flex-col md:flex-row overflow-hidden transform scale-95 transition-transform duration-500" id="newsletter-popup-content">
    
    <!-- Image Side -->
    <div class="w-full md:w-1/2 bg-blush p-8 flex flex-col justify-center items-center relative overflow-hidden hidden md:flex">
      <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent"></div>
      <img src="{{ 'hero-banner.webp' | asset_url }}" alt="Floral India" class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-multiply" onerror="this.style.display='none'">
      <div class="relative z-10 text-center">
        <span class="text-6xl mb-4 block">🌸</span>
        <h3 class="text-3xl font-playfair font-bold text-gray-900 mb-2">Welcome to<br>Floral India</h3>
      </div>
    </div>

    <!-- Content Side -->
    <div class="w-full md:w-1/2 p-8 md:p-12 relative flex flex-col justify-center">
      <button id="close-newsletter" class="absolute top-4 right-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-50 text-gray-400 hover:text-gray-900 hover:bg-gray-100 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>

      <div class="text-center md:text-left mb-6">
        <span class="inline-block px-3 py-1 bg-primary/10 text-primary text-xs font-bold uppercase tracking-widest rounded-full mb-4">Special Offer</span>
        <h2 class="text-3xl md:text-4xl font-playfair font-bold text-gray-900 mb-3">Get 10% Off Your First Order</h2>
        <p class="text-gray-600 text-sm">Join our family today and let happiness bloom! Enter your email to receive your exclusive welcome gift.</p>
      </div>

      {% form 'customer', id: 'popup-newsletter-form', class: 'w-full flex flex-col gap-3' %}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">
        
        {%- if form.posted_successfully? -%}
          <div class="bg-green-50 text-green-800 p-4 rounded-xl text-sm font-medium text-center border border-green-100">
            Thank you! Please check your email for your surprise. 🎁
          </div>
          <script>
            // Set storage immediately if successful
            localStorage.setItem('floral_newsletter_dismissed', 'true');
            localStorage.setItem('floral_newsletter_dismissed_time', Date.now());
          </script>
        {%- else -%}
          <div class="flex flex-col gap-3">
            <input type="email" name="contact[email]" id="PopupEmail" class="w-full bg-gray-50 border border-gray-200 text-gray-900 rounded-xl px-4 py-3.5 text-sm focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Enter your email address" required aria-label="Email Address">
            <!-- reCAPTCHA -->
            {% render 'captcha-widget', widget_id: 'newsletter' %}
            <button type="submit" class="w-full bg-primary hover:bg-primary-600 text-white px-6 py-3.5 rounded-xl font-bold text-sm transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2 group">
              Reveal My Gift
              <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </button>
          </div>
          {%- if form.errors -%}
            <div class="text-red-500 text-xs text-center mt-2">{{ form.errors | default_errors }}</div>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
      
      <div class="mt-6 text-center">
        <button id="decline-newsletter" class="text-xs text-gray-400 hover:text-gray-600 underline underline-offset-2 transition-colors">
          No thanks, I'll pay full price
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const popup = document.getElementById('newsletter-popup');
    const content = document.getElementById('newsletter-popup-content');
    const closeBtn = document.getElementById('close-newsletter');
    const declineBtn = document.getElementById('decline-newsletter');
    
    // Check if user already dismissed or subscribed recently (within 7 days)
    const isDismissed = localStorage.getItem('floral_newsletter_dismissed');
    const dismissedTime = localStorage.getItem('floral_newsletter_dismissed_time');
    
    const SEVEN_DAYS = 7 * 24 * 60 * 60 * 1000;
    const shouldShow = !isDismissed || (dismissedTime && (Date.now() - parseInt(dismissedTime) > SEVEN_DAYS));

    // Also don't show on checkout/cart/login
    const isExcludedPage = window.location.pathname.includes('/cart') || 
                           window.location.pathname.includes('/checkout') || 
                           window.location.pathname.includes('/account');

    // Make sure we didn't just submit the form (which reloads the page)
    const justSubmitted = window.location.search.includes('customer_posted=true');

    if (shouldShow && !isExcludedPage && !justSubmitted && popup) {
      // Show popup after 5 seconds
      setTimeout(() => {
        popup.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.remove('scale-95');
        content.classList.add('scale-100');
      }, 5000);
    }

    const dismissPopup = () => {
      popup.classList.add('opacity-0', 'pointer-events-none');
      content.classList.add('scale-95');
      content.classList.remove('scale-100');
      
      // Save state to local storage
      localStorage.setItem('floral_newsletter_dismissed', 'true');
      localStorage.setItem('floral_newsletter_dismissed_time', Date.now());
    };

    if (closeBtn) closeBtn.addEventListener('click', dismissPopup);
    if (declineBtn) declineBtn.addEventListener('click', dismissPopup);
    
    // Close on click outside
    if (popup) {
      popup.addEventListener('click', (e) => {
        if (e.target === popup) {
          dismissPopup();
        }
      });
    }
  });
</script>
