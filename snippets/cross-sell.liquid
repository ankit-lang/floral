{% comment %}
  Cross-Sell / Frequently Bought Together Snippet
  ─────────────────────────────────────────────────
  How it works:
  • Add tags like "cross-sell:Balloons", "cross-sell:Cakes", "cross-sell:Chocolates"
    to any product in Shopify admin.
  • This snippet reads those tags, fetches up to 3 products per tag from the
    Shopify Search API, and renders a beautiful selectable cross-sell shelf.
  • Customers tick the items they want → single "Add Selected to Cart" CTA
    sends all items in one AJAX request.
{% endcomment %}

{% assign cross_sell_tags = '' %}
{% for tag in product.tags %}
  {% if tag contains 'cross-sell:' %}
    {% assign cross_sell_tags = cross_sell_tags | append: tag | append: ',' %}
  {% endif %}
{% endfor %}

{% if cross_sell_tags == '' %}
  {% assign cross_sell_tags = 'cross-sell:Cakes,cross-sell:Chocolates,cross-sell:Vases,cross-sell:Gifts,cross-sell:Gourmet,cross-sell:Fragrance,cross-sell:Plants,cross-sell:Greeting Cards,cross-sell:Jar Cakes,' %}
{% endif %}

{% assign is_current_london = false %}
{% assign is_current_usa = false %}
{% for tag in product.tags %}
  {% assign tag_lower = tag | downcase | strip %}
  {% if tag_lower == 'london' or tag_lower == 'uk' or tag_lower == 'united kingdom' %}
    {% assign is_current_london = true %}
  {% elsif tag_lower == 'usa' or tag_lower == 'us' or tag_lower == 'united states' %}
    {% assign is_current_usa = true %}
  {% endif %}
{% endfor %}

<div id="cross-sell-section" class="mt-6 mb-4 rounded-2xl bg-amber-50/40 border border-amber-200/70 p-4 scroll-mt-24" data-cross-tags="{{ cross_sell_tags | escape }}" data-current-is-london="{{ is_current_london }}" data-current-is-usa="{{ is_current_usa }}">

  <!-- Section Header -->
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="text-xl">✨</span>
      <div>
        <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider">
          {{ section_settings.cross_sell_heading | default: 'Make It Extra Special' }}
        </h3>
        <p class="text-[11px] text-gray-500">
          {{ section_settings.cross_sell_subtitle | default: 'Pair your flowers with delicious cakes & gourmet gifts' }}
        </p>
      </div>
    </div>
    <span class="text-[10px] font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full uppercase tracking-wider">Add-ons</span>
  </div>

  <!-- Pre-rendered Cross-sell Container -->
  <div id="cross-sell-items" class="block">

    <!-- Category tabs (filled by JS) -->
    <div id="cross-sell-tabs" class="flex gap-2 mb-3 overflow-x-auto pb-1 cursor-grab active:cursor-grabbing select-none" style="scrollbar-width:none;-ms-overflow-style:none;">
      <button type="button" class="cs-tab active">Cakes</button>
      <button type="button" class="cs-tab">Chocolates</button>
      <button type="button" class="cs-tab">Vases</button>
      <button type="button" class="cs-tab">Gifts</button>
      <button type="button" class="cs-tab">Gourmet</button>
      <button type="button" class="cs-tab">Fragrance</button>
      <button type="button" class="cs-tab">Plants</button>
      <button type="button" class="cs-tab">Greeting Cards</button>
      <button type="button" class="cs-tab">Jar Cakes</button>
    </div>

    <!-- Items shelf wrapper -->
    <div class="relative group">
      <!-- Left Arrow -->
      <button type="button" id="cs-scroll-left" class="absolute left-0 top-1/2 -translate-y-1/2 -ml-2 w-8 h-8 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-600 hover:text-primary z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <!-- Items shelf (Pre-rendered real store products from Theme Editor or Store catalog) -->
      <div id="cross-sell-shelf" class="flex gap-3 overflow-x-auto pb-3 cursor-grab active:cursor-grabbing select-none relative z-0" style="scrollbar-width:none;-ms-overflow-style:none;">
        {% assign current_prod_id = product.id %}
        {% assign real_count = 0 %}
        {% assign glass_vase_product = all_products['glass-vase'] %}
        {% assign has_rendered_glass_vase = false %}

        {% assign custom_addon_list = section_settings.addon_products %}
        {% if custom_addon_list == blank and section_settings.addon_collection != blank %}
          {% assign custom_addon_list = section_settings.addon_collection.products %}
        {% endif %}
        {% if custom_addon_list != blank %}
          {% for p in custom_addon_list %}
            {% if p.handle == 'glass-vase' %}{% assign has_rendered_glass_vase = true %}{% endif %}
            {% render 'cross-sell-card', p: p, current_prod_id: current_prod_id %}
          {% endfor %}
        {% else %}
          {% paginate collections['all'].products by 250 %}
            {% for p in collections['all'].products %}
              {% if p.handle == 'glass-vase' %}{% assign has_rendered_glass_vase = true %}{% endif %}
              {% render 'cross-sell-card', p: p, current_prod_id: current_prod_id %}
            {% endfor %}
          {% endpaginate %}
        {% endif %}

        {% if has_rendered_glass_vase == false and glass_vase_product and glass_vase_product.id != blank and glass_vase_product.id != current_prod_id %}
          {% render 'cross-sell-card', p: glass_vase_product, current_prod_id: current_prod_id, is_london_exclusive_addon: true %}
          {% assign has_rendered_glass_vase = true %}
        {% endif %}

        {% if has_rendered_glass_vase == false and current_prod_id != 8154809073742 %}
          {% comment %} Direct fallback for Glass Vase London add-on {% endcomment %}
          <div class="cs-card" data-category="Vases" data-is-uk="true" data-is-usa="false" data-is-india="false" data-domestic-only="false" data-is-vase="true" data-london-only="true" data-tags="London,Glass Vase,Gifts,Flowers and Glass" data-product-url="/products/glass-vase" data-title="GLASS VASE" data-img="https://cdn.shopify.com/s/files/1/0748/1766/7150/files/l14.jpg?v=1792417348" data-variant-id="44602006241358" data-price="159810">
            <div class="cs-check"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></div>
            <div class="w-full h-28 bg-gray-50 overflow-hidden relative">
              <img src="https://cdn.shopify.com/s/files/1/0748/1766/7150/files/l14.jpg?v=1792417348" alt="GLASS VASE" class="w-full h-full object-cover" loading="lazy">
            </div>
            <div class="p-2.5">
              <p class="text-[11px] font-bold text-gray-800 line-clamp-2 leading-tight mb-1">GLASS VASE</p>
              <p class="text-[11px] font-semibold text-primary cs-price" data-base-price="159810">£15.98</p>
              <button class="cs-add-btn" type="button">+ Add</button>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Right Arrow -->
      <button type="button" id="cs-scroll-right" class="absolute right-0 top-1/2 -translate-y-1/2 -mr-2 w-8 h-8 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-600 hover:text-primary z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>

    <!-- Add selected CTA -->
    <div id="cross-sell-footer" class="hidden mt-3 pt-3 border-t border-gray-200/60">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-[11px] text-gray-500">Selected Cake / Add-ons</p>
          <p id="cross-sell-total" class="text-sm font-bold text-gray-900">₹0</p>
        </div>
        <button id="cross-sell-add-btn" type="button"
          class="flex items-center gap-2 px-4 py-2 bg-primary text-white text-xs font-bold rounded-xl hover:bg-primary-600 active:scale-95 transition-all duration-200 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Add to Cart with Selected Add-ons
        </button>
      </div>

      <!-- Success flash -->
      <div id="cross-sell-success" class="hidden mt-2 flex items-center gap-2 text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg>
        Add-ons added to your cart!
      </div>
    </div>
  </div>

</div>

<style>
  #cross-sell-shelf::-webkit-scrollbar { display: none; }

  .cs-card {
    flex-shrink: 0;
    width: 140px;
    border-radius: 1rem;
    border: 2px solid #e5e7eb;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    position: relative;
    user-select: none;
  }
  .cs-card:hover {
    border-color: #0e7040;
    box-shadow: 0 6px 20px rgba(14,112,64,0.12);
    transform: translateY(-2px);
  }
  .cs-card.selected {
    border-color: #0e7040;
    box-shadow: 0 0 0 3px rgba(14,112,64,0.15);
    background: #f0faf4;
  }
  .cs-card .cs-check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #d1d5db;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    z-index: 10;
  }
  .cs-card.selected .cs-check {
    background: #0e7040;
    border-color: #0e7040;
  }
  .cs-card.selected .cs-check svg {
    display: block;
  }
  .cs-card .cs-check svg {
    display: none;
  }
  .cs-tab {
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    border: 1.5px solid #e5e7eb;
    background: #fff;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.18s;
    white-space: nowrap;
  }
  .cs-tab.active {
    background: #0e7040;
    border-color: #0e7040;
    color: #fff;
  }
  .cs-add-btn {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 5px 0;
    border-radius: 8px;
    border: none;
    background: #f3f4f6;
    color: #374151;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    text-align: center;
  }
  .cs-add-btn:hover {
    background: #0e7040;
    color: #fff;
  }
  #cross-sell-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
(function() {
  const sectionEl = document.getElementById('cross-sell-section');
  if (!sectionEl) return;

  const rawTags = sectionEl.dataset.crossTags || '';
  const categories = rawTags.split(',')
    .filter(Boolean)
    .map(function(t) { return t.replace('cross-sell:', '').trim(); })
    .filter(function(v, i, a) { return v && a.indexOf(v) === i; }); // unique

  if (!categories.length) return;

  const shelf      = document.getElementById('cross-sell-shelf');
  const tabsEl     = document.getElementById('cross-sell-tabs');
  const loading    = document.getElementById('cross-sell-loading');
  const itemsWrap  = document.getElementById('cross-sell-items');
  const footer     = document.getElementById('cross-sell-footer');
  const totalEl    = document.getElementById('cross-sell-total');
  const addBtn     = document.getElementById('cross-sell-add-btn');
  const successEl  = document.getElementById('cross-sell-success');

  const initialCardsHTML = shelf ? shelf.innerHTML : '';

  // Cache: { category: [product, ...] }
  const cache      = {};
  let activeCategory = categories[0];
  const selectedItems = {}; // variantId → { price, title }

  // ── Fetch products for a category ──────────────────────────────────────────
  function fetchCategory(cat) {
    return new Promise(function(resolve) {
      if (cat.toLowerCase() === 'vases') {
        resolve([]);
        return;
      }
      if (cache[cat]) { resolve(cache[cat]); return; }
      fetch('/search/suggest.json?q=' + encodeURIComponent(cat) + '&resources[type]=product&resources[limit]=6')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          const products = (data.resources && data.resources.results && data.resources.results.products) || [];
          cache[cat] = products;
          resolve(products);
        })
        .catch(function() { cache[cat] = []; resolve([]); });
    });
  }

  // ── Format money using Global Currency Manager ───────────────────────────
  function formatMoney(paise) {
    if (window.FloralCurrencyManager) {
      return window.FloralCurrencyManager.formatBasePrice(paise);
    }
    return '₹' + (paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function syncCrossSellPrices() {
    if (!shelf) return;
    shelf.querySelectorAll('.cs-card').forEach(function(card) {
      const priceEl = card.querySelector('.cs-price');
      const pVal = card.dataset.price;
      if (priceEl && pVal) {
        priceEl.textContent = formatMoney(parseInt(pVal, 10));
      }
    });
    updateFooter();
  }

  function filterShelfByCategory(cat) {
    if (shelf && !shelf.querySelector('.cs-card')) {
      shelf.innerHTML = initialCardsHTML;
      shelf.querySelectorAll('.cs-card').forEach(bindCardEvents);
    }

    // Deduplicate any repeated cards with the same variant ID
    const seenCards = new Set();
    if (shelf) {
      shelf.querySelectorAll('.cs-card').forEach(function(c) {
        const vid = c.dataset.variantId;
        if (vid && seenCards.has(vid)) {
          c.remove();
        } else if (vid) {
          seenCards.add(vid);
        }
      });
    }

    const mode = (localStorage.getItem('delivery_mode') || '').toLowerCase().trim();
    const userCountry = (localStorage.getItem('user_country') || '').toLowerCase().trim();
    const userCountryCode = (localStorage.getItem('user_country_code') || '').toLowerCase().trim();
    const userLocality = (localStorage.getItem('user_intl_locality') || '').toLowerCase().trim();

    const isCurrentProductLondon = (sectionEl && sectionEl.dataset.currentIsLondon === 'true') ||
                                   document.documentElement.classList.contains('london-mode-active') ||
                                   (document.body && document.body.classList.contains('london-mode-active')) ||
                                   document.querySelector('#intl-delivery-pdp-notice[data-is-london="true"]') !== null;

    const isCurrentProductUsa = (sectionEl && sectionEl.dataset.currentIsUsa === 'true') ||
                                document.documentElement.classList.contains('usa-mode-active') ||
                                (document.body && document.body.classList.contains('usa-mode-active')) ||
                                document.querySelector('#intl-delivery-pdp-notice[data-is-usa="true"]') !== null;

    const shopifyCountry = (window.Shopify && window.Shopify.country) ? window.Shopify.country.toLowerCase() : '';
    const shopifyCurrency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) ? window.Shopify.currency.active.toUpperCase() : '';

    // Active browsing context — the visitor's delivery choice (India / International) decides first.
    // Previously stale browser values (an old UK selection, GBP currency or a UK Shopify market) put
    // India-mode visitors into UK context, so some browsers showed UK add-ons on Indian products.
    const isIntlMode = mode === 'international';
    const noModeChosen = !mode;
    const pickedUk = userCountryCode === 'gb' || userCountryCode === 'uk' ||
                     /\b(uk|united kingdom|great britain|london|england)\b/.test(userCountry) || userLocality.includes('london');
    const pickedUsa = userCountryCode === 'us' || /\b(usa|us|united states|america)\b/.test(userCountry);

    // UK context: current product is a London product, or visitor chose UK delivery,
    // or (only when no delivery mode chosen yet) the Shopify market is UK / GBP
    const isUkContext = isCurrentProductLondon ||
                        (isIntlMode && pickedUk) ||
                        (noModeChosen && !isCurrentProductUsa && (shopifyCountry === 'gb' || shopifyCurrency === 'GBP'));

    // USA context: same rules for the United States
    const isUsaContext = !isUkContext && (isCurrentProductUsa ||
                         (isIntlMode && pickedUsa) ||
                         (noModeChosen && (shopifyCountry === 'us' || shopifyCurrency === 'USD')));

    // India context for everything else
    const isIndiaContext = !isUkContext && !isUsaContext;

    let matched = 0;
    const cards = shelf ? shelf.querySelectorAll('.cs-card') : [];

    cards.forEach(function(card) {
      const cardCat = card.dataset.category || 'Gifts';
      const cardTitle = (card.dataset.title || '').toLowerCase();
      const cardTagsRaw = (card.dataset.tags || '').toLowerCase();
      const cardTagsList = cardTagsRaw.split(',').map(t => t.trim());
      const cardUrl = (card.dataset.productUrl || '').toLowerCase();

      const isGlassVase = card.dataset.isVase === 'true' || cardUrl.includes('glass-vase') || cardTitle.includes('glass vase');

      // Strict product country tags:
      // UK product has london tag (or uk tag, or is glass vase)
      // USA product has usa tag
      // All other products are Indian products
      const hasLondonTag = cardTagsList.includes('london') || cardTagsList.includes('uk') || cardTagsList.includes('united kingdom');
      const hasUsaTag = cardTagsList.includes('usa') || cardTagsList.includes('us') || cardTagsList.includes('united states');

      const isCardUk = card.dataset.isUk === 'true' || isGlassVase || hasLondonTag;
      const isCardUsa = !isCardUk && (card.dataset.isUsa === 'true' || hasUsaTag);
      const isCardIndia = !isCardUk && !isCardUsa;

      // Exclude Karwa Chauth products & Jewellery, purses, bangles, necklaces
      const isKarwaChauth = cardTitle.includes('karwa') || cardTitle.includes('karva') || cardTitle.includes('sargi') || cardTitle.includes('chauth') ||
        cardTagsRaw.includes('karwa') || cardTagsRaw.includes('karva') || cardTagsRaw.includes('sargi') || cardTagsRaw.includes('chauth');

      const isJewelleryOrPurse = 
        cardTitle.includes('jewel') || cardTitle.includes('necklace') || cardTitle.includes('neckpiece') ||
        cardTitle.includes('bangle') || cardTitle.includes('bracelet') || cardTitle.includes('earring') ||
        cardTitle.includes('pendant') || cardTitle.includes('chain') || cardTitle.includes('anklet') ||
        cardTitle.includes('payal') || cardTitle.includes('mangalsutra') || cardTitle.includes('shringar') ||
        cardTitle.includes('purse') || cardTitle.includes('clutch') || cardTitle.includes('handbag') ||
        cardTitle.includes('tote') || cardTitle.includes('potli') || cardTitle.includes('batwa') ||
        cardTitle.includes('wallet') ||
        cardTagsRaw.includes('jewel') || cardTagsRaw.includes('necklace') || cardTagsRaw.includes('neckpiece') ||
        cardTagsRaw.includes('bangle') || cardTagsRaw.includes('bracelet') || cardTagsRaw.includes('earring') ||
        cardTagsRaw.includes('pendant') || cardTagsRaw.includes('chain') || cardTagsRaw.includes('anklet') ||
        cardTagsRaw.includes('payal') || cardTagsRaw.includes('mangalsutra') || cardTagsRaw.includes('shringar') ||
        cardTagsRaw.includes('purse') || cardTagsRaw.includes('clutch') || cardTagsRaw.includes('handbag') ||
        cardTagsRaw.includes('tote') || cardTagsRaw.includes('potli') || cardTagsRaw.includes('batwa') ||
        cardTagsRaw.includes('wallet');

      if (isKarwaChauth || isJewelleryOrPurse) {
        card.style.display = 'none';
        return;
      }

      let isCatMatch = false;
      if (!cat || cat === 'All') {
        isCatMatch = true;
      } else if (cat.toLowerCase() === 'vases') {
        // Show ONLY the standalone glass vase under Vases tab
        isCatMatch = isGlassVase;
      } else {
        // Other tabs must not show the glass vase
        isCatMatch = (cardCat.toLowerCase() === cat.toLowerCase()) && !isGlassVase;
      }
      
      let isCountryMatch = false;
      if (isUkContext) {
        // UK context: show ONLY UK products
        isCountryMatch = isCardUk;
      } else if (isUsaContext) {
        // USA context: show ONLY USA products
        isCountryMatch = isCardUsa;
      } else {
        // India context: show ONLY Indian products (never UK, never USA)
        isCountryMatch = isCardIndia;
      }

      card.dataset.countryEligible = isCountryMatch ? 'true' : 'false';

      if (isCatMatch && isCountryMatch) {
        card.style.display = '';
        matched++;
      } else {
        card.style.display = 'none';
      }

      // Update card price in current currency
      const priceEl = card.querySelector('.cs-price');
      const pVal = card.dataset.price;
      if (priceEl && pVal) {
        priceEl.textContent = formatMoney(parseInt(pVal, 10));
      }
    });

    updateTabsVisibility();

    // Remove any notification banner completely
    const noticeEl = document.getElementById('cs-intl-category-notice');
    if (noticeEl) {
      noticeEl.remove();
    }
  }

  // ── Render cards for a category ───────────────────────────────────────────
  function renderCards(products) {
    if (!products || !products.length) {
      filterShelfByCategory(activeCategory);
      return;
    }

    products = products.filter(function(p) {
      const t = ((p.title || '') + ' ' + (p.handle || '')).toLowerCase();
      const isExcluded = 
        t.includes('karwa') || t.includes('karva') || t.includes('sargi') || t.includes('chauth') ||
        t.includes('jewel') || t.includes('necklace') || t.includes('neckpiece') ||
        t.includes('bangle') || t.includes('bracelet') || t.includes('earring') ||
        t.includes('pendant') || t.includes('chain') || t.includes('anklet') ||
        t.includes('payal') || t.includes('mangalsutra') || t.includes('shringar') ||
        t.includes('purse') || t.includes('clutch') || t.includes('handbag') ||
        t.includes('tote') || t.includes('potli') || t.includes('batwa') ||
        t.includes('wallet');
      return !isExcluded;
    });

    shelf.innerHTML = '';
    products.forEach(function(p) {
      const price     = p.price;
      const variantId = p.id;
      let imgUrl = (p.featured_image && p.featured_image.url) ? p.featured_image.url : (p.image || '');
      if (imgUrl && imgUrl.startsWith('//')) {
        imgUrl = 'https:' + imgUrl;
      }

      const title     = p.title || p.handle;
      const url       = p.url;

      const card = document.createElement('div');
      card.className = 'cs-card';
      card.dataset.productUrl = url;
      card.dataset.title = title;
      card.dataset.img   = imgUrl;
      card.dataset.category = activeCategory;

      card.innerHTML =
        // Checkmark
        '<div class="cs-check"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></div>' +
        // Image
        '<div class="w-full h-28 bg-gray-50 overflow-hidden relative">' +
          '<img src="' + imgUrl + '" alt="' + title.replace(/"/g,'') + '" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" onerror="this.onerror=null;this.src=\'https://images.pexels.com/photos/291528/pexels-photo-291528.jpeg?auto=compress&cs=tinysrgb&w=400\';">' +
        '</div>' +
        // Info
        '<div class="p-2.5">' +
          '<p class="text-[11px] font-bold text-gray-800 line-clamp-2 leading-tight mb-1">' + title + '</p>' +
          '<p class="text-[11px] font-semibold text-primary cs-price">Loading...</p>' +
          '<button class="cs-add-btn" type="button">+ Add</button>' +
        '</div>';

      shelf.appendChild(card);

      if (p.fallbackPrice) {
        card.dataset.variantId = 'addon-' + Math.random().toString(36).substr(2, 6);
        card.dataset.price     = p.fallbackPrice;
        card.querySelector('.cs-price').textContent = formatMoney(p.fallbackPrice);
      } else {
        let handle = '';
        if (url && url.includes('/products/')) {
          handle = url.split('/products/')[1].split('?')[0].split('#')[0];
        } else if (p.handle) {
          handle = p.handle;
        }

        if (handle) {
          fetch('/products/' + handle + '.js')
            .then(function(r) { return r.json(); })
            .then(function(product) {
              if (product && product.variants && product.variants.length > 0) {
                const variant = product.variants[0];
                card.dataset.variantId = variant.id;
                card.dataset.price     = variant.price;
                card.querySelector('.cs-price').textContent = formatMoney(variant.price);
              }
            })
            .catch(function(err) {
              console.warn('Error loading cross-sell variant info', err);
              card.querySelector('.cs-price').textContent = p.price || '';
            });
        } else {
          card.querySelector('.cs-price').textContent = p.price || '';
        }
      }

      bindCardEvents(card);
    });
  }

  // ── Bind click events to a card ────────────────────────────────────────────
  function bindCardEvents(card) {
    if (card.dataset.eventsBound) return;
    card.dataset.eventsBound = "true";

    card.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleCard(card);
    });
  }

  // ── Toggle card selection ──────────────────────────────────────────────────
  function toggleCard(card) {
    let vid = card.dataset.variantId;
    if (!vid) {
      vid = 'addon-' + Math.random().toString(36).substr(2, 6);
      card.dataset.variantId = vid;
    }

    let price = parseInt(card.dataset.price || '0', 10);
    if (!price) {
      const priceText = card.querySelector('.cs-price') ? card.querySelector('.cs-price').textContent : '';
      const num = parseInt(priceText.replace(/[^0-9]/g, ''), 10);
      price = (num || 599) * 100;
      card.dataset.price = price;
    }

    const title = card.dataset.title || (card.querySelector('.line-clamp-2') ? card.querySelector('.line-clamp-2').textContent.trim() : 'Add-on Item');
    const addBtnEl = card.querySelector('.cs-add-btn');

    if (card.classList.contains('selected')) {
      card.classList.remove('selected');
      delete selectedItems[vid];
      if (addBtnEl) {
        addBtnEl.textContent = '+ Add';
        addBtnEl.style.background = '';
        addBtnEl.style.color = '';
      }
    } else {
      card.classList.add('selected');
      selectedItems[vid] = { price: price, title: title };
      if (addBtnEl) {
        addBtnEl.textContent = '✓ Added';
        addBtnEl.style.background = '#0e7040';
        addBtnEl.style.color = '#fff';
      }
    }
    updateFooter();
  }

  // ── Global accessor for selected cross-sell products ──────────────────────
  window.getSelectedCrossSellItems = function() {
    const list = [];
    const keys = Object.keys(selectedItems);
    keys.forEach(function(vid) {
      const numVid = parseInt(vid, 10);
      if (!isNaN(numVid) && numVid > 0) {
        list.push({
          id: numVid,
          title: (selectedItems[vid] && selectedItems[vid].title) ? selectedItems[vid].title : 'Add-on',
          price: (selectedItems[vid] && selectedItems[vid].price) ? selectedItems[vid].price : 0
        });
      }
    });
    // Fallback: Also check any .cs-card.selected in DOM that might have data-variant-id
    const selectedCards = document.querySelectorAll('#cross-sell-shelf .cs-card.selected, .cs-card.selected');
    selectedCards.forEach(function(c) {
      const numVid = parseInt(c.dataset.variantId, 10);
      if (!isNaN(numVid) && numVid > 0 && !list.some(function(item) { return item.id === numVid; })) {
        list.push({
          id: numVid,
          title: c.dataset.title || 'Add-on',
          price: parseInt(c.dataset.price || '0', 10)
        });
      }
    });
    return list;
  };

  function updateFooter() {
    const keys = Object.keys(selectedItems);
    const bottomCartBtn = document.getElementById('add-to-cart-btn');

    if (keys.length === 0) {
      if (footer) footer.classList.add('hidden');
      if (bottomCartBtn && bottomCartBtn.dataset.originalHtml) {
        bottomCartBtn.innerHTML = bottomCartBtn.dataset.originalHtml;
      }
      return;
    }

    if (footer) footer.classList.remove('hidden');
    const total = keys.reduce(function(sum, vid) { return sum + (selectedItems[vid].price || 0); }, 0);
    if (totalEl) totalEl.textContent = formatMoney(total);
    const countText = keys.length + ' Add-on' + (keys.length > 1 ? 's' : '');
    if (addBtn) addBtn.textContent = 'Add to Cart with ' + countText + ' (' + formatMoney(total) + ')';

    if (bottomCartBtn) {
      if (!bottomCartBtn.dataset.originalHtml) {
        bottomCartBtn.dataset.originalHtml = bottomCartBtn.innerHTML;
      }
      bottomCartBtn.innerHTML = 'Add to Cart (+ ' + countText + ') <svg class="w-4 h-4 ml-1 inline" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>';
    }
  }

  // ── Quick add one item ─────────────────────────────────────────────────────
  function quickAddOne(variantId, title, price, btnEl) {
    if (!variantId) return;
    const card = btnEl ? btnEl.closest('.cs-card') : document.querySelector('.cs-card[data-variant-id="' + variantId + '"]');
    if (card && !card.classList.contains('selected')) {
      toggleCard(card);
    }
    const form = document.querySelector('form[action*="/cart/add"]');
    if (form) {
      if (typeof form.requestSubmit === 'function') {
        form.requestSubmit();
      } else {
        const submitBtn = form.querySelector('[type="submit"], button[name="add"], #add-to-cart-btn');
        if (submitBtn) submitBtn.click();
        else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
      }
    }
  }

  // ── Add all selected items with main product ───────────────────────────────
  if (addBtn) {
    addBtn.addEventListener('click', function(e) {
      e.preventDefault();
      const keys = Object.keys(selectedItems);
      if (!keys.length) return;

      // Validate delivery time if required on product page
      if (typeof window.checkDeliveryTimeBeforeSubmit === 'function') {
        const isValid = window.checkDeliveryTimeBeforeSubmit(e);
        if (isValid === false) return;
      }

      const form = document.querySelector('form[action*="/cart/add"]');
      if (form) {
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          const submitBtn = form.querySelector('[type="submit"], button[name="add"], #add-to-cart-btn');
          if (submitBtn) {
            submitBtn.click();
          } else {
            form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
          }
        }
      }
    });
  }

  // ── Update header cart badge count ────────────────────────────────────────
  function updateCartBadge() {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        let realCount = 0;
        if (cart.items) {
           cart.items.forEach(function(item) {
             if (item.handle !== 'peak-season-delivery-surcharge' && item.handle !== 'international-delivery-charge') {
               realCount += item.quantity;
             }
           });
        } else {
           realCount = cart.item_count;
        }
        const badge = document.getElementById('cart-count-badge');
        if (badge) badge.textContent = realCount;
        document.querySelectorAll('[data-cart-count]').forEach(function(el) {
          el.textContent = realCount;
        });
      });
  }

  // ── Update Tabs Visibility based on available eligible items ───────────────
  function updateTabsVisibility() {
    if (!tabsEl) return;
    const cards = shelf ? shelf.querySelectorAll('.cs-card') : [];
    const tabs = tabsEl.querySelectorAll('.cs-tab');

    let firstActiveTab = null;
    let currentTabHasItems = false;

    tabs.forEach(function(tab) {
      const tabCat = tab.textContent.trim().toLowerCase();
      let count = 0;
      cards.forEach(function(card) {
        if (card.dataset.countryEligible === 'true') {
          const cardCat = (card.dataset.category || 'Gifts').toLowerCase();
          const cardTitle = (card.dataset.title || '').toLowerCase();
          const cardUrl = (card.dataset.productUrl || '').toLowerCase();
          const isGlassVase = card.dataset.isVase === 'true' || cardUrl.includes('glass-vase') || cardTitle.includes('glass vase');
          let match = false;
          if (tabCat === 'all') match = true;
          else if (tabCat === 'vases') match = isGlassVase;
          else match = (cardCat === tabCat && !isGlassVase);
          if (match) count++;
        }
      });

      if (count > 0) {
        tab.style.display = '';
        if (!firstActiveTab) firstActiveTab = tab;
        if (tabCat === activeCategory.toLowerCase()) {
          currentTabHasItems = true;
        }
      } else {
        tab.style.display = 'none';
      }
    });

    // If currently selected tab has no items in this country, switch to first available tab
    if (!currentTabHasItems && firstActiveTab) {
      tabs.forEach(function(t) { t.classList.remove('active'); });
      firstActiveTab.classList.add('active');
      activeCategory = firstActiveTab.textContent.trim();
      const activeCatLower = activeCategory.toLowerCase();
      cards.forEach(function(card) {
        if (card.dataset.countryEligible === 'true') {
          const cardCat = (card.dataset.category || 'Gifts').toLowerCase();
          const cardTitle = (card.dataset.title || '').toLowerCase();
          const cardUrl = (card.dataset.productUrl || '').toLowerCase();
          const isGlassVase = card.dataset.isVase === 'true' || cardUrl.includes('glass-vase') || cardTitle.includes('glass vase');
          let isMatch = false;
          if (activeCatLower === 'all') isMatch = true;
          else if (activeCatLower === 'vases') isMatch = isGlassVase;
          else isMatch = (cardCat === activeCatLower && !isGlassVase);
          card.style.display = isMatch ? '' : 'none';
        } else {
          card.style.display = 'none';
        }
      });
    }
  }

  // ── Build category tabs ────────────────────────────────────────────────────
  function buildTabs() {
    tabsEl.innerHTML = '';
    categories.forEach(function(cat, idx) {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'cs-tab' + (idx === 0 ? ' active' : '');
      tab.textContent = cat;
      tab.addEventListener('click', function() {
        document.querySelectorAll('.cs-tab').forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        activeCategory = cat;
        filterShelfByCategory(cat);
      });
      tabsEl.appendChild(tab);
    });
  }

  // ── Mouse Drag-to-Scroll (Move Left/Right with Cursor) ─────────────────
  function enableDragToScroll(el) {
    if (!el) return;
    let isDown = false;
    let startX;
    let scrollLeft;

    el.addEventListener('mousedown', function(e) {
      isDown = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });

    el.addEventListener('mouseleave', function() {
      isDown = false;
    });

    el.addEventListener('mouseup', function() {
      isDown = false;
    });

    el.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      const walk = (x - startX) * 2;
      el.scrollLeft = scrollLeft - walk;
    });
  }

  enableDragToScroll(shelf);
  enableDragToScroll(tabsEl);

  // ── Arrow Scrolling ────────────────────────────────────────────────────────
  const scrollLeftBtn = document.getElementById('cs-scroll-left');
  const scrollRightBtn = document.getElementById('cs-scroll-right');
  
  if (scrollLeftBtn) {
    scrollLeftBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (shelf) shelf.scrollBy({ left: -250, behavior: 'smooth' });
    });
  }
  if (scrollRightBtn) {
    scrollRightBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (shelf) shelf.scrollBy({ left: 250, behavior: 'smooth' });
    });
  }

  // ── Make it extra special Scroll Trigger ─────────────────────────────────
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('#make-extra-special-trigger, .make-special-btn');
    if (btn) {
      e.preventDefault();
      sectionEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  // ── Event Listeners for Delivery & Currency Changes ─────────────────────────
  const handleCrossSellSync = function() {
    filterShelfByCategory(activeCategory);
    syncCrossSellPrices();
  };

  document.addEventListener('deliveryModeChanged', handleCrossSellSync);
  window.addEventListener('deliveryModeChanged', handleCrossSellSync);
  window.addEventListener('currencyUpdated', handleCrossSellSync);

  // ── Init ───────────────────────────────────────────────────────────────────
  document.querySelectorAll('.cs-card').forEach(bindCardEvents);
  buildTabs();
  if (loading) loading.classList.add('hidden');
  if (itemsWrap) itemsWrap.classList.remove('hidden');
  filterShelfByCategory(activeCategory);
  syncCrossSellPrices();

})();
</script>
