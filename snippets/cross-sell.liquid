{% comment %}
  Cross-Sell / Frequently Bought Together Snippet
  ─────────────────────────────────────────────────
  How it works:
  • Add tags like "cross-sell:Balloons", "cross-sell:Cakes", "cross-sell:Chocolates"
    to any product in Shopify admin.
  • This snippet reads those tags, fetches up to 3 products per tag from the
    Shopify Search API, and renders a beautiful selectable cross-sell shelf.
  • Customers tick the items they want → single "Add Selected to Cart" CTA
    sends all items in one AJAX request.
{% endcomment %}

{% assign cross_sell_tags = '' %}
{% for tag in product.tags %}
  {% if tag contains 'cross-sell:' %}
    {% assign cross_sell_tags = cross_sell_tags | append: tag | append: ',' %}
  {% endif %}
{% endfor %}

{% if cross_sell_tags == '' %}
  {% assign cross_sell_tags = 'cross-sell:Cakes,cross-sell:Chocolates,cross-sell:Gourmet,cross-sell:Fragrance,cross-sell:Plants,cross-sell:Greeting Cards,cross-sell:Gifts,cross-sell:Jar Cakes,' %}
{% endif %}

<div id="cross-sell-section" class="mt-6 mb-4 rounded-2xl bg-amber-50/40 border border-amber-200/70 p-4 scroll-mt-24" data-cross-tags="{{ cross_sell_tags | escape }}">

  <!-- Section Header -->
  <div class="flex items-center justify-between mb-3">
    <div class="flex items-center gap-2">
      <span class="text-xl">✨</span>
      <div>
        <h3 class="text-xs font-bold text-gray-900 uppercase tracking-wider">
          {{ section_settings.cross_sell_heading | default: 'Make It Extra Special' }}
        </h3>
        <p class="text-[11px] text-gray-500">
          {{ section_settings.cross_sell_subtitle | default: 'Pair your flowers with delicious cakes & gourmet gifts' }}
        </p>
      </div>
    </div>
    <span class="text-[10px] font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full uppercase tracking-wider">Add-ons</span>
  </div>

  <!-- Pre-rendered Cross-sell Container -->
  <div id="cross-sell-items" class="block">

    <!-- Category tabs (filled by JS) -->
    <div id="cross-sell-tabs" class="flex gap-2 mb-3 overflow-x-auto pb-1 cursor-grab active:cursor-grabbing select-none" style="scrollbar-width:none;-ms-overflow-style:none;">
      <button type="button" class="cs-tab active">Cakes</button>
      <button type="button" class="cs-tab">Chocolates</button>
      <button type="button" class="cs-tab">Gourmet</button>
      <button type="button" class="cs-tab">Fragrance</button>
      <button type="button" class="cs-tab">Plants</button>
      <button type="button" class="cs-tab">Greeting Cards</button>
      <button type="button" class="cs-tab">Gifts</button>
      <button type="button" class="cs-tab">Jar Cakes</button>
    </div>

    <!-- Items shelf wrapper -->
    <div class="relative group">
      <!-- Left Arrow -->
      <button type="button" id="cs-scroll-left" class="absolute left-0 top-1/2 -translate-y-1/2 -ml-2 w-8 h-8 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-600 hover:text-primary z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>

      <!-- Items shelf (Pre-rendered real store products from Theme Editor or Store catalog) -->
      <div id="cross-sell-shelf" class="flex gap-3 overflow-x-auto pb-3 cursor-grab active:cursor-grabbing select-none relative z-0" style="scrollbar-width:none;-ms-overflow-style:none;">
        {% assign current_prod_id = product.id %}
        {% assign real_count = 0 %}

        {% assign custom_addon_list = section_settings.addon_products %}
        {% if custom_addon_list == blank and section_settings.addon_collection != blank %}
          {% assign custom_addon_list = section_settings.addon_collection.products %}
        {% endif %}
        {% if custom_addon_list != blank %}
          {% for p in custom_addon_list %}
            {% render 'cross-sell-card', p: p, current_prod_id: current_prod_id %}
          {% endfor %}
        {% else %}
          {% paginate collections['all'].products by 250 %}
            {% for p in collections['all'].products %}
              {% render 'cross-sell-card', p: p, current_prod_id: current_prod_id %}
            {% endfor %}
          {% endpaginate %}
        {% endif %}
      </div>

      <!-- Right Arrow -->
      <button type="button" id="cs-scroll-right" class="absolute right-0 top-1/2 -translate-y-1/2 -mr-2 w-8 h-8 rounded-full bg-white shadow-md border border-gray-200 flex items-center justify-center text-gray-600 hover:text-primary z-10">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>

    <!-- Add selected CTA -->
    <div id="cross-sell-footer" class="hidden mt-3 pt-3 border-t border-gray-200/60">
      <div class="flex items-center justify-between gap-3">
        <div>
          <p class="text-[11px] text-gray-500">Selected Cake / Add-ons</p>
          <p id="cross-sell-total" class="text-sm font-bold text-gray-900">₹0</p>
        </div>
        <button id="cross-sell-add-btn" type="button"
          class="flex items-center gap-2 px-4 py-2 bg-primary text-white text-xs font-bold rounded-xl hover:bg-primary-600 active:scale-95 transition-all duration-200 shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          Add Selected Add-ons to Cart
        </button>
      </div>

      <!-- Success flash -->
      <div id="cross-sell-success" class="hidden mt-2 flex items-center gap-2 text-xs font-semibold text-green-700 bg-green-50 border border-green-200 rounded-lg px-3 py-2">
        <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg>
        Add-ons added to your cart!
      </div>
    </div>
  </div>

</div>

<style>
  #cross-sell-shelf::-webkit-scrollbar { display: none; }

  .cs-card {
    flex-shrink: 0;
    width: 140px;
    border-radius: 1rem;
    border: 2px solid #e5e7eb;
    background: #fff;
    overflow: hidden;
    cursor: pointer;
    transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s;
    position: relative;
    user-select: none;
  }
  .cs-card:hover {
    border-color: #0e7040;
    box-shadow: 0 6px 20px rgba(14,112,64,0.12);
    transform: translateY(-2px);
  }
  .cs-card.selected {
    border-color: #0e7040;
    box-shadow: 0 0 0 3px rgba(14,112,64,0.15);
    background: #f0faf4;
  }
  .cs-card .cs-check {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid #d1d5db;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    z-index: 10;
  }
  .cs-card.selected .cs-check {
    background: #0e7040;
    border-color: #0e7040;
  }
  .cs-card.selected .cs-check svg {
    display: block;
  }
  .cs-card .cs-check svg {
    display: none;
  }
  .cs-tab {
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    border: 1.5px solid #e5e7eb;
    background: #fff;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.18s;
    white-space: nowrap;
  }
  .cs-tab.active {
    background: #0e7040;
    border-color: #0e7040;
    color: #fff;
  }
  .cs-add-btn {
    display: block;
    width: 100%;
    margin-top: 6px;
    padding: 5px 0;
    border-radius: 8px;
    border: none;
    background: #f3f4f6;
    color: #374151;
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.18s, color 0.18s;
    text-align: center;
  }
  .cs-add-btn:hover {
    background: #0e7040;
    color: #fff;
  }
  #cross-sell-add-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
(function() {
  const sectionEl = document.getElementById('cross-sell-section');
  if (!sectionEl) return;

  const rawTags = sectionEl.dataset.crossTags || '';
  const categories = rawTags.split(',')
    .filter(Boolean)
    .map(function(t) { return t.replace('cross-sell:', '').trim(); })
    .filter(function(v, i, a) { return v && a.indexOf(v) === i; }); // unique

  if (!categories.length) return;

  const shelf      = document.getElementById('cross-sell-shelf');
  const tabsEl     = document.getElementById('cross-sell-tabs');
  const loading    = document.getElementById('cross-sell-loading');
  const itemsWrap  = document.getElementById('cross-sell-items');
  const footer     = document.getElementById('cross-sell-footer');
  const totalEl    = document.getElementById('cross-sell-total');
  const addBtn     = document.getElementById('cross-sell-add-btn');
  const successEl  = document.getElementById('cross-sell-success');

  const initialCardsHTML = shelf ? shelf.innerHTML : '';

  // Cache: { category: [product, ...] }
  const cache      = {};
  let activeCategory = categories[0];
  const selectedItems = {}; // variantId → { price, title }

  // ── Fetch products for a category ──────────────────────────────────────────
  function fetchCategory(cat) {
    return new Promise(function(resolve) {
      if (cache[cat]) { resolve(cache[cat]); return; }
      fetch('/search/suggest.json?q=' + encodeURIComponent(cat) + '&resources[type]=product&resources[limit]=6')
        .then(function(r) { return r.json(); })
        .then(function(data) {
          const products = (data.resources && data.resources.results && data.resources.results.products) || [];
          cache[cat] = products;
          resolve(products);
        })
        .catch(function() { cache[cat] = []; resolve([]); });
    });
  }

  // ── Format money using Global Currency Manager ───────────────────────────
  function formatMoney(paise) {
    if (window.FloralCurrencyManager) {
      return window.FloralCurrencyManager.formatBasePrice(paise);
    }
    return '₹' + (paise / 100).toLocaleString('en-IN', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
  }

  function syncCrossSellPrices() {
    if (!shelf) return;
    shelf.querySelectorAll('.cs-card').forEach(function(card) {
      const priceEl = card.querySelector('.cs-price');
      const pVal = card.dataset.price;
      if (priceEl && pVal) {
        priceEl.textContent = formatMoney(parseInt(pVal, 10));
      }
    });
    updateFooter();
  }

  function filterShelfByCategory(cat) {
    if (shelf && !shelf.querySelector('.cs-card')) {
      shelf.innerHTML = initialCardsHTML;
      shelf.querySelectorAll('.cs-card').forEach(bindCardEvents);
    }
    const mode = localStorage.getItem('delivery_mode') || 'india';
    const userCountry = (localStorage.getItem('user_country') || 'India').toLowerCase().trim();
    const userCountryCode = (localStorage.getItem('user_country_code') || 'IN').toLowerCase().trim();

    const isUsa = mode === 'international' && (userCountry.includes('usa') || userCountry.includes('united states') || userCountry === 'us' || userCountryCode === 'us' || userCountryCode === 'usa');
    const isUk  = mode === 'international' && (userCountry.includes('london') || userCountry.includes('uk') || userCountry.includes('united kingdom') || userCountryCode === 'gb');
    const isUae = mode === 'international' && (userCountry.includes('uae') || userCountry.includes('dubai') || userCountryCode === 'ae');

    let matched = 0;
    const cards = shelf ? shelf.querySelectorAll('.cs-card') : [];

    cards.forEach(function(card) {
      const cardCat = card.dataset.category || 'Gifts';
      const cardTitle = (card.dataset.title || '').toLowerCase();
      const cardTagsRaw = (card.dataset.tags || '').toLowerCase();
      const cardTagsList = cardTagsRaw.split(',').map(t => t.trim());
      
      const isUsaProd = cardTagsList.includes('usa') || cardTagsList.includes('us') || cardTagsList.includes('united states') || cardTagsRaw.includes('usa') || cardTitle.includes('usa');
      const isUkProd  = cardTagsList.includes('london') || cardTagsList.includes('uk') || cardTagsList.includes('united kingdom') || cardTagsRaw.includes('london') || cardTitle.includes('london');
      const isUaeProd = cardTagsList.includes('uae') || cardTagsList.includes('dubai') || cardTagsRaw.includes('uae') || cardTagsRaw.includes('dubai') || cardTitle.includes('dubai') || cardTitle.includes('uae');

      let isCatMatch = (!cat || cat === 'All' || cardCat.toLowerCase() === cat.toLowerCase());
      
      let isCountryMatch = false;
      if (mode === 'international') {
        if (isUsa) {
          // STRICT USA FILTER: Show ONLY products tagged with 'usa', 'us', or 'united states'
          isCountryMatch = isUsaProd;
        } else if (isUk) {
          // STRICT UK FILTER: Show ONLY products tagged with 'london', 'uk', or 'united kingdom'
          isCountryMatch = isUkProd;
        } else if (isUae) {
          // STRICT UAE FILTER: Show ONLY products tagged with 'uae' or 'dubai'
          isCountryMatch = isUaeProd;
        } else {
          const matchesTag = cardTagsList.includes(userCountry) || cardTagsList.includes(userCountryCode) || cardTagsList.includes('international') || cardTagsList.includes('worldwide');
          isCountryMatch = matchesTag;
        }
      } else {
        // India mode: hide international exclusive tagged items
        if (isUsaProd || isUkProd || isUaeProd) {
          isCountryMatch = false;
        } else {
          isCountryMatch = true;
        }
      }

      if (isCatMatch && isCountryMatch) {
        card.style.display = '';
        matched++;
      } else {
        card.style.display = 'none';
      }

      // Update card price in current currency
      const priceEl = card.querySelector('.cs-price');
      const pVal = card.dataset.price;
      if (priceEl && pVal) {
        priceEl.textContent = formatMoney(parseInt(pVal, 10));
      }
    });

    // Show clean info notice if 0 products match the strict country tag in International mode
    let noticeEl = document.getElementById('cs-intl-category-notice');
    if (mode === 'international' && matched === 0) {
      if (!noticeEl) {
        noticeEl = document.createElement('div');
        noticeEl.id = 'cs-intl-category-notice';
        noticeEl.className = 'w-full p-4 my-2 rounded-xl bg-amber-50 border border-amber-200 text-center text-xs text-amber-800 font-medium';
        shelf.parentElement.insertBefore(noticeEl, shelf);
      }
      const tagLabel = isUsa ? 'usa' : (isUk ? 'london' : (isUae ? 'uae' : userCountry));
      noticeEl.innerHTML = '🌐 <strong>No ' + cat + ' tagged "' + tagLabel + '" found</strong><br><span class="text-[11px] text-amber-700">To show ' + cat + ' for ' + userCountry.toUpperCase() + ' delivery, please add the tag <strong>"' + tagLabel + '"</strong> to your products in Shopify Admin.</span>';
      noticeEl.classList.remove('hidden');
    } else if (noticeEl) {
      noticeEl.classList.add('hidden');
    }
  }

  // ── Render cards for a category ───────────────────────────────────────────
  function renderCards(products) {
    if (!products || !products.length) {
      filterShelfByCategory(activeCategory);
      return;
    }

    shelf.innerHTML = '';
    products.forEach(function(p) {
      const price     = p.price;
      const variantId = p.id;
      let imgUrl = (p.featured_image && p.featured_image.url) ? p.featured_image.url : (p.image || '');
      if (imgUrl && imgUrl.startsWith('//')) {
        imgUrl = 'https:' + imgUrl;
      }

      const title     = p.title || p.handle;
      const url       = p.url;

      const card = document.createElement('div');
      card.className = 'cs-card';
      card.dataset.productUrl = url;
      card.dataset.title = title;
      card.dataset.img   = imgUrl;
      card.dataset.category = activeCategory;

      card.innerHTML =
        // Checkmark
        '<div class="cs-check"><svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path d="m5 13 4 4L19 7"/></svg></div>' +
        // Image
        '<div class="w-full h-28 bg-gray-50 overflow-hidden relative">' +
          '<img src="' + imgUrl + '" alt="' + title.replace(/"/g,'') + '" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" loading="lazy" onerror="this.onerror=null;this.src=\'https://images.pexels.com/photos/291528/pexels-photo-291528.jpeg?auto=compress&cs=tinysrgb&w=400\';">' +
        '</div>' +
        // Info
        '<div class="p-2.5">' +
          '<p class="text-[11px] font-bold text-gray-800 line-clamp-2 leading-tight mb-1">' + title + '</p>' +
          '<p class="text-[11px] font-semibold text-primary cs-price">Loading...</p>' +
          '<button class="cs-add-btn" type="button">+ Add</button>' +
        '</div>';

      shelf.appendChild(card);

      if (p.fallbackPrice) {
        card.dataset.variantId = 'addon-' + Math.random().toString(36).substr(2, 6);
        card.dataset.price     = p.fallbackPrice;
        card.querySelector('.cs-price').textContent = formatMoney(p.fallbackPrice);
      } else {
        let handle = '';
        if (url && url.includes('/products/')) {
          handle = url.split('/products/')[1].split('?')[0].split('#')[0];
        } else if (p.handle) {
          handle = p.handle;
        }

        if (handle) {
          fetch('/products/' + handle + '.js')
            .then(function(r) { return r.json(); })
            .then(function(product) {
              if (product && product.variants && product.variants.length > 0) {
                const variant = product.variants[0];
                card.dataset.variantId = variant.id;
                card.dataset.price     = variant.price;
                card.querySelector('.cs-price').textContent = formatMoney(variant.price);
              }
            })
            .catch(function(err) {
              console.warn('Error loading cross-sell variant info', err);
              card.querySelector('.cs-price').textContent = p.price || '';
            });
        } else {
          card.querySelector('.cs-price').textContent = p.price || '';
        }
      }

      bindCardEvents(card);
    });
  }

  // ── Bind click events to a card ────────────────────────────────────────────
  function bindCardEvents(card) {
    if (card.dataset.eventsBound) return;
    card.dataset.eventsBound = "true";

    card.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleCard(card);
    });
  }

  // ── Toggle card selection ──────────────────────────────────────────────────
  function toggleCard(card) {
    let vid = card.dataset.variantId;
    if (!vid) {
      vid = 'addon-' + Math.random().toString(36).substr(2, 6);
      card.dataset.variantId = vid;
    }

    let price = parseInt(card.dataset.price || '0', 10);
    if (!price) {
      const priceText = card.querySelector('.cs-price') ? card.querySelector('.cs-price').textContent : '';
      const num = parseInt(priceText.replace(/[^0-9]/g, ''), 10);
      price = (num || 599) * 100;
      card.dataset.price = price;
    }

    const title = card.dataset.title || (card.querySelector('.line-clamp-2') ? card.querySelector('.line-clamp-2').textContent.trim() : 'Add-on Item');
    const addBtnEl = card.querySelector('.cs-add-btn');

    if (card.classList.contains('selected')) {
      card.classList.remove('selected');
      delete selectedItems[vid];
      if (addBtnEl) {
        addBtnEl.textContent = '+ Add';
        addBtnEl.style.background = '';
        addBtnEl.style.color = '';
      }
      const existingInput = document.getElementById('addon-prop-' + vid);
      if (existingInput) existingInput.remove();
    } else {
      card.classList.add('selected');
      selectedItems[vid] = { price: price, title: title };
      if (addBtnEl) {
        addBtnEl.textContent = '✓ Added';
        addBtnEl.style.background = '#0e7040';
        addBtnEl.style.color = '#fff';
      }

      // Attach hidden property to product form so add-on is included when main item added
      const form = document.querySelector('form[action*="/cart/add"]');
      if (form && !document.getElementById('addon-prop-' + vid)) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.id = 'addon-prop-' + vid;
        input.name = 'properties[Add-on: ' + title + ']';
        input.value = formatMoney(price);
        form.appendChild(input);
      }
    }
    updateFooter();
  }

  function updateFooter() {
    const keys = Object.keys(selectedItems);
    if (keys.length === 0) {
      footer.classList.add('hidden');
      return;
    }
    footer.classList.remove('hidden');
    const total = keys.reduce(function(sum, vid) { return sum + (selectedItems[vid].price || 0); }, 0);
    totalEl.textContent = formatMoney(total);
    addBtn.textContent  = 'Add ' + keys.length + ' Item' + (keys.length > 1 ? 's' : '') + ' to Cart (' + formatMoney(total) + ')';
  }

  // ── Quick add one item ─────────────────────────────────────────────────────
  function quickAddOne(variantId, title, price, btnEl) {
    if (!variantId) return;
    const orig = btnEl.textContent;
    btnEl.textContent = '...';
    btnEl.disabled = true;

    const numericVid = parseInt(variantId, 10);
    if (!isNaN(numericVid)) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: numericVid, quantity: 1 })
      })
      .then(function(r) { return r.json(); })
      .then(function(res) {
        if (res.status && res.status >= 400) {
          throw new Error(res.description || 'Add to cart failed');
        }
        btnEl.textContent = '✓ Added!';
        btnEl.style.background = '#0e7040';
        btnEl.style.color = '#fff';
        updateCartBadge();
        setTimeout(function() {
          btnEl.textContent = orig;
          btnEl.style.background = '';
          btnEl.style.color = '';
          btnEl.disabled = false;
        }, 2000);
      })
      .catch(function(err) {
        console.error('Add to cart error', err);
        btnEl.textContent = orig;
        btnEl.disabled = false;
      });
    } else {
      // Fallback item — add property to form
      const form = document.querySelector('form[action*="/cart/add"]');
      if (form) {
        let input = document.getElementById('addon-prop-' + variantId);
        if (!input) {
          input = document.createElement('input');
          input.type = 'hidden';
          input.id = 'addon-prop-' + variantId;
          input.name = 'properties[Add-on: ' + title + ']';
          input.value = formatMoney(price || 0);
          form.appendChild(input);
        }
      }
      btnEl.textContent = '✓ Added to Product!';
      btnEl.style.background = '#0e7040';
      btnEl.style.color = '#fff';
      setTimeout(function() {
        btnEl.textContent = orig;
        btnEl.style.background = '';
        btnEl.style.color = '';
        btnEl.disabled = false;
      }, 2000);
    }
  }

  // ── Add all selected items ─────────────────────────────────────────────────
  addBtn.addEventListener('click', function() {
    const keys = Object.keys(selectedItems);
    if (!keys.length) return;

    addBtn.disabled = true;
    addBtn.textContent = 'Adding...';

    const items = [];
    keys.forEach(function(vid) {
      const numVid = parseInt(vid, 10);
      if (!isNaN(numVid)) {
        items.push({ id: numVid, quantity: 1 });
      }
    });

    if (items.length > 0) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
      .then(function(r) { return r.json(); })
      .then(function() {
        updateCartBadge();
        successEl.classList.remove('hidden');
        addBtn.textContent = '✓ Added!';
        setTimeout(function() {
          successEl.classList.add('hidden');
          addBtn.disabled = false;
          updateFooter();
        }, 3000);

        // Deselect all
        document.querySelectorAll('.cs-card.selected').forEach(function(c) {
          c.classList.remove('selected');
        });
        Object.keys(selectedItems).forEach(function(k) { delete selectedItems[k]; });
        updateFooter();
      })
      .catch(function(err) {
        console.error('Error adding selected cross-sells', err);
        addBtn.disabled = false;
        updateFooter();
      });
    } else {
      // Only fallback properties selected
      updateCartBadge();
      successEl.classList.remove('hidden');
      addBtn.textContent = '✓ Added!';
      setTimeout(function() {
        successEl.classList.add('hidden');
        addBtn.disabled = false;
        updateFooter();
      }, 3000);
    }
  });

  // ── Update header cart badge count ────────────────────────────────────────
  function updateCartBadge() {
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        let realCount = 0;
        if (cart.items) {
           cart.items.forEach(function(item) {
             if (item.handle !== 'peak-season-delivery-surcharge') {
               realCount += item.quantity;
             }
           });
        } else {
           realCount = cart.item_count;
        }
        const badge = document.getElementById('cart-count-badge');
        if (badge) badge.textContent = realCount;
        document.querySelectorAll('[data-cart-count]').forEach(function(el) {
          el.textContent = realCount;
        });
      });
  }

  // ── Build category tabs ────────────────────────────────────────────────────
  function buildTabs() {
    tabsEl.innerHTML = '';
    categories.forEach(function(cat, idx) {
      const tab = document.createElement('button');
      tab.type = 'button';
      tab.className = 'cs-tab' + (idx === 0 ? ' active' : '');
      tab.textContent = cat;
      tab.addEventListener('click', function() {
        document.querySelectorAll('.cs-tab').forEach(function(t) { t.classList.remove('active'); });
        tab.classList.add('active');
        activeCategory = cat;
        filterShelfByCategory(cat);
      });
      tabsEl.appendChild(tab);
    });
  }

  // ── Mouse Drag-to-Scroll (Move Left/Right with Cursor) ─────────────────
  function enableDragToScroll(el) {
    if (!el) return;
    let isDown = false;
    let startX;
    let scrollLeft;

    el.addEventListener('mousedown', function(e) {
      isDown = true;
      startX = e.pageX - el.offsetLeft;
      scrollLeft = el.scrollLeft;
    });

    el.addEventListener('mouseleave', function() {
      isDown = false;
    });

    el.addEventListener('mouseup', function() {
      isDown = false;
    });

    el.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - el.offsetLeft;
      const walk = (x - startX) * 2;
      el.scrollLeft = scrollLeft - walk;
    });
  }

  enableDragToScroll(shelf);
  enableDragToScroll(tabsEl);

  // ── Arrow Scrolling ────────────────────────────────────────────────────────
  const scrollLeftBtn = document.getElementById('cs-scroll-left');
  const scrollRightBtn = document.getElementById('cs-scroll-right');
  
  if (scrollLeftBtn) {
    scrollLeftBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (shelf) shelf.scrollBy({ left: -250, behavior: 'smooth' });
    });
  }
  if (scrollRightBtn) {
    scrollRightBtn.addEventListener('click', function(e) {
      e.preventDefault();
      if (shelf) shelf.scrollBy({ left: 250, behavior: 'smooth' });
    });
  }

  // ── Make it extra special Scroll Trigger ─────────────────────────────────
  document.addEventListener('click', function(e) {
    const btn = e.target.closest('#make-extra-special-trigger, .make-special-btn');
    if (btn) {
      e.preventDefault();
      sectionEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });

  // ── Event Listeners for Delivery & Currency Changes ─────────────────────────
  const handleCrossSellSync = function() {
    filterShelfByCategory(activeCategory);
    syncCrossSellPrices();
  };

  document.addEventListener('deliveryModeChanged', handleCrossSellSync);
  window.addEventListener('deliveryModeChanged', handleCrossSellSync);
  window.addEventListener('currencyUpdated', handleCrossSellSync);

  // ── Init ───────────────────────────────────────────────────────────────────
  document.querySelectorAll('.cs-card').forEach(bindCardEvents);
  buildTabs();
  if (loading) loading.classList.add('hidden');
  if (itemsWrap) itemsWrap.classList.remove('hidden');
  filterShelfByCategory(activeCategory);
  syncCrossSellPrices();

})();
</script>
