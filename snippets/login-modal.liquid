          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Sign Up -->
    <div class="w-full md:w-5/12 relative flex flex-col justify-center text-center p-8 md:p-10 min-h-[300px] md:min-h-full">
      <!-- Background Image -->
      <div class="absolute inset-0 bg-black">
        <img src="{{ 'login_modal_banner.png' | asset_url }}" alt="Floral Cake" class="w-full h-full object-cover opacity-80">
        <div class="absolute inset-0 bg-black/20"></div>
      </div>
      
      <div class="relative z-10 text-white">
        <h3 class="text-2xl font-serif font-bold mb-3 drop-shadow-md">New here?</h3>
        <p class="text-xs mb-8 drop-shadow-md px-2 leading-relaxed opacity-95">Sign up and discover a great amount of new opportunities!</p>
        <a id="login-modal-signup-btn" href="https://shopify.com/74817667150/account?return_url=%2F" class="inline-block border-2 border-white rounded-full py-2.5 px-8 text-xs font-bold tracking-wider hover:bg-white hover:text-gray-900 transition-all uppercase drop-shadow-md">SIGN UP</a>
      </div>
    </div>

  </div>
</div>

<script>
  function openLoginModal(redirectUrl) {
    if (typeof window.saveCartDeliveryDetailsToStorage === 'function') {
      window.saveCartDeliveryDetailsToStorage();
    }
    const overlay = document.getElementById('login-modal-overlay');
    const content = document.getElementById('login-modal-content');

    const signinBtn = document.getElementById('login-modal-signin-btn');
    const signupBtn = document.getElementById('login-modal-signup-btn');
    const baseAccountUrl = 'https://shopify.com/74817667150/account';

    // Smart return_url: go to cart if it has items, otherwise homepage
    fetch('/cart.js')
      .then(function(r) { return r.json(); })
      .then(function(cart) {
        var returnPath = (cart && cart.item_count > 0) ? '/cart' : '/';
        var urlWithReturn = baseAccountUrl + '?return_url=' + encodeURIComponent(returnPath);
        if (signinBtn) signinBtn.href = urlWithReturn;
        if (signupBtn) signupBtn.href = urlWithReturn;
      })
      .catch(function() {
        var urlWithReturn = baseAccountUrl + '?return_url=' + encodeURIComponent('/');
        if (signinBtn) signinBtn.href = urlWithReturn;
        if (signupBtn) signupBtn.href = urlWithReturn;
      });

    overlay.classList.remove('opacity-0', 'invisible');
    overlay.classList.add('opacity-100', 'visible');
    
    setTimeout(() => {
      content.classList.remove('scale-95', 'opacity-0');
      content.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeLoginModal() {
    const overlay = document.getElementById('login-modal-overlay');
    const content = document.getElementById('login-modal-content');
    
    content.classList.remove('scale-100', 'opacity-100');
    content.classList.add('scale-95', 'opacity-0');
    
    setTimeout(() => {
      overlay.classList.remove('opacity-100', 'visible');
      overlay.classList.add('opacity-0', 'invisible');
    }, 300);
  }

  // Close modal when clicking outside
  document.getElementById('login-modal-overlay')?.addEventListener('click', function(e) {
    if (e.target === this) {
      closeLoginModal();
    }
  });
</script>
