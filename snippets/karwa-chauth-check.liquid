{%- comment -%}
  Outputs "true" if the product is a Karwa Chauth product, otherwise "false".
  Matches karwa / karva / chauth / sargi in the title, handle, type, tags,
  or in any of the product's collection handles/titles.
  Usage: {%- capture is_kc -%}{%- render 'karwa-chauth-check', product: product -%}{%- endcapture -%}
{%- endcomment -%}
{%- assign kc = false -%}
{%- if product != blank -%}
  {%- assign kc_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | downcase -%}
  {%- assign kc_tags = product.tags | join: ' ' | downcase -%}
  {%- assign kc_colls = product.collections | map: 'handle' | join: ' ' | downcase -%}
  {%- assign kc_coll_titles = product.collections | map: 'title' | join: ' ' | downcase -%}
  {%- assign kc_all = kc_text | append: ' ' | append: kc_tags | append: ' ' | append: kc_colls | append: ' ' | append: kc_coll_titles -%}
  {%- if kc_all contains 'karwa' or kc_all contains 'karva' or kc_all contains 'chauth' or kc_all contains 'sargi' -%}
    {%- assign kc = true -%}
  {%- endif -%}
{%- endif -%}
{{- kc -}}
