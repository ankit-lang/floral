{% comment %}
  GST Tax Rate Breakdown Component
  Applicable Rates:
  - Fresh cut flowers / loose flowers: 0% GST (Nil)
  - Plants: 5% GST
  - Cakes: 18% GST
  - Chocolates: 18% GST
  - Balloons: 18% GST
  - Hampers: 18% GST
  - Musician / Guitarist / Pianist / Flutist on Call: 18% GST
  - Video Message: 18% GST
  - Delivery Charges: 18% GST
{% endcomment %}

<div class="gst-tax-breakdown my-4 p-4 rounded-2xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
  <div class="flex items-center justify-between mb-2">
    <div class="flex items-center gap-2">
      <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xs">
        ₹
      </div>
      <h4 class="text-xs font-bold text-gray-900 uppercase tracking-wider">Applicable GST Tax Rates</h4>
    </div>
    <span class="text-[10px] font-bold text-emerald-800 bg-emerald-100/80 px-2 py-0.5 rounded-full uppercase tracking-wider">Official GST Schedule</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs mt-3">
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Fresh Cut / Loose Flowers</span>
      <span class="font-bold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-lg border border-emerald-200/60">0% (Nil)</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Indoor & Potted Plants</span>
      <span class="font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded-lg border border-blue-200/60">5% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Cakes & Confectionery</span>
      <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Chocolates & Sweets</span>
      <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Balloons & Party Items</span>
      <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Gourmet Hampers</span>
      <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Artist on Call (Guitarist/Musician)</span>
      <span class="font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded-lg border border-purple-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs">
      <span class="font-medium text-gray-700">Video Message Service</span>
      <span class="font-bold text-purple-700 bg-purple-50 px-2 py-0.5 rounded-lg border border-purple-200/60">18% GST</span>
    </div>
    <div class="flex items-center justify-between p-2 rounded-xl bg-white border border-gray-100 shadow-2xs md:col-span-2">
      <span class="font-medium text-gray-700">Delivery & Logistics Charges</span>
      <span class="font-bold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200/60">18% GST</span>
    </div>
  </div>
</div>
