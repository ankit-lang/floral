{%- comment -%}
  Reusable product card snippet with Magic UI glow effect.
  Accepts: product_card_product (Product object)
{%- endcomment -%}

{%- assign title_lc = product_card_product.title | downcase -%}
{%- assign type_lc = product_card_product.type | downcase -%}
{%- assign tags_lc = product_card_product.tags | join: ',' | downcase -%}
{%- assign is_intl_eligible = false -%}

{%- assign is_domestic_only = false -%}
{%- if tags_lc contains 'domestic' or tags_lc contains 'india only' or tags_lc contains 'india-only' or title_lc contains 'carlton london' or tags_lc contains 'carlton london' -%}
  {%- assign is_domestic_only = true -%}
{%- endif -%}

{%- assign is_london_product = false -%}
{%- unless is_domestic_only -%}
  {%- if tags_lc contains 'london' or tags_lc contains 'uk' or tags_lc contains 'united kingdom' or title_lc contains 'london' or type_lc contains 'london' -%}
    {%- assign is_london_product = true -%}
  {%- endif -%}
{%- endunless -%}

{%- assign is_usa_product = false -%}
{%- for tag in product_card_product.tags -%}
  {%- assign tag_lower = tag | downcase | strip -%}
  {%- if tag_lower == 'usa' or tag_lower == 'us' or tag_lower == 'united states' or tag_lower contains 'usa' -%}
    {%- assign is_usa_product = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
{%- if title_lc contains 'usa' or type_lc contains 'usa' -%}
  {%- assign is_usa_product = true -%}
{%- endif -%}

{%- assign is_in_flower_collection = false -%}
{%- if collection and collection.handle contains 'flower' -%}
  {%- assign is_in_flower_collection = true -%}
{%- endif -%}
{%- for c in product_card_product.collections -%}
  {%- assign c_handle = c.handle | downcase -%}
  {%- if c_handle contains 'flower' -%}
    {%- assign is_in_flower_collection = true -%}
  {%- endif -%}
{%- endfor -%}

{%- if is_london_product or is_usa_product or tags_lc contains 'international' or tags_lc contains 'worldwide' or tags_lc contains 'dubai' or tags_lc contains 'uae' or tags_lc contains 'canada' or tags_lc contains 'australia' or title_lc contains 'usa' or title_lc contains 'international' or title_lc contains 'worldwide' -%}
  {%- unless is_domestic_only -%}
    {%- assign is_intl_eligible = true -%}
  {%- endunless -%}
{%- endif -%}

{%- assign is_in_plant_collection = false -%}
{%- if collection and collection.handle contains 'plant' -%}
  {%- assign is_in_plant_collection = true -%}
{%- endif -%}
{%- for c in product_card_product.collections -%}
  {%- assign c_handle = c.handle | downcase -%}
  {%- if c_handle contains 'plant' -%}
    {%- assign is_in_plant_collection = true -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} ABSOLUTE EXCLUSION: Plants, Balloons, Hampers, Gifts, Sweets, Mugs, Teddy Bears are ALWAYS INDIA DELIVERY ONLY {%- endcomment -%}
{%- if is_in_plant_collection or title_lc contains 'plant' or title_lc contains 'fykus' or title_lc contains 'ficus' or title_lc contains 'bamboo' or title_lc contains 'bonsai' or title_lc contains 'jade' or title_lc contains 'agave' or title_lc contains 'zamia' or title_lc contains 'yami' or title_lc contains 'succulent' or title_lc contains 'planter' or title_lc contains 'pot' or title_lc contains 'balloon' or title_lc contains 'hamper' or title_lc contains 'teddy' or title_lc contains 'mug' or title_lc contains 'sweet' or title_lc contains 'candle' or title_lc contains 'diffuser' or title_lc contains 'card' or title_lc contains 'gift' or type_lc contains 'plant' or type_lc contains 'balloon' or type_lc contains 'hamper' or tags_lc contains 'plant' or tags_lc contains 'plants' or tags_lc contains 'balloon' or tags_lc contains 'hamper' -%}
  {%- unless is_usa_product -%}
    {%- assign is_intl_eligible = false -%}
  {%- endunless -%}
{%- endif -%}

{%- assign is_exotic = false -%}
{%- for tag in product_card_product.tags -%}
  {%- assign tag_lower = tag | downcase | strip -%}
  {%- if tag_lower contains 'exotic' -%}
    {%- assign is_exotic = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

<div class="product-card magic-glow bg-white rounded-2xl flex flex-col h-full border border-gray-100" 
  data-tiers="{{ product_card_product.tags | join: ',' }}"
  data-type="{{ product_card_product.type | escape }}"
  data-tags="{{ product_card_product.tags | join: ',' | escape }}"
  data-price="{{ product_card_product.price | default: 0 }}"
  data-created="{{ product_card_product.created_at | date: '%s' | default: '0' }}"
  data-title="{{ product_card_product.title | escape }}"
  data-domestic-only="{{ is_domestic_only }}"
  data-intl-eligible="{{ is_intl_eligible }}"
  data-is-london="{{ is_london_product }}"
  data-is-usa="{{ is_usa_product }}"
  data-is-exotic="{{ is_exotic }}"
  data-position="{{ forloop.index | default: 0 }}">
  <a href="{{ product_card_product.url | default: '#' }}" class="relative block overflow-hidden rounded-t-2xl bg-gray-50">
    <div class="aspect-square w-full relative overflow-hidden group/img">
      <!-- Shine effect on hover -->
      <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent skew-x-[-20deg] group-hover/img:animate-[shimmer_1.5s_infinite] z-10 pointer-events-none"></div>
      {% if product_card_product.featured_media %}
        <img src="{{ product_card_product.featured_media | image_url: width: 600 }}" alt="{{ product_card_product.title | escape }}" class="w-full h-full object-cover transition-transform duration-700 group-hover/img:scale-110 duration-[1500ms]" loading="lazy">
      {% else %}
        <div class="w-full h-full bg-gradient-to-br from-blush to-champagne flex items-center justify-center">
          <span class="text-5xl opacity-30">-</span>
        </div>
      {% endif %}
    </div>
    
    {%- if product_card_product.available == false -%}
      <div class="absolute top-3 -left-2 bg-gray-900 text-white text-[10px] font-bold px-4 py-1 uppercase tracking-wider shadow-md animate-pulse-soft z-20" style="clip-path: polygon(0 0, 100% 0, 90% 100%, 0% 100%);">Sold Out</div>
    {%- elsif product_card_product.tags contains 'Same Day Delivery' or tags_lc contains 'sdd' -%}
      <span class="absolute top-3 left-3 bg-primary text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">Same Day</span>
    {%- elsif product_card_product.compare_at_price > product_card_product.price -%}
      {%- assign discount = product_card_product.compare_at_price | minus: product_card_product.price | times: 100 | divided_by: product_card_product.compare_at_price -%}
      <span class="absolute top-3 left-3 bg-secondary text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">{{ discount }}% Off</span>
    {%- endif -%}



    <!-- Quick add heart -->
    <button class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/80 backdrop-blur-sm flex items-center justify-center hover:bg-secondary hover:text-white text-gray-400 transition-all duration-200 shadow-sm">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
  </a>

  <div class="p-4 flex flex-col flex-grow">
    {% if product_card_product.vendor != blank %}
      <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">{{ product_card_product.vendor }}</span>
    {% endif %}
    <a href="{{ product_card_product.url | default: '#' }}" class="text-sm font-semibold text-gray-800 hover:text-secondary transition-colors line-clamp-2 mb-2">
      {{ product_card_product.title | default: 'Beautiful Product' | escape }}
    </a>
    <div class="mt-auto flex items-center gap-2">
      <span class="text-base font-bold text-gray-900" data-base-price="{{ product_card_product.price | default: 99900 }}">{{ product_card_product.price | default: 99900 | money }}</span>
      {% if product_card_product.compare_at_price > product_card_product.price %}
        <span class="text-xs text-gray-400 line-through" data-base-price="{{ product_card_product.compare_at_price }}">{{ product_card_product.compare_at_price | money }}</span>
      {% endif %}
    </div>
  </div>

  <div class="px-4 pb-4">
    <form class="card-ajax-form" data-product-id="{{ product_card_product.id }}" data-variant-id="{{ product_card_product.selected_or_first_available_variant.id }}" onsubmit="return false;">
      <input type="hidden" name="id" value="{{ product_card_product.selected_or_first_available_variant.id }}">
      
      <!-- Default Add to Cart Button -->
      <button type="button" onclick="window.handleProductCardAddToCart(this)" class="card-add-to-cart-btn relative w-full h-10 rounded-xl bg-primary/5 text-primary text-sm font-semibold hover:bg-primary hover:text-white transition-all duration-300 overflow-hidden group/btn cursor-pointer" {% unless product_card_product.available %}disabled{% endunless %}>
        <span class="btn-text absolute inset-0 flex items-center justify-center transition-transform duration-300 group-hover/btn:-translate-y-full">{% if product_card_product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
        <span class="absolute inset-0 flex items-center justify-center translate-y-full transition-transform duration-300 group-hover/btn:translate-y-0 text-xl font-light">{% if product_card_product.available %}+{% else %}Sold Out{% endif %}</span>
      </button>

      <!-- Inline Quantity Selector Control (Hidden by default) -->
      <div class="card-qty-wrapper hidden flex items-center justify-between w-full h-10 rounded-xl bg-primary text-white text-sm font-bold shadow-md">


        <button type="button" class="card-qty-btn card-qty-minus px-3.5 h-full hover:bg-primary-600 rounded-l-xl transition-colors flex items-center justify-center text-lg font-black select-none cursor-pointer">-</button>
        <span class="card-qty-count px-2 text-xs font-bold tracking-wider">1 in Cart</span>
        <button type="button" class="card-qty-btn card-qty-plus px-3.5 h-full hover:bg-primary-600 rounded-r-xl transition-colors flex items-center justify-center text-lg font-black select-none cursor-pointer">+</button>
      </div>
    </form>
  </div>
</div>
