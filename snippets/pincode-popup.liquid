  function getLocalitiesForIntl(country, zip) {
    const cleanZip = (zip || '').trim().toUpperCase();
    
    // 1. Check exact PIN match in static DB
    let match = intlPincodeDatabase.find(item => item.country === country && item.pincode && item.pincode.toUpperCase() === cleanZip);
    if (match && match.localities && match.localities.length > 0) return match.localities;

    // 2. Check country fallback in static DB
    let countryFallback = intlPincodeDatabase.find(item => item.country === country && (!item.pincode || item.pincode === '') && item.localities);
    let baseLocs = (countryFallback && countryFallback.localities) ? countryFallback.localities : ['City Center', 'Business District', 'Metropolitan Area', 'Suburbs'];

    if (cleanZip.length > 0) {
      const isNumber = !isNaN(cleanZip) && cleanZip.trim() !== '';
      if (isNumber) {
        return [
          `Central Area (${cleanZip})`,
          `Downtown District (${cleanZip})`
        ].concat(baseLocs);
      }
    }
    
    return baseLocs;
  }

  function fetchIntlPostalCode(countryCode, zip) {
    const cleanZip = (zip || '').trim();
    if (intlZipError) intlZipError.classList.add('hidden');

    if (!cleanZip) {
      const defLocs = getLocalitiesForIntl(selectedIntlCountry, '');
      activeIntlLocalities = defLocs;
      if (intlLocalityBadge) intlLocalityBadge.textContent = `${defLocs.length} Localities Found`;
      filterAndDrawIntlLocalities('');
      return;
    }

    const hasDigit = /\d/.test(cleanZip);
    const isNumber = !isNaN(cleanZip) && cleanZip.trim() !== '';
    let apiCountry = (countryCode || 'US').toLowerCase();
    if (apiCountry === 'uk') apiCountry = 'gb';

    let apiZip = cleanZip.replace(/\s+/g, '');
    let isZipLike = false;

    if (apiCountry === 'us') {
      isZipLike = isNumber && cleanZip.length === 5;
    } else if (apiCountry === 'gb') {
      if (hasDigit && apiZip.length <= 4 && !cleanZip.includes(',')) {
        isZipLike = true;
        apiZip = apiZip.substring(0, 4);
      }
    } else if (apiCountry === 'ca') {
      if (hasDigit && apiZip.length <= 3 && !cleanZip.includes(',')) {
        isZipLike = true;
        apiZip = apiZip.substring(0, 3);
      }
    } else {
      isZipLike = isNumber;
    }

    if (isZipLike) {
      // Search via Zippopotam for zip codes
      fetch(`https://api.zippopotam.us/${apiCountry}/${encodeURIComponent(apiZip)}`)
        .then(res => {
          if (!res.ok) throw new Error('Zip not found');
          return res.json();
        })
        .then(data => {
          if (data && data.places && data.places.length > 0) {
            if (intlZipError) intlZipError.classList.add('hidden');
            const realLocs = data.places.map(p => {
              const placeName = p['place name'] || '';
              const state = p['state abbreviation'] || p['state'] || '';
              return state ? `${placeName}, ${state}` : placeName;
            });
            activeIntlLocalities = Array.from(new Set(realLocs));
            if (intlLocalityBadge) intlLocalityBadge.textContent = `${activeIntlLocalities.length} Verified Localities Found`;
            filterAndDrawIntlLocalities('');
            if (activeIntlLocalities.length > 0) {
              selectedIntlLocality = activeIntlLocalities[0];
              if (selectedIntlBtnText) selectedIntlBtnText.textContent = `${selectedIntlLocality}, ${selectedIntlCountry}`;
            }
          } else {
            showIntlFallback(cleanZip);
          }
        })
        .catch(() => {
          showIntlFallback(cleanZip);
        });
    } else {
      // Search via Photon API (ElasticSearch prefix autocomplete optimized)
      fetch(`https://photon.komoot.io/api/?q=${encodeURIComponent(cleanZip)}&limit=15&lang=en`)
        .then(res => {
          if (!res.ok) throw new Error('Photon API error');
          return res.json();
        })
        .then(data => {
          let realLocs = [];
          if (data && data.features && data.features.length > 0) {
            data.features.forEach(feat => {
              const p = feat.properties || {};
              const cc = (p.countrycode || '').toLowerCase();
              const isUkMatch = (apiCountry === 'gb' || apiCountry === 'uk') && (cc === 'gb' || cc === 'uk');
              const isUsMatch = (apiCountry === 'us') && (cc === 'us');
              const isCountryMatch = !apiCountry || cc === apiCountry || isUkMatch || isUsMatch;

              if (cc && !isCountryMatch) return;

              const name = p.name || p.city || p.locality || p.district;
              const state = p.state || '';
              if (name) {
                const locStr = (state && name !== state) ? `${name}, ${state}` : name;
                if (!realLocs.includes(locStr)) {
                  realLocs.push(locStr);
                }
              }
            });
          }

          if (realLocs.length > 0) {
            if (intlZipError) intlZipError.classList.add('hidden');
            activeIntlLocalities = realLocs;
            if (intlLocalityBadge) intlLocalityBadge.textContent = `${activeIntlLocalities.length} Verified Localities Found`;
            filterAndDrawIntlLocalities('');

            if (activeIntlLocalities.length > 0) {
              selectedIntlLocality = activeIntlLocalities[0];
              if (selectedIntlBtnText) selectedIntlBtnText.textContent = `${selectedIntlLocality}, ${selectedIntlCountry}`;
            }
          } else {
            // Fallback to Nominatim if Photon yields no matches for country
            return fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(cleanZip)}&countrycodes=${apiCountry}&format=json&addressdetails=1&limit=10`)
              .then(res => res.json())
              .then(nomData => {
                if (nomData && nomData.length > 0) {
                  if (intlZipError) intlZipError.classList.add('hidden');
                  const nomLocs = nomData.map(item => {
                    const addr = item.address || {};
                    const name = addr.city || addr.town || addr.village || addr.suburb || addr.hamlet || addr.county || item.name;
                    const state = addr.state || '';
                    return state && name !== state ? `${name}, ${state}` : name;
                  }).filter(Boolean);

                  activeIntlLocalities = Array.from(new Set(nomLocs));
                  if (intlLocalityBadge) intlLocalityBadge.textContent = `${activeIntlLocalities.length} Verified Localities Found`;
                  filterAndDrawIntlLocalities('');
                } else {
                  showIntlFallback(cleanZip);
                }
              })
              .catch(() => showIntlFallback(cleanZip));
          }
        })
        .catch(() => {
          showIntlFallback(cleanZip);
        });
    }
  }

  function showIntlFallback(cleanZip) {
    const isNumber = !isNaN(cleanZip) && cleanZip.trim() !== '';
    
    if (intlZipError) {
      if (selectedIntlCode === 'US' && isNumber && cleanZip.length !== 5) {
        intlZipError.textContent = `Note: US ZIP codes are 5 digits (e.g. 90210). Showing available areas:`;
        intlZipError.classList.remove('hidden');
      } else {
        intlZipError.textContent = ``;
        intlZipError.classList.add('hidden');
      }
    }

    const fallbackLocs = getLocalitiesForIntl(selectedIntlCountry, cleanZip);
    activeIntlLocalities = fallbackLocs;
    if (intlLocalityBadge) intlLocalityBadge.textContent = `${fallbackLocs.length} Localities Found`;
    
    if (!isNumber && cleanZip.length > 0) {
       filterAndDrawIntlLocalities(cleanZip);
    } else {
       filterAndDrawIntlLocalities('');
    }
  }

  function renderIntlLocalityList(country, zip, query) {
    fetchIntlPostalCode(selectedIntlCode, zip);
  }

  function filterAndDrawIntlLocalities(query) {
    const q = (query || '').toLowerCase().trim();
    let filtered = activeIntlLocalities.filter(loc => loc.toLowerCase().includes(q));

    let html = '';

    if (filtered.length > 0) {
      html += filtered.map((locName) => {
        const isSelected = selectedIntlLocality === locName;

        return `
          <div class="intl-locality-item px-3.5 py-2 hover:bg-amber-100/50 cursor-pointer flex items-center justify-between text-xs transition-colors ${isSelected ? 'bg-amber-100 font-bold text-amber-900 border-l-4 border-amber-600' : 'text-gray-800'}"
            data-locality="${locName}">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full ${isSelected ? 'bg-amber-600' : 'bg-gray-300'} shrink-0"></span>
              <span class="font-semibold text-gray-900">${locName}</span>
            </div>
            <span class="text-[10px] text-amber-800 font-medium">${selectedIntlCountry}</span>
          </div>
        `;
      }).join('');
    } else {
      html += `
        <div class="px-3.5 py-4 text-center text-xs text-gray-500 italic">
          No localities found. Try a different search.
        </div>
      `;
    }

    intlLocalityList.innerHTML = html;
    if (intlLocalityBadge) intlLocalityBadge.textContent = `${filtered.length} Localities Found`;

    intlLocalityList.querySelectorAll('.intl-locality-item').forEach(item => {
      item.addEventListener('click', function() {
        intlLocalityList.querySelectorAll('.intl-locality-item').forEach(i => {
          i.classList.remove('bg-amber-100', 'font-bold', 'text-amber-900', 'border-l-4', 'border-amber-600');
          i.classList.add('text-gray-800');
        });

        this.classList.add('bg-amber-100', 'font-bold', 'text-amber-900', 'border-l-4', 'border-amber-600');

        selectedIntlLocality = this.dataset.locality;
        if (selectedIntlBtnText) selectedIntlBtnText.textContent = `${selectedIntlLocality}, ${selectedIntlCountry}`;
      });
    });
  }

  if (intlLocalitySearchInput) {
    intlLocalitySearchInput.addEventListener('input', function() {
      filterAndDrawIntlLocalities(this.value);
    });
  }

  let intlZipDebounce = null;
  if (intlZipInput) {
    intlZipInput.addEventListener('input', function() {
      clearTimeout(intlZipDebounce);
      const val = this.value;
      const q = val.trim().toLowerCase();
      if (!q || activeIntlLocalities.some(loc => loc.toLowerCase().includes(q))) {
        filterAndDrawIntlLocalities(val);
      }
      intlZipDebounce = setTimeout(() => {
        fetchIntlPostalCode(selectedIntlCode, val);
      }, 250);
    });
  }

  if (intlSearchInput) {
    intlSearchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      document.querySelectorAll('.intl-country-opt').forEach(opt => {
        const name = opt.dataset.name.toLowerCase();
        if (name.includes(q)) {
          opt.style.display = 'flex';
        } else {
          opt.style.display = 'none';
        }
      });
    });
  }

  const intlCountryDropdownBtn = document.getElementById('intl-country-dropdown-btn');
  const intlCountryMenu = document.getElementById('intl-country-menu');
  if (intlCountryDropdownBtn && intlCountryMenu) {
    intlCountryDropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      intlCountryMenu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!intlCountryDropdownBtn.contains(e.target) && !intlCountryMenu.contains(e.target)) {
        intlCountryMenu.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll('.intl-country-opt').forEach(opt => {
    opt.addEventListener('click', function() {
      document.querySelectorAll('input[name="intl_country_radio"]').forEach(r => r.checked = false);
      const radio = this.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      selectedIntlCountry = this.dataset.name;
      selectedIntlCurrency = this.dataset.currency;
      selectedIntlCode = this.dataset.code;
      selectedIntlLocality = '';

      const flag = this.querySelector('.text-xl').textContent;
      const selectedDiv = document.getElementById('intl-country-selected');
      if (selectedDiv) {
        selectedDiv.innerHTML = `<span class="text-xl leading-none">${flag}</span><span class="font-bold text-gray-900 text-[14px]">${selectedIntlCountry}</span>`;
      }
      
      if (intlCountryMenu) intlCountryMenu.classList.add('hidden');

      if (selectedIntlBtnText) selectedIntlBtnText.textContent = selectedIntlCountry;
      if (intlCountryCodeBadge) intlCountryCodeBadge.textContent = `${selectedIntlCountry} ${selectedIntlCode}`;

      fetchIntlPostalCode(selectedIntlCode, intlZipInput ? intlZipInput.value : '');
    });
  });

  // Initial call for default selected country (USA)
  fetchIntlPostalCode('US', '');

  if (confirmIntlBtn) {
    confirmIntlBtn.addEventListener('click', function() {
      const zipVal = intlZipInput ? intlZipInput.value.trim() : '';

      // Basic validation for USA (must be exactly 5 digits if provided)
      if (selectedIntlCode === 'US' && zipVal && !/^\d{5}$/.test(zipVal)) {
        alert('Please provide a valid 5-digit US ZIP code.');
        return;
      }

      const oldMode = localStorage.getItem('delivery_mode') || 'india';
      const isModeChange = (oldMode !== 'international');

      const finalizeIntl = function() {
        setCookie('delivery_mode', 'international', 365);
        setCookie('user_country', selectedIntlCountry, 365);
        setCookie('user_country_code', selectedIntlCode, 365);
        setCookie('user_intl_zip', zipVal, 365);
        setCookie('user_intl_locality', selectedIntlLocality, 365);
        
        localStorage.setItem('delivery_mode', 'international');
        localStorage.setItem('user_country', selectedIntlCountry);
        localStorage.setItem('user_country_code', selectedIntlCode);
        localStorage.setItem('user_intl_zip', zipVal);
        localStorage.setItem('user_intl_locality', selectedIntlLocality);

        if (window.FloralCurrencyManager) {
          window.FloralCurrencyManager.setCurrencyByCountry(selectedIntlCode || selectedIntlCountry);
        }

        syncDeliveryStateUI();
        hideModal();
        if (isModeChange || window.location.pathname.includes('/cart')) window.location.reload();
      };

      if (isModeChange) {
        fetch('/cart/clear.js', { method: 'POST' })
          .then(() => finalizeIntl())
          .catch(() => finalizeIntl());
      } else {
        finalizeIntl();
      }
    });
  }

  /* ===== INDIA PINCODE LOGIC ===== */
  const input = document.getElementById('pincode-input');
  const suggestionsBox = document.getElementById('pincode-suggestions');
  const localityContainer = document.getElementById('locality-container');
  const localityBadge = document.getElementById('locality-badge');
  const localitySearchInput = document.getElementById('locality-search-input');
  const localityList = document.getElementById('locality-list');
  const errorMsg = document.getElementById('pincode-error');

  const pincodeDatabase = [
    { pincode: '110025', city: 'Delhi', state: 'Delhi', localities: ['New Friends Colony', 'Jasola', 'Okhla', 'Jamia Nagar', 'Holy Family Hospital Area', 'Sukhdev Vihar', 'Masigarh'] },
    { pincode: '110044', city: 'Delhi', state: 'Delhi', localities: ['Badarpur', 'Molarband', 'Jaitpur', 'Tughlakabad Extension', 'Sarita Vihar', 'Ali Village'] },
    { pincode: '110001', city: 'Delhi', state: 'Delhi', localities: ['Connaught Place', 'Barakhamba Road', 'Janpath', 'Parliament Street', 'Bengali Market'] },
    { pincode: '226001', city: 'Lucknow', state: 'Uttar Pradesh', localities: ['Hazratganj', 'Lalbagh', 'Raj Bhavan', 'Vidhan Sabha Marg', 'Kaiserbagh'] },
    { pincode: '226010', city: 'Lucknow', state: 'Uttar Pradesh', localities: ['Gomti Nagar', 'Patrakar Puram', 'Vipul Khand', 'Vijay Khand', 'Viraj Khand'] },
    { pincode: '400001', city: 'Mumbai', state: 'Maharashtra', localities: ['Fort', 'Colaba', 'Marine Drive', 'Nariman Point', 'Ballard Estate'] },
    { pincode: '560001', city: 'Bengaluru', state: 'Karnataka', localities: ['MG Road', 'Brigade Road', 'Commercial Street', 'Cubbon Park', 'Residency Road'] },
    { pincode: '600001', city: 'Chennai', state: 'Tamil Nadu', localities: ['Parry\'s Corner', 'George Town', 'Broadway', 'Beach Road'] },
    { pincode: '700001', city: 'Kolkata', state: 'West Bengal', localities: ['BBD Bagh', 'Esplanade', 'Dalhousie Square', 'Strand Road'] },
    { pincode: '500001', city: 'Hyderabad', state: 'Telangana', localities: ['Abids', 'Nampally', 'Koti', 'Mozamjahi Market'] }
  ];

  let selectedLocation = null;

  function setConfirmPincodeActive(active) {
    if (active) {
      confirmPincodeBtn.disabled = false;
      confirmPincodeBtn.className = "w-full bg-primary text-white font-bold h-12 rounded-xl text-sm transition-all duration-200 cursor-pointer shadow-md hover:bg-primary-600";
    } else {
      confirmPincodeBtn.disabled = true;
      confirmPincodeBtn.className = "w-full bg-gray-300 text-white font-bold h-12 rounded-xl text-sm transition-all duration-200 cursor-not-allowed";
    }
  }

  function cleanCityName(rawCity, state) {
    if (!rawCity) return state || 'India';
    let c = rawCity.trim();
    if (c.toLowerCase().includes('delhi')) return 'Delhi';
    return c;
  }

  function renderLocalityList(localities, pincode, city, state) {
    if (!localities || localities.length === 0) {
      localityContainer.classList.add('hidden');
      return;
    }

    localityBadge.textContent = `${localities.length} Localities Found`;
    localitySearchInput.value = '';
    localityContainer.classList.remove('hidden');

    filterAndDrawLocalities(localities, pincode, city, state, '');
  }

  function filterAndDrawLocalities(localities, pincode, city, state, query) {
    const q = (query || '').toLowerCase().trim();
    const filtered = localities.filter(loc => loc.toLowerCase().includes(q));

    if (filtered.length === 0) {
      localityList.innerHTML = `<div class="p-3 text-center text-xs text-gray-500">No locality matching "${query}"</div>`;
      return;
    }

    const cleanedCity = cleanCityName(city, state);

    localityList.innerHTML = filtered.map((locName) => {
      const isSelected = selectedLocation && selectedLocation.locality === locName;
      const fullLoc = `${pincode}, ${locName}, ${cleanedCity}`;

      return `
        <div class="locality-item px-3.5 py-2.5 hover:bg-primary/5 cursor-pointer flex items-center justify-between text-xs transition-colors ${isSelected ? 'bg-primary/10 font-bold text-primary border-l-4 border-primary' : 'text-gray-800'}"
          data-pincode="${pincode}"
          data-locality="${locName}"
          data-city="${cleanedCity}"
          data-state="${state}"
          data-full="${fullLoc}">
          <div class="flex items-center gap-2.5">
            <span class="w-2.5 h-2.5 rounded-full ${isSelected ? 'bg-primary' : 'bg-gray-300'} shrink-0"></span>
            <span class="font-semibold text-gray-900">${locName}</span>
          </div>
          <span class="text-[11px] text-gray-400 font-normal">${pincode}, ${cleanedCity}</span>
        </div>
      `;
    }).join('');

    localityList.querySelectorAll('.locality-item').forEach(item => {
      item.addEventListener('click', function() {
        localityList.querySelectorAll('.locality-item').forEach(i => {
          i.classList.remove('bg-primary/10', 'font-bold', 'text-primary', 'border-l-4', 'border-primary');
          i.classList.add('text-gray-800');
        });

        this.classList.add('bg-primary/10', 'font-bold', 'text-primary', 'border-l-4', 'border-primary');

        const locName = this.dataset.locality;
        const mainCity = this.dataset.city;
        const code = this.dataset.pincode;
        const state = this.dataset.state || '';

        selectedLocation = {
          pincode: code,
          locality: locName,
          city: `${locName}, ${mainCity}`,
          location: `${code}, ${locName}, ${mainCity}`,
          state: state
        };

        setConfirmPincodeActive(true);
      });
    });
  }

  function lookupPincode(code) {
    if (code.length !== 6 || isNaN(code)) return;

    fetch(`https://api.postalpincode.in/pincode/${code}`)
      .then(res => res.json())
      .then(data => {
        if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
          const offices = data[0].PostOffice;
          const firstPO = offices[0];
          const rawCity = firstPO.District || firstPO.Block || firstPO.State;
          const state = firstPO.State;
          const city = cleanCityName(rawCity, state);

          const localities = Array.from(new Set(offices.map(po => po.Name).filter(Boolean)));

          suggestionsBox.classList.add('hidden');
          errorMsg.classList.add('hidden');

          renderLocalityList(localities, code, city, state);

          selectedLocation = {
            pincode: code,
            locality: localities[0],
            city: `${localities[0]}, ${city}`,
            location: `${code}, ${localities[0]}, ${city}`,
            state: state
          };
          setConfirmPincodeActive(true);
        } else {
          selectedLocation = null;
          localityContainer.classList.add('hidden');
          suggestionsBox.classList.add('hidden');
          errorMsg.textContent = "Sorry, pincode not found or not deliverable.";
          errorMsg.classList.remove('hidden');
          setConfirmPincodeActive(false);
        }
      })
      .catch(() => {
        const dbMatch = pincodeDatabase.find(item => item.pincode === code);
        if (dbMatch) {
          renderLocalityList(dbMatch.localities, code, dbMatch.city, dbMatch.state);
          selectedLocation = {
            pincode: code,
            locality: dbMatch.localities[0],
            city: `${dbMatch.localities[0]}, ${dbMatch.city}`,
            location: `${code}, ${dbMatch.localities[0]}, ${dbMatch.city}`,
            state: dbMatch.state
          };
          setConfirmPincodeActive(true);
        } else {
          selectedLocation = null;
          localityContainer.classList.add('hidden');
          suggestionsBox.classList.add('hidden');
          errorMsg.textContent = "Invalid pincode or network issue.";
          errorMsg.classList.remove('hidden');
          setConfirmPincodeActive(false);
        }
      });
  }

  function lookupLocality(query) {
    fetch(`https://api.postalpincode.in/postoffice/${query}`)
      .then(res => res.json())
      .then(data => {
        if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice && data[0].PostOffice.length > 0) {
          
          suggestionsBox.innerHTML = data[0].PostOffice.map(po => {
            const locName = po.Name;
            const mainCity = cleanCityName(po.District || po.Block || po.State, po.State);
            const state = po.State;
            const code = po.Pincode;
            
            return `
              <div class="suggestion-item px-3.5 py-2.5 hover:bg-gray-50 cursor-pointer flex items-center gap-3 transition-colors text-gray-800"
                data-pincode="${code}"
                data-locality="${locName}"
                data-city="${mainCity}"
                data-state="${state}">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <div>
                  <div class="text-xs font-semibold">${locName}</div>
                  <div class="text-[10px] text-gray-500">${mainCity}, ${state}, India - ${code}</div>
                </div>
              </div>
            `;
          }).join('');
          
          suggestionsBox.classList.remove('hidden');
          
          suggestionsBox.querySelectorAll('.suggestion-item').forEach(item => {
            item.addEventListener('click', function() {
              const locName = this.dataset.locality;
              const mainCity = this.dataset.city;
              const code = this.dataset.pincode;
              const state = this.dataset.state || '';

              selectedLocation = {
                pincode: code,
                locality: locName,
                city: `${locName}, ${mainCity}`,
                location: `${code}, ${locName}, ${mainCity}`,
                state: state
              };

              input.value = `${locName}, ${mainCity} - ${code}`;
              suggestionsBox.classList.add('hidden');
              localityContainer.classList.add('hidden');
              errorMsg.classList.add('hidden');
              setConfirmPincodeActive(true);
            });
          });
          
        } else {
          suggestionsBox.classList.add('hidden');
        }
      })
      .catch(() => {
        suggestionsBox.classList.add('hidden');
      });
  }

  let inputDebounce = null;
  if (input) {
    input.addEventListener('input', function() {
      const val = this.value.trim();
      errorMsg.classList.add('hidden');
      clearTimeout(inputDebounce);
      
      if (!val) {
        suggestionsBox.classList.add('hidden');
        suggestionsBox.innerHTML = '';
        selectedLocation = null;
        localityContainer.classList.add('hidden');
        setConfirmPincodeActive(false);
        return;
      }
      
      inputDebounce = setTimeout(() => {
        if (!isNaN(val) && val.length === 6) {
          suggestionsBox.classList.add('hidden');
          lookupPincode(val);
        } else if (isNaN(val) && val.length >= 3) {
          localityContainer.classList.add('hidden');
          lookupLocality(val);
        } else {
          suggestionsBox.classList.add('hidden');
          selectedLocation = null;
          localityContainer.classList.add('hidden');
          setConfirmPincodeActive(false);
        }
      }, 400);
    });
  }

  if (confirmPincodeBtn) {
    confirmPincodeBtn.addEventListener('click', function() {
      if (!selectedLocation) {
        errorMsg.classList.remove('hidden');
        return;
      }

      const oldMode = localStorage.getItem('delivery_mode') || 'india';
      const isModeChange = (oldMode !== 'india');

      const finalizeIndia = function() {
        setCookie('delivery_mode', 'india', 365);
        setCookie('user_pincode', selectedLocation.pincode, 365);
        setCookie('user_location', selectedLocation.location, 365);
        setCookie('user_city', selectedLocation.city, 365);
        if (selectedLocation.state) setCookie('user_state', selectedLocation.state, 365);

        localStorage.setItem('delivery_mode', 'india');
        localStorage.setItem('user_pincode', selectedLocation.pincode);
        localStorage.setItem('user_location', selectedLocation.location);
        localStorage.setItem('user_city', selectedLocation.city);
        if (selectedLocation.state) localStorage.setItem('user_state', selectedLocation.state);

        if (window.FloralCurrencyManager) {
          window.FloralCurrencyManager.setCurrency('INR', false);
        }

        syncDeliveryStateUI();
        hideModal();
        if (isModeChange || window.location.pathname.includes('/cart')) window.location.reload();
      };

      if (isModeChange) {
        fetch('/cart/clear.js', { method: 'POST' })
          .then(() => finalizeIndia())
          .catch(() => finalizeIndia());
      } else {
        finalizeIndia();
      }
    });
  }

  // Initial Sync on Page Load
  syncDeliveryStateUI();

  // Auto-open location modal for new customers who haven't saved a pincode or country yet
  const hasSavedPincode = localStorage.getItem('user_pincode') || getCookie('user_pincode');
  const hasSavedCountry = localStorage.getItem('user_country') || getCookie('user_country');
  const hasSavedMode    = localStorage.getItem('delivery_mode') || getCookie('delivery_mode');
  const hasSelectedLocation = hasSavedPincode || hasSavedCountry || (hasSavedMode === 'international');

  if (!hasSelectedLocation) {
    setTimeout(function() {
      if (window.openPincodeModal) {
        window.openPincodeModal('india');
      }
    }, 600);
  }
});
</script>
