  let activeIntlLocalities = [];
  let activeIntlLocalitiesData = [];

  function getLocalitiesForIntl(country, zip) {
    const cleanZip = (zip || '').trim().toUpperCase();
    
    // 1. Check exact PIN match in static DB
    let match = intlPincodeDatabase.find(item => item.country === country && item.pincode && item.pincode.toUpperCase() === cleanZip);
    if (match && match.localities && match.localities.length > 0) return match.localities;

    // 2. Check country fallback in static DB
    let countryFallback = intlPincodeDatabase.find(item => item.country === country && (!item.pincode || item.pincode === '') && item.localities);
    let baseLocs = (countryFallback && countryFallback.localities) ? countryFallback.localities : ['City Center', 'Business District', 'Metropolitan Area', 'Suburbs'];

    if (cleanZip.length > 0) {
      return []; // Do not show dummy localities if a specific zip was entered but not found
    }
    
    return baseLocs;
  }

  function fetchIntlPostalCode(countryCode, zip) {
    const cleanZip = (zip || '').trim();
    if (intlZipError) intlZipError.classList.add('hidden');

    if (!cleanZip) {
      activeIntlLocalitiesData = [];
      const defLocs = getLocalitiesForIntl(selectedIntlCountry, '');
      activeIntlLocalities = defLocs;
      if (intlLocalityBadge) intlLocalityBadge.textContent = `${defLocs.length} Localities Found`;
      filterAndDrawIntlLocalities('');
      return;
    }

    const apiKey = '70b21c8c216144c4acc4b4932d43790e';
    let url = `https://api.geoapify.com/v1/geocode/autocomplete?text=${encodeURIComponent(cleanZip)}&apiKey=${apiKey}&limit=10`;
    
    if (countryCode) {
      let filterCode = (countryCode || 'US').toLowerCase();
      if (filterCode === 'uk') filterCode = 'gb';
      url += `&filter=countrycode:${filterCode}`;
    }

    fetch(url)
      .then(res => {
        if (!res.ok) throw new Error('Geoapify API error');
        return res.json();
      })
      .then(data => {
        if (data && data.features && data.features.length > 0) {
          if (intlZipError) intlZipError.classList.add('hidden');
          
          activeIntlLocalitiesData = data.features.map(f => {
            const p = f.properties || {};
            const name = p.formatted || `${p.city || p.name || ''}, ${p.state || ''}, ${p.country || ''}`.replace(/, ,/g, ',').replace(/^, /, '').replace(/, $/, '');
            return {
              name: name,
              city: p.city || p.name || '',
              state: p.state || '',
              zip: p.postcode || '',
              lat: p.lat || '',
              lon: p.lon || ''
            };
          });
          
          activeIntlLocalities = activeIntlLocalitiesData.map(d => d.name);
          
          if (intlLocalityBadge) intlLocalityBadge.textContent = `${activeIntlLocalities.length} Verified Localities Found`;
          filterAndDrawIntlLocalities('');
          
          if (activeIntlLocalities.length > 0) {
            selectedIntlLocality = activeIntlLocalities[0];
            if (selectedIntlBtnText) selectedIntlBtnText.textContent = selectedIntlLocality;
          }
        } else {
          showIntlFallback(cleanZip);
        }
      })
      .catch((e) => {
        console.error(e);
        showIntlFallback(cleanZip);
      });
  }

  function showIntlFallback(cleanZip) {
    const isNumber = !isNaN(cleanZip) && cleanZip.trim() !== '';
    
    if (intlZipError) {
      if (selectedIntlCode === 'US' && isNumber && cleanZip.length !== 5) {
        intlZipError.textContent = `Please enter a valid 5-digit US ZIP code.`;
        intlZipError.classList.remove('hidden');
        activeIntlLocalities = [];
        if (intlLocalityBadge) intlLocalityBadge.textContent = `0 Localities Found`;
        filterAndDrawIntlLocalities('');
        return;
      } else {
        intlZipError.textContent = ``;
        intlZipError.classList.add('hidden');
      }
    }

    const fallbackLocs = getLocalitiesForIntl(selectedIntlCountry, cleanZip);
    activeIntlLocalities = fallbackLocs;
    if (intlLocalityBadge) intlLocalityBadge.textContent = `${fallbackLocs.length} Localities Found`;
    
    if (fallbackLocs.length === 0 && cleanZip.length > 0) {
      if (intlZipError) {
        intlZipError.textContent = `Invalid postal code or location. Please try again.`;
        intlZipError.classList.remove('hidden');
      }
    }

    if (!isNumber && cleanZip.length > 0) {
       filterAndDrawIntlLocalities(cleanZip);
    } else {
       filterAndDrawIntlLocalities('');
    }
  }

  function renderIntlLocalityList(country, zip, query) {
    fetchIntlPostalCode(selectedIntlCode, zip);
  }

  function filterAndDrawIntlLocalities(query) {
    if (intlZipInput && intlZipInput.value.trim().length === 0) {
      if (intlLocalityContainer) intlLocalityContainer.classList.add('hidden');
      return;
    } else {
      if (intlLocalityContainer) intlLocalityContainer.classList.remove('hidden');
    }

    const q = (query || '').toLowerCase().trim();
    let filtered = activeIntlLocalities.filter(loc => loc.toLowerCase().includes(q));

    let html = '';

    if (filtered.length > 0) {
      html += filtered.map((locName) => {
        const isSelected = selectedIntlLocality === locName;

        return `
          <div class="intl-locality-item px-3.5 py-2 hover:bg-amber-100/50 cursor-pointer flex items-center justify-between text-xs transition-colors ${isSelected ? 'bg-amber-100 font-bold text-amber-900 border-l-4 border-amber-600' : 'text-gray-800'}"
            data-locality="${locName.replace(/"/g, '&quot;')}">
            <div class="flex items-center gap-2 overflow-hidden">
              <span class="w-2.5 h-2.5 rounded-full ${isSelected ? 'bg-amber-600' : 'bg-gray-300'} shrink-0"></span>
              <span class="font-semibold text-gray-900 truncate" title="${locName.replace(/"/g, '&quot;')}">${locName}</span>
            </div>
            <span class="text-[10px] text-amber-800 font-medium shrink-0 ml-2">${selectedIntlCountry}</span>
          </div>
        `;
      }).join('');
    } else {
      html += `
        <div class="px-3.5 py-4 text-center text-xs text-gray-500 italic">
          No localities found. Try a different search.
        </div>
      `;
    }

    intlLocalityList.innerHTML = html;
    if (intlLocalityBadge) intlLocalityBadge.textContent = `${filtered.length} Localities Found`;

    intlLocalityList.querySelectorAll('.intl-locality-item').forEach(item => {
      item.addEventListener('click', function() {
        intlLocalityList.querySelectorAll('.intl-locality-item').forEach(i => {
          i.classList.remove('bg-amber-100', 'font-bold', 'text-amber-900', 'border-l-4', 'border-amber-600');
          i.classList.add('text-gray-800');
        });

        this.classList.add('bg-amber-100', 'font-bold', 'text-amber-900', 'border-l-4', 'border-amber-600');

        selectedIntlLocality = this.dataset.locality;
        if (selectedIntlBtnText) selectedIntlBtnText.textContent = selectedIntlLocality;
        
        const match = activeIntlLocalitiesData.find(d => d.name === selectedIntlLocality);
        if (match) {
          selectedIntlCity = match.city;
          selectedIntlState = match.state;
          selectedIntlZip = match.zip;
          selectedIntlLat = match.lat;
          selectedIntlLon = match.lon;
          if (intlZipInput && match.zip) {
            intlZipInput.value = match.zip;
          }
        }
      });
    });
  }

  function clearIntlSelection() {
    selectedIntlLocality = '';
    selectedIntlCity = '';
    selectedIntlState = '';
    selectedIntlZip = '';
    selectedIntlLat = '';
    selectedIntlLon = '';
    if (selectedIntlBtnText) selectedIntlBtnText.textContent = selectedIntlCountry;
  }

  function updateIntlGeoapifySearch() {
    const zipVal = (intlZipInput ? intlZipInput.value.trim() : '');
    const locVal = (intlLocalitySearchInput ? intlLocalitySearchInput.value.trim() : '');
    
    const isNumber = !isNaN(zipVal) && zipVal !== '';
    if (selectedIntlCode === 'US' && isNumber && zipVal.length !== 5) {
      if (intlZipError) {
        intlZipError.textContent = 'Please enter a valid 5-digit US ZIP code.';
        intlZipError.classList.remove('hidden');
      }
      activeIntlLocalities = [];
      activeIntlLocalitiesData = [];
      if (intlLocalityBadge) intlLocalityBadge.textContent = '0 Localities Found';
      filterAndDrawIntlLocalities('');
      return;
    }

    if (intlZipError) intlZipError.classList.add('hidden');
    
    let query = zipVal;
    if (locVal) {
      query = locVal + (zipVal ? ' ' + zipVal : '');
    }
    
    fetchIntlPostalCode(selectedIntlCode, query);
  }

  let intlZipDebounce = null;
  
  if (intlLocalitySearchInput) {
    intlLocalitySearchInput.addEventListener('input', function() {
      clearIntlSelection();
      clearTimeout(intlZipDebounce);
      intlZipDebounce = setTimeout(() => {
        updateIntlGeoapifySearch();
      }, 250);
    });
  }

  if (intlZipInput) {
    intlZipInput.addEventListener('input', function() {
      clearIntlSelection();
      if (selectedIntlCode === 'US' && /^\d{5}/.test(this.value) && this.value.length > 5) {
        this.value = this.value.substring(0, 5);
      }
      
      clearTimeout(intlZipDebounce);
      const val = this.value;
      const q = val.trim().toLowerCase();
      if (!q || activeIntlLocalities.some(loc => loc.toLowerCase().includes(q))) {
        filterAndDrawIntlLocalities(val);
      }
      intlZipDebounce = setTimeout(() => {
        updateIntlGeoapifySearch();
      }, 250);
    });
  }

  if (intlSearchInput) {
    intlSearchInput.addEventListener('input', function() {
      const q = this.value.toLowerCase().trim();
      document.querySelectorAll('.intl-country-opt').forEach(opt => {
        const name = opt.dataset.name.toLowerCase();
        if (name.includes(q)) {
          opt.style.display = 'flex';
        } else {
          opt.style.display = 'none';
        }
      });
    });
  }

  const intlCountryDropdownBtn = document.getElementById('intl-country-dropdown-btn');
  const intlCountryMenu = document.getElementById('intl-country-menu');
  if (intlCountryDropdownBtn && intlCountryMenu) {
    intlCountryDropdownBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      intlCountryMenu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!intlCountryDropdownBtn.contains(e.target) && !intlCountryMenu.contains(e.target)) {
        intlCountryMenu.classList.add('hidden');
      }
    });
  }

  document.querySelectorAll('.intl-country-opt').forEach(opt => {
    opt.addEventListener('click', function() {
      document.querySelectorAll('input[name="intl_country_radio"]').forEach(r => r.checked = false);
      const radio = this.querySelector('input[type="radio"]');
      if (radio) radio.checked = true;

      selectedIntlCountry = this.dataset.name;
      selectedIntlCurrency = this.dataset.currency;
      selectedIntlCode = this.dataset.code;
      selectedIntlLocality = '';

      const flag = this.querySelector('.text-xl').textContent;
      const selectedDiv = document.getElementById('intl-country-selected');
      if (selectedDiv) {
        selectedDiv.innerHTML = `<span class="text-xl leading-none">${flag}</span><span class="font-bold text-gray-900 text-[14px]">${selectedIntlCountry}</span>`;
      }
      
      if (intlCountryMenu) intlCountryMenu.classList.add('hidden');

      if (selectedIntlBtnText) selectedIntlBtnText.textContent = selectedIntlCountry;
      if (intlCountryCodeBadge) intlCountryCodeBadge.textContent = `${selectedIntlCountry} ${selectedIntlCode}`;

      fetchIntlPostalCode(selectedIntlCode, intlZipInput ? intlZipInput.value : '');
    });
  });

  // Initial call for default selected country (USA)
  fetchIntlPostalCode('US', '');

  if (confirmIntlBtn) {
    confirmIntlBtn.addEventListener('click', function() {
      const userEnteredZip = intlZipInput ? intlZipInput.value.trim() : '';
      const finalZipToValidate = selectedIntlLocality ? (selectedIntlZip || '') : userEnteredZip;

      // Basic validation for USA (must be exactly 5 digits if provided)
      if (selectedIntlCode === 'US' && finalZipToValidate && !/^\d{5}$/.test(finalZipToValidate)) {
        if (intlZipError) {
          intlZipError.textContent = 'Please enter a valid 5-digit US ZIP code.';
          intlZipError.classList.remove('hidden');
        } else {
          alert('Please provide a valid 5-digit US ZIP code.');
        }
        return;
      }
      
      // Only save a real postal code. If the customer typed a place name (e.g. "Bell Gardens"),
      // store no ZIP so checkout asks for it instead of receiving invalid text.
      const looksLikePostal = function(z) {
        if (!z) return false;
        if (selectedIntlCode === 'US') return /^\d{5}(-\d{4})?$/.test(z);
        return /\d/.test(z) && /^[A-Za-z0-9 \-]{2,10}$/.test(z);
      };
      const zipVal = looksLikePostal(finalZipToValidate) ? finalZipToValidate
                   : (looksLikePostal(userEnteredZip) ? userEnteredZip : '');

      const oldMode = localStorage.getItem('delivery_mode') || 'india';
      const isModeChange = (oldMode !== 'international');

      const finalizeIntl = function() {
        setCookie('delivery_mode', 'international', 365);
        setCookie('user_country', selectedIntlCountry, 365);
        setCookie('user_country_code', selectedIntlCode, 365);
        setCookie('user_intl_zip', zipVal, 365);
        setCookie('user_intl_locality', selectedIntlLocality, 365);
        
        if (selectedIntlCity) setCookie('user_intl_city', selectedIntlCity, 365);
        if (selectedIntlState) setCookie('user_intl_state', selectedIntlState, 365);
        if (selectedIntlLat) setCookie('user_intl_lat', selectedIntlLat, 365);
        if (selectedIntlLon) setCookie('user_intl_lon', selectedIntlLon, 365);

        localStorage.setItem('delivery_mode', 'international');
        localStorage.setItem('user_country', selectedIntlCountry);
        localStorage.setItem('user_country_code', selectedIntlCode);
        localStorage.setItem('user_intl_zip', zipVal);
        localStorage.setItem('user_intl_locality', selectedIntlLocality);
        
        if (selectedIntlCity) localStorage.setItem('user_intl_city', selectedIntlCity);
        if (selectedIntlState) localStorage.setItem('user_intl_state', selectedIntlState);
        if (selectedIntlLat) localStorage.setItem('user_intl_lat', selectedIntlLat);
        if (selectedIntlLon) localStorage.setItem('user_intl_lon', selectedIntlLon);

        if (window.FloralCurrencyManager) {
          window.FloralCurrencyManager.setCurrencyByCountry(selectedIntlCode || selectedIntlCountry);
        }

        const intlAddress = [selectedIntlLocality, selectedIntlCity, selectedIntlState, zipVal, selectedIntlCountry].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ');

        // Update saved delivery details in storage
        try {
          ['floral_saved_delivery_details', 'floral_session_delivery_details'].forEach(storeKey => {
            const raw = localStorage.getItem(storeKey) || sessionStorage.getItem(storeKey);
            if (raw) {
              const parsed = JSON.parse(raw);
              parsed['Delivery_Country'] = (selectedIntlCode || 'US').toUpperCase();
              parsed['Delivery Country'] = selectedIntlCountry;
              parsed['Delivery_Postcode'] = zipVal;
              parsed['Delivery_City'] = selectedIntlCity || selectedIntlLocality;
              parsed['Delivery_State'] = selectedIntlState || '';
              parsed['Delivery_Address'] = intlAddress;
              parsed['Delivery_Landmark'] = intlAddress;
              if (storeKey === 'floral_saved_delivery_details') {
                localStorage.setItem(storeKey, JSON.stringify(parsed));
              } else {
                sessionStorage.setItem(storeKey, JSON.stringify(parsed));
              }
            }
          });
        } catch(e) {}

        const onDoneIntl = function() {
          syncDeliveryStateUI();
          window.dispatchEvent(new CustomEvent('pincodeLocationChanged', { 
            detail: { mode: 'international', country: selectedIntlCountry, zip: zipVal, address: intlAddress } 
          }));
          hideModal();
          if (isModeChange || window.location.pathname.includes('/cart')) {
            window.location.reload();
          }
        };

        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            attributes: {
              'Delivery_Country': (selectedIntlCode || 'US').toUpperCase(),
              'Delivery Country': selectedIntlCountry,
              'Delivery_Postcode': zipVal,
              'Delivery_City': selectedIntlCity || selectedIntlLocality,
              'Delivery_State': selectedIntlState || '',
              'Delivery_Address': intlAddress,
              'Delivery_Landmark': intlAddress,
              'Delivery Address': intlAddress
            }
          })
        }).then(() => onDoneIntl()).catch(() => onDoneIntl());
      };

      if (isModeChange) {
        // Wait for clear to finish before reloading
        fetch('/cart/clear.js', { method: 'POST' })
          .then(r => r.json())
          .then(() => finalizeIntl())
          .catch(() => finalizeIntl());
      } else {
        finalizeIntl();
      }
    });
  }

  /* ===== INDIA PINCODE LOGIC ===== */
  const input = document.getElementById('pincode-input');
  const suggestionsBox = document.getElementById('pincode-suggestions');
  const errorMsg = document.getElementById('pincode-error');

  let selectedLocation = null;

  function setConfirmPincodeActive(active) {
    if (active) {
      confirmPincodeBtn.disabled = false;
      confirmPincodeBtn.className = "w-full bg-primary text-white font-bold h-12 rounded-xl text-sm transition-all duration-200 cursor-pointer shadow-md hover:bg-primary-600";
    } else {
      confirmPincodeBtn.disabled = true;
      confirmPincodeBtn.className = "w-full bg-gray-300 text-white font-bold h-12 rounded-xl text-sm transition-all duration-200 cursor-not-allowed";
    }
  }

  function fetchIndiaGeoapify(query) {
    const cleanQuery = (query || '').trim();
    if (errorMsg) errorMsg.classList.add('hidden');
    
    if (!cleanQuery) {
      suggestionsBox.classList.add('hidden');
      suggestionsBox.innerHTML = '';
      return;
    }

    const isPincode = /^\d+$/.test(cleanQuery);
    let url = '';
    
    if (isPincode) {
      if (cleanQuery.length !== 6) {
        return;
      }
      url = `https://api.postalpincode.in/pincode/${cleanQuery}`;
    } else {
      if (cleanQuery.length < 3) {
        return;
      }
      url = `https://api.postalpincode.in/postoffice/${encodeURIComponent(cleanQuery)}`;
    }

    fetch(url)
      .then(res => res.json())
      .then(data => {
        if (data && data[0] && data[0].Status === 'Success' && data[0].PostOffice) {
          const postOffices = data[0].PostOffice.slice(0, 10); // Limit to 10 suggestions
          suggestionsBox.innerHTML = postOffices.map(po => {
            const locName = po.Name || '';
            const mainCity = po.District || po.Block || po.Region || '';
            const state = po.State || '';
            const code = po.Pincode || '';
            const formatted = `${locName}, ${mainCity} - ${code}, ${state}`;
            
            return `
              <div class="suggestion-item px-3.5 py-2.5 hover:bg-gray-50 cursor-pointer flex items-center gap-3 transition-colors text-gray-800"
                data-pincode="${code}"
                data-locality="${locName}"
                data-city="${mainCity}"
                data-state="${state}"
                data-formatted="${formatted}"
                data-lat=""
                data-lon="">
                <svg class="w-4 h-4 text-gray-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                <div>
                  <div class="text-xs font-semibold">${locName} ${mainCity ? '(' + mainCity + ')' : ''}</div>
                  <div class="text-[10px] text-gray-500">${formatted}</div>
                </div>
              </div>
            `;
          }).join('');
          
          suggestionsBox.classList.remove('hidden');
          
          suggestionsBox.querySelectorAll('.suggestion-item').forEach(item => {
            item.addEventListener('click', function() {
              const locName = this.dataset.locality;
              const mainCity = this.dataset.city;
              const code = this.dataset.pincode;
              const state = this.dataset.state || '';
              const formatted = this.dataset.formatted || '';

              selectedLocation = {
                pincode: code,
                locality: locName,
                city: mainCity || locName,
                location: formatted,
                state: state,
                lat: '',
                lon: ''
              };

              input.value = formatted;
              suggestionsBox.classList.add('hidden');
              if (errorMsg) errorMsg.classList.add('hidden');
              setConfirmPincodeActive(true);
            });
          });
        } else {
          suggestionsBox.classList.add('hidden');
          if (errorMsg) {
             errorMsg.textContent = isPincode ? "No locations found for this pincode." : "No locations found. Try a different search.";
             errorMsg.classList.remove('hidden');
          }
        }
      })
      .catch(() => {
         suggestionsBox.classList.add('hidden');
      });
  }

  let inputDebounce = null;
  if (input) {


    
    input.addEventListener('input', function() {
      const val = this.value.trim();
      if (errorMsg) errorMsg.classList.add('hidden');
      clearTimeout(inputDebounce);
      
      if (!val) {
        suggestionsBox.classList.add('hidden');
        suggestionsBox.innerHTML = '';
        selectedLocation = null;
        setConfirmPincodeActive(false);
        return;
      }
      
      inputDebounce = setTimeout(() => {
        fetchIndiaGeoapify(val);
      }, 300);
    });
  }

  if (confirmPincodeBtn) {
    confirmPincodeBtn.addEventListener('click', function() {
      if (!selectedLocation) {
        errorMsg.classList.remove('hidden');
        return;
      }

      const oldMode = localStorage.getItem('delivery_mode') || 'india';
      const isModeChange = (oldMode !== 'india');

      const finalizeIndia = function() {
        setCookie('delivery_mode', 'india', 365);
        setCookie('user_country', 'India', 365);
        setCookie('user_country_code', 'IN', 365);
        setCookie('user_pincode', selectedLocation.pincode, 365);
        setCookie('user_location', selectedLocation.location, 365);
        setCookie('user_city', selectedLocation.city, 365);
        if (selectedLocation.state) setCookie('user_state', selectedLocation.state, 365);
        if (selectedLocation.lat) setCookie('user_lat', selectedLocation.lat, 365);
        if (selectedLocation.lon) setCookie('user_lon', selectedLocation.lon, 365);

        localStorage.setItem('delivery_mode', 'india');
        localStorage.setItem('user_country', 'India');
        localStorage.setItem('user_country_code', 'IN');
        localStorage.setItem('user_pincode', selectedLocation.pincode);
        localStorage.setItem('user_location', selectedLocation.location);
        localStorage.setItem('user_city', selectedLocation.city);
        if (selectedLocation.state) localStorage.setItem('user_state', selectedLocation.state);
        if (selectedLocation.lat) localStorage.setItem('user_lat', selectedLocation.lat);
        if (selectedLocation.lon) localStorage.setItem('user_lon', selectedLocation.lon);

        // Remove any stale international location keys
        localStorage.removeItem('user_intl_zip');
        localStorage.removeItem('user_intl_locality');
        localStorage.removeItem('user_intl_city');
        localStorage.removeItem('user_intl_state');

        if (window.FloralCurrencyManager) {
          window.FloralCurrencyManager.setCurrency('INR', false);
        }

        // Update saved delivery details in storage with the new pincode address
        try {
          ['floral_saved_delivery_details', 'floral_session_delivery_details'].forEach(storeKey => {
            const raw = localStorage.getItem(storeKey) || sessionStorage.getItem(storeKey);
            if (raw) {
              const parsed = JSON.parse(raw);
              parsed['Delivery_Country'] = 'IN';
              parsed['Delivery Country'] = 'India';
              parsed['Delivery_Postcode'] = selectedLocation.pincode;
              parsed['Delivery_City'] = selectedLocation.city;
              parsed['Delivery_State'] = selectedLocation.state || '';
              parsed['Delivery_Address'] = selectedLocation.location;
              parsed['Delivery_Landmark'] = selectedLocation.location;
              if (storeKey === 'floral_saved_delivery_details') {
                localStorage.setItem(storeKey, JSON.stringify(parsed));
              } else {
                sessionStorage.setItem(storeKey, JSON.stringify(parsed));
              }
            }
          });
        } catch(e) {}

        const onDoneIndia = function() {
          syncDeliveryStateUI();
          window.dispatchEvent(new CustomEvent('pincodeLocationChanged', { detail: selectedLocation }));
          hideModal();
          if (isModeChange || window.location.pathname.includes('/cart')) {
            window.location.reload();
          }
        };

        // Send updated attributes to Shopify cart so server render on reload is also fresh
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            attributes: {
              'Delivery_Country': 'IN',
              'Delivery Country': 'India',
              'Delivery_Postcode': selectedLocation.pincode,
              'Delivery Postcode': selectedLocation.pincode,
              'Delivery_City': selectedLocation.city,
              'Delivery City': selectedLocation.city,
              'City': selectedLocation.city,
              'Delivery_State': selectedLocation.state || '',
              'Delivery State': selectedLocation.state || '',
              'Delivery_Address': selectedLocation.location,
              'Delivery_Landmark': selectedLocation.location,
              'Delivery Address': selectedLocation.location
            }
          })
        }).then(() => onDoneIndia()).catch(() => onDoneIndia());
      };

      if (isModeChange) {
        fetch('/cart/clear.js', { method: 'POST' })
          .then(() => finalizeIndia())
          .catch(() => finalizeIndia());
      } else {
        finalizeIndia();
      }
    });
  }

  // Initial Sync on Page Load
  syncDeliveryStateUI();

  // Auto-open location modal for new customers who haven't saved a pincode or country yet
  const hasSavedPincode = localStorage.getItem('user_pincode') || getCookie('user_pincode');
  const hasSavedCountry = localStorage.getItem('user_country') || getCookie('user_country');
  const hasSavedMode    = localStorage.getItem('delivery_mode') || getCookie('delivery_mode');
  const hasSelectedLocation = hasSavedPincode || hasSavedCountry || (hasSavedMode === 'international');

  if (!hasSelectedLocation) {
    setTimeout(function() {
      if (window.openPincodeModal) {
        window.openPincodeModal('india');
      }
    }, 600);
  }
});
</script>
