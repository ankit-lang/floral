  // Global Tab Switcher
  window.switchDeliveryModalTab = function(mode) {
    const dropdownSelected = document.getElementById('delivery-mode-selected');
    if (mode === 'international') {
      if(dropdownSelected) dropdownSelected.innerHTML = '<span class="text-lg leading-none">🌐</span><span class="font-bold text-gray-900 text-[15px]">International</span>';
      indiaSection.classList.add('hidden');
      intlSection.classList.remove('hidden');
    } else {
      if(dropdownSelected) dropdownSelected.innerHTML = '<span class="text-lg leading-none">🇮🇳</span><span class="font-bold text-gray-900 text-[15px]">India</span>';
      intlSection.classList.add('hidden');
      indiaSection.classList.remove('hidden');
    }
  };

