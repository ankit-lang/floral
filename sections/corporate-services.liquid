<section class="relative bg-gray-900 py-24 overflow-hidden" id="corporate-services-section">
  <!-- Parallax Background Image -->
  <div class="absolute inset-0 z-0">
    <img src="https://cdn.shopify.com/s/files/1/0748/1766/7150/files/hero-banner.png" alt="Corporate Events" class="w-full h-full object-cover opacity-20" style="transform: translateY(0px);" id="corp-parallax-bg">
  </div>
  
  <div class="relative z-10 max-w-7xl mx-auto px-4">
    <div class="text-center mb-16 anim-up">
      <h2 class="text-4xl md:text-5xl font-serif font-bold text-white mb-4">Our Corporate & Personal Services</h2>
      <p class="text-gray-300 max-w-2xl mx-auto text-lg">From intimate office parties to mega events, we provide end-to-end branding and gifting solutions.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
      <!-- Left Column: Flip Cards (60%) -->
      <div class="lg:w-3/5 grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Card 1 -->
        <div class="group perspective h-64 anim-up stagger-1 cursor-pointer">
          <div class="relative preserve-3d group-hover:rotate-y-180 w-full h-full duration-700">
            <!-- Front -->
            <div class="absolute backface-hidden w-full h-full bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 flex flex-col items-center justify-center text-center">
              <svg class="w-12 h-12 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <h3 class="text-2xl font-serif font-bold text-white">Corporate</h3>
            </div>
            <!-- Back -->
            <div class="absolute backface-hidden w-full h-full bg-gold rounded-2xl p-8 flex items-center text-center rotate-y-180 shadow-[0_0_30px_rgba(201,168,108,0.4)]">
              <p class="text-gray-900 font-medium">From intimate office parties like birthday and farewell to mega events like seminars, conferences or annual meets, we provide end to end branding and gifting solutions.</p>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="group perspective h-64 anim-up stagger-2 cursor-pointer">
          <div class="relative preserve-3d group-hover:rotate-y-180 w-full h-full duration-700">
            <div class="absolute backface-hidden w-full h-full bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 flex flex-col items-center justify-center text-center">
              <svg class="w-12 h-12 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 9.36l-7.1 7.1a1 1 0 0 1-1.4 0l-2.8-2.8a1 1 0 0 1 0-1.4l7.1-7.1a6 6 0 0 1 9.36-7.94l-3.77 3.77z"/></svg>
              <h3 class="text-2xl font-serif font-bold text-white">Weddings</h3>
            </div>
            <div class="absolute backface-hidden w-full h-full bg-gold rounded-2xl p-8 flex items-center text-center rotate-y-180">
              <p class="text-gray-900 font-medium">Organising a wedding is like running a marathon... We offer a complete wedding solution for small, big and online wedding functions.</p>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="group perspective h-64 anim-up stagger-3 cursor-pointer">
          <div class="relative preserve-3d group-hover:rotate-y-180 w-full h-full duration-700">
            <div class="absolute backface-hidden w-full h-full bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 flex flex-col items-center justify-center text-center">
              <svg class="w-12 h-12 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              <h3 class="text-2xl font-serif font-bold text-white">Parties</h3>
            </div>
            <div class="absolute backface-hidden w-full h-full bg-gold rounded-2xl p-8 flex items-center text-center rotate-y-180">
              <p class="text-gray-900 font-medium">Let’s celebrate parties together, choose from our wide selection of cakes, balloons, gifts, flowers, mithai and more.</p>
            </div>
          </div>
        </div>

        <!-- Card 4 (Full Width) -->
        <div class="group perspective h-64 md:col-span-2 anim-up stagger-4 cursor-pointer">
          <div class="relative preserve-3d group-hover:rotate-y-180 w-full h-full duration-700">
            <div class="absolute backface-hidden w-full h-full bg-white/10 backdrop-blur-md rounded-2xl border border-white/20 p-8 flex flex-col items-center justify-center text-center">
              <svg class="w-12 h-12 text-gold mb-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20 7h-3a2 2 0 0 0-2-2V4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v1a2 2 0 0 0-2 2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/></svg>
              <h3 class="text-2xl font-serif font-bold text-white">Tailor Made or Ready Made Packages</h3>
            </div>
            <div class="absolute backface-hidden w-full h-full bg-gold rounded-2xl p-8 flex items-center text-center rotate-y-180">
              <p class="text-gray-900 font-medium md:text-lg">Send gifts across the globe or India through our efficient system of multi deliveries and real time tracking of your packages. You can opt for a tailor made or a ready made package to fit your needs.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Stats, Map, Testimonials (40%) -->
      <div class="lg:w-2/5 flex flex-col gap-8">
        
        <!-- Animated Stats -->
        <div class="grid grid-cols-2 gap-4 anim-right stagger-2">
          <div class="bg-white/5 backdrop-blur-md rounded-2xl p-6 border border-white/10 text-center shadow-lg">
            <div class="text-4xl font-bold text-gold mb-1 stat-counter" data-target="500">0</div>
            <div class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold">Events Curated</div>
          </div>
          <div class="bg-white/5 backdrop-blur-md rounded-2xl p-6 border border-white/10 text-center shadow-lg">
            <div class="text-4xl font-bold text-gold mb-1 stat-counter" data-target="50">0</div>
            <div class="text-[10px] text-gray-400 uppercase tracking-widest font-semibold">Countries (Deliveries)</div>
          </div>
        </div>

        <!-- World Map Visual -->
        <div class="bg-white/5 backdrop-blur-md rounded-2xl p-8 border border-white/10 text-center flex-1 flex flex-col items-center justify-center anim-right stagger-3 relative overflow-hidden shadow-lg">
          <h4 class="text-white font-serif text-xl mb-6">Global Reach</h4>
          <!-- Abstract SVG Dotted Map -->
          <svg class="w-full h-32 text-gray-500 opacity-50" viewBox="0 0 200 100" fill="currentColor">
            <circle cx="30" cy="30" r="1.5"/><circle cx="35" cy="28" r="1.5"/><circle cx="40" cy="35" r="1.5"/><circle cx="25" cy="40" r="1.5"/><circle cx="32" cy="45" r="1.5"/>
            <circle cx="90" cy="25" r="1.5"/><circle cx="95" cy="22" r="1.5"/><circle cx="100" cy="30" r="1.5"/><circle cx="85" cy="35" r="1.5"/><circle cx="105" cy="20" r="1.5"/>
            <circle cx="140" cy="40" r="1.5"/><circle cx="145" cy="45" r="1.5"/><circle cx="150" cy="35" r="1.5"/><circle cx="155" cy="50" r="1.5"/>
            <circle cx="160" cy="70" r="1.5"/><circle cx="165" cy="75" r="1.5"/>
            <circle cx="60" cy="60" r="1.5"/><circle cx="65" cy="65" r="1.5"/><circle cx="70" cy="70" r="1.5"/>
            
            <!-- Pulsing Pins -->
            <circle cx="35" cy="28" r="3" class="text-gold animate-pulse-soft"/><circle cx="35" cy="28" r="8" class="text-gold animate-ping opacity-20"/>
            <circle cx="100" cy="30" r="3" class="text-gold animate-pulse-soft"/><circle cx="100" cy="30" r="8" class="text-gold animate-ping opacity-20"/>
            <circle cx="145" cy="45" r="3" class="text-gold animate-pulse-soft"/><circle cx="145" cy="45" r="8" class="text-gold animate-ping opacity-20"/>
          </svg>
          <p class="text-xs text-gray-400 mt-6 leading-relaxed">Send gifts across the globe or India efficiently through our seamless network.</p>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .perspective { perspective: 1000px; }
  .preserve-3d { transform-style: preserve-3d; }
  .backface-hidden { backface-visibility: hidden; }
  .rotate-y-180 { transform: rotateY(180deg); }
</style>

<script>
  // Simple Parallax
  window.addEventListener('scroll', () => {
    const bg = document.getElementById('corp-parallax-bg');
    if (bg) {
      const scrollPos = window.scrollY;
      bg.style.transform = `translateY(${scrollPos * 0.3}px)`;
    }
  });

  // Stat Counter Animation via IntersectionObserver
  document.addEventListener('DOMContentLoaded', () => {
    const counters = document.querySelectorAll('.stat-counter');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const target = +entry.target.getAttribute('data-target');
          let count = 0;
          const speed = target / 50; 
          const updateCount = () => {
            count += speed;
            if (count < target) {
              entry.target.innerText = Math.ceil(count) + '+';
              requestAnimationFrame(updateCount);
            } else {
              entry.target.innerText = (target === 50 ? '50k+' : target + '+');
            }
          };
          updateCount();
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });
    
    counters.forEach(counter => observer.observe(counter));
  });
</script>

