<script>
  (function() {
    function initCategoryFilters() {
      const filterBtns = document.querySelectorAll('.category-filter-btn');
      const grid = document.getElementById('collection-product-grid');
      if (!grid || filterBtns.length === 0) return;

      const keywords = {
        flower: ['flower', 'rose', 'lili', 'lily', 'bouquet', 'orchid', 'carnation', 'gerbera', 'tulip', 'blossom', 'floral', 'stem', 'bunch', 'vase'],
        cake: ['cake', 'truffle', 'velvet', 'pineapple', 'chocolate', 'black forest', 'butterscotch', 'pastry', 'gateau', 'fudge', 'cheesecake', 'sponge'],
        combo: ['combo', 'hamper', 'set', 'pack', 'bundle', 'pair', 'surprise', '+', '&'],
        plant: ['plant', 'bonsai', 'pothos', 'sansevieria', 'bamboo', 'succulent', 'jade', 'syngonium', 'money plant', 'indoor'],
        // Hamper Tag Specific Keywords
        diwali: ['diwali', 'deepavali', 'diya'],
        idol: ['idol', 'idols', 'murti', 'statue', 'laxmi', 'lakshmi', 'ganesha', 'ganesh', 'god', 'pooja'],
        rakhi: ['rakhi', 'raksha', 'rakshabandhan', 'bandhan', 'brother', 'sister'],
        chocolate: ['chocolate', 'chocolates', 'ferrero', 'cadbury', 'truffle', 'cacao', 'cocoa'],
        gourmet: ['gourmet', 'dry fruit', 'nuts', 'snack', 'cookies', 'sweets', 'treats', 'almond', 'cashew'],
        floral: ['flower', 'floral', 'bloom', 'rose', 'orchid', 'bouquet', 'carnation'],
        // Hamper Sub-Collection Keywords
        healthy: ['healthy', 'health', 'organic', 'nut', 'diet', 'fit', 'seeds', 'salads'],
        snacks: ['snack', 'snacks', 'namkeen', 'munch', 'chip', 'cookies', 'savory', 'crisp'],
        grooming: ['grooming', 'care', 'spa', 'body', 'skin', 'wellness', 'fragrance', 'lotion', 'bath'],
        tea: ['tea', 'coffee', 'brew', 'mug', 'sipper', 'chai', 'espresso', 'green tea', 'cozy'],
        fruit: ['fruit', 'fruits', 'apple', 'orange', 'berry', 'fresh fruit'],
        sweet: ['sweet', 'sweets', 'mithai', 'halwa', 'laddu', 'barfi', 'gulab', 'dessert'],
        dryfruit: ['dry fruit', 'dryfruit', 'nuts', 'cashew', 'almond', 'pista', 'raisin', 'walnut'],
        diy: ['diy', 'kit', 'craft', 'paint', 'make', 'activity', 'create']
      };

      // 1. Pre-index all items in memory (0ms lookup, avoids layout reflows from innerText)
      const cachedItems = Array.from(grid.children).map(wrapper => {
        if (wrapper.id === 'intl-collection-empty-notice' || wrapper.id === 'tag-filter-empty-notice') {
          return { wrapper, isNotice: true };
        }
        const card = wrapper.classList.contains('product-card') ? wrapper : (wrapper.querySelector('.product-card') || wrapper);
        const title = (card.dataset.title || card.getAttribute('alt') || '').toLowerCase();
        const type  = (card.dataset.type || '').toLowerCase();
        const tags  = (card.dataset.tags || card.dataset.tiers || '').toLowerCase();
        const fullText = `${title} ${type} ${tags}`;
        return { wrapper, card, fullText, isNotice: false };
      });

      function applyFilter(filterVal) {
        // Fast UI pill active toggle
        filterBtns.forEach(b => {
          if (b.dataset.filter === filterVal) {
            b.classList.add('active');
          } else {
            b.classList.remove('active');
          }
        });

        let matchCount = 0;
        const matchesKeywords = keywords[filterVal] || [filterVal.toLowerCase()];

        // Ultra-fast Batch DOM Updates (<1ms)
        cachedItems.forEach(item => {
          if (item.isNotice) return;

          if (filterVal === 'all') {
            item.wrapper.classList.remove('filter-hidden');
            item.wrapper.style.display = '';
            matchCount++;
          } else {
            const isMatch = matchesKeywords.some(kw => item.fullText.includes(kw));
            if (isMatch) {
              item.wrapper.classList.remove('filter-hidden');
              item.wrapper.style.display = '';
              matchCount++;
            } else {
              item.wrapper.classList.add('filter-hidden');
              item.wrapper.style.display = 'none';
            }
          }
        });

        // Toggle empty tag filter state notice
        let emptyTagNotice = document.getElementById('tag-filter-empty-notice');
        if (matchCount === 0) {
          if (!emptyTagNotice) {
            emptyTagNotice = document.createElement('div');
            emptyTagNotice.id = 'tag-filter-empty-notice';
            emptyTagNotice.className = 'w-full my-8 p-8 rounded-3xl bg-amber-50 border border-amber-200/70 text-center col-span-full anim-scale';
            grid.appendChild(emptyTagNotice);
          }
          const allLabel = window.location.pathname.includes('/all') ? 'All Products' : 'All Hampers';
          emptyTagNotice.innerHTML = `
            <div class="w-16 h-16 mx-auto bg-amber-100 rounded-full flex items-center justify-center mb-3 text-3xl">🎁</div>
            <h3 class="text-lg font-serif font-bold text-amber-900 mb-1">No ${filterVal.toUpperCase()} Items Found</h3>
            <p class="text-xs text-amber-700 max-w-md mx-auto mb-4">No items matching "${filterVal}" are available in this grid right now.</p>
            <button type="button" class="reset-filter-btn px-5 py-2 rounded-full bg-primary text-white text-xs font-bold shadow-sm hover:bg-primary-600 transition-all cursor-pointer">
              Show ${allLabel}
            </button>
          `;
          emptyTagNotice.style.display = '';
          const resetBtn = emptyTagNotice.querySelector('.reset-filter-btn');
          if (resetBtn) {
            resetBtn.onclick = () => applyFilter('all');
          }
        } else if (emptyTagNotice) {
          emptyTagNotice.style.display = 'none';
        }
      }

      filterBtns.forEach(btn => {
        btn.addEventListener('click', function(e) {
          if (this.tagName === 'A' && this.getAttribute('href')) {
            return; // Allow standard link navigation
          }
          e.preventDefault();
          applyFilter(this.dataset.filter);
        });
      });

      // 2. High-performance Instant URL & Link Interceptor
      function checkAndApplyUrlFilter() {
        try {
          const urlParams = new URLSearchParams(window.location.search);
          let paramVal = (urlParams.get('tag') || urlParams.get('filter') || window.location.hash.replace('#', '')).toLowerCase();

          if (paramVal && keywords[paramVal]) {
            applyFilter(paramVal);
          }
        } catch(e) {}
      }

      // Run initial filter check immediately
      checkAndApplyUrlFilter();

      // Intercept same-page links (e.g. clicking /collections/hampers?tag=rakhi while already on hampers page)
      document.addEventListener('click', function(e) {
        const link = e.target.closest('a[href*="tag="], a[href*="filter="]');
        if (!link) return;
        
        try {
          const targetUrl = new URL(link.href, window.location.origin);
          if (targetUrl.pathname === window.location.pathname) {
            const tagParam = targetUrl.searchParams.get('tag') || targetUrl.searchParams.get('filter') || targetUrl.hash.replace('#', '');
            let filterName = tagParam ? tagParam.toLowerCase() : '';
            if (filterName && keywords[filterName]) {
              e.preventDefault();
              history.pushState(null, '', link.href);
              applyFilter(filterName);
            }
          }
        } catch(err) {}
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCategoryFilters);
    } else {
      initCategoryFilters();
    }
  })();

  // Filter Scroll Buttons Helper
  window.scrollFilterContainer = function(btn, distance) {
    const wrapper = btn.closest('.filter-scroll-wrapper') || btn.closest('.relative');
    if (!wrapper) return;
    const container = wrapper.querySelector('#collection-category-filters, .overflow-x-auto');
    if (container) {
      container.scrollBy({ left: distance, behavior: 'smooth' });
    }
  };

  function initFilterScrollArrows() {
    const wrappers = document.querySelectorAll('.filter-scroll-wrapper');
    wrappers.forEach(wrapper => {
      const container = wrapper.querySelector('#collection-category-filters, .overflow-x-auto');
      const leftBtn = wrapper.querySelector('.filter-scroll-btn.left-btn');
      const rightBtn = wrapper.querySelector('.filter-scroll-btn.right-btn');
      if (!container) return;

      function updateArrows() {
        const maxScrollLeft = container.scrollWidth - container.clientWidth;
        if (maxScrollLeft <= 5) {
          if (leftBtn) leftBtn.style.display = 'none';
          if (rightBtn) rightBtn.style.display = 'none';
          return;
        }

        if (leftBtn) {
          leftBtn.style.display = 'flex';
          if (container.scrollLeft <= 5) {
            leftBtn.classList.add('opacity-30', 'pointer-events-none');
          } else {
            leftBtn.classList.remove('opacity-30', 'pointer-events-none');
          }
        }

        if (rightBtn) {
          rightBtn.style.display = 'flex';
          if (container.scrollLeft >= maxScrollLeft - 5) {
            rightBtn.classList.add('opacity-30', 'pointer-events-none');
          } else {
            rightBtn.classList.remove('opacity-30', 'pointer-events-none');
          }
        }
      }

      container.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows, { passive: true });
      updateArrows();

      // Auto scroll active filter pill into view on load
      const activePill = container.querySelector('.category-filter-btn.active');
      if (activePill) {
        setTimeout(() => {
          activePill.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }, 150);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFilterScrollArrows);
  } else {
    initFilterScrollArrows();
  }
</script>

