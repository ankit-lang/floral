<div class="max-w-7xl mx-auto px-4 py-8" id="collection-page-container" data-collection-handle="{{ collection.handle }}">

{% comment %} Exotic Flowers Collection: Metro City Gate {% endcomment %}
{% assign handle_lower = collection.handle | downcase %}
{% if handle_lower == 'exotic-flowers' or handle_lower == 'exoticflowers' %}
<div id="exotic-city-gate-notice" class="hidden text-center py-16 bg-rose-50/80 rounded-3xl border border-rose-200 mb-8">
  <div class="w-20 h-20 mx-auto bg-white rounded-full flex items-center justify-center mb-4 shadow-sm text-4xl">🌺</div>
  <h2 class="text-2xl font-serif font-bold text-rose-900 mb-2">Exotic Flowers — Metro Cities Only</h2>
  <p class="text-sm text-rose-700 max-w-md mx-auto mb-6">Exotic flowers are currently available for delivery in <strong>Delhi, Mumbai, Kolkata, Pune, and Bangalore</strong> only. Please change your delivery city to view and order these products.</p>
  <button type="button" onclick="if(window.openPincodeModal) window.openPincodeModal('india');" class="inline-flex items-center justify-center h-11 px-8 rounded-full bg-primary text-white font-bold hover:bg-primary/90 transition-colors shadow-md text-sm cursor-pointer">
    Change Delivery City
  </button>
</div>
<script>
(function() {
  var metroCities = ['delhi', 'new delhi', 'mumbai', 'kolkata', 'pune', 'bangalore', 'bengaluru'];
  function getCookieVal(name) {
    var nameEQ = name + '=';
    var ca = document.cookie.split(';');
    for (var i = 0; i < ca.length; i++) {
      var c = ca[i];
      while (c.charAt(0) === ' ') c = c.substring(1);
      if (c.indexOf(nameEQ) === 0) return decodeURIComponent(c.substring(nameEQ.length));
    }
    return '';
  }
  function checkExoticAccess() {
    var city = (localStorage.getItem('user_city') || getCookieVal('user_city') || '').toLowerCase().trim();
    var isMetro = !city || metroCities.some(function(c) { return city.indexOf(c) !== -1; });
    var gateNotice = document.getElementById('exotic-city-gate-notice');
    var gridEl = document.getElementById('collection-product-grid');
    var breadcrumb = document.querySelector('nav[aria-label="Breadcrumb"]');
    var headerBar = document.querySelector('#collection-page-container > .flex.flex-col.md\\:flex-row');
    var pagination = document.querySelector('#collection-page-container nav[aria-label="Pagination"]');
    if (!isMetro) {
      if (gateNotice) { gateNotice.classList.remove('hidden'); gateNotice.style.display = ''; }
      if (gridEl) gridEl.style.setProperty('display', 'none', 'important');
      if (pagination) pagination.style.setProperty('display', 'none', 'important');
    } else {
      if (gateNotice) { gateNotice.classList.add('hidden'); gateNotice.style.display = 'none'; }
      if (gridEl) gridEl.style.removeProperty('display');
      if (pagination) pagination.style.removeProperty('display');
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', checkExoticAccess);
  } else {
    checkExoticAccess();
  }
  document.addEventListener('pincodeUpdated', checkExoticAccess);
  document.addEventListener('deliveryModeChanged', checkExoticAccess);
  window.addEventListener('storage', function(e) { if (e.key === 'user_city') checkExoticAccess(); });
})();
</script>
{% endif %}
