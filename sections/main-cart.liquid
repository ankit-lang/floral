        if (typeof window.openLoginModal === 'function') {
          window.openLoginModal(currentUrl);
        } else {
          window.location.href = `/customer_authentication/login?return_to=${encodeURIComponent(currentUrl)}`;
        }
        return false;
      }

      e.preventDefault();
        
        const btnText = checkoutBtn.querySelector('.btn-text');
        const btnLoading = checkoutBtn.querySelector('.btn-loading');

        function resetCheckoutButtonState() {
          if (btnText) btnText.style.opacity = '1';
          if (btnLoading) btnLoading.classList.add('hidden');
          checkoutBtn.style.pointerEvents = 'auto';
        }

        // GUARD: Ensure at least one main product exists in the cart before proceeding
        const mainProductCards = document.querySelectorAll('.cart-country-item[data-is-main="true"]');
        const addonCards = document.querySelectorAll('.cart-country-item[data-is-addon="true"]');
        if (mainProductCards.length === 0 && addonCards.length > 0) {
          alert('⚠️ "Make It Extra" items are add-on products and cannot be ordered without a main product. Please add flowers, cakes, or gifts to your cart to proceed.');
          resetCheckoutButtonState();
          return;
        }

        if (!validateCartFormFields()) {
          resetCheckoutButtonState();
          return;
        }

        // Ensure live cart hidden attributes are synced
        syncLiveCartAttributes();
        
        // Show loading state
        if (btnText) btnText.style.opacity = '0';
        if (btnLoading) btnLoading.classList.remove('hidden');
        checkoutBtn.style.pointerEvents = 'none';

        const mainCartForm = checkoutBtn.closest('form') || document.querySelector('form[action^="/cart"]') || document.querySelector('form#cart');

        // Fallback safety timeout (forces checkout submit if network is slow)
        const safetyTimeout = setTimeout(() => {
          console.warn('Checkout submission timing out, forcing direct form submission...');
          if (mainCartForm) {
            let hiddenInput = mainCartForm.querySelector('input[name="checkout"]');
            if (!hiddenInput) {
              hiddenInput = document.createElement('input');
              hiddenInput.type = 'hidden';
              hiddenInput.name = 'checkout';
              hiddenInput.value = 'Checkout';
              mainCartForm.appendChild(hiddenInput);
            }
            mainCartForm.submit();
          } else {
            window.location.href = '/checkout';
          }
        }, 3500);

        try {
          const updates = [];
          const allCartAttributes = {};
          let checkoutShippingData = null;
          const deliverySchedule = [];

          forms.forEach((form, idx) => {
            const lineAttr = form.dataset.line;
            
            // Sync from first form to hidden forms so all items have complete delivery details
            if (idx > 0) {
              const firstForm = forms[0];
              const firstFields = firstForm.querySelectorAll('.addr-field');
              const currFields = form.querySelectorAll('.addr-field');
              currFields.forEach((field, i) => {
                if (firstFields[i]) {
                  if (form.dataset.ownDate === 'true' && (field.dataset.prop === 'Delivery Date' || field.dataset.prop === 'Delivery Time')) return;
                  if (field.type === 'checkbox') field.checked = firstFields[i].checked;
                  else field.value = firstFields[i].value;
                }
              });
            }
            
            const fields = form.querySelectorAll('.addr-field');
            
            let existingProperties = {};
            try {
              if (form.dataset.existingProperties) {
                existingProperties = JSON.parse(form.dataset.existingProperties);
              }
            } catch(err) {}

            const properties = Object.assign({}, existingProperties);
            
            let hasData = false;
            fields.forEach(field => {
              const val = field.type === 'checkbox' ? (field.checked ? field.value : '') : field.value;
              if (val) {
                properties[field.dataset.prop] = val;
                hasData = true;
              }
            });

            const title = properties['Delivery_Title'] || '';
            const fName = properties['Delivery_FirstName'] || '';
            const lName = properties['Delivery_LastName'] || '';
            const address = properties['Delivery_Address'] || '';
            const landmark = properties['Delivery_Landmark_IN'] || '';
            const houseNo = properties['Delivery_HouseNo'] || '';
            const city = properties['Delivery_City'] || properties['City'] || properties['_City'] || '';
            const state = properties['Delivery_State'] || '';
            const postcode = properties['Delivery_Postcode'] || properties['_Pincode'] || '';
            const country = properties['Delivery_Country'] || '';
            const delMobileInput = form.querySelector('[data-prop="Delivery_Mobile"]');
            const senderMobileInput = form.querySelector('[data-prop="Sender_Mobile"]');

            const mobile = (delMobileInput && delMobileInput.dataset.e164) ? delMobileInput.dataset.e164 : (properties['Delivery_Mobile'] || '');
            const senderMobile = (senderMobileInput && senderMobileInput.dataset.e164) ? senderMobileInput.dataset.e164 : (properties['Sender_Mobile'] || '');
            const giftMsg = properties['Delivery_GiftMessage'] || '';
            const senderName = properties['Sender_Name'] || '';
            const senderEmail = properties['Sender_Email'] || '';
            const delDate = properties['Delivery Date'] || properties['Delivery_Date'] || '';
            const delTime = properties['Delivery Time'] || properties['Delivery_Time'] || '';

            if (fName || lName) properties['Recipient Name'] = `${title} ${fName} ${lName}`.trim();
            if (address || houseNo) properties['Delivery Address'] = `${houseNo ? houseNo + ', ' : ''}${address}${landmark ? ', ' + landmark : ''}${city ? ', ' + city : ''}${state ? ', ' + state : ''}${postcode ? ' - ' + postcode : ''}`;
            if (mobile) properties['Recipient Phone'] = mobile;
            if (giftMsg) properties['Gift Message'] = giftMsg;
            if (senderName) properties['Sender Name'] = senderName;
            if (senderMobile) properties['Sender Phone'] = senderMobile;
            if (senderEmail) properties['Sender Email'] = senderEmail;
            if (delDate) properties['Delivery Date'] = delDate;
            if (delTime) properties['Delivery Time'] = delTime;

            if (idx === 0) {
              if (fName || lName) allCartAttributes['Recipient Name'] = `${title} ${fName} ${lName}`.trim();
              if (address || houseNo) allCartAttributes['Delivery Address'] = `${houseNo ? houseNo + ', ' : ''}${address}${landmark ? ', ' + landmark : ''}${city ? ', ' + city : ''}${state ? ', ' + state : ''}${postcode ? ' - ' + postcode : ''}`;
              if (mobile) allCartAttributes['Recipient Phone'] = mobile;
              if (giftMsg) allCartAttributes['Gift Message'] = giftMsg;
              if (senderName) allCartAttributes['Sender Name'] = senderName;
              if (senderMobile) allCartAttributes['Sender Phone'] = senderMobile;
              if (senderEmail) allCartAttributes['Sender Email'] = senderEmail;
              if (delDate) allCartAttributes['Delivery Date'] = delDate;
              if (delTime) allCartAttributes['Delivery Time'] = delTime;
              
              let finalCountry = (typeof normaliseCountryToIso === 'function' ? normaliseCountryToIso(country) : (country || 'IN')).toUpperCase();
              let fullCountryName = (finalCountry === 'IN' ? 'India' : (country || finalCountry));
              
              allCartAttributes['Delivery_Country'] = finalCountry;
              allCartAttributes['Delivery Country'] = fullCountryName;
              allCartAttributes['Delivery_State'] = state;
              allCartAttributes['Delivery State'] = state;
              allCartAttributes['Delivery_City'] = city;
              allCartAttributes['Delivery City'] = city;
              allCartAttributes['City'] = city;
              allCartAttributes['Delivery_Postcode'] = postcode;
              allCartAttributes['Delivery Postcode'] = postcode;
              
              checkoutShippingData = {
                 first_name: fName,
                 last_name: lName,
                 address1: `${houseNo ? houseNo + ', ' : ''}${address}`,
                 address2: landmark,
                 city: city,
                 province: state,
                 // Send only a real postal code; a place name (e.g. "Bell Gardens") makes checkout show
                 // "Enter a valid ZIP code". Leave it blank so the customer enters it at checkout.
                 zip: (function(z, cc) {
                   z = (z || '').trim();
                   if (!z) return '';
                   if (cc === 'US') return /^\d{5}(-\d{4})?$/.test(z) ? z : '';
                   if (cc === 'IN') return /^\d{6}$/.test(z) ? z : '';
                   return (/\d/.test(z) && /^[A-Za-z0-9 \-]{2,10}$/.test(z)) ? z : '';
                 })(postcode, finalCountry),
                 country: finalCountry,
                 phone: mobile || senderMobile
              };
            }

            if (hasData || Object.keys(properties).length > 0) {
              if (lineAttr === 'all') {
                const qtyButtons = document.querySelectorAll('.js-qty-btn[data-line]');
                const lineNumbers = new Set();
                qtyButtons.forEach(b => { if (b.dataset.line) lineNumbers.add(parseInt(b.dataset.line, 10)); });
                if (lineNumbers.size === 0) lineNumbers.add(1);

                lineNumbers.forEach(lineNum => {
                  const qtyInput = document.getElementById(`updates_${lineNum}`);
                  const qty = qtyInput ? parseInt(qtyInput.value || '1', 10) : 1;

                  // Apply this item's own advance-day rule (e.g. cakes need more notice than flowers)
                  let lineProps = properties;
                  const itemForm = document.querySelector(`.item-delivery-form[data-item-line="${lineNum}"]`);
                  if (itemForm && typeof window.getLineDeliveryDate === 'function') {
                    const itemDate = window.getLineDeliveryDate(itemForm);
                    const timeForm = itemForm.dataset.dateLeader ? (document.querySelector(`.item-delivery-form[data-item-line="${itemForm.dataset.dateLeader}"]`) || itemForm) : itemForm;
                    const ownTimeEl = timeForm.dataset.ownDate === 'true' ? timeForm.querySelector('.delivery-time-select') : null;
                    const itemTime = ownTimeEl && ownTimeEl.value ? ownTimeEl.value : null;
                    if ((itemDate && itemDate !== delDate) || itemTime) {
                      lineProps = Object.assign({}, properties);
                      if (itemDate) {
                        lineProps['Delivery Date'] = itemDate;
                        if ('Delivery_Date' in lineProps) lineProps['Delivery_Date'] = itemDate;
                      }
                      if (itemTime) {
                        lineProps['Delivery Time'] = itemTime;
                        if ('Delivery_Time' in lineProps) lineProps['Delivery_Time'] = itemTime;
                      }
                    }
                  }
                  if (itemForm && lineProps['Delivery Date']) {
                    deliverySchedule.push(`${itemForm.dataset.itemTitle || 'Item ' + lineNum}: ${lineProps['Delivery Date']}${lineProps['Delivery Time'] ? ' (' + lineProps['Delivery Time'] + ')' : ''}`);
                  }

                  updates.push({
                    line: lineNum,
                    quantity: qty,
                    properties: lineProps
                  });
                });
              } else if (forms[0] && forms[0].dataset.line === 'all') {
                // Already written by the main form above (with this item's own date) — skip to avoid overwriting it
              } else {
                const line = parseInt(lineAttr || '1', 10);
                const qty = parseInt(form.dataset.quantity || '1', 10);
                if (!isNaN(line)) {
                  updates.push({
                    line: line,
                    quantity: qty,
                    properties: properties
                  });
                }
              }
            }
          });

          // === GUARANTEED ATTRIBUTE WRITE — runs FIRST before anything else ===
          // Reads country/state/city/postcode directly from DOM and normalises to ISO-2.
          // Runs before Promise.all so the safety timeout can never race against it.
          try {
            const firstForm = forms && forms[0];
            if (firstForm) {
              const getVal = (prop) => {
                const el = firstForm.querySelector(`[data-prop="${prop}"]`);
                return el ? (el.value || '').trim() : '';
              };
              const rawCountry = getVal('Delivery_Country');
              const rawState = getVal('Delivery_State');
              const rawCity = getVal('Delivery_City');
              const rawPostcode = getVal('Delivery_Postcode');

              // Normalize to ISO-2 so BoomGate "Shipping country code" comparison works
              const isoCountry = (typeof normaliseCountryToIso === 'function' ? normaliseCountryToIso(rawCountry) : (rawCountry || 'IN')).toUpperCase();
              const fullCountryName = (isoCountry === 'IN' ? 'India' : (rawCountry || isoCountry));

              await fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ attributes: {
                  'Delivery_Country': isoCountry,
                  'Delivery Country': fullCountryName,
                  'Delivery_State': rawState,
                  'Delivery State': rawState,
                  'Delivery_City': rawCity,
                  'Delivery City': rawCity,
                  'City': rawCity,
                  'Delivery_Postcode': rawPostcode,
                  'Delivery Postcode': rawPostcode
                }})
              });
            }
          } catch(attrErr) {
            console.error('Failed to guarantee cart attributes:', attrErr);
          }
          // === END GUARANTEED ATTRIBUTE WRITE ===

          // Safety timeout no longer needed — clear it now
          clearTimeout(safetyTimeout);

          // Per-item delivery schedule as an order attribute (shown in admin + emails) when dates differ
          const scheduleDates = new Set(deliverySchedule.map(s => s.split(': ').pop().slice(0, 10)));
          allCartAttributes['Delivery Schedule'] = scheduleDates.size > 1 ? deliverySchedule.join(' | ') : '';
          allCartAttributes['Delivery Dates Count'] = String(window.getCartDeliveryDateCount ? window.getCartDeliveryDateCount() : 1);

          // Parallel fetch to update line items & attributes faster
          const updatePromises = updates.map(u => fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ line: u.line, quantity: u.quantity, properties: u.properties })
          }).catch(err => console.error('Error updating line property', err)));

          try {
            const currentCart = await fetch('/cart.js').then(r => r.json());
            const ghostKeys = Object.keys(currentCart.attributes || {}).filter(k => k.startsWith('Item '));
            ghostKeys.forEach(k => allCartAttributes[k] = "");
          } catch(e) {}

          const recipientNameStr = allCartAttributes['Recipient Name'] || '';
          const recipientPhoneStr = allCartAttributes['Recipient Phone'] || '';
          const deliveryDateStr = allCartAttributes['Delivery Date'] || '';
          const deliveryTimeStr = allCartAttributes['Delivery Time'] || '';
          const giftMsgStr = allCartAttributes['Gift Message'] || '';
          const senderNameStr = allCartAttributes['Sender Name'] || '';
          const senderPhoneStr = allCartAttributes['Sender Phone'] || '';
          const deliveryAddressStr = allCartAttributes['Delivery Address'] || '';

          const orderNoteParts = [];
          if (recipientNameStr) orderNoteParts.push(`Recipient Name: ${recipientNameStr}`);
          if (recipientPhoneStr) orderNoteParts.push(`Recipient Phone: ${recipientPhoneStr}`);
          if (deliveryAddressStr) orderNoteParts.push(`Delivery Address: ${deliveryAddressStr}`);
          if (deliveryDateStr) orderNoteParts.push(`Delivery Date: ${deliveryDateStr} ${deliveryTimeStr ? '(' + deliveryTimeStr + ')' : ''}`);
          if (giftMsgStr) orderNoteParts.push(`Gift Message: ${giftMsgStr}`);
          if (senderNameStr) orderNoteParts.push(`Sender: ${senderNameStr}${senderPhoneStr ? ' (' + senderPhoneStr + ')' : ''}`);

          const orderNote = orderNoteParts.join('\n');

          const cartUpdatePayload = {
            attributes: allCartAttributes
          };
          if (orderNote) {
            cartUpdatePayload.note = orderNote;
          }

          updatePromises.push(fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(cartUpdatePayload)
          }).catch(err => console.error('Error updating attributes and note', err)));

          await Promise.all(updatePromises);

          clearTimeout(safetyTimeout);

          // AGGRESSIVE FALLBACK FOR LOGGED-IN USERS:
          // Since Shopify ignores checkout URL params and hidden inputs for logged-in users,
          // we forcefully add the cart's address to their address book as the default address
          // right before sending them to checkout.
          if (checkoutShippingData && checkoutShippingData.country && '{{ customer.id }}') {
            try {
              // 1. Fetch addresses page to steal the authenticity_token
              const htmlRes = await fetch('/account/addresses');
              const htmlText = await htmlRes.text();
              const tokenMatch = htmlText.match(/name="authenticity_token" value="([^"]+)"/);
              const csrfToken = tokenMatch ? tokenMatch[1] : '';

              const countryNames = {
                'IN': 'India',
                'US': 'United States',
                'GB': 'United Kingdom',
                'AE': 'United Arab Emirates',
                'CA': 'Canada',
                'AU': 'Australia',
                'SG': 'Singapore'
              };
              const fullCountry = countryNames[checkoutShippingData.country] || checkoutShippingData.country;

              // 2. Submit via native hidden iframe to bypass XHR/Fetch restrictions
              const iframe = document.createElement('iframe');
              iframe.name = 'address_iframe';
              iframe.style.display = 'none';
              document.body.appendChild(iframe);

              const form = document.createElement('form');
              form.method = 'POST';
              form.action = '/account/addresses';
              form.target = 'address_iframe';
              form.style.display = 'none';

              const addInput = (name, val) => {
                const i = document.createElement('input');
                i.type = 'hidden';
                i.name = name;
                i.value = val;
                form.appendChild(i);
              };

              // Update existing address in place if available to prevent accumulating duplicate saved addresses
              const editMatch = htmlText.match(/action="\/account\/addresses\/(\d+)"/) || htmlText.match(/id="EditAddress_(\d+)"/);
              if (editMatch && editMatch[1]) {
                form.action = '/account/addresses/' + editMatch[1];
                addInput('_method', 'put');
              }

              addInput('form_type', 'customer_address');
              addInput('utf8', '✓');
              if (csrfToken) {
                addInput('authenticity_token', csrfToken);
              }
              
              addInput('address[first_name]', checkoutShippingData.first_name || '.');
              addInput('address[last_name]', checkoutShippingData.last_name || '.');
              addInput('address[address1]', checkoutShippingData.address1 || checkoutShippingData.city || '.');
              addInput('address[address2]', checkoutShippingData.address2 || '');
              addInput('address[city]', checkoutShippingData.city || '');
              addInput('address[province]', checkoutShippingData.province || '');
              addInput('address[country]', fullCountry);
              addInput('address[zip]', checkoutShippingData.zip || '');
              addInput('address[phone]', checkoutShippingData.phone || '');
              addInput('address[default]', '1');

              document.body.appendChild(form);
              form.submit();

              // Wait 1.5s for the form submission to complete in the background
              await new Promise(r => setTimeout(r, 1500));
            } catch(e) {
              console.warn("Could not save address to account", e);
            }
          }

          {% unless customer %}
             clearTimeout(safetyTimeout);
             window.location.href = '/customer_authentication/login?return_to=' + encodeURIComponent('/cart');
             return;
          {% endunless %}

          let checkoutUrl = window.__storefrontCheckoutUrl || '/checkout';
          const params = new URLSearchParams();
          
          if (!window.__storefrontCheckoutUrl && checkoutShippingData && checkoutShippingData.country) {
            if (checkoutShippingData.first_name) params.append('checkout[shipping_address][first_name]', checkoutShippingData.first_name);
            if (checkoutShippingData.last_name) params.append('checkout[shipping_address][last_name]', checkoutShippingData.last_name);
            if (checkoutShippingData.address1) params.append('checkout[shipping_address][address1]', checkoutShippingData.address1);
            if (checkoutShippingData.address2) params.append('checkout[shipping_address][address2]', checkoutShippingData.address2);
            if (checkoutShippingData.city) params.append('checkout[shipping_address][city]', checkoutShippingData.city);
            if (checkoutShippingData.province) params.append('checkout[shipping_address][province]', checkoutShippingData.province);
            if (checkoutShippingData.zip) params.append('checkout[shipping_address][zip]', checkoutShippingData.zip);
            params.append('checkout[shipping_address][country]', checkoutShippingData.country);
            if (checkoutShippingData.phone) params.append('checkout[shipping_address][phone]', checkoutShippingData.phone);
          }

          if (mainCartForm) {
            const discountInput = mainCartForm.querySelector('input[name="discount"]');
            if (discountInput && discountInput.value) {
              params.append('discount', discountInput.value);
            }
          }

          const queryString = params.toString();
          if (queryString) {
            checkoutUrl += (checkoutUrl.includes('?') ? '&' : '?') + queryString;
          }

          window.location.href = checkoutUrl;
        } catch (checkoutErr) {
          console.error('Error during checkout preparation:', checkoutErr);
          clearTimeout(safetyTimeout);
          window.location.href = '/checkout';
        }
      });
</script>

<script>
/* ============================================================
   CART COUNTRY FILTER
   Removes cart items unavailable for the selected delivery country
   when the page loads or when the delivery mode changes.
============================================================ */
(function() {
  function getCookieVal(name) {
    const v = '; ' + document.cookie;
    const parts = v.split('; ' + name + '=');
    if (parts.length === 2) return decodeURIComponent(parts.pop().split(';').shift());
    return '';
  }

  function showRemovedBanner(names) {
    if (!names || names.length === 0) return;
    let banner = document.getElementById('cart-country-removed-banner');
    if (!banner) {
      banner = document.createElement('div');
      banner.id = 'cart-country-removed-banner';
      banner.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%);z-index:9999;max-width:480px;width:90%;';
      document.body.appendChild(banner);
    }
    banner.innerHTML = '<div style="background:linear-gradient(135deg,#7c3aed,#db2777);color:#fff;border-radius:16px;padding:16px 20px;box-shadow:0 8px 32px rgba(0,0,0,0.18);display:flex;align-items:flex-start;gap:12px;font-family:system-ui,sans-serif;">' +
      '<span style="font-size:22px;flex-shrink:0;">&#128683;</span>' +
      '<div>' +
        '<div style="font-weight:700;font-size:14px;margin-bottom:4px;">Items Removed from Cart</div>' +
        '<div style="font-size:12px;opacity:0.92;">The following items are not available for your selected delivery destination and were removed:<br><b>' + names.join(', ') + '</b></div>' +
      '</div>' +
      '<button onclick="this.parentElement.parentElement.remove()" style="margin-left:auto;background:rgba(255,255,255,0.2);border:none;border-radius:8px;color:#fff;font-size:18px;cursor:pointer;padding:2px 8px;flex-shrink:0;">&times;</button>' +
    '</div>';
    setTimeout(() => { if (banner && banner.parentNode) banner.remove(); }, 8000);
  }

  async function removeUnavailableCartItems() {
    const mode = localStorage.getItem('delivery_mode') || getCookieVal('delivery_mode') || 'india';
    if (mode !== 'international') return; // Only filter on international mode

    const userCountry = (localStorage.getItem('user_country') || getCookieVal('user_country') || '').toLowerCase().trim();
    const userCountryCode = (localStorage.getItem('user_country_code') || getCookieVal('user_country_code') || '').toLowerCase().trim();

    const isUsaMode = userCountry.includes('usa') || userCountry.includes('united states') || userCountry === 'us' || userCountryCode === 'us';
    const isLondonMode = userCountry.includes('london') || userCountry.includes('united kingdom') || userCountry === 'uk' || userCountryCode === 'gb';
    const isUaeMode = userCountry.includes('uae') || userCountry.includes('dubai') || userCountryCode === 'ae';
    const isCanadaMode = userCountry.includes('canada') || userCountryCode === 'ca';
    const isAusMode = userCountry.includes('australia') || userCountryCode === 'au';

    // Specific country mode: only matched-tag products allowed
    const isSpecificCountryMode = isUsaMode || isLondonMode || isUaeMode || isCanadaMode || isAusMode;
    if (!isSpecificCountryMode) return; // Generic intl, no strict filtering needed

    const items = document.querySelectorAll('.cart-country-item');
    if (!items.length) return;

    const toRemove = [];
    items.forEach(item => {
      const rawTags = (item.dataset.tags || '').toLowerCase();
      const tagsList = rawTags.split(',').map(t => t.trim()).filter(Boolean);
      const title = item.dataset.productTitle || 'Product';
      const handle = item.dataset.handle || '';
      const lineIndex = item.dataset.line;

      // Never remove the Peak Season Delivery Surcharge product due to country mismatch
      if (handle === 'peak-season-delivery-surcharge' || handle === 'international-delivery-charge') return;

      const isUsaProd = tagsList.includes('usa') || tagsList.includes('us') || tagsList.includes('united states');
      const isLondonProd = tagsList.includes('london') || tagsList.includes('uk') || tagsList.includes('united kingdom');
      const isUaeProd = tagsList.includes('uae') || tagsList.includes('dubai') || tagsList.includes('ae');
      const isCanadaProd = tagsList.includes('canada') || tagsList.includes('ca');
      const isAusProd = tagsList.includes('australia') || tagsList.includes('au');

      let shouldRemove = false;
      if (isUsaMode && !isUsaProd) shouldRemove = true;
      else if (isLondonMode && !isLondonProd) shouldRemove = true;
      else if (isUaeMode && !isUaeProd) shouldRemove = true;
      else if (isCanadaMode && !isCanadaProd) shouldRemove = true;
      else if (isAusMode && !isAusProd) shouldRemove = true;

      if (shouldRemove) {
        toRemove.push({ line: parseInt(lineIndex, 10), title: title });
      }
    });

    if (toRemove.length === 0) return;

    // Build updates object: set quantity to 0 for all items to remove
    // We need to use /cart/update.js with the full updates array
    let cartRes = await fetch('/cart.js');
    let cart = await cartRes.json();

    const updates = {};
    toRemove.forEach(r => {
      // Find by line index (1-based) in the live cart
      const cartItem = cart.items[r.line - 1];
      if (cartItem) updates[cartItem.key] = 0;
    });

    if (Object.keys(updates).length === 0) return;

    await fetch('/cart/update.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ updates })
    });

    // Show notification and reload page
    const removedNames = toRemove.map(r => r.title);
    showRemovedBanner(removedNames);

    setTimeout(() => { window.location.reload(); }, 1800);
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', removeUnavailableCartItems);

  // Also run when delivery mode changes
  document.addEventListener('deliveryModeChanged', function() {
    setTimeout(removeUnavailableCartItems, 300);
  });
})();
</script>

<!-- ===== SHIPPING RATE SYNC: Fetch rates and prefill Storefront Cart ===== -->
<script>
(function initShippingRateSync() {
  'use strict';

  function getCartCountryCode() {
    const mode = localStorage.getItem('delivery_mode') || 'india';
    if (mode !== 'international') return 'IN';
    const code = (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
    return (code && code !== 'IN') ? code : 'GB';
  }

  async function syncShippingAddressAndRates() {
    let countryCode = getCartCountryCode();
    let zipCode = localStorage.getItem('user_intl_zip') || localStorage.getItem('user_pincode') || '';
    let province = localStorage.getItem('user_intl_state') || '';
    let city = localStorage.getItem('user_intl_locality') || localStorage.getItem('user_city') || '';
    
    let firstName = '', lastName = '', address1 = '', phone = '';

    // Extract real-time from the first delivery form if it exists
    const firstForm = document.querySelector('.delivery-address-form');
    if (firstForm) {
       const formZip = firstForm.querySelector('[data-prop="Delivery_Postcode"]')?.value;
       const formCity = firstForm.querySelector('[data-prop="Delivery_City"]')?.value;
       const formState = firstForm.querySelector('[data-prop="Delivery_State"]')?.value;
       
       firstName = firstForm.querySelector('[data-prop="Delivery_FirstName"]')?.value || '';
       lastName = firstForm.querySelector('[data-prop="Delivery_LastName"]')?.value || '';
       let houseNo = firstForm.querySelector('[data-prop="Delivery_HouseNo"]')?.value || '';
       let mainAddr = firstForm.querySelector('[data-prop="Delivery_Address"]')?.value || '';
       address1 = houseNo ? houseNo + ' ' + mainAddr : mainAddr;
       phone = firstForm.querySelector('[data-prop="Delivery_Mobile"]')?.value || '';
       
       if (formZip) zipCode = formZip;
       if (formCity) city = formCity;
       if (formState) province = formState;
    }
    
    const shippingRow = document.getElementById('cart-shipping-row');
    const shippingEl = document.getElementById('cart-shipping-price');

    // Show shipping in the visitor's selected currency and add it to the Estimated Total.
    // amount = shipping in major units (e.g. 3600 for ₹3,600); currencyCode from Shopify.
    // India: shipping is ₹450 per delivery date. The India zone has one flat rate per date count
    // (₹450, ₹900, ₹1,350 ...) and checkout shows only the one matching the "Delivery Dates Count"
    // cart attribute. Show that same rate here; with a single rate this just returns it.
    window.pickPerDateShippingOption = function(options) {
      const list = (options || []).filter(o => !isNaN(o.price));
      if (list.length === 0) return { price: 0, currency: 'INR' };
      const isIndia = (localStorage.getItem('delivery_mode') || 'india') === 'india';
      const count = typeof window.getCartDeliveryDateCount === 'function' ? window.getCartDeliveryDateCount() : 1;
      if (isIndia && list.length > 1) {
        const want = 450 * Math.max(1, count);
        const match = list.find(o => Math.round(o.price) === want);
        if (match) return match;
      }
      return list[0];
    };

    function renderShipping(amount, currencyCode) {
      const totalEl = document.getElementById('cart-estimated-total');
      const subtotal = totalEl ? parseInt(totalEl.dataset.cartSubtotal || '0', 10) : 0;
      if (!(amount > 0)) {
        if (shippingRow) shippingRow.classList.add('hidden');
        if (totalEl) totalEl.dataset.basePrice = String(subtotal);
        if (window.FloralCurrencyManager) window.FloralCurrencyManager.updateDOM();
        return;
      }
      const code = (currencyCode || 'INR').toUpperCase();
      if (code === 'INR') {
        const paise = Math.round(amount * 100);
        if (shippingEl) {
          shippingEl.dataset.basePrice = String(paise);
          shippingEl.textContent = window.FloralCurrencyManager
            ? window.FloralCurrencyManager.formatBasePrice(paise)
            : '₹' + Math.round(amount).toLocaleString('en-IN');
        }
        if (totalEl) totalEl.dataset.basePrice = String(subtotal + paise);
      } else if (shippingEl) {
        delete shippingEl.dataset.basePrice;
        shippingEl.textContent = new Intl.NumberFormat('en', { style: 'currency', currency: code }).format(amount);
      }
      if (shippingRow) shippingRow.classList.remove('hidden');
      if (window.FloralCurrencyManager) window.FloralCurrencyManager.updateDOM();
    }

    let success = false;
    let checkoutUrl = '';

    // 1. Storefront API (for Checkout Extensibility)
    const storefrontToken = window.STOREFRONT_ACCESS_TOKEN || 'fab4fc1304a1de5b1c5db57ee232ff68'; 
    if (storefrontToken) {
      if (storefrontToken.startsWith('shptka_')) {
        console.error('🚨 ERROR: The token provided (shptka_...) is a Theme Access Token, NOT a Storefront API token. Checkout prefill will fail. You must generate a Storefront API token in Shopify Admin.');
      } else {
        try {
          const cartRes = await fetch('/cart.js').then(r => r.json());
          const cartId = `gid://shopify/Cart/${cartRes.token}`;
          
          const query = `
            mutation cartBuyerIdentityUpdate($cartId: ID!, $buyerIdentity: CartBuyerIdentityInput!) {
              cartBuyerIdentityUpdate(cartId: $cartId, buyerIdentity: $buyerIdentity) {
                cart {
                  checkoutUrl
                  deliveryGroups(first: 1) {
                    nodes {
                      deliveryOptions { handle title estimatedCost { amount currencyCode } }
                    }
                  }
                }
                userErrors { field message }
              }
            }
          `;
          
          const variables = {
            cartId: cartId,
            buyerIdentity: {
              deliveryAddressPreferences: [{
                deliveryAddress: {
                  firstName: firstName,
                  lastName: lastName,
                  address1: address1,
                  phone: phone,
                  country: countryCode,
                  zip: zipCode,
                  province: province,
                  city: city
                }
              }]
            }
          };
          
          const sfRes = await fetch('/api/2024-01/graphql.json', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Shopify-Storefront-Access-Token': storefrontToken
            },
            body: JSON.stringify({ query, variables })
          });
          
          const sfData = await sfRes.json();
          if (sfData.data && sfData.data.cartBuyerIdentityUpdate && sfData.data.cartBuyerIdentityUpdate.cart) {
            const cartData = sfData.data.cartBuyerIdentityUpdate.cart;
            window.__storefrontCheckoutUrl = cartData.checkoutUrl;
            
            const groups = cartData.deliveryGroups?.nodes || [];
            if (groups.length > 0 && groups[0].deliveryOptions?.length > 0) {
              const opts = groups[0].deliveryOptions.map(o => ({ price: parseFloat(o.estimatedCost.amount), currency: o.estimatedCost.currencyCode }));
              const opt = window.pickPerDateShippingOption(opts);
              renderShipping(opt.price, opt.currency);
            } else {
               if (shippingRow) shippingRow.classList.add('hidden');
            }
            success = true;
          } else if (sfData.errors) {
            console.error('[ShippingSync] Storefront API error (Check token):', sfData.errors);
          }
        } catch (err) {
          console.warn('[ShippingSync] Storefront API sync failed:', err);
        }
      }
    }

    // 2. Fallback to AJAX API
    if (!success) {
      try {
        const res = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ country_code: countryCode })
        });
        
        const qs = new URLSearchParams();
        qs.append('shipping_address[country]', countryCode);
        if (zipCode) qs.append('shipping_address[zip]', zipCode);
        if (province) qs.append('shipping_address[province]', province);
        
        const rateRes = await fetch('/cart/shipping_rates.json?' + qs.toString());
        if (rateRes.ok) {
          const rateData = await rateRes.json();
          if (rateData.shipping_rates && rateData.shipping_rates.length > 0) {
             const opt = window.pickPerDateShippingOption(rateData.shipping_rates.map(r => ({ price: parseFloat(r.price), currency: r.currency || 'INR' })));
             renderShipping(opt.price, opt.currency);
          } else {
             if (shippingRow) shippingRow.classList.add('hidden');
          }
        } else {
             if (shippingRow) shippingRow.classList.add('hidden');
        }
      } catch (err) {
        console.error('[ShippingSync] Error syncing country_code:', err);
        if (shippingRow) shippingRow.classList.add('hidden');
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncShippingAddressAndRates);
  } else {
    syncShippingAddressAndRates();
  }

  window.addEventListener('storage', function (e) {
    if (e.key === 'delivery_mode' || e.key === 'user_country_code' || e.key === 'user_intl_zip' || e.key === 'user_pincode') {
      syncShippingAddressAndRates();
    }
  });

  document.addEventListener('deliveryModeChanged', syncShippingAddressAndRates);
  window.syncShippingCountry = syncShippingAddressAndRates;

  // Listen to address changes in the form to instantly recalculate rates
  document.addEventListener('change', function(e) {
    if (e.target && e.target.closest('.delivery-address-form')) {
      const prop = e.target.getAttribute('data-prop') || '';
      if (prop.includes('Postcode') || prop.includes('City') || prop.includes('State') || prop.includes('Country') || prop.includes('Address') || prop.includes('Name') || prop.includes('Mobile')) {
        clearTimeout(window.__shippingSyncTimer);
        window.__shippingSyncTimer = setTimeout(syncShippingAddressAndRates, 800);
      }
    }
  });
})();
</script>



<!-- Peak Season Surcharge on Cart Page -->
<script>
  {% capture raw_festivals_list %}{% render 'festivals-list' %}{% endcapture %}
  {% assign all_festivals_list = raw_festivals_list | strip | split: ',' %}
  window.__peakSeasonDates = [
    {% for entry in all_festivals_list %}
      {% assign f_parts = entry | split: ':' %}
      { "date": "{{ f_parts[0] }}", "region": "{{ f_parts[5] | default: 'ALL' }}" }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  window.__peakProductSurcharge = {{ settings.peak_product_surcharge | default: 15 }};

  {%- assign surcharge_product = all_products['peak-season-delivery-surcharge'] -%}
  {%- if surcharge_product and surcharge_product.available -%}
    window.__surchargeVariantId = {{ surcharge_product.variants.first.id }};
  {%- else -%}
    window.__surchargeVariantId = null;
  {%- endif -%}

  {%- assign intl_delivery_product = all_products['international-delivery-charge'] -%}
  {%- if intl_delivery_product and intl_delivery_product.available and settings.intl_fee_via_shipping_rates != true -%}
    window.__intlDeliveryVariantId = {{ intl_delivery_product.variants.first.id }};
  {%- else -%}
    window.__intlDeliveryVariantId = null;
  {%- endif -%}
  window.__intlFeeViaShipping = {{ settings.intl_fee_via_shipping_rates | default: false }};

</script>
<script>
(function() {
  'use strict';

  const PEAK_DATES = window.__peakSeasonDates || [];
  const SURCHARGE_PCT = window.__peakProductSurcharge || 15;

  if (PEAK_DATES.length === 0) return;

  const FEE_HANDLES = ['peak-season-delivery-surcharge', 'international-delivery-charge'];
  function isFeeItem(item) {
    const h = (item.handle || '').toLowerCase();
    const t = (item.product_title || item.title || '').toLowerCase();
    return FEE_HANDLES.includes(h) || h.includes('surcharge') || h.includes('delivery-charge') ||
      t.includes('surcharge') || t.includes('delivery charge') ||
      (item.properties && item.properties['_For Surcharge'] === 'True');
  }

  // Delivery date of one cart line, as shown in its date box on this page (falls back to the saved property)
  function cartItemDate(item, index) {
    const forms = Array.from(document.querySelectorAll('.item-delivery-form'));
    const form = forms.find(f => f.dataset.itemKey === item.key) ||
      forms.find(f => f.dataset.itemLine === String(index + 1) && f.dataset.lineKey === String(item.variant_id)) ||
      forms.find(f => f.dataset.lineKey === String(item.variant_id));
    let d = '';
    if (form && typeof window.getLineDeliveryDate === 'function') d = window.getLineDeliveryDate(form) || '';
    if (!d && item.properties) d = item.properties['Delivery Date'] || item.properties['Delivery_Date'] || '';
    return (d || '').trim();
  }

  function isPeakDate(dateStr) {
    if (!dateStr) return false;
    const normalized = dateStr.trim();
    const deliveryMode = localStorage.getItem('delivery_mode') || 'india';
    
    const peakMatch = PEAK_DATES.find(p => p.date === normalized);
    if (!peakMatch) return false;

    let isMatch = false;
    if (peakMatch.region === 'ALL') isMatch = true;
    else if (deliveryMode === 'india' && peakMatch.region === 'IN') isMatch = true;
    else if (deliveryMode === 'international') {
      const intlCountry = localStorage.getItem('intl_country');
      if (peakMatch.region === 'INTL') isMatch = true;
      else if (intlCountry && peakMatch.region === intlCountry) isMatch = true;
    }
    
    return isMatch;
  }

  async function syncSurchargeProduct() {
    // Wait until the per-item date boxes are set up, so every item's own date is known
    if (!document.querySelector('.item-delivery-form[data-line="all"]')) {
      syncSurchargeProduct._tries = (syncSurchargeProduct._tries || 0) + 1;
      if (syncSurchargeProduct._tries > 30 || !document.querySelector('.item-delivery-form')) return;
      clearTimeout(syncSurchargeProduct._retry);
      syncSurchargeProduct._retry = setTimeout(syncSurchargeProduct, 300);
      return;
    }
    try {
      const res = await fetch(window.Shopify.routes.root + 'cart.js?v=' + new Date().getTime(), {
        cache: 'no-store',
        headers: {
          'Pragma': 'no-cache',
          'Cache-Control': 'no-cache'
        }
      });
      const cart = await res.json();
      
      const hiddenInput = document.querySelector('.cart-date-input');
      const selectedDate = hiddenInput ? hiddenInput.value : '';
      const isIntlMode = (localStorage.getItem('delivery_mode') || 'india') === 'international';

      let expectedSurchargeQty = 0;
      let currentSurchargeQty = 0;
      let surchargeKey = null;

      let expectedIntlQty = 0;
      let currentIntlQty = 0;
      let intlKey = null;
      let realItemsCount = 0;
      let anyPeak = false;

      // Find surcharge product and calculate expected total surcharge quantity
      cart.items.forEach((item, index) => {
        if (item.handle === 'peak-season-delivery-surcharge') {
          currentSurchargeQty = item.quantity;
          surchargeKey = item.key;
        } else if (item.handle === 'international-delivery-charge') {
          currentIntlQty = item.quantity;
          intlKey = item.key;
        } else if (isFeeItem(item)) {
          // other fee lines never count as products
        } else {
          realItemsCount += item.quantity;
          const itemDate = cartItemDate(item, index);
          // Peak surcharge follows each item's own delivery date
          const isPeak = isPeakDate(itemDate);
          if (isPeak) anyPeak = true;
          if (isPeak) {
             // current item price is in cents/paise
             const baseRupees = item.price >= 100 ? item.price / 100 : item.price;
             const itemSurchargeUnit = Math.round(baseRupees * (SURCHARGE_PCT / 100));
             expectedSurchargeQty += (itemSurchargeUnit * item.quantity);
          }
          // Skip the fee product when international delivery is charged via shipping rates
          if (isIntlMode && !window.__intlFeeViaShipping) {
             expectedIntlQty += item.quantity;
          }
        }
      });

      // If there are no real items in cart at all, all surcharges/fees must be 0
      if (realItemsCount === 0) {
        expectedSurchargeQty = 0;
        expectedIntlQty = 0;
      } else if (!selectedDate && currentSurchargeQty > 0) {
        // If dates are not loaded yet we can't be sure - don't remove fees
        console.log('[Surcharge Sync] Date not yet loaded, skipping sync to avoid false removal.');
        return;
      }

      const peakNotice = document.getElementById('cart-peak-surcharge-notice');
      if (peakNotice && !peakNotice.classList.contains('bg-red-50')) peakNotice.classList.toggle('hidden', !anyPeak);

      if (currentSurchargeQty !== expectedSurchargeQty || currentIntlQty !== expectedIntlQty) {
        
        // Disable cart temporarily to prevent other clicks
        const container = document.getElementById('cart-container');
        if (container) {
          container.style.opacity = '0.5';
          container.style.pointerEvents = 'none';
        }
        
        let updates = {};
        let itemsToAdd = [];

        if (currentSurchargeQty !== expectedSurchargeQty) {
           if (surchargeKey) {
              updates[surchargeKey] = expectedSurchargeQty;
           } else if (expectedSurchargeQty > 0 && window.__surchargeVariantId) {
              itemsToAdd.push({
                 id: window.__surchargeVariantId,
                 quantity: expectedSurchargeQty,
                 properties: { '_For Surcharge': 'True' }
              });
           }
        }

        if (currentIntlQty !== expectedIntlQty) {
           if (intlKey) {
              updates[intlKey] = expectedIntlQty;
           } else if (expectedIntlQty > 0 && window.__intlDeliveryVariantId) {
              itemsToAdd.push({
                 id: window.__intlDeliveryVariantId,
                 quantity: expectedIntlQty,
                 properties: { '_For International Delivery': 'True' }
              });
           }
        }

        const currentDateBeforeUpdate = document.querySelector('.cart-date-input');
        if (currentDateBeforeUpdate && currentDateBeforeUpdate.value) {
          try {
            const savedData = JSON.parse(localStorage.getItem('floral_saved_delivery_details') || '{}');
            savedData['Delivery Date'] = currentDateBeforeUpdate.value;
            localStorage.setItem('floral_saved_delivery_details', JSON.stringify(savedData));
          } catch(e) {}
        }

        let needsReload = false;

        // 1. Process Updates
        if (Object.keys(updates).length > 0) {
           const res = await fetch(window.Shopify.routes.root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates: updates })
           });
           if (!res.ok) throw new Error(await res.text());
           needsReload = true;
        }

        // 2. Process Adds
        if (itemsToAdd.length > 0) {
           const addRes = await fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd })
           });
           if (!addRes.ok) throw new Error(await addRes.text());
           needsReload = true;
        }

        if (needsReload) {
           window.location.href = window.location.pathname + '?_v=' + new Date().getTime();
        } else {
           if (container) {
             container.style.opacity = '1';
             container.style.pointerEvents = 'auto';
           }
        }
      }
    } catch (err) {
      console.error('[Surcharge Sync Error]', err);
      const container = document.getElementById('cart-container');
      if (container) {
        container.style.opacity = '1';
        container.style.pointerEvents = 'auto';
      }
      
      const notice = document.getElementById('cart-peak-surcharge-notice');
      if (notice) {
        notice.classList.remove('hidden');
        notice.classList.remove('bg-amber-50', 'border-amber-200', 'text-amber-800');
        notice.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
        notice.innerHTML = '⚠️ Failed to apply surcharge. Please check if the surcharge product exists and has "Track quantity" unchecked in Shopify Admin.';
      }
    }
  }

  // Helper to setup the interval and listener on a block
  function setupPeakSurchargeListener(block) {
    const hiddenInput = block.querySelector('.cart-date-input');
    if (hiddenInput && !hiddenInput.dataset.surchargeAttached) {
      hiddenInput.dataset.surchargeAttached = 'true';
      
      // Wait for the date picker to restore a real date (polls up to 3s)
      let waited = 0;
      const MAX_WAIT = 3000;
      const POLL_INTERVAL = 100;
      function waitForDate() {
        waited += POLL_INTERVAL;
        const initialDate = hiddenInput.value;
        // If we have a real date, or we've waited too long, run the sync
        if (initialDate || waited >= MAX_WAIT) {
          const notice = document.getElementById('cart-peak-surcharge-notice');
          if (notice) {
            if (isPeakDate(initialDate)) notice.classList.remove('hidden');
            else notice.classList.add('hidden');
          }
          // Only sync to backend if we have a real date (avoid erasing surcharge on empty state)
          if (initialDate) syncSurchargeProduct();
        } else {
          setTimeout(waitForDate, POLL_INTERVAL);
        }
      }
      setTimeout(waitForDate, POLL_INTERVAL);

      let lastValue = hiddenInput.value;
      setInterval(function() {
        if (hiddenInput.value !== lastValue) {
          lastValue = hiddenInput.value;
          
          // Only toggle notice visually before sync happens (sync reloads page)
          const notice = document.getElementById('cart-peak-surcharge-notice');
          if (notice) {
            if (isPeakDate(lastValue)) notice.classList.remove('hidden');
            else notice.classList.add('hidden');
          }

          // Sync the surcharge product to the backend cart (only if date is known)
          if (lastValue) syncSurchargeProduct();
        }
      }, 500);
    }
  }

  // Hook into the cart date picker's selectDate function for future renders
  const origInitCartDatePicker = window.initCartDatePicker;
  if (origInitCartDatePicker) {
    window.initCartDatePicker = function(block, effectiveAdvance) {
      origInitCartDatePicker(block, effectiveAdvance);
      setupPeakSurchargeListener(block);
    };
  }

  // Attach to already rendered blocks on initial load
  document.querySelectorAll('.cart-date-picker-block').forEach(setupPeakSurchargeListener);

})();
</script>

