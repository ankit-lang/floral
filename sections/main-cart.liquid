              <span id="cart-shipping-price" class="font-semibold text-primary text-xs uppercase tracking-wider bg-primary/5 px-2 py-1 rounded-md"></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-gray-500 font-medium">Taxes</span>
              <span class="font-medium text-gray-500">Calculated at checkout</span>
            </div>
          </div>
          
          <div class="flex justify-between items-end mb-2">
            <span class="text-lg font-bold text-gray-900">Estimated Total</span>
            <span id="cart-estimated-total" class="text-3xl font-serif font-bold text-primary" data-base-price="{{ cart.total_price }}" data-cart-subtotal="{{ cart.total_price }}">{{ cart.total_price | money }}</span>
          </div>

          <!-- Peak Surcharge Notice (hidden by default) -->
          <div id="cart-peak-surcharge-notice" class="hidden mb-6 p-3 bg-amber-50 border border-amber-200 text-amber-800 text-xs font-semibold rounded-xl flex items-center gap-2">
            <span>⚡</span>
            <span id="cart-surcharge-notice-text">Peak season surcharge applied for this delivery date.</span>
          </div>



          {% unless customer %}
            <div class="mb-4 p-3.5 bg-amber-50 border border-amber-200/80 text-amber-900 text-xs font-medium rounded-2xl flex items-center justify-between gap-3 shadow-2xs">
              <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-amber-600 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <span>Login required to place order</span>
              </div>
