              </div>
              <div class="md:col-span-3 addr-wrapper">
                <input type="text" placeholder="City *" autocomplete="address-level2" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_City" value="{{ cart.attributes.Delivery_City | default: item.properties.Delivery_City | default: item.properties._City | escape }}">
              </div>
              <div class="md:col-span-3 addr-wrapper">
                <input type="text" placeholder="State *" autocomplete="address-level1" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-gray-100 text-gray-500 cursor-not-allowed addr-field" required data-prop="Delivery_State" value="{{ cart.attributes.Delivery_State | default: item.properties.Delivery_State | escape }}" readonly>
              </div>
              <div class="md:col-span-2 addr-wrapper">
                <input type="text" placeholder="Postcode *" autocomplete="postal-code" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-gray-100 text-gray-500 cursor-not-allowed addr-field" required data-prop="Delivery_Postcode" value="{{ cart.attributes.Delivery_Postcode | default: item.properties.Delivery_Postcode | default: item.properties['_Pincode'] | default: item.properties['Pincode'] | escape }}" readonly>
              </div>
              <div class="md:col-span-4 addr-wrapper">
                <input type="text" placeholder="Country *" autocomplete="country-name" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_Country" value="{{ cart.attributes.Delivery_Country | default: item.properties.Delivery_Country | escape }}">
              </div>

              <div class="md:col-span-4 addr-wrapper">
                <div class="phone-field-group">
                  <div class="relative flex items-center shadow-2xs rounded-md">
                    <div class="phone-dial-badge relative shrink-0 border border-r-0 border-gray-200 rounded-l-md bg-gray-100 transition-colors">
                      <div class="flex items-center gap-1 px-2.5 py-2 text-xs font-bold text-gray-700 pointer-events-none">
                        <span class="flag-icon">🇬🇧</span>
                        <span class="dial-code">+44</span>
                      </div>
                      <select disabled class="phone-country-select absolute inset-0 w-full h-full opacity-0 pointer-events-none">
                        <option value="GB">🇬🇧 UK (+44)</option>
                        <option value="IN">🇮🇳 India (+91)</option>
                        <option value="US">🇺🇸 USA (+1)</option>
                        <option value="CA">🇨🇦 Canada (+1)</option>
                        <option value="AE">🇦🇪 UAE (+971)</option>
                        <option value="AU">🇦🇺 Australia (+61)</option>
                        <option value="SG">🇸🇬 Singapore (+65)</option>
                        <option value="DE">🇩🇪 Germany (+49)</option>
                      </select>
                    </div>
                    <input type="tel" placeholder="Mobile No *" autocomplete="tel" class="w-full rounded-r-md rounded-l-none border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field tel-input" required data-prop="Delivery_Mobile" value="{{ cart.attributes.Delivery_Mobile | default: item.properties.Delivery_Mobile | escape }}" inputmode="numeric">
                  </div>
                </div>
              </div>
              <div class="md:col-span-4 addr-wrapper">
                <div class="phone-field-group">
                  <div class="relative flex items-center shadow-2xs rounded-md">
                    <div class="phone-dial-badge relative shrink-0 border border-r-0 border-gray-200 rounded-l-md bg-gray-100 transition-colors">
                      <div class="flex items-center gap-1 px-2.5 py-2 text-xs font-bold text-gray-700 pointer-events-none">
                        <span class="flag-icon">🇬🇧</span>
                        <span class="dial-code">+44</span>
                      </div>
                      <select disabled class="phone-country-select absolute inset-0 w-full h-full opacity-0 pointer-events-none">
                        <option value="GB">🇬🇧 UK (+44)</option>
                        <option value="IN">🇮🇳 India (+91)</option>
                        <option value="US">🇺🇸 USA (+1)</option>
                        <option value="CA">🇨🇦 Canada (+1)</option>
                        <option value="AE">🇦🇪 UAE (+971)</option>
                        <option value="AU">🇦🇺 Australia (+61)</option>
                        <option value="SG">🇸🇬 Singapore (+65)</option>
                        <option value="DE">🇩🇪 Germany (+49)</option>
                      </select>
                    </div>
                    <input type="tel" placeholder="Alternate No" class="w-full rounded-r-md rounded-l-none border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field tel-input" data-prop="Delivery_AlternateMobile" value="{{ cart.attributes.Delivery_AlternateMobile | default: item.properties.Delivery_AlternateMobile | escape }}" inputmode="numeric">
                  </div>
                </div>
              </div>
              <div class="md:col-span-4 flex items-center addr-wrapper">
                <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
                  <input type="checkbox" value="Yes" class="addr-field rounded border-gray-300 text-primary focus:ring-primary" data-prop="Delivery_Contactless" {% assign c_val = cart.attributes.Delivery_Contactless | default: item.properties.Delivery_Contactless %}{% if c_val == 'Yes' %}checked{% endif %}>
                  Opt for Contact less Delivery
                </label>
              </div>

              <!-- Delivery Date & Delivery Time (Always Visible) -->
              {% assign p_date = item.properties['Delivery Date'] | default: item.properties['Delivery_Date'] | default: cart.attributes['Delivery Date'] %}
              {% assign p_time = item.properties['Delivery Time'] | default: item.properties['Delivery_Time'] | default: cart.attributes['Delivery Time'] %}
              <div class="md:col-span-12 mt-2 cart-date-picker-block" style="z-index: 20; position: relative;">



                <div class="flex items-center justify-between mb-3">
                  <label class="text-xs font-bold text-gray-500 uppercase tracking-widest">Date and Time of Delivery</label>
                  <span class="delivery-countdown text-xs font-semibold text-secondary"></span>
                </div>

                <!-- Quick-Select Date Tabs -->
                <div class="flex gap-2 mb-4 delivery-date-tabs">
                  <button type="button"
                    class="date-tab date-tab-today flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                    data-date="today">
                    <span class="block font-bold today-label">Today</span>
                    <span class="block text-[10px] opacity-90 today-date-display"></span>
                  </button>
                  <button type="button"
                    class="date-tab date-tab-tomorrow flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                    data-date="tomorrow">
                    <span class="block font-bold">Tomorrow</span>
                    <span class="block text-[10px] text-gray-400 tomorrow-date-display"></span>
                  </button>
                  <button type="button"
                    class="date-tab date-tab-dayafter flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                    data-date="dayafter">
                    <span class="block font-bold">Day After</span>
                    <span class="block text-[10px] text-gray-400 dayafter-date-display"></span>
                  </button>
                  <button type="button"
                    class="date-tab custom-date-btn flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                    title="Choose your own date">
                    <span class="block font-bold custom-date-label">
                      <svg class="w-5 h-5 mx-auto text-gray-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                      </svg>
                    </span>
                    <span class="block text-[10px] text-gray-400 custom-date-display"></span>
                  </button>
                </div>

                <!-- Hidden date value -->
                <input type="hidden" class="addr-field cart-date-input" required data-prop="Delivery Date" value="{{ p_date | escape }}">
                <input type="text" class="custom-calendar-picker sr-only" tabindex="-1">

                <!-- Time Slot Info Notice -->
                <div class="cart-delivery-notice hidden mb-3 px-3 py-2 bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold rounded-lg flex items-center gap-2">
                  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                  <span class="cart-delivery-notice-text"></span>
                </div>

                <!-- Time Slot Dropdown Container -->
