              <button type="button" onclick="if(typeof window.saveCartDeliveryDetailsToStorage==='function'){window.saveCartDeliveryDetailsToStorage();} const p=window.location.pathname+window.location.search; if(typeof openLoginModal==='function'){openLoginModal(p);}else{window.location.href='/account/login?return_to='+encodeURIComponent(p);}" class="px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl transition-all shadow-xs text-xs shrink-0">
