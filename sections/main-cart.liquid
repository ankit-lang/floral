{% style %}
  .cart-item-enter {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .cart-item-stagger-1 { animation-delay: 0.1s; }
  .cart-item-stagger-2 { animation-delay: 0.2s; }
  .cart-item-stagger-3 { animation-delay: 0.3s; }
  .cart-item-stagger-4 { animation-delay: 0.4s; }
  .cart-item-stagger-5 { animation-delay: 0.5s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .glass-panel {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  }

  .btn-gradient {
    background-size: 200% auto;
    transition: 0.5s;
  }
  .btn-gradient:hover {
    background-position: right center;
  }
{% endstyle %}

<section id="cart-container" class="max-w-7xl mx-auto px-4 py-12 md:py-20 relative">
  <!-- Decorative background blobs -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none opacity-30">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob"></div>
    <div class="absolute top-1/4 -right-24 w-96 h-96 bg-pink-300/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000"></div>
  </div>

  <div class="flex flex-col md:flex-row items-baseline justify-between mb-12 cart-item-enter">
    <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 tracking-tight">Your Cart</h1>
    <a href="/collections/all" class="mt-4 md:mt-0 text-sm font-semibold text-primary hover:text-primary-600 transition-all duration-300 flex items-center gap-2 group">
      <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Continue Shopping
    </a>
  </div>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Cart Items List -->
      <div class="lg:col-span-8 space-y-6">
        <div class="hidden md:grid grid-cols-12 gap-6 text-xs font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-4 cart-item-enter">
          <div class="col-span-6">Product</div>
          <div class="col-span-3 text-center">Quantity</div>
          <div class="col-span-3 text-right">Total</div>
        </div>

        {% for item in cart.items %}
          {%- assign item_tags_lc = item.product.tags | join: ',' | downcase -%}
          <div class="glass-panel rounded-2xl p-4 md:p-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center cart-item-enter cart-item-stagger-{{ forloop.index | at_most: 5 }} hover:-translate-y-1 transition-all duration-300 hover:shadow-xl cart-country-item"
            {% if item.product.handle == 'peak-season-delivery-surcharge' %}style="display: none !important;"{% endif %}
            data-line="{{ forloop.index }}"
            data-variant-id="{{ item.variant_id }}"
            data-product-title="{{ item.product.title | escape }}"
            data-handle="{{ item.product.handle }}"
            data-tags="{{ item.product.tags | join: ',' | escape }}">
            
            <!-- Product Info -->
            <div class="col-span-1 md:col-span-6 flex items-center gap-6">
              <a href="{{ item.url }}" class="w-28 h-28 rounded-2xl overflow-hidden bg-gray-50 flex-shrink-0 shadow-inner group relative">
                {% if item.image %}
                  <img src="{{ item.image | img_url: 'medium' }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                {% else %}
                  <span class="w-full h-full flex items-center justify-center text-3xl"></span>
                {% endif %}
                <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-2xl pointer-events-none"></div>
              </a>
              <div>
                <a href="{{ item.url }}" class="text-lg font-bold text-gray-900 hover:text-primary transition-colors block mb-1 leading-tight">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-sm text-gray-500 mb-3">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="text-base font-semibold text-gray-900" data-base-price="{{ item.price }}">{{ item.price | money }}</p>
                {% if item.properties.size > 0 %}
                  <div class="mt-2 space-y-1 text-xs text-gray-600 bg-gray-50/80 p-2 rounded-lg border border-gray-100">
                    {% for property in item.properties %}
                      {% assign first_char = property.first | slice: 0 %}
                      {% unless property.last == blank or first_char == '_' %}
                        <p class="flex items-center gap-1.5">
                          <span class="font-bold text-gray-700">{{ property.first }}:</span>
                          <span>{{ property.last }}</span>
                        </p>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
                <!-- Cart Expiry Countdown Badge -->
                <span data-cart-expiry-variant="{{ item.variant_id }}"
                  class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-600 bg-amber-50 border border-amber-200 rounded-full px-2 py-0.5 mt-1"
                  style="display:none;">
                </span>
              </div>
            </div>

            <!-- Quantity -->
            <div class="col-span-1 md:col-span-3 flex items-center md:justify-center">
              {% if item.product.handle == 'peak-season-delivery-surcharge' %}
                <span class="text-sm font-bold text-gray-500 bg-gray-50 px-3 py-1 rounded-full border border-gray-100">Fee applied</span>
                <input type="hidden" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}">
              {% else %}
                <div class="flex items-center bg-gray-50/80 rounded-full h-12 w-36 border border-gray-100 p-1">
                  <button type="button" data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | minus: 1 }}" class="js-qty-btn w-10 h-10 rounded-full flex items-center justify-center text-gray-500 hover:bg-white hover:text-primary hover:shadow-sm transition-all">-</button>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="w-full h-full text-center text-base font-bold text-gray-900 focus:outline-none bg-transparent appearance-none" readonly>
                  <button type="button" data-line="{{ forloop.index }}" data-quantity="{{ item.quantity | plus: 1 }}" class="js-qty-btn w-10 h-10 rounded-full flex items-center justify-center text-gray-500 hover:bg-white hover:text-primary hover:shadow-sm transition-all">+</button>
                </div>
              {% endif %}
            </div>

            <!-- Total & Remove -->
            <div class="col-span-1 md:col-span-3 flex items-center justify-between md:justify-end">
              <span class="text-base font-bold text-gray-900 md:hidden">Total: </span>
              <span class="text-lg font-bold text-gray-900 mr-6" data-base-price="{{ item.final_line_price }}">{{ item.final_line_price | money }}</span>
              {% if item.product.handle == 'peak-season-delivery-surcharge' %}
                <div class="w-10 h-10"></div>
              {% else %}
                <button type="button" data-line="{{ forloop.index }}" data-quantity="0" class="js-qty-btn w-10 h-10 rounded-full bg-red-50/50 flex items-center justify-center text-gray-400 hover:bg-red-500 hover:text-white hover:shadow-md transition-all group" title="Remove Item">
                  <svg class="w-4 h-4 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
              {% endif %}
            </div>
            
          </div>
        {% endfor %}

        {%- assign max_cart_advance_days = 0 -%}
        {%- assign max_cart_no_sunday = false -%}
        {%- assign max_cart_no_weekend = false -%}
        {%- for item in cart.items -%}
          {%- assign i_desc = item.product.description | strip_html | downcase -%}
          {%- if i_desc contains 'advance' or i_desc contains 'process' -%}
            {%- if i_desc contains '4-5 advance' or i_desc contains '4 to 5 advance' or i_desc contains '4-5 days advance' or i_desc contains '5 days advance' or i_desc contains '5-day advance' -%}
              {%- assign max_cart_advance_days = 5 -%}
            {%- elsif i_desc contains '3-4 advance' or i_desc contains '3 to 4 advance' or i_desc contains '4 days advance' or i_desc contains '4-day advance' -%}
              {%- if max_cart_advance_days < 4 -%}{%- assign max_cart_advance_days = 4 -%}{%- endif -%}
            {%- elsif i_desc contains '2-3 advance' or i_desc contains '2 to 3 advance' or i_desc contains '2-3 days advance' or i_desc contains '3 days advance' or i_desc contains '3-day advance' or i_desc contains '3 days process' -%}
              {%- if max_cart_advance_days < 2 -%}{%- assign max_cart_advance_days = 2 -%}{%- endif -%}
            {%- elsif i_desc contains '1-2 advance' or i_desc contains '1 to 2 advance' or i_desc contains '2 days advance' or i_desc contains '2-day advance' or i_desc contains '2 days process' -%}
              {%- if max_cart_advance_days < 2 -%}{%- assign max_cart_advance_days = 2 -%}{%- endif -%}
            {%- elsif i_desc contains '1 day advance' or i_desc contains '1-day advance' or i_desc contains '1 day process' -%}
              {%- if max_cart_advance_days < 1 -%}{%- assign max_cart_advance_days = 1 -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- assign has_choc = false -%}
          {%- assign has_gifting = false -%}
          {%- assign is_exotic = false -%}
          {%- for tag in item.product.tags -%}
            {%- assign tag_lc = tag | downcase | strip -%}
            {%- if tag_lc == 'chocolate' or tag_lc == 'chocolates' -%}
              {%- assign has_choc = true -%}
            {%- endif -%}
            {%- if tag_lc == 'gifting' -%}
              {%- assign has_gifting = true -%}
            {%- endif -%}
            {%- if tag_lc contains 'exotic' -%}
              {%- assign is_exotic = true -%}
            {%- endif -%}
            {%- if tag_lc == '2-days-advance' or tag_lc == '2 days advance' or tag_lc == '2-advance' -%}
              {%- if max_cart_advance_days < 2 -%}{%- assign max_cart_advance_days = 2 -%}{%- endif -%}
            {%- elsif tag_lc == '3-days-advance' or tag_lc == '3 days advance' or tag_lc == '3-advance' -%}
              {%- if max_cart_advance_days < 3 -%}{%- assign max_cart_advance_days = 3 -%}{%- endif -%}
            {%- elsif tag_lc == '4-days-advance' or tag_lc == '4 days advance' or tag_lc == '4-advance' -%}
              {%- if max_cart_advance_days < 4 -%}{%- assign max_cart_advance_days = 4 -%}{%- endif -%}
            {%- elsif tag_lc == 'usa' or tag_lc == 'us' or tag_lc == 'united states' or tag_lc == 'london' or tag_lc == 'uk' or tag_lc == 'united kingdom' -%}
              {%- assign max_cart_no_weekend = true -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_choc and has_gifting -%}
            {%- if max_cart_advance_days < 1 -%}{%- assign max_cart_advance_days = 1 -%}{%- endif -%}
          {%- endif -%}
          {%- if is_exotic -%}
            {%- if max_cart_advance_days < 2 -%}{%- assign max_cart_advance_days = 2 -%}{%- endif -%}
          {%- endif -%}

          {%- if i_desc contains 'sunday delivery not possible' or i_desc contains 'sundays non-delivery' or i_desc contains 'no sunday' -%}
            {%- assign max_cart_no_sunday = true -%}
          {%- endif -%}
        {%- endfor -%}

        {% assign first_item = cart.items.first %}
        <div class="glass-panel rounded-2xl p-6 md:p-8 mt-6 delivery-address-form" data-line="all" data-existing-properties="{{ first_item.properties | json | escape }}" data-advance-days="{{ max_cart_advance_days }}" data-no-sunday="{{ max_cart_no_sunday }}" data-no-weekend="{{ max_cart_no_weekend }}">
          <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3">
            <h3 class="text-base font-bold text-gray-900 uppercase tracking-wider flex items-center gap-2">
              <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Delivery Address & Customization
            </h3>
            <span class="text-xs text-gray-400 font-medium">Applied to all items in cart</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-12 gap-4 address-fields-container">
            <div class="md:col-span-2">
              <select class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" data-prop="Delivery_Title">
                <option value="Mr." {% if first_item.properties.Delivery_Title == 'Mr.' %}selected{% endif %}>Mr.</option>
                <option value="Mrs." {% if first_item.properties.Delivery_Title == 'Mrs.' %}selected{% endif %}>Mrs.</option>
                <option value="Ms." {% if first_item.properties.Delivery_Title == 'Ms.' %}selected{% endif %}>Ms.</option>
              </select>
            </div>
            <div class="md:col-span-5">
              <input type="text" placeholder="First Name *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_FirstName" value="{{ cart.attributes.Delivery_FirstName | default: first_item.properties.Delivery_FirstName | escape }}">
            </div>
            <div class="md:col-span-5">
              <input type="text" placeholder="Last Name *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_LastName" value="{{ cart.attributes.Delivery_LastName | default: first_item.properties.Delivery_LastName | escape }}">
            </div>

            <div class="md:col-span-12">
              <input type="text" placeholder="Address *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_Address" value="{{ cart.attributes.Delivery_Address | default: first_item.properties.Delivery_Address | default: first_item.properties['_Exact Location'] | escape }}">
            </div>

            <div class="md:col-span-12">
              <textarea placeholder="Gift Message *" required class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" rows="2" data-prop="Delivery_GiftMessage">{{ cart.attributes.Delivery_GiftMessage | default: first_item.properties.Delivery_GiftMessage | escape }}</textarea>
            </div>

            <div class="md:col-span-4">
              <input type="text" placeholder="Landmark *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_Landmark" value="{{ cart.attributes.Delivery_Landmark | default: first_item.properties.Delivery_Landmark | escape }}">
            </div>
            <div class="md:col-span-3">
              <input type="text" placeholder="City *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_City" value="{{ cart.attributes.Delivery_City | default: first_item.properties.Delivery_City | default: first_item.properties._City | escape }}">
            </div>
            <div class="md:col-span-3">
              <input type="text" placeholder="State *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_State" value="{{ cart.attributes.Delivery_State | default: first_item.properties.Delivery_State | escape }}">
            </div>
            <div class="md:col-span-2">
              <input type="text" placeholder="Postcode *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_Postcode" value="{{ cart.attributes.Delivery_Postcode | default: first_item.properties.Delivery_Postcode | default: first_item.properties['_Pincode'] | escape }}">
            </div>
            <div class="md:col-span-4">
              <input type="text" placeholder="Country *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_Country" value="{{ cart.attributes.Delivery_Country | default: first_item.properties.Delivery_Country | escape }}">
            </div>

            <div class="md:col-span-4">
              <div class="phone-field-group">
                <div class="relative flex items-center shadow-2xs rounded-md">
                  <div class="phone-dial-badge relative shrink-0 border border-r-0 border-gray-200 rounded-l-md bg-gray-100 transition-colors">
                    <div class="flex items-center gap-1 px-2.5 py-2 text-xs font-bold text-gray-700 pointer-events-none">
                      <span class="flag-icon">🇬🇧</span>
                      <span class="dial-code">+44</span>
                    </div>
                    <select disabled class="phone-country-select absolute inset-0 w-full h-full opacity-0 pointer-events-none">
                      <option value="GB">🇬🇧 UK (+44)</option>
                      <option value="IN">🇮🇳 India (+91)</option>
                      <option value="US">🇺🇸 USA (+1)</option>
                      <option value="CA">🇨🇦 Canada (+1)</option>
                      <option value="AE">🇦🇪 UAE (+971)</option>
                      <option value="AU">🇦🇺 Australia (+61)</option>
                      <option value="SG">🇸🇬 Singapore (+65)</option>
                      <option value="DE">🇩🇪 Germany (+49)</option>
                    </select>
                  </div>
                  <input type="tel" placeholder="Mobile No *" class="w-full rounded-r-md rounded-l-none border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field tel-input" required data-prop="Delivery_Mobile" value="{{ cart.attributes.Delivery_Mobile | default: first_item.properties.Delivery_Mobile | escape }}" inputmode="numeric">
                </div>
              </div>
            </div>
            <div class="md:col-span-4">
              <div class="phone-field-group">
                <div class="relative flex items-center shadow-2xs rounded-md">
                  <div class="phone-dial-badge relative shrink-0 border border-r-0 border-gray-200 rounded-l-md bg-gray-100 transition-colors">
                    <div class="flex items-center gap-1 px-2.5 py-2 text-xs font-bold text-gray-700 pointer-events-none">
                      <span class="flag-icon">🇬🇧</span>
                      <span class="dial-code">+44</span>
                    </div>
                    <select disabled class="phone-country-select absolute inset-0 w-full h-full opacity-0 pointer-events-none">
                      <option value="GB">🇬🇧 UK (+44)</option>
                      <option value="IN">🇮🇳 India (+91)</option>
                      <option value="US">🇺🇸 USA (+1)</option>
                      <option value="CA">🇨🇦 Canada (+1)</option>
                      <option value="AE">🇦🇪 UAE (+971)</option>
                      <option value="AU">🇦🇺 Australia (+61)</option>
                      <option value="SG">🇸🇬 Singapore (+65)</option>
                      <option value="DE">🇩🇪 Germany (+49)</option>
                    </select>
                  </div>
                  <input type="tel" placeholder="Alternate No" class="w-full rounded-r-md rounded-l-none border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field tel-input" data-prop="Delivery_AlternateMobile" value="{{ cart.attributes.Delivery_AlternateMobile | default: first_item.properties.Delivery_AlternateMobile | escape }}" inputmode="numeric">
                </div>
              </div>
            </div>
            <div class="md:col-span-4 flex items-center">
              <label class="flex items-center gap-2 text-sm text-gray-600 cursor-pointer">
                <input type="checkbox" value="Yes" class="addr-field rounded border-gray-300 text-primary focus:ring-primary" data-prop="Delivery_Contactless" {% assign c_val = cart.attributes.Delivery_Contactless | default: first_item.properties.Delivery_Contactless %}{% if c_val == 'Yes' %}checked{% endif %}>
                Opt for Contact less Delivery
              </label>
            </div>

            <!-- Delivery Date & Delivery Time -->
            {% assign p_date = cart.attributes['Delivery Date'] | default: first_item.properties['Delivery Date'] | default: first_item.properties['Delivery_Date'] %}
            {% assign p_time = cart.attributes['Delivery Time'] | default: first_item.properties['Delivery Time'] | default: first_item.properties['Delivery_Time'] %}
            <div class="md:col-span-12 mt-2 cart-date-picker-block" data-line="all">

              <div class="flex items-center justify-between mb-3">
                <label class="text-xs font-bold text-gray-500 uppercase tracking-widest">Date and Time of Delivery</label>
                <span class="delivery-countdown text-xs font-semibold text-secondary"></span>
              </div>

              <!-- Quick-Select Date Tabs -->
              <div class="flex gap-2 mb-4 delivery-date-tabs">
                <button type="button"
                  class="date-tab date-tab-today flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                  data-date="today">
                  <span class="block font-bold today-label">Today</span>
                  <span class="block text-[10px] opacity-90 today-date-display"></span>
                </button>
                <button type="button"
                  class="date-tab date-tab-tomorrow flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                  data-date="tomorrow">
                  <span class="block font-bold">Tomorrow</span>
                  <span class="block text-[10px] text-gray-400 tomorrow-date-display"></span>
                </button>
                <button type="button"
                  class="date-tab date-tab-dayafter flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                  data-date="dayafter">
                  <span class="block font-bold">Day After</span>
                  <span class="block text-[10px] text-gray-400 dayafter-date-display"></span>
                </button>
                <button type="button"
                  class="date-tab custom-date-btn flex-1 py-2.5 px-2 rounded-lg bg-white border border-gray-200 text-gray-700 text-center text-xs font-bold transition-all hover:border-primary hover:shadow-md cursor-pointer"
                  title="Choose your own date">
                  <span class="block font-bold custom-date-label">Pick Date</span>
                  <span class="block text-[10px] text-gray-400 custom-date-display"></span>
                </button>
              </div>

              <!-- Hidden date value -->
              <input type="hidden" class="addr-field cart-date-input" required data-prop="Delivery Date" value="{{ p_date | escape }}">
              <input type="text" class="custom-calendar-picker sr-only" tabindex="-1">

              <!-- Time Slot Info Notice -->
              <div class="cart-delivery-notice hidden mb-3 px-3 py-2 bg-blue-50 border border-blue-200 text-blue-700 text-xs font-semibold rounded-lg flex items-center gap-2">
                <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                <span class="cart-delivery-notice-text"></span>
              </div>

              <!-- Time Slot Dropdown Container -->
              <div class="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 bg-white transition-all focus-within:ring-2 focus-within:ring-primary/20 focus-within:border-primary">
                <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
