          window.lockCartLocationFields();
        }
      }
    });

    const isCustomerLoggedIn = {% if customer %}true{% else %}false{% endif %};

    // Reusable delivery address form validator
    function validateCartFormFields() {
      if (typeof window.saveCartDeliveryDetailsToStorage === 'function') {
        window.saveCartDeliveryDetailsToStorage();
      }

      // Flush live cart attributes to server even for guests
      syncLiveCartAttributes();
      try {
        const firstForm = document.querySelector('.delivery-address-form');
        if (firstForm) {
          const getV = (prop) => (firstForm.querySelector(`[data-prop="${prop}"]`)?.value || '').trim();
          const rawCountry = getV('Delivery_Country');
          const iso = (typeof normaliseCountryToIso === 'function' ? normaliseCountryToIso(rawCountry) : (rawCountry || 'IN')).toUpperCase();
          const full = (iso === 'IN' ? 'India' : (rawCountry || iso));
          const attrsToSave = {
            'Delivery_Country': iso,
            'Delivery Country': full,
            'Delivery_State': getV('Delivery_State'),
            'Delivery State': getV('Delivery_State'),
            'Delivery_City': getV('Delivery_City'),
            'Delivery City': getV('Delivery_City'),
            'City': getV('Delivery_City'),
            'Delivery_Postcode': getV('Delivery_Postcode'),
            'Delivery Postcode': getV('Delivery_Postcode'),
            'Delivery_Title': getV('Delivery_Title'),
            'Delivery_FirstName': getV('Delivery_FirstName'),
            'Delivery_LastName': getV('Delivery_LastName'),
            'Delivery_HouseNo': getV('Delivery_HouseNo'),
            'Delivery_Landmark_IN': getV('Delivery_Landmark_IN'),
            'Delivery_Mobile': getV('Delivery_Mobile'),
            'Delivery_GiftMessage': getV('Delivery_GiftMessage'),
            'Sender_Name': getV('Sender_Name'),
            'Sender_Mobile': getV('Sender_Mobile'),
            'Sender_Email': getV('Sender_Email')
          };
          const fName = getV('Delivery_FirstName');
          const lName = getV('Delivery_LastName');
          const title = getV('Delivery_Title');
          const mob = getV('Delivery_Mobile');
          const gMsg = getV('Delivery_GiftMessage');
          const sName = getV('Sender_Name');
          const sMob = getV('Sender_Mobile');
          const sMail = getV('Sender_Email');
          if (fName || lName) attrsToSave['Recipient Name'] = `${title} ${fName} ${lName}`.trim();
          if (mob) attrsToSave['Recipient Phone'] = mob;
          if (gMsg) attrsToSave['Gift Message'] = gMsg;
          if (sName) attrsToSave['Sender Name'] = sName;
          if (sMob) attrsToSave['Sender Phone'] = sMob;
          if (sMail) attrsToSave['Sender Email'] = sMail;

          fetch('/cart/update.js', {
            method: 'POST',
            keepalive: true,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ attributes: attrsToSave })
          }).catch(() => {});
        }
      } catch(e) {}

      if (!isCustomerLoggedIn) {
        const currentUrl = window.location.pathname + window.location.search;
        if (typeof window.openLoginModal === 'function') {
          window.openLoginModal(currentUrl);
        } else {
          window.location.href = `/customer_authentication/login?return_to=${encodeURIComponent(currentUrl)}`;
        }
        return false;
      }

      const mode = localStorage.getItem('delivery_mode') || 'india';
      const uCountryCode = localStorage.getItem('user_country_code') || 'US';
      const forms = document.querySelectorAll('.delivery-address-form');
      let isValid = true;
      let firstInvalidField = null;
      let invalidPincode = false;

      // 1. Sync primary visible form (forms[0]) to all other hidden forms for multi-item carts
      const firstForm = forms[0];
      if (firstForm && forms.length > 1) {
        const firstFields = firstForm.querySelectorAll('.addr-field');
        forms.forEach((form, idx) => {
          if (idx === 0) return;
          const currFields = form.querySelectorAll('.addr-field');
          currFields.forEach((field, i) => {
            if (firstFields[i]) {
              if (form.dataset.ownDate === 'true' && (field.dataset.prop === 'Delivery Date' || field.dataset.prop === 'Delivery Time')) return;
              if (field.type === 'checkbox') field.checked = firstFields[i].checked;
              else field.value = firstFields[i].value;
            }
          });
        });
      }

      forms.forEach((form, idx) => {
        // Only validate the visible unified form (forms[0])
        if (form.style.display === 'none' || idx > 0) {
          return;
        }

        // Auto-handle single name or full name in First Name
        const fNameInput = form.querySelector('[data-prop="Delivery_FirstName"]');
        const lNameInput = form.querySelector('[data-prop="Delivery_LastName"]');
        if (fNameInput) {
          const fVal = fNameInput.value.trim();
          const lVal = lNameInput ? lNameInput.value.trim() : '';
          if (fVal && !lVal) {
            const parts = fVal.split(/\s+/);
            if (parts.length > 1) {
              fNameInput.value = parts[0];
              if (lNameInput) lNameInput.value = parts.slice(1).join(' ');
            } else if (lNameInput) {
              lNameInput.value = fVal;
            }
          }
        }

        const allFields = form.querySelectorAll('.addr-field');
        allFields.forEach(field => {
          let fieldValid = true;
          const val = field.value.trim();
          const isRequired = field.hasAttribute('required');
          
          let isDummyText = false;
          if (val) {
            const hasRepeatedChars = /(.)\1{3,}/.test(val);
            const hasConsecutiveConsonants = /[bcdfghjklmnpqrstvwxyz]{6,}/i.test(val);
            const isKeyboardSmash = /12345|asdf|qwer|zxcv/i.test(val);
            isDummyText = hasRepeatedChars || hasConsecutiveConsonants || isKeyboardSmash;
          }
          
          if (isRequired && !val) {
            // If Last Name is empty but First Name is valid, allow single name
            if (field.dataset && field.dataset.prop === 'Delivery_LastName') {
              const fNameVal = (fNameInput ? fNameInput.value.trim() : '');
              if (fNameVal.length >= 2) {
                fieldValid = true;
                field.value = fNameVal;
              } else {
                fieldValid = false;
              }
            } else {
              fieldValid = false;
            }
          } else if (val) {
            const prop = field.dataset ? field.dataset.prop : '';
            
            if (prop === 'Delivery_FirstName' || prop === 'Delivery_LastName') {
              if (val.length < 2 || !/^[a-zA-Z\s\.'\-]+$/.test(val) || isDummyText) fieldValid = false;
            } else if (prop === 'Delivery_Address') {
              if (val.length < 8 || isDummyText) fieldValid = false;
            } else if (prop === 'Delivery_Landmark' || prop === 'Delivery_Landmark_IN') {
              // The "Search Address Automatically..." field or actual landmark
              if (val.length > 0 && (val.length < 4 || isDummyText)) fieldValid = false;
            } else if (prop === 'Sender_Name') {
              if (val.length < 2 || !/^[a-zA-Z\s\.'\-]+$/.test(val) || isDummyText) fieldValid = false;
            }
            
            // Validate Postcode
            if (prop === 'Delivery_Postcode') {
              if (mode === 'india') {
                if (val.length !== 6 || isNaN(val)) { invalidPincode = true; fieldValid = false; }
              } else if (mode === 'international' && uCountryCode === 'US') {
                if (!/^\d{5}$/.test(val)) { invalidPincode = true; fieldValid = false; }
              }
            }
          }

          let errorMsgEl = field.parentNode.querySelector('.field-error-msg');
          if (!errorMsgEl) {
            errorMsgEl = document.createElement('div');
            errorMsgEl.className = 'field-error-msg text-[11px] text-red-500 font-bold mt-1 hidden';
            field.parentNode.appendChild(errorMsgEl);
          }

          if (!fieldValid) {
            field.classList.add('border-red-500', 'ring-2', 'ring-red-500');
            field.classList.remove('border-gray-200', 'focus:border-primary', 'focus:ring-primary');
            
            let errText = "Invalid entry";
            if (isRequired && !val) errText = "This field is required";
            else if (typeof isDummyText !== 'undefined' && isDummyText) errText = "Random/dummy text is not allowed";
            else if (invalidPincode && prop === 'Delivery_Postcode') errText = "Invalid Postal Code";
            else if (val.length < 2) errText = "Entry is too short";
            
            errorMsgEl.textContent = errText;
            errorMsgEl.classList.remove('hidden');
            
            isValid = false;
            if (!firstInvalidField) firstInvalidField = field;
          } else {
            field.classList.remove('border-red-500', 'ring-2', 'ring-red-500');
            field.classList.add('border-gray-200', 'focus:border-primary', 'focus:ring-primary');
            errorMsgEl.classList.add('hidden');
          }
        });

        const telFields = form.querySelectorAll('input[type="tel"]');
        telFields.forEach(field => {
          const isPhoneValid = validateSinglePhoneField(field);
          if (!isPhoneValid) {
            isValid = false;
            if (!firstInvalidField) firstInvalidField = field;
          }
        });

        const emailFields = form.querySelectorAll('input[type="email"]');
        emailFields.forEach(field => {
          const isEmailValid = validateSingleEmailField(field);
          if (!isEmailValid) {
            isValid = false;
            if (!firstInvalidField) firstInvalidField = field;
          }
        });
      });

      // Items with their own delivery date box must have a date chosen
      for (const f of forms) {
        if (f.dataset.ownDate !== 'true') continue;
        const d = f.querySelector('.cart-date-input');
        if (d && !(d.value || '').trim()) {
          const tabs = f.querySelector('.delivery-date-tabs') || f;
          alert(`Please select a delivery date for ${window.cartDateCategoryLabel(f)}.`);
          tabs.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return false;
        }
      }

      if (!isValid) {
        alert('Please fill out all required fields correctly.\n\n• Names must contain only valid letters.\n• Address/Landmark must not be random dummy text.\n• Phone numbers and emails must be valid.');
        if (firstInvalidField) {
          firstInvalidField.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalidField.focus();
        }
        return false;
      }
      return true;
    }

    // Real-time validation
    function validateFieldOnEvent(e) {
      if (e.target && e.target.classList && e.target.classList.contains('addr-field')) {
        const field = e.target;
        const val = field.value.trim();
        const isRequired = field.hasAttribute('required');
        let fieldValid = true;
        let isDummyText = false;
        
        if (val) {
          const hasRepeatedChars = /(.)\1{3,}/.test(val);
          const hasConsecutiveConsonants = /[bcdfghjklmnpqrstvwxyz]{6,}/i.test(val);
          const isKeyboardSmash = /12345|asdf|qwer|zxcv/i.test(val);
          isDummyText = hasRepeatedChars || hasConsecutiveConsonants || isKeyboardSmash;
        }

        if (isRequired && !val) {
          fieldValid = false;
        } else if (val) {
          const prop = field.dataset ? field.dataset.prop : '';

          if (prop === 'Delivery_FirstName' || prop === 'Delivery_LastName' || prop === 'Sender_Name') {
            if (val.length < 2 || !/^[a-zA-Z\s\.'\-]+$/.test(val) || isDummyText) fieldValid = false;
          } else if (prop === 'Delivery_Address') {
            if (val.length < 8 || isDummyText) fieldValid = false;
          } else if (prop === 'Delivery_Landmark' || prop === 'Delivery_Landmark_IN') {
            if (val.length > 0 && (val.length < 4 || isDummyText)) fieldValid = false;
          }
          
          if (field.type === 'tel') fieldValid = validateSinglePhoneField(field);
          if (field.type === 'email') fieldValid = validateSingleEmailField(field);
        }

        let errorMsgEl = field.parentNode.querySelector('.field-error-msg');
        if (!errorMsgEl) {
          errorMsgEl = document.createElement('div');
          errorMsgEl.className = 'field-error-msg text-[11px] text-red-500 font-bold mt-1 hidden';
          field.parentNode.appendChild(errorMsgEl);
        }

        if (!fieldValid) {
          field.classList.add('border-red-500', 'ring-2', 'ring-red-500');
          field.classList.remove('border-gray-200', 'focus:border-primary', 'focus:ring-primary');
          
          let errText = "Invalid entry";
          if (isRequired && !val) errText = "This field is required";
          else if (isDummyText) errText = "Random/dummy text is not allowed";
          else if (val.length < 2) errText = "Entry is too short";
          
          errorMsgEl.textContent = errText;
          errorMsgEl.classList.remove('hidden');
        } else {
          field.classList.remove('border-red-500', 'ring-2', 'ring-red-500');
          field.classList.add('border-gray-200', 'focus:border-primary', 'focus:ring-primary');
          errorMsgEl.classList.add('hidden');
        }
      }
    }
    
    document.addEventListener('blur', validateFieldOnEvent, true);
    document.addEventListener('input', validateFieldOnEvent, true);

    // Capture phase click interceptor for ALL checkout buttons (including Scala Discount button)
