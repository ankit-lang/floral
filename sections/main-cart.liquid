          <div class="flex items-center justify-center gap-2 text-xs text-gray-500 font-medium">
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
            Secure 256-bit Encrypted Checkout
          </div>

         
        </div>
      </div>
      
    </form>
  {% else %}
