      <a href="/collections/all" class="inline-flex items-center gap-3 bg-gradient-to-r from-gray-900 to-gray-800 text-white px-10 py-4 rounded-full font-bold hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        Explore Collection
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
