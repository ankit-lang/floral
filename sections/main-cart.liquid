    // ---- Date & Time Picker Logic (Matching Product Page Functionality) ----
    const PREP_HOURS     = 3;   // 3-hour processing time
    const MIDNIGHT_HOURS = 6;   // 6-hour advance notice for midnight delivery
    const SAMEDAY_CUTOFF = 16;  // 4 PM same-day cutoff hour

    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    const days   = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];

    function formatTabDate(d) {
      return days[d.getDay()] + ', ' + months[d.getMonth()] + ' ' + d.getDate();
    }
    function formatISODate(d) {
      return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
    }

    function normalizeToISODate(dateVal) {
      if (!dateVal) return '';
      dateVal = dateVal.trim();
      if (/^\d{4}-\d{2}-\d{2}$/.test(dateVal)) return dateVal;

      const parts = dateVal.split(/[\/\-\.]/);
      if (parts.length === 3) {
        let p1 = parseInt(parts[0], 10);
        let p2 = parseInt(parts[1], 10);
        let p3 = parseInt(parts[2], 10);

        if (p3 > 1000) {
          let day = p1, month = p2, year = p3;
          if (p1 <= 12 && p2 > 12) {
            month = p1; day = p2;
          }
          return year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0');
        } else if (p1 > 1000) {
          return p1 + '-' + String(p2).padStart(2, '0') + '-' + String(p3).padStart(2, '0');
        }
      }

      const d = new Date(dateVal);
      if (!isNaN(d.getTime())) {
        return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
      }
      return dateVal;
    }

    // ---- Helper: UK & London Location Classifier for Cart ----
    function checkUkDeliveryLocation(cartFormEl) {
      const mode = localStorage.getItem('delivery_mode') || 'india';
      let country = (localStorage.getItem('user_country') || 'India').toLowerCase().trim();
      let countryCode = (localStorage.getItem('user_country_code') || 'IN').toLowerCase().trim();
      let locality = (localStorage.getItem('user_intl_locality') || '').toLowerCase().trim();
      let city = (localStorage.getItem('user_city') || '').toLowerCase().trim();
      let zip = (localStorage.getItem('user_intl_zip') || '').toLowerCase().trim();

      if (cartFormEl) {
        const cityInput = cartFormEl.querySelector('[data-prop="Delivery_City"]');
        if (cityInput && cityInput.value && cityInput.value.trim()) city = cityInput.value.toLowerCase().trim();

        const postcodeInput = cartFormEl.querySelector('[data-prop="Delivery_Postcode"]');
        if (postcodeInput && postcodeInput.value && postcodeInput.value.trim()) zip = postcodeInput.value.toLowerCase().trim();

        const countryInput = cartFormEl.querySelector('[data-prop="Delivery_Country"]');
        if (countryInput && countryInput.value && countryInput.value.trim()) country = countryInput.value.toLowerCase().trim();

        const landmarkInput = cartFormEl.querySelector('[data-prop="Delivery_Landmark"]');
        if (landmarkInput && landmarkInput.value && landmarkInput.value.trim()) locality = landmarkInput.value.toLowerCase().trim();
      }

      const isIntl = (mode === 'international') && (country !== 'india' && country !== 'in');
      const isUk = isIntl && (
        country.includes('uk') ||
        country.includes('united kingdom') ||
        country.includes('britain') ||
        country.includes('london') ||
        countryCode === 'gb' ||
        countryCode === 'uk'
      );

      if (!isUk) {
        return { isUk: false, isLondon: false, isOtherUk: false };
      }

      const nonLondonCities = [
        'manchester', 'birmingham', 'edinburgh', 'glasgow', 'bristol', 
        'leeds', 'liverpool', 'sheffield', 'newcastle', 'nottingham', 
        'cardiff', 'belfast', 'southampton', 'oxford', 'cambridge', 
        'york', 'brighton', 'leicester', 'coventry', 'hull', 'bradford'
      ];

      const isExplicitNonLondon = nonLondonCities.some(function(c) {
        return locality.includes(c) || city.includes(c);
      });

      const isLondonPostcode = /^(e|ec|n|nw|se|sw|w|wc)\d/i.test(zip);

      const isLondonKeyword = 
        locality.includes('london') || 
        city.includes('london') ||
        country.includes('london') ||
        locality.includes('westminster') ||
        locality.includes('belgravia') ||
        locality.includes('chelsea') ||
        locality.includes('kensington') ||
        locality.includes('mayfair') ||
        locality.includes('soho') ||
        locality.includes('camden') ||
        locality.includes('islington') ||
        locality.includes('greenwich') ||
        locality.includes('hackney') ||
        locality.includes('canary wharf') ||
        locality.includes('farringdon') ||
        locality.includes('barbican') ||
        city.includes('westminster') ||
        city.includes('kensington');

      let isLondon = false;
      if (isExplicitNonLondon) {
        isLondon = false;
      } else if (isLondonKeyword || isLondonPostcode) {
        isLondon = true;
      } else if (!locality && !city && !zip) {
        isLondon = true;
      } else if (zip && !isLondonPostcode) {
        isLondon = false;
      } else {
        isLondon = false;
      }

      return {
        isUk: true,
        isLondon: isLondon,
        isOtherUk: !isLondon
      };
    }

    // ---- Remember dates/times picked on the cart page (per item) so they survive sign-in and page reloads ----
    const CART_PICKS_KEY = 'floral_cart_date_picks';
    const CART_PICKS_TTL = 24 * 60 * 60 * 1000;
    function cartPickKey(block) {
      const form = block && block.closest('.item-delivery-form');
      return form ? (form.dataset.lineKey || '') : '';
    }
    function readCartPicks() {
      try {
        const all = JSON.parse(localStorage.getItem(CART_PICKS_KEY) || '{}') || {};
        const now = Date.now();
        Object.keys(all).forEach(k => { if (!all[k] || now - (all[k].ts || 0) > CART_PICKS_TTL) delete all[k]; });
        return all;
      } catch (e) { return {}; }
    }
    window.getCartPick = function(block) {
      const key = cartPickKey(block);
      return key ? (readCartPicks()[key] || null) : null;
    };
    window.saveCartPick = function(block, patch) {
      const key = cartPickKey(block);
      if (!key) return;
      try {
        const all = readCartPicks();
        all[key] = Object.assign({}, all[key] || {}, patch, { ts: Date.now() });
        localStorage.setItem(CART_PICKS_KEY, JSON.stringify(all));
      } catch (e) {}
      window.scheduleCartLineDateSync();
    };

    // ---- Write each item's delivery date/time onto its cart line right away ----
    // So every route to checkout (slow-network fallback, rewards "Checkout with discount", etc.)
    // carries the date picked on the cart page, not the old product-page date.
    let lineDateSyncTimer = null;
    let lineDateSyncRunning = false;
    let lineDateSyncAgain = false;
    // Number of distinct delivery dates in the cart (used for India per-date shipping)
    window.getCartDeliveryDateCount = function() {
      const dates = new Set();
      document.querySelectorAll('.item-delivery-form').forEach(f => {
        const t = (f.dataset.itemTitle || '').toLowerCase();
        if (t.includes('surcharge') || t.includes('delivery charge')) return;
        const d = typeof window.getLineDeliveryDate === 'function' ? window.getLineDeliveryDate(f) : '';
        if (d) dates.add(d);
      });
      return Math.max(1, dates.size);
    };
    let lastSentDateCount = '{{ cart.attributes["Delivery Dates Count"] | escape }}';
    async function syncDeliveryDateCountAttribute() {
      const count = String(window.getCartDeliveryDateCount());
      if (count === lastSentDateCount) return false;
      try {
        const r = await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'Delivery Dates Count': count } })
        });
        if (r.ok) { lastSentDateCount = count; return true; }
      } catch (e) {}
      return false;
    }

    window.scheduleCartLineDateSync = function() {
      clearTimeout(lineDateSyncTimer);
      lineDateSyncTimer = setTimeout(runCartLineDateSync, 700);
    };
    async function runCartLineDateSync() {
      if (lineDateSyncRunning) { lineDateSyncAgain = true; return; }
      lineDateSyncRunning = true;
      let anyChanged = false;
      try {
        const forms = Array.from(document.querySelectorAll('.item-delivery-form[data-item-key]')).filter(f => {
          const t = (f.dataset.itemTitle || '').toLowerCase();
          return !t.includes('surcharge') && !t.includes('delivery charge');
        });
        const mainForm = document.querySelector('.item-delivery-form[data-line="all"]');
        for (const form of forms) {
          const date = typeof window.getLineDeliveryDate === 'function' ? window.getLineDeliveryDate(form) : '';
          if (!date) continue;
          const timeForm = form.dataset.dateLeader
            ? (document.querySelector(`.item-delivery-form[data-item-line="${form.dataset.dateLeader}"]`) || form)
            : form;
          const timeSrc = timeForm.dataset.ownDate === 'true' ? timeForm : (mainForm || timeForm);
          const timeEl = timeSrc.querySelector('.delivery-time-select');
          const time = timeEl && timeEl.value ? timeEl.value : '';

          let props = {};
          try { props = JSON.parse(form.dataset.existingProperties || '{}') || {}; } catch (e) {}
          if (Array.isArray(props)) props = {};
          const curDate = props['Delivery Date'] || props['Delivery_Date'] || '';
          const curTime = props['Delivery Time'] || props['Delivery_Time'] || '';
          if (curDate === date && (!time || curTime === time)) continue;

          props['Delivery Date'] = date;
          if ('Delivery_Date' in props) props['Delivery_Date'] = date;
          if (time) {
            props['Delivery Time'] = time;
            if ('Delivery_Time' in props) props['Delivery_Time'] = time;
          }

          try {
            const res = await fetch('/cart/change.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ id: form.dataset.itemKey, quantity: parseInt(form.dataset.quantity || '1', 10) || 1, properties: props })
            });
            if (!res.ok) continue;
            const cart = await res.json();
            // The line key changes when its properties change — pick up the new one
            const updated = (cart.items || []).find(it => {
              if (String(it.variant_id) !== String(form.dataset.lineKey)) return false;
              const p = it.properties || {};
              return (p['Delivery Date'] || '') === date && (!time || (p['Delivery Time'] || '') === time);
            });
            if (updated) form.dataset.itemKey = updated.key;
            form.dataset.existingProperties = JSON.stringify(props);
            anyChanged = true;
          } catch (e) {}
        }
      } finally {
        // Shipping is ₹450 per delivery date — keep the date count on the cart and refresh the estimate
        if (await syncDeliveryDateCountAttribute()) anyChanged = true;
        if (anyChanged && typeof window.syncShippingCountry === 'function') window.syncShippingCountry();
        lineDateSyncRunning = false;
        if (lineDateSyncAgain) { lineDateSyncAgain = false; window.scheduleCartLineDateSync(); }
      }
    }

    window.initCartDatePicker = function(block, effectiveAdvance) {
      if (!block) return;

      const now = new Date();
      const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
      const tomorrow = new Date(today); tomorrow.setDate(tomorrow.getDate() + 1);
      const dayAfter = new Date(today); dayAfter.setDate(dayAfter.getDate() + 2);

      const currentHour = now.getHours() + now.getMinutes() / 60;
      const todayAvailable = currentHour < SAMEDAY_CUTOFF;

      const todayIso = formatISODate(today);
      const tomorrowIso = formatISODate(tomorrow);
      const dayAfterIso = formatISODate(dayAfter);

      // Populate Tab Labels
      const todayDisplay = block.querySelector('.today-date-display');
      const tomorrowDisplay = block.querySelector('.tomorrow-date-display');
      const dayAfterDisplay = block.querySelector('.dayafter-date-display');

      if (todayDisplay) todayDisplay.textContent = formatTabDate(today);
      if (tomorrowDisplay) tomorrowDisplay.textContent = formatTabDate(tomorrow);
      if (dayAfterDisplay) dayAfterDisplay.textContent = formatTabDate(dayAfter);

      const tabToday = block.querySelector('.date-tab-today');
      const tabTomorrow = block.querySelector('.date-tab-tomorrow');
      const tabDayAfter = block.querySelector('.date-tab-dayafter');
      const customBtn = block.querySelector('.custom-date-btn');
      const hiddenInput = block.querySelector('.cart-date-input');
      const timeSelect = block.querySelector('.delivery-time-select');
      const noticeBox = block.querySelector('.cart-delivery-notice');
      const noticeText = block.querySelector('.cart-delivery-notice-text');
      const calendarPicker = block.querySelector('.custom-calendar-picker');

      if (!tabToday || !tabTomorrow || !tabDayAfter || !hiddenInput || !timeSelect) return;

      const sundayAllowedCountries = [
        'AE', 'UAE', 'UNITED ARAB EMIRATES', 'DUBAI',
        'ID', 'INDONESIA',
        'SA', 'SAUDI ARABIA', 'SAUDI',
        'QA', 'QATAR',
        'OM', 'OMAN',
        'KW', 'KUWAIT',
        'BH', 'BAHRAIN'
      ];

      const deliveryMode = localStorage.getItem('delivery_mode') || 'india';
      const userCountry = (localStorage.getItem('user_country') || 'India').trim();
      const userCountryCode = (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
      const isIntl = (deliveryMode === 'international') && (userCountry.toUpperCase() !== 'INDIA' && userCountry.toUpperCase() !== 'IN');
      const isSundayAllowed = !isIntl || sundayAllowedCountries.includes(userCountryCode) || sundayAllowedCountries.includes(userCountry.toUpperCase());

      const timeSelectContainer = timeSelect ? timeSelect.closest('.flex.items-center.gap-2.rounded-lg') : null;
      if (isIntl) {
        if (timeSelectContainer) timeSelectContainer.style.display = 'none';
        if (timeSelect) {
          timeSelect.removeAttribute('required');
          timeSelect.value = 'Standard Full Day Delivery';
        }
      } else {
        if (timeSelectContainer) timeSelectContainer.style.display = 'flex';
        if (timeSelect) timeSelect.setAttribute('required', 'required');
      }

      // Check UK location & London SDD product eligibility
      const cartFormEl = block.closest('.delivery-address-form');
      const cartAdvDays = effectiveAdvance !== undefined ? parseInt(effectiveAdvance, 10) : (cartFormEl ? (parseInt(cartFormEl.dataset.advanceDays, 10) || 0) : 0);
      const cartNoSun = cartFormEl ? (cartFormEl.dataset.noSunday === 'true') : false;
      const cartNoWeekend = cartFormEl ? (cartFormEl.dataset.noWeekend === 'true') : false;

      const ukLoc = checkUkDeliveryLocation(cartFormEl);
      const isLondonSddItem = cartFormEl && cartFormEl.dataset.isLondon === 'true' && cartFormEl.dataset.hasSdd === 'true';
      const allowSameDayLondon = isIntl && ukLoc.isUk && ukLoc.isLondon && isLondonSddItem && (cartAdvDays === 0);

      // Handle Cutoff & International Same-Day Disable
      if ((isIntl && !allowSameDayLondon) || !todayAvailable) {
        tabToday.disabled = true;
        tabToday.classList.add('opacity-40', 'cursor-not-allowed');
        if (!todayAvailable) {
          tabToday.title = 'Same-day delivery cutoff (4 PM) has passed';
        } else if (ukLoc.isUk && ukLoc.isOtherUk && isLondonSddItem) {
          tabToday.title = 'Next-day delivery available for this UK location. Same-day delivery is only available within London.';
        } else {
          tabToday.title = 'Same-day delivery is not available for International Shipping';
        }
      } else {
        tabToday.disabled = false;
        tabToday.classList.remove('opacity-40', 'cursor-not-allowed');
        tabToday.title = 'Same-day delivery available for London';
      }



      const allTabs = [tabToday, tabTomorrow, tabDayAfter];

      function activateTab(tab) {
        allTabs.forEach(t => {
          t.classList.remove('active', 'bg-primary', 'text-white');
          t.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-700');
        });
        if (customBtn) {
          customBtn.classList.remove('bg-primary', 'text-white');
          customBtn.classList.add('bg-white', 'border', 'border-gray-200', 'text-gray-500');
        }

        if (tab) {
          tab.classList.add('active', 'bg-primary', 'text-white');
          tab.classList.remove('bg-white', 'border', 'border-gray-200', 'text-gray-700', 'text-gray-500');
        }
      }

      function filterTimeSlots(selectedDateISO) {
        if (isIntl) {
          if (noticeBox) noticeBox.classList.add('hidden');
          return;
        }

        const isToday = (selectedDateISO === todayIso);
        const options = timeSelect.querySelectorAll('option');
        let allDisabled = true;
        let selectedOptionDisabled = false;

        options.forEach(opt => {
          if (!opt.value) return;

          const slotStart = parseInt(opt.dataset.start, 10);
          const isMidnight = opt.dataset.midnight === 'true';

          let disabled = false;

          if (slotStart === 8 || opt.value.indexOf('08:00 AM') !== -1) {
            const parts = selectedDateISO.split('-');
            if (parts.length === 3) {
              const selY = parseInt(parts[0], 10);
              const selM = parseInt(parts[1], 10) - 1;
              const selD = parseInt(parts[2], 10);
              const morningCutoff = new Date(selY, selM, selD - 1, 19, 0, 0, 0);
              if (new Date() >= morningCutoff) {
                disabled = true;
              }
            }
          }

          if (isIntl && isMidnight) {
            disabled = true;
          }

          if (isToday) {
            if (isMidnight) {
              if (currentHour >= (22 - MIDNIGHT_HOURS)) disabled = true;
            } else {
              if (currentHour + PREP_HOURS > slotStart) disabled = true;
            }
          }

          opt.disabled = disabled;
          opt.style.color = disabled ? '#bbb' : '';

          if (!disabled) allDisabled = false;
          if (timeSelect.value === opt.value && disabled) selectedOptionDisabled = true;
        });

        if (selectedOptionDisabled) {
          timeSelect.value = '';
        }

        if (noticeBox && noticeText) {
          const morningOpt = timeSelect.querySelector('option[data-start="8"]');
          const morningBlocked = morningOpt && morningOpt.disabled;

          if (isToday) {
            noticeBox.classList.remove('hidden');
            const midnightOpt = timeSelect.querySelector('option[data-midnight="true"]');
            const midnightBlocked = midnightOpt && midnightOpt.disabled;

            if (allDisabled) {
              noticeText.textContent = "⚠️ No delivery slots available today. Please select Tomorrow or a future date.";
              noticeBox.className = "cart-delivery-notice mb-3 px-3 py-2 text-xs font-semibold rounded-lg flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-800";
            } else if (midnightBlocked && currentHour >= (22 - MIDNIGHT_HOURS)) {
              noticeText.textContent = "🌙 Midnight slot unavailable — must be ordered 6 hrs in advance (by 4 PM). Select tomorrow for midnight delivery.";
              noticeBox.className = "cart-delivery-notice mb-3 px-3 py-2 text-xs font-semibold rounded-lg flex items-center gap-2 bg-blue-50 border border-blue-200 text-blue-700";
            } else {
              noticeBox.classList.add('hidden');
            }
          } else if (morningBlocked && currentHour >= 19 && selectedDateISO === tomorrowIso) {
            noticeBox.classList.remove('hidden');
            noticeText.textContent = "🌅 Morning slot (8:00 AM – 10:00 AM) closed — must be ordered before 7:00 PM on the previous day.";
            noticeBox.className = "cart-delivery-notice mb-3 px-3 py-2 text-xs font-semibold rounded-lg flex items-center gap-2 bg-blue-50 border border-blue-200 text-blue-700";
          } else {
            noticeBox.classList.add('hidden');
          }
        }
      }

      function selectDate(dateObj, tabEl) {
        const isoDate = formatISODate(dateObj);
        hiddenInput.value = isoDate;
        activateTab(tabEl);
        filterTimeSlots(isoDate);
      }



      let minCartDate = new Date(today);
      if (cartAdvDays > 0) {
        minCartDate.setDate(today.getDate() + cartAdvDays);
      } else if (allowSameDayLondon) {
        if (!todayAvailable) {
          minCartDate.setDate(today.getDate() + 1);
        }
      } else if (isIntl || !todayAvailable) {
        minCartDate.setDate(today.getDate() + 1);
      }

      const userCountryStr = (userCountry || '').toLowerCase().trim();
      const isLondonCart = isIntl && (userCountryStr.includes('london') || userCountryStr.includes('uk') || userCountryStr.includes('united kingdom') || userCountryCode === 'GB' || userCountryCode === 'gb' || ukLoc.isUk);

      const disallowCartSunday = ((isIntl ? !isSundayAllowed : false) || cartNoSun || cartNoWeekend || isLondonCart);
      const disallowCartSaturday = isLondonCart ? false : cartNoWeekend;

      while ((disallowCartSunday && minCartDate.getDay() === 0) || (disallowCartSaturday && minCartDate.getDay() === 6)) {
        minCartDate.setDate(minCartDate.getDate() + 1);
      }

      const minCartIso = formatISODate(minCartDate);

      if (todayIso < minCartIso) {
        tabToday.disabled = true;
        tabToday.classList.add('opacity-40', 'cursor-not-allowed');
      }
      if (tomorrowIso < minCartIso || (disallowCartSunday && tomorrow.getDay() === 0) || (disallowCartSaturday && tomorrow.getDay() === 6)) {
        tabTomorrow.disabled = true;
        tabTomorrow.classList.add('opacity-40', 'cursor-not-allowed');
      }
      if (dayAfterIso < minCartIso || (disallowCartSunday && dayAfter.getDay() === 0) || (disallowCartSaturday && dayAfter.getDay() === 6)) {
        tabDayAfter.disabled = true;
        tabDayAfter.classList.add('opacity-40', 'cursor-not-allowed');
      }

      // Resolution of selected cart date
      // Priority: 1) localStorage from product page, 2) line item properties (initialIso), 3) auto-select earliest
      let pdpSavedDate = '';
      let pdpSavedTime = '';
      try {
        pdpSavedDate = localStorage.getItem('floral_pdp_delivery_date') || '';
        pdpSavedTime = localStorage.getItem('floral_pdp_delivery_time') || '';
        // Clear them so they don't linger after being read
        localStorage.removeItem('floral_pdp_delivery_date');
        localStorage.removeItem('floral_pdp_delivery_time');
      } catch(e) {}

      // The item's own saved date wins; the last product-page pick is only a fallback for items without one
      // (otherwise the last-added item's date, e.g. a cake's, was applied to every item)
      // A date the customer picked on this cart page (remembered across sign-in/reload) wins over both.
      const cartPick = window.getCartPick(block);
      let initialIso = normalizeToISODate(cartPick && cartPick.date) || normalizeToISODate(hiddenInput.value) || normalizeToISODate(pdpSavedDate);

      // Pre-fill time slot: cart-page pick first, then product page selection
      const preferredTime = (cartPick && cartPick.time) || pdpSavedTime;
      if (preferredTime && timeSelect) {
        for (let opt of timeSelect.options) {
          if (opt.value === preferredTime) {
            timeSelect.value = preferredTime;
            break;
          }
        }
      }

      function updateCustomBtnLabel(isoDate) {
        const customLabel = customBtn ? customBtn.querySelector('.custom-date-label') : null;
        const customDisplay = customBtn ? customBtn.querySelector('.custom-date-display') : null;
        if (!customLabel || !customDisplay || !isoDate) return;
        const parts = isoDate.split('-');
        if (parts.length !== 3) return;
        const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
        const dayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        customLabel.textContent = dayNames[d.getDay()];
        customDisplay.textContent = monthNames[d.getMonth()] + ' ' + d.getDate();
      }

      // Flatpickr Integration — init BEFORE date resolution so fp.setDate() works on load
      const maxDate = new Date(today);
      maxDate.setMonth(maxDate.getMonth() + 12);

      let fp = null;
      if (calendarPicker && typeof flatpickr !== 'undefined') {
        const disableRules = [];
        if (disallowCartSunday || disallowCartSaturday) {
          disableRules.push(function(date) {
            if (disallowCartSunday && date.getDay() === 0) return true;
            if (disallowCartSaturday && date.getDay() === 6) return true;
            return false;
          });
        }

        fp = flatpickr(calendarPicker, {
          minDate: minCartIso,
          maxDate: maxDate,
          dateFormat: 'Y-m-d',
          defaultDate: (initialIso && initialIso >= minCartIso) ? initialIso : minCartIso,
          disableMobile: true,
          disable: disableRules,
          onChange: function(selectedDates, dateStr) {
            if (selectedDates.length > 0) {
              hiddenInput.value = dateStr;
              window.saveCartPick(block, { date: dateStr });
              activateTab(customBtn);
              updateCustomBtnLabel(dateStr);
              filterTimeSlots(dateStr);
            }
          }
        });
      }

      if (initialIso && initialIso >= minCartIso) {
        if (initialIso === todayIso && !tabToday.disabled) {
