    // Qty update logic with Addon Cascade Removal
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.js-qty-btn');
      if (!btn) return;
      e.preventDefault();

      if (typeof window.saveCartDeliveryDetailsToStorage === 'function') {
        window.saveCartDeliveryDetailsToStorage();
      }

      const line = btn.dataset.line;
      const key = btn.dataset.key;
      const targetQty = parseInt(btn.dataset.quantity, 10);
      const container = document.getElementById('cart-container');

      const itemRow = btn.closest('.cart-country-item');
      const isMain = itemRow && (itemRow.dataset.isMain === 'true');
      const itemTitle = itemRow ? (itemRow.dataset.productTitle || '').trim() : '';
      const groupId = itemRow ? (itemRow.dataset.groupId || '').trim() : '';

      if (container) {
        container.style.opacity = '0.5';
        container.style.pointerEvents = 'none';
      }

      try {
        if (targetQty === 0 && isMain) {
          // A MAIN product is being removed!
          // Find if there are other main products remaining in the cart
          const allMainItems = Array.from(document.querySelectorAll('.cart-country-item[data-is-main="true"]'));
          const otherMainItems = allMainItems.filter(el => el !== itemRow);
          const allAddonItems = Array.from(document.querySelectorAll('.cart-country-item[data-is-addon="true"]'));

          const updates = {};
          if (key) updates[key] = 0;
          else updates[line] = 0;

          if (otherMainItems.length === 0) {
            // No other main products left! Clear the entire cart!
            await fetch('/cart/clear.js', { method: 'POST' });
            window.location.reload();
            return;
          } else {
            // Remove add-on items specifically attached to THIS main product
            allAddonItems.forEach(addonEl => {
              const parentGroup = (addonEl.dataset.parentGroupId || '').trim();
              const addonFor = (addonEl.dataset.addonFor || '').trim();
              let isMatch = false;
              if (groupId && parentGroup && groupId === parentGroup) isMatch = true;
              else if (itemTitle && addonFor && itemTitle.toLowerCase() === addonFor.toLowerCase()) isMatch = true;

              if (isMatch) {
                const aKey = addonEl.dataset.key;
                if (aKey) updates[aKey] = 0;
              }
            });

            await fetch('/cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ updates })
            });
          }
        } else {
          // Regular qty update or addon removal
          await fetch('/cart/change.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ line: line, quantity: targetQty })
          });
        }

        // Validate and clean any orphaned addons
        if (typeof window.validateAndCleanOrphanedAddons === 'function') {
          const hadCleaned = await window.validateAndCleanOrphanedAddons();
          if (hadCleaned) {
            window.location.reload();
            return;
          }
        }

        const response = await fetch(window.location.pathname + '?section_id=main-cart');
        const text = await response.text();
        const html = new DOMParser().parseFromString(text, 'text/html');
        
        const newContainer = html.getElementById('cart-container');
        if (newContainer && container) {
          container.innerHTML = newContainer.innerHTML;
          if (typeof window.restoreCartDeliveryDetailsFromStorage === 'function') {
            window.restoreCartDeliveryDetailsFromStorage();
          }
          if (typeof window.lockCartLocationFields === 'function') {
            window.lockCartLocationFields();
          }
          if (window.initAllCartDatePickers) window.initAllCartDatePickers();
        } else {
          window.location.reload();
        }
      } catch (error) {
        console.error('Error updating cart:', error);
        window.location.reload();
      } finally {
        if (container) {
          container.style.opacity = '1';
          container.style.pointerEvents = 'auto';
        }
      }
    });

    // Helper to validate that no add-on items exist in the cart without a main product
    window.validateAndCleanOrphanedAddons = async function() {
      try {
        const res = await fetch('/cart.js');
        const cart = await res.json();
        if (!cart.items || cart.items.length === 0) return false;

        const isSurchargeItem = (item) => {
          const h = (item.handle || '').toLowerCase();
          const t = (item.title || item.product_title || '').toLowerCase();
          return h.includes('surcharge') || h.includes('delivery-charge') || t.includes('surcharge') || t.includes('delivery charge') || (item.properties && item.properties['_For Surcharge'] === 'True');
        };

        const isAddonItem = (item) => {
          if (!item.properties) return false;
          return Boolean(item.properties['_Addon_For'] || item.properties['_is_addon'] === 'true');
        };

        const isMainItem = (item) => !isSurchargeItem(item) && !isAddonItem(item);

        const mainItems = cart.items.filter(isMainItem);
        const addonItems = cart.items.filter(isAddonItem);

        if (mainItems.length === 0) {
          // Zero main items in cart!
          // Clear everything (addons, surcharges, intl delivery fees)
          if (cart.items.length > 0) {
            console.warn('[Cart] Zero main products in cart. Clearing cart completely.');
            await fetch('/cart/clear.js', { method: 'POST' });
            return true;
          }
          return false;
        }

        if (addonItems.length === 0) return false;

        const orphanedKeys = [];
          // Check each addon to ensure its parent main product is in the cart
          addonItems.forEach(addon => {
            const addonFor = (addon.properties['_Addon_For'] || addon.properties['_parent_title'] || '').toLowerCase().trim();
            const parentGroup = (addon.properties['_parent_group_id'] || '').trim();

            const hasParent = mainItems.some(main => {
              const mainTitle = (main.product_title || main.title || '').toLowerCase().trim();
              const mainGroup = (main.properties && main.properties['_group_id'] || '').trim();
              if (parentGroup && mainGroup && parentGroup === mainGroup) return true;
              if (addonFor && mainTitle && (mainTitle === addonFor || mainTitle.includes(addonFor) || addonFor.includes(mainTitle))) return true;
              return false;
            });

            if (!hasParent) {
              orphanedKeys.push(addon.key);
            }
          });

        if (orphanedKeys.length > 0) {
          console.warn('[Cart] Cleaning up orphaned add-on items:', orphanedKeys);
          const updates = {};
          orphanedKeys.forEach(k => { updates[k] = 0; });
          await fetch('/cart/update.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ updates })
          });
          return true;
        }
        return false;
      } catch (err) {
        console.error('[Cart Addon Validation Error]', err);
        return false;
      }
    };

    // Auto-clean any orphaned addons immediately when cart loads
