{% style %}
  .cart-item-enter {
    animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .cart-item-stagger-1 { animation-delay: 0.1s; }
  .cart-item-stagger-2 { animation-delay: 0.2s; }
  .cart-item-stagger-3 { animation-delay: 0.3s; }
  .cart-item-stagger-4 { animation-delay: 0.4s; }
  .cart-item-stagger-5 { animation-delay: 0.5s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .glass-panel {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.5);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  }

  .btn-gradient {
    background-size: 200% auto;
    transition: 0.5s;
  }
  .btn-gradient:hover {
    background-position: right center;
  }
{% endstyle %}

<section id="cart-container" class="max-w-7xl mx-auto px-4 py-12 md:py-20 relative">
  <!-- Decorative background blobs -->
  <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none opacity-30">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-primary/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob"></div>
    <div class="absolute top-1/4 -right-24 w-96 h-96 bg-pink-300/20 rounded-full mix-blend-multiply filter blur-3xl opacity-70 animate-blob animation-delay-2000"></div>
  </div>

  <div class="flex flex-col md:flex-row items-baseline justify-between mb-12 cart-item-enter">
    <h1 class="text-4xl md:text-6xl font-serif font-bold text-gray-900 tracking-tight">Your Cart</h1>
    <a href="/collections/all" class="mt-4 md:mt-0 text-sm font-semibold text-primary hover:text-primary-600 transition-all duration-300 flex items-center gap-2 group">
      <svg class="w-4 h-4 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Continue Shopping
    </a>
  </div>

  {%- assign main_product_count = 0 -%}
  {%- assign addon_product_count = 0 -%}
  {%- for item in cart.items -%}
    {%- assign item_h_lc = item.product.handle | downcase -%}
    {%- assign item_t_lc = item.product.title | downcase -%}
    {%- if item_h_lc contains 'surcharge' or item_h_lc contains 'delivery-charge' or item_t_lc contains 'surcharge' or item_t_lc contains 'delivery charge' or item.properties['_For Surcharge'] == 'True' -%}
      {%- continue -%}
    {%- endif -%}
    {%- if item.properties['_Addon_For'] != blank or item.properties['_is_addon'] == 'true' -%}
      {%- assign addon_product_count = addon_product_count | plus: item.quantity -%}
    {%- else -%}
      {%- assign main_product_count = main_product_count | plus: item.quantity -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign real_product_count = main_product_count | plus: addon_product_count -%}

  {% if real_product_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" novalidate class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Cart Items List -->
      <div class="lg:col-span-8 space-y-6">

        {% if main_product_count == 0 and addon_product_count > 0 %}
          <div id="addon-only-warning" class="p-5 rounded-2xl bg-amber-50 border-2 border-amber-300 text-amber-900 flex items-start gap-4 shadow-sm mb-6">
            <svg class="w-6 h-6 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <div class="text-sm">
              <p class="font-bold text-base text-amber-950">Main Product Required</p>
              <p class="mt-1 text-amber-800">"Make It Extra" items are add-on products and cannot be ordered alone. Please add a main flower bouquet, cake, or gift to continue checkout.</p>
              <div class="mt-3 flex items-center gap-3">
                <a href="/collections/all" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white rounded-xl font-bold text-xs shadow-xs transition-colors">
                  Browse Flowers & Gifts &rarr;
                </a>
              </div>
            </div>
          </div>
        {% endif %}

        <div class="hidden md:grid grid-cols-12 gap-6 text-xs font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-4 cart-item-enter">
          <div class="col-span-6">Product</div>
          <div class="col-span-3 text-center">Quantity</div>
          <div class="col-span-3 text-right">Total</div>
        </div>

        {% for item in cart.items %}
          {%- assign item_tags_lc = item.product.tags | join: ',' | downcase -%}
          {%- assign item_h_lc = item.product.handle | downcase -%}
          {%- assign item_t_lc = item.product.title | downcase -%}
          {%- assign is_surcharge = false -%}
          {%- if item_h_lc contains 'surcharge' or item_h_lc contains 'delivery-charge' or item_t_lc contains 'surcharge' or item_t_lc contains 'delivery charge' or item.properties['_For Surcharge'] == 'True' -%}
            {%- assign is_surcharge = true -%}
          {%- endif -%}
          {%- assign is_addon = false -%}
          {%- if item.properties['_Addon_For'] != blank or item.properties['_is_addon'] == 'true' -%}
            {%- assign is_addon = true -%}
          {%- endif -%}
          {%- assign is_main_product = false -%}
          {%- if is_surcharge == false and is_addon == false -%}
            {%- assign is_main_product = true -%}
          {%- endif -%}

          <div class="glass-panel rounded-2xl p-4 md:p-6 grid grid-cols-1 md:grid-cols-12 gap-6 items-center cart-item-enter cart-item-stagger-{{ forloop.index | at_most: 5 }} hover:-translate-y-1 transition-all duration-300 hover:shadow-xl cart-country-item"
            {% if is_surcharge %}style="display: none !important;"{% endif %}
            data-line="{{ forloop.index }}"
            data-key="{{ item.key }}"
            data-variant-id="{{ item.variant_id }}"
            data-product-title="{{ item.product.title | escape }}"
            data-handle="{{ item.product.handle }}"
            data-tags="{{ item.product.tags | join: ',' | escape }}"
            data-is-surcharge="{{ is_surcharge }}"
            data-is-addon="{{ is_addon }}"
            data-is-main="{{ is_main_product }}"
            data-addon-for="{{ item.properties['_Addon_For'] | escape }}"
            data-parent-group-id="{{ item.properties['_parent_group_id'] | escape }}"
            data-group-id="{{ item.properties['_group_id'] | escape }}">
            
            <!-- Product Info -->
            <div class="col-span-1 md:col-span-6 flex items-center gap-6">
              <a href="{{ item.url }}" class="w-28 h-28 rounded-2xl overflow-hidden bg-gray-50 flex-shrink-0 shadow-inner group relative">
                {% if item.image %}
                  <img src="{{ item.image | img_url: 'medium' }}" alt="{{ item.title | escape }}" class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700">
                {% else %}
                  <span class="w-full h-full flex items-center justify-center text-3xl"></span>
                {% endif %}
                <div class="absolute inset-0 ring-1 ring-inset ring-black/5 rounded-2xl pointer-events-none"></div>
              </a>
              <div>
                <a href="{{ item.url }}" class="text-lg font-bold text-gray-900 hover:text-primary transition-colors block mb-1 leading-tight">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <p class="text-sm text-gray-500 mb-2">{{ item.variant.title }}</p>
                {% endunless %}
                <p class="text-base font-semibold text-gray-900" data-base-price="{{ item.price }}">{{ item.price | money }}</p>
                {%- comment -%} Filled by renderPerItemDateNotice() when items have different delivery dates {%- endcomment -%}
                <p class="line-delivery-date" data-line="{{ forloop.index }}" style="display:none; margin-top:4px; font-size:12px; font-weight:600; color:#0e7040;"></p>
                {% if item.properties.size > 0 %}
                  <div class="mt-2 space-y-1 text-xs text-gray-600 bg-gray-50/80 p-2 rounded-lg border border-gray-100">
                    {% for property in item.properties %}
                      {% assign first_char = property.first | slice: 0 %}
                      {% unless property.last == blank or first_char == '_' %}
                        <p class="flex items-center gap-1.5">
                          <span class="font-bold text-gray-700">{{ property.first }}:</span>
                          <span>{{ property.last }}</span>
                        </p>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>

            <!-- Quantity -->
            <div class="col-span-1 md:col-span-3 flex items-center md:justify-center">
              {% if is_surcharge %}
                <span class="text-sm font-bold text-gray-500 bg-gray-50 px-3 py-1 rounded-full border border-gray-100">Fee applied</span>
                <input type="hidden" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}">
              {% else %}
                <div class="flex items-center bg-gray-50/80 rounded-full h-12 w-36 border border-gray-100 p-1">
                  <button type="button" data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-quantity="{{ item.quantity | minus: 1 }}" class="js-qty-btn w-10 h-10 rounded-full flex items-center justify-center text-gray-500 hover:bg-white hover:text-primary hover:shadow-sm transition-all">-</button>
                  <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" class="w-full h-full text-center text-base font-bold text-gray-900 focus:outline-none bg-transparent appearance-none" readonly>
                  <button type="button" data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-quantity="{{ item.quantity | plus: 1 }}" class="js-qty-btn w-10 h-10 rounded-full flex items-center justify-center text-gray-500 hover:bg-white hover:text-primary hover:shadow-sm transition-all">+</button>
                </div>
              {% endif %}
            </div>

            <!-- Total & Remove -->
            <div class="col-span-1 md:col-span-3 flex items-center justify-between md:justify-end">
              <span class="text-base font-bold text-gray-900 md:hidden">Total: </span>
              <span class="text-lg font-bold text-gray-900 mr-6" data-base-price="{{ item.final_line_price }}">{{ item.final_line_price | money }}</span>
              {% if is_surcharge %}
                <div class="w-10 h-10"></div>
              {% else %}
                <button type="button" data-line="{{ forloop.index }}" data-key="{{ item.key }}" data-quantity="0" class="js-qty-btn w-10 h-10 rounded-full bg-red-50/50 flex items-center justify-center text-gray-400 hover:bg-red-500 hover:text-white hover:shadow-md transition-all group" title="Remove Item">
                  <svg class="w-4 h-4 transform group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                </button>
              {% endif %}
            </div>
            
          </div>
        {% endfor %}

                {%- assign real_item_count = 0 -%}
        {%- for item in cart.items -%}
          {%- assign item_h_lc = item.product.handle | downcase -%}
          {%- assign item_t_lc = item.product.title | downcase -%}
          {%- if item_h_lc contains 'surcharge' or item_h_lc contains 'delivery-charge' or item_t_lc contains 'surcharge' or item_t_lc contains 'delivery charge' or item.properties['_For Surcharge'] == 'True' -%}
            {%- continue -%}
          {%- endif -%}
          {%- assign real_item_count = real_item_count | plus: 1 -%}

          {%- assign i_desc = item.product.description | strip_html | downcase -%}
          {%- assign item_advance_days = 0 -%}
          {%- assign item_no_sunday = false -%}
          {%- assign item_no_weekend = false -%}
          {%- assign is_cake = false -%}
          {%- assign has_choc = false -%}
          {%- assign has_gifting = false -%}
          {%- assign is_exotic = false -%}
          {%- assign item_is_london = false -%}
          {%- assign item_has_sdd = false -%}

          {%- if i_desc contains 'advance' or i_desc contains 'process' -%}
            {%- if i_desc contains '4-5 advance' or i_desc contains '4 to 5 advance' or i_desc contains '4-5 days advance' or i_desc contains '5 days advance' or i_desc contains '5-day advance' -%}
              {%- assign item_advance_days = 5 -%}
            {%- elsif i_desc contains '3-4 advance' or i_desc contains '3 to 4 advance' or i_desc contains '4 days advance' or i_desc contains '4-day advance' -%}
              {%- if item_advance_days < 4 -%}{%- assign item_advance_days = 4 -%}{%- endif -%}
            {%- elsif i_desc contains '2-3 advance' or i_desc contains '2 to 3 advance' or i_desc contains '2-3 days advance' or i_desc contains '3 days advance' or i_desc contains '3-day advance' or i_desc contains '3 days process' -%}
              {%- if item_advance_days < 2 -%}{%- assign item_advance_days = 2 -%}{%- endif -%}
            {%- elsif i_desc contains '1-2 days advance' or i_desc contains '1-2 day advance' or i_desc contains '1-2 advance' or i_desc contains '1 to 2 days advance' or i_desc contains '1 to 2 advance' -%}
              {%- comment -%} '1-2 days' means next-day delivery is possible {%- endcomment -%}
              {%- if item_advance_days < 1 -%}{%- assign item_advance_days = 1 -%}{%- endif -%}
            {%- elsif i_desc contains '2 days advance' or i_desc contains '2-day advance' or i_desc contains '2 days process' -%}
              {%- if item_advance_days < 2 -%}{%- assign item_advance_days = 2 -%}{%- endif -%}
            {%- elsif i_desc contains '1 day advance' or i_desc contains '1-day advance' or i_desc contains '1 day process' -%}
              {%- if item_advance_days < 1 -%}{%- assign item_advance_days = 1 -%}{%- endif -%}
            {%- endif -%}
          {%- endif -%}

          {%- if item.product.title contains 'Cake' or item.product.title contains 'cake' or item.product.type contains 'Cake' or item.product.type contains 'cake' -%}
            {%- assign is_cake = true -%}
          {%- endif -%}

          {%- for tag in item.product.tags -%}
            {%- assign tag_lc = tag | downcase | strip -%}
            {%- if tag_lc contains 'cake' -%}
              {%- assign is_cake = true -%}
            {%- endif -%}
            {%- if tag_lc == 'chocolate' or tag_lc == 'chocolates' -%}
              {%- assign has_choc = true -%}
            {%- endif -%}
            {%- if tag_lc == 'gifting' -%}
              {%- assign has_gifting = true -%}
            {%- endif -%}
            {%- if tag_lc contains 'exotic' -%}
              {%- assign is_exotic = true -%}
            {%- endif -%}
            {%- if tag_lc == '2-days-advance' or tag_lc == '2 days advance' or tag_lc == '2-advance' -%}
              {%- if item_advance_days < 2 -%}{%- assign item_advance_days = 2 -%}{%- endif -%}
            {%- elsif tag_lc == '3-days-advance' or tag_lc == '3 days advance' or tag_lc == '3-advance' -%}
              {%- if item_advance_days < 3 -%}{%- assign item_advance_days = 3 -%}{%- endif -%}
            {%- elsif tag_lc == '4-days-advance' or tag_lc == '4 days advance' or tag_lc == '4-advance' -%}
              {%- if item_advance_days < 4 -%}{%- assign item_advance_days = 4 -%}{%- endif -%}
            {%- elsif tag_lc == 'usa' or tag_lc == 'us' or tag_lc == 'united states' -%}
              {%- assign item_no_weekend = true -%}
            {%- elsif tag_lc == 'london' or tag_lc == 'uk' or tag_lc == 'united kingdom' -%}
              {%- assign item_no_sunday = true -%}
              {%- assign item_is_london = true -%}
            {%- endif -%}
            {%- if tag_lc == 'sdd' or tag_lc == 'same day' or tag_lc == 'sameday' -%}
              {%- assign item_has_sdd = true -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if item_t_lc contains 'london' or item_t_lc contains 'uk' -%}
            {%- assign item_is_london = true -%}
          {%- endif -%}

          {%- comment -%} Item category used for the cart date-box labels (Cakes / Flowers / Hampers / ...) {%- endcomment -%}
          {%- assign i_type_lc = item.product.type | downcase -%}
          {%- assign i_tags_lc = item.product.tags | join: ',' | downcase -%}
          {%- assign i_colls_lc = item.product.collections | map: 'handle' | join: ',' | downcase -%}
          {%- if is_cake -%}
            {%- assign item_category = 'cake' -%}
          {%- elsif item_t_lc contains 'hamper' or i_type_lc contains 'hamper' or i_tags_lc contains 'hamper' or item_t_lc contains 'dry fruit' or i_type_lc contains 'dry fruit' or i_tags_lc contains 'dry fruit' or item_t_lc contains 'basket' -%}
            {%- assign item_category = 'hamper' -%}
          {%- elsif item_t_lc contains 'idol' or item_t_lc contains 'murti' or i_type_lc contains 'idol' or i_tags_lc contains 'idol' -%}
            {%- assign item_category = 'idol' -%}
          {%- elsif item_t_lc contains 'plant' or i_type_lc contains 'plant' or i_tags_lc contains 'plant' -%}
            {%- assign item_category = 'plant' -%}
          {%- elsif item_t_lc contains 'flower' or item_t_lc contains 'bouquet' or item_t_lc contains 'rose' or item_t_lc contains 'bunch' or item_t_lc contains 'bloom' or item_t_lc contains 'lily' or item_t_lc contains 'lilies' or item_t_lc contains 'orchid' or item_t_lc contains 'tulip' or item_t_lc contains 'gerbera' or item_t_lc contains 'carnation' or i_type_lc contains 'flower' or i_tags_lc contains 'flower' or i_colls_lc contains 'flower' -%}
            {%- assign item_category = 'flower' -%}
          {%- elsif has_choc or item_t_lc contains 'chocolate' or i_type_lc contains 'chocolate' -%}
            {%- assign item_category = 'chocolate' -%}
          {%- else -%}
            {%- assign item_category = 'gift' -%}
          {%- endif -%}

          {%- if has_choc and has_gifting -%}
            {%- if item_advance_days < 1 -%}{%- assign item_advance_days = 1 -%}{%- endif -%}
          {%- endif -%}
          {%- if is_exotic -%}
            {%- if item_advance_days < 2 -%}{%- assign item_advance_days = 2 -%}{%- endif -%}
          {%- endif -%}

          {%- comment -%} Karwa Chauth products need at least 3 days notice (same rule as the product page) {%- endcomment -%}
          {%- capture kc_flag -%}{%- render 'karwa-chauth-check', product: item.product -%}{%- endcapture -%}
          {%- if kc_flag contains 'true' -%}
            {%- if item_advance_days < 3 -%}{%- assign item_advance_days = 3 -%}{%- endif -%}
          {%- endif -%}

          {%- if i_desc contains 'sunday delivery not possible' or i_desc contains 'sundays non-delivery' or i_desc contains 'no sunday' -%}
            {%- assign item_no_sunday = true -%}
          {%- endif -%}

          <div class="glass-panel rounded-2xl p-6 md:p-8 mt-6 delivery-address-form item-delivery-form" style="{% if real_item_count > 1 %}display: none;{% endif %}" data-line="{% if real_item_count == 1 %}all{% else %}{{ forloop.index }}{% endif %}" data-item-line="{{ forloop.index }}" data-quantity="{{ item.quantity }}" data-existing-properties="{{ item.properties | json | escape }}" data-advance-days="{{ item_advance_days }}" data-no-sunday="{{ item_no_sunday }}" data-no-weekend="{{ item_no_weekend }}" data-is-cake="{{ is_cake }}" data-line-key="{{ item.variant.id }}" data-item-key="{{ item.key }}" data-category="{{ item_category }}" data-item-title="{{ item.product.title | escape }}" data-is-london="{{ item_is_london }}" data-has-sdd="{{ item_has_sdd }}">
            <div class="flex items-center justify-between mb-4 border-b border-gray-100 pb-3 address-form-header">
              <h3 class="text-base font-bold text-gray-900 uppercase tracking-wider flex items-center gap-2">
                <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                Delivery Address & Customization
              </h3>
              <span class="text-xs text-gray-400 font-medium form-subtitle">Applied to all items in cart</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 address-fields-container relative">
              

              <!-- Address Fields -->
              <div class="md:col-span-2 addr-wrapper">
                <select class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" data-prop="Delivery_Title">
                  <option value="Mr." {% if cart.attributes.Delivery_Title == 'Mr.' or item.properties.Delivery_Title == 'Mr.' %}selected{% endif %}>Mr.</option>
                  <option value="Mrs." {% if cart.attributes.Delivery_Title == 'Mrs.' or item.properties.Delivery_Title == 'Mrs.' %}selected{% endif %}>Mrs.</option>
                  <option value="Ms." {% if cart.attributes.Delivery_Title == 'Ms.' or item.properties.Delivery_Title == 'Ms.' %}selected{% endif %}>Ms.</option>
                </select>
              </div>
              <div class="md:col-span-5 addr-wrapper">
                <input type="text" placeholder="First Name *" autocomplete="given-name" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_FirstName" value="{{ cart.attributes.Delivery_FirstName | default: item.properties.Delivery_FirstName | escape }}">
              </div>
              <div class="md:col-span-5 addr-wrapper">
                <input type="text" placeholder="Last Name *" autocomplete="family-name" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Delivery_LastName" value="{{ cart.attributes.Delivery_LastName | default: item.properties.Delivery_LastName | escape }}">
              </div>

              <!-- International mode: location autocomplete -->
              <div class="md:col-span-12 addr-wrapper intl-location-wrapper-top" style="display:none; position:relative;">
                <div class="intl-location-autocomplete relative">
                  <input type="text" id="intl-location-input-{{ forloop.index }}" placeholder="Search Address Automatically..." autocomplete="new-password" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 pr-10 bg-white addr-field intl-location-input" data-prop="Delivery_Landmark" value="{{ cart.attributes.Delivery_Landmark | default: item.properties.Delivery_Landmark | default: item.properties['Exact Location'] | default: item.properties['_Exact Location'] | escape }}">
                  <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                    <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
