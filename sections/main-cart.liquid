<script>
(function initIntlLocationAutocomplete() {
  const GEOAPIFY_KEY = '70b21c8c216144c4acc4b4932d43790e';
  let debounceTimer = null;

  function getDeliveryMode() {
    return localStorage.getItem('delivery_mode') || 'india';
  }

  function getUserCountryCode() {
    if (getDeliveryMode() === 'india') return 'IN';
    return (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
  }

  function isIntlMode() {
    return getDeliveryMode() === 'international' && getUserCountryCode() !== 'IN';
  }

    function applyModeToForm(form) {
    const intl = isIntlMode();
    const landmarkFields = form.querySelectorAll('.india-landmark-field');
    const autocompleteWrappersTop = form.querySelectorAll('.intl-location-wrapper-top');

    // Make India exactly identical to International
    landmarkFields.forEach(f => {
      const wrapper = f.closest('.intl-location-wrapper-bottom');
      if (wrapper) wrapper.style.display = 'none';
      f.removeAttribute('required');
    });

    autocompleteWrappersTop.forEach(w => {
      const inp = w.querySelector('.intl-location-input');
      const inner = w.querySelector('.intl-location-autocomplete');
      w.style.display = '';
      if (inner) inner.style.display = '';
      if (inp) inp.setAttribute('required', 'required');
    });

    // Make Postcode and State optional for International orders
    const pinField = form.querySelector('[data-prop="Delivery_Postcode"]');
    const stateField = form.querySelector('[data-prop="Delivery_State"]');
    
    if (intl) {
      if (pinField) {
        pinField.removeAttribute('required');
        pinField.placeholder = "Postcode (Optional)";
      }
      if (stateField) {
        stateField.removeAttribute('required');
        stateField.placeholder = "State (Optional)";
      }
    } else {
      if (pinField) {
        pinField.setAttribute('required', 'required');
        pinField.placeholder = "Postcode *";
      }
      if (stateField) {
        stateField.setAttribute('required', 'required');
        stateField.placeholder = "State *";
      }
    }
  }

  function fillAddressFields(form, result) {
    const props = result.properties || {};
    const city = props.city || props.county || props.state_district || '';
    const state = props.state || props.state_code || '';
    const postcode = props.postcode || '';
    let country = props.country || '';
    if (country === 'United States of America') country = 'United States';
    const formattedAddress = props.formatted || props.address_line1 || props.name || [city, state, country].filter(Boolean).join(', ') || '';

    function setField(prop, val, lockIt) {
      const el = form.querySelector(`[data-prop="${prop}"]`);
      if (el) {
        el.readOnly = false;
        
        el.value = val || '';
        el.dispatchEvent(new Event('input', { bubbles: true }));
        el.dispatchEvent(new Event('change', { bubbles: true }));
        
        if (lockIt) {
          el.readOnly = true;
          el.classList.add('bg-gray-50', 'text-gray-500');
          el.classList.remove('bg-white');
        } else {
          el.readOnly = false;
          el.classList.remove('bg-gray-50', 'text-gray-500');
          el.classList.add('bg-white');
        }
      }
    }

    if (formattedAddress) {
      setField('Delivery_Address', formattedAddress, true);
      setField('Delivery_City', city, city !== '');
      setField('Delivery_State', state, state !== '');
      
      const finalPostcode = postcode || localStorage.getItem('user_pincode') || '';
      setField('Delivery_Postcode', finalPostcode, finalPostcode !== '');
      if (typeof window.sanitizeCartPostcodes === 'function') window.sanitizeCartPostcodes();
      
      setField('Delivery_Country', country, country !== '');

      if (typeof window.initAllCartDatePickers === 'function') {
        window.initAllCartDatePickers();
      }
    }
  }

  function setupAutocompleteInput(input) {
    if (input._intlAcInit) return;
    input._intlAcInit = true;

    const dropdown = input.closest('.intl-location-autocomplete').querySelector('.intl-location-dropdown');
    const form = input.closest('.delivery-address-form');

    function closeDropdown() {
      dropdown.style.display = 'none';
      dropdown.innerHTML = '';
    }

    input.addEventListener('input', function () {
      const query = this.value.trim();
      
      // If user types in search, clear the main address field so they are FORCED to pick a valid one from dropdown
      if (form) {
        const mainAddr = form.querySelector('[data-prop="Delivery_Address"]');
        if (mainAddr && mainAddr.value && query.toLowerCase() !== mainAddr.value.trim().toLowerCase()) {
          const wasReadOnly = mainAddr.readOnly;
          mainAddr.readOnly = false;
          mainAddr.value = '';
          if (wasReadOnly) mainAddr.readOnly = true;
          mainAddr.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
      
      clearTimeout(debounceTimer);

      if (query.length < 3) { closeDropdown(); return; }

      const countryCode = getUserCountryCode().toLowerCase();
      const filterParam = countryCode ? `&filter=countrycode:${countryCode}` : '';

      debounceTimer = setTimeout(() => {
        const url = `https://api.geoapify.com/v1/geocode/autocomplete?text=${encodeURIComponent(query)}${filterParam}&limit=6&apiKey=${GEOAPIFY_KEY}`;

        fetch(url)
          .then(r => r.json())
          .then(data => {
            closeDropdown();
            if (data && data.query && data.query.parsed) {
              input._lastParsed = data.query.parsed;
            } else {
              input._lastParsed = null;
            }
            if (!data.features || !data.features.length) return;

            data.features.forEach(feature => {
              const props = feature.properties || {};
              const main = props.address_line1 || props.name || props.formatted?.split(',')[0] || '';
              const sub = props.formatted || '';

              const li = document.createElement('li');
              li.innerHTML = `
                <span class="loc-icon">📍</span>
                <span>
                  <span class="loc-main">${main}</span><br>
                  <span class="loc-sub">${sub}</span>
                </span>`;

              li.addEventListener('mousedown', function (e) {
                e.preventDefault();
                input.value = props.formatted || main;
                input.dispatchEvent(new Event('change', { bubbles: true }));
                closeDropdown();
                if (form) fillAddressFields(form, feature);
              });

              dropdown.appendChild(li);
            });

            dropdown.style.display = 'block';
          })
          .catch(() => closeDropdown());
      }, 350);
    });

    input.addEventListener('blur', () => {
      setTimeout(() => {
        closeDropdown();
        if (form) {
          const mainAddr = form.querySelector('[data-prop="Delivery_Address"]');
          if (mainAddr && !mainAddr.value.trim()) {
            const val = input.value.trim();
            if (val) {
              const wasReadOnly = mainAddr.readOnly;
              mainAddr.readOnly = false;
              mainAddr.value = val;
              if (wasReadOnly) mainAddr.readOnly = true;
              mainAddr.dispatchEvent(new Event('change', { bubbles: true }));

              // Unlock other location fields so they can be corrected manually
              const cityField = form.querySelector('[data-prop="Delivery_City"]');
              const stateField = form.querySelector('[data-prop="Delivery_State"]');
              const pinField = form.querySelector('[data-prop="Delivery_Postcode"]');
              
              [cityField, stateField, pinField].forEach(el => {
                if (el) {
                  el.readOnly = false;
                  el.classList.remove('bg-gray-50', 'text-gray-500', 'cursor-not-allowed');
                  el.classList.add('bg-white');
                  let wrapper = el.parentNode;
                  if (wrapper && wrapper.classList.contains('locked-wrapper')) {
                    wrapper.outerHTML = wrapper.innerHTML;
                  }
                }
              });

              // Attempt to auto-parse details
              const parsed = input._lastParsed || {};
              const pCity = parsed.city || parsed.county || parsed.district || parsed.state || '';
              const pState = parsed.state || parsed.county || '';
              const pPin = parsed.postcode || '';

              if (cityField && pCity) {
                const words = pCity.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                cityField.value = words;
                cityField.dispatchEvent(new Event('change', { bubbles: true }));
              }
              if (stateField && pState) {
                const words = pState.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
                stateField.value = words;
                stateField.dispatchEvent(new Event('change', { bubbles: true }));
              }
              if (pinField) {
                const pinMatch = pPin || (val.match(/\b\d{5,6}\b/) ? val.match(/\b\d{5,6}\b/)[0] : '');
                if (pinMatch) {
                  pinField.value = pinMatch;
                  pinField.dispatchEvent(new Event('change', { bubbles: true }));
                }
              }
            } else {
              if (typeof window.lockCartLocationFields === 'function') {
                window.lockCartLocationFields();
              }
            }
          }
        }
      }, 250);
    });
    input.addEventListener('focus', function () {
      if (this.value.trim().length >= 3) this.dispatchEvent(new Event('input', { bubbles: true }));
    });
    
    input.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        const firstLi = dropdown.querySelector('li');
        if (firstLi && dropdown.style.display !== 'none') {
          firstLi.dispatchEvent(new MouseEvent('mousedown'));
        }
      }
    });
  }

  function initAllForms() {
    document.querySelectorAll('.delivery-address-form').forEach(form => {
      applyModeToForm(form);
      form.querySelectorAll('.intl-location-input').forEach(setupAutocompleteInput);
    });
  }

  // Init on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllForms);
  } else {
    initAllForms();
  }

  // Re-init if delivery mode changes (user switches country)
  window.addEventListener('storage', function (e) {
    if (e.key === 'delivery_mode' || e.key === 'user_country_code') {
      initAllForms();
    }
  });

  // Also expose for external re-triggering
  window.reinitIntlLocationAC = initAllForms;
})();
</script>

<script>
  (function initCartPhoneEngine() {
    window.PhoneCountryMap = {
      'GB': { name: 'UK', iso: 'GB', dialCode: '+44', flag: '🇬🇧' },
      'IN': { name: 'India', iso: 'IN', dialCode: '+91', flag: '🇮🇳' },
      'US': { name: 'USA', iso: 'US', dialCode: '+1', flag: '🇺🇸' },
      'CA': { name: 'Canada', iso: 'CA', dialCode: '+1', flag: '🇨🇦' },
      'AE': { name: 'UAE', iso: 'AE', dialCode: '+971', flag: '🇦🇪' },
      'AU': { name: 'Australia', iso: 'AU', dialCode: '+61', flag: '🇦🇺' },
      'SG': { name: 'Singapore', iso: 'SG', dialCode: '+65', flag: '🇸🇬' },
      'DE': { name: 'Germany', iso: 'DE', dialCode: '+49', flag: '🇩🇪' },
      'FR': { name: 'France', iso: 'FR', dialCode: '+33', flag: '🇫🇷' },
      'IT': { name: 'Italy', iso: 'IT', dialCode: '+39', flag: '🇮🇹' },
      'ES': { name: 'Spain', iso: 'ES', dialCode: '+34', flag: '🇪🇸' },
      'NL': { name: 'Netherlands', iso: 'NL', dialCode: '+31', flag: '🇳🇱' },
      'NZ': { name: 'New Zealand', iso: 'NZ', dialCode: '+64', flag: '🇳🇿' },
      'IE': { name: 'Ireland', iso: 'IE', dialCode: '+353', flag: '🇮🇪' }
    };

    function resolveCountryISO(formEl, overrideISO) {
      if (overrideISO && window.PhoneCountryMap[overrideISO.toUpperCase()]) {
        return overrideISO.toUpperCase();
      }

      const countryInput = formEl ? formEl.querySelector('[data-prop="Delivery_Country"]') : null;
      const text = (countryInput ? countryInput.value : '').trim().toUpperCase();

      if (text) {
        if (text.includes('INDIA') || text.includes('BHARAT') || text === 'IN') return 'IN';
        if (text.includes('UK') || text.includes('UNITED KINGDOM') || text.includes('GREAT BRITAIN') || text.includes('ENGLAND') || text.includes('SCOTLAND') || text.includes('WALES') || text.includes('NORTHERN IRELAND') || text === 'GB') return 'GB';
        if (text.includes('US') || text.includes('USA') || text.includes('UNITED STATES') || text.includes('AMERICA')) return 'US';
        if (text.includes('UAE') || text.includes('EMIRATES') || text.includes('DUBAI') || text.includes('ABU DHABI') || text === 'AE') return 'AE';
        if (text.includes('CANADA') || text === 'CA') return 'CA';
        if (text.includes('AUSTRALIA') || text === 'AU') return 'AU';
        if (text.includes('SINGAPORE') || text === 'SG') return 'SG';
        if (text.includes('GERMANY') || text.includes('DEUTSCHLAND') || text === 'DE') return 'DE';
        if (text.includes('FRANCE') || text === 'FR') return 'FR';
        if (text.includes('ITALY') || text === 'IT') return 'IT';
        if (text.includes('SPAIN') || text === 'ES') return 'ES';
        if (text.includes('NETHERLANDS') || text === 'NL') return 'NL';
        if (text.includes('NEW ZEALAND') || text === 'NZ') return 'NZ';
        if (text.includes('IRELAND') || text === 'IE') return 'IE';
      }

      if ((localStorage.getItem('delivery_mode') || 'india') === 'india') return 'IN';
      const storeCode = (localStorage.getItem('user_country_code') || 'IN').toUpperCase();
      if (['UK', 'GB'].includes(storeCode)) return 'GB';
      if (['IN', 'INDIA'].includes(storeCode)) return 'IN';
      if (['US', 'USA'].includes(storeCode)) return 'US';
      if (['AE', 'UAE'].includes(storeCode)) return 'AE';
      if (['CA'].includes(storeCode)) return 'CA';
      if (['AU'].includes(storeCode)) return 'AU';
      if (['SG'].includes(storeCode)) return 'SG';
      if (['DE'].includes(storeCode)) return 'DE';

      return 'US';
    }

    function fallbackPhoneValidation(digits, iso) {
      if (iso === 'GB') {
        return (digits.startsWith('07') && digits.length === 11) ||
               (digits.startsWith('7') && digits.length === 10) ||
               (/^0[123]/.test(digits) && (digits.length === 10 || digits.length === 11)) ||
               (/^[123]/.test(digits) && digits.length === 10);
      }
      if (iso === 'IN') {
        return digits.length === 10 && /^[6-9]/.test(digits);
      }
      if (iso === 'US' || iso === 'CA') {
        return digits.length === 10 && /^[2-9]/.test(digits) && /^[2-9]/.test(digits.charAt(3));
      }
      if (iso === 'AE') {
        return digits.length === 9 && /^5/.test(digits);
      }
      if (iso === 'AU') {
        return (digits.startsWith('04') && digits.length === 10) || (digits.startsWith('4') && digits.length === 9);
      }
      return digits.length >= 8 && digits.length <= 12;
    }

    function validateSinglePhoneField(inputEl, forceISO) {
      if (!inputEl) return true;
      const formEl = inputEl.closest('.delivery-address-form') || document;
      const groupEl = inputEl.closest('.phone-field-group') || inputEl.parentNode;
      const selectEl = groupEl ? groupEl.querySelector('.phone-country-select') : null;

      const currentISO = resolveCountryISO(formEl, forceISO);
      const countryInfo = window.PhoneCountryMap[currentISO] || { name: currentISO, iso: currentISO, dialCode: '+1', flag: '🌐' };

      if (selectEl && selectEl.value !== currentISO) {
        selectEl.value = currentISO;
      }

      const flagEl = groupEl ? groupEl.querySelector('.flag-icon') : null;
      const dialEl = groupEl ? groupEl.querySelector('.dial-code') : null;
      if (flagEl) flagEl.textContent = countryInfo.flag;
      if (dialEl) dialEl.textContent = countryInfo.dialCode;

      const raw = inputEl.value;
      const cleanDigits = raw.replace(/[^\d+]/g, '');

      const lib = window.libphonenumber;
      
      // Apply As-You-Type formatting to give users visual feedback on how their number is interpreted
      if (lib && typeof lib.AsYouType === 'function' && cleanDigits) {
        const formatter = new lib.AsYouType(currentISO);
        const formattedVal = formatter.input(cleanDigits);
        
        if (inputEl.value !== formattedVal) {
          inputEl.value = formattedVal;
          // Move cursor to the end after formatting so typing isn't interrupted
          if (document.activeElement === inputEl) {
            inputEl.setSelectionRange(formattedVal.length, formattedVal.length);
          }
        }
      }

      let parentContainer = groupEl.parentNode;
      let hintEl = parentContainer ? parentContainer.querySelector('.tel-input-hint') : null;
      if (!hintEl && parentContainer) {
        hintEl = document.createElement('p');
        hintEl.className = 'tel-input-hint text-[11px] font-semibold mt-1 transition-all';
        parentContainer.appendChild(hintEl);
      }

      const isRequired = inputEl.hasAttribute('required');

      if (!raw) {
        if (isRequired) {
          if (hintEl) {
            hintEl.textContent = `Please enter a valid ${countryInfo.name} phone number.`;
            hintEl.style.color = '#dc2626';
            hintEl.style.display = 'block';
          }
          inputEl.classList.add('border-red-500', 'ring-2', 'ring-red-500');
          delete inputEl.dataset.e164;
          return false;
        } else {
          if (hintEl) {
            hintEl.textContent = '';
            hintEl.style.display = 'none';
          }
          inputEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500', 'border-emerald-500');
          delete inputEl.dataset.e164;
          return true;
        }
      }

      let isValid = false;
      let e164 = '';
      let isMismatch = false;

      if (lib && typeof lib.parsePhoneNumber === 'function') {
        try {
          const parsed = lib.parsePhoneNumber(cleanDigits, currentISO);
          if (parsed && parsed.isValid()) {
            if (parsed.country && parsed.country !== currentISO) {
              isMismatch = true;
              isValid = false;
            } else {
              isValid = true;
              e164 = parsed.format('E.164');
            }
          }
        } catch (e) {
          isValid = false;
        }
      } else {
        isValid = fallbackPhoneValidation(cleanDigits.replace(/[^0-9]/g, ''), currentISO);
      }

      if (isValid) {
        if (hintEl) {
          hintEl.textContent = `✓ Valid ${countryInfo.name} phone number`;
          hintEl.style.color = '#059669';
          hintEl.style.display = 'block';
        }
        inputEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500', 'border-amber-400');
        inputEl.classList.add('border-emerald-500');
        inputEl.dataset.e164 = e164 || `${countryInfo.dialCode}${cleanDigits.replace(/[^0-9]/g, '').replace(/^0/, '')}`;
        return true;
      } else {
        if (hintEl) {
          hintEl.textContent = `Please enter a valid ${countryInfo.name} phone number.`;
          hintEl.style.color = '#dc2626';
          hintEl.style.display = 'block';
        }
        inputEl.classList.add('border-red-500', 'ring-2', 'ring-red-500');
        inputEl.classList.remove('border-emerald-500');
        delete inputEl.dataset.e164;
        return false;
      }
    }

    function syncAllTelInputs(formEl) {
      const scope = formEl || document;
      scope.querySelectorAll('input[type="tel"]').forEach(input => {
        validateSinglePhoneField(input);
      });
    }

    window.validateSinglePhoneField = validateSinglePhoneField;
    window.syncAllTelInputs = syncAllTelInputs;

    function validateSingleEmailField(inputEl) {
      if (!inputEl) return true;
      const raw = inputEl.value.trim();
      
      let parentContainer = inputEl.parentNode;
      let hintEl = parentContainer ? parentContainer.querySelector('.email-input-hint') : null;
      if (!hintEl && parentContainer) {
        hintEl = document.createElement('p');
        hintEl.className = 'email-input-hint text-[11px] font-semibold mt-1 transition-all';
        parentContainer.appendChild(hintEl);
      }

      const isRequired = inputEl.hasAttribute('required');

      if (!raw) {
        if (isRequired) {
          if (hintEl) {
            hintEl.textContent = 'Please enter a valid email address.';
            hintEl.style.color = '#dc2626';
            hintEl.style.display = 'block';
          }
          inputEl.classList.add('border-red-500', 'ring-2', 'ring-red-500');
          return false;
        } else {
          if (hintEl) {
            hintEl.textContent = '';
            hintEl.style.display = 'none';
          }
          inputEl.classList.remove('border-red-500', 'ring-2', 'ring-red-500', 'border-emerald-500');
          return true;
        }
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      const isValid = emailRegex.test(raw);

      if (isValid) {
        if (hintEl) {
          hintEl.textContent = '✓ Valid email address';
          hintEl.style.color = '#059669';
          hintEl.style.display = 'block';
        }
