          hiddenInput.value = initialIso;
          activateTab(customBtn);
          updateCustomBtnLabel(initialIso);
          filterTimeSlots(initialIso);
          if (fp) fp.setDate(initialIso, false);
        }
      } else {
        if (minCartIso === todayIso && !tabToday.disabled) {
          selectDate(today, tabToday);
        } else if (minCartIso === tomorrowIso && !tabTomorrow.disabled) {
          selectDate(tomorrow, tabTomorrow);
        } else if (minCartIso === dayAfterIso && !tabDayAfter.disabled) {
          selectDate(dayAfter, tabDayAfter);
        } else {
          hiddenInput.value = minCartIso;
          activateTab(customBtn);
          updateCustomBtnLabel(minCartIso);
          filterTimeSlots(minCartIso);
          if (fp) fp.setDate(minCartIso, false);
        }
      }

      // Event Listeners for Date Tabs
      tabToday.addEventListener('click', (e) => {
        e.preventDefault();
        if (!tabToday.disabled) { selectDate(today, tabToday); window.saveCartPick(block, { date: todayIso }); }
      });

      tabTomorrow.addEventListener('click', (e) => {
        e.preventDefault();
        if (!tabTomorrow.disabled) { selectDate(tomorrow, tabTomorrow); window.saveCartPick(block, { date: tomorrowIso }); }
      });

      tabDayAfter.addEventListener('click', (e) => {
        e.preventDefault();
        if (!tabDayAfter.disabled) { selectDate(dayAfter, tabDayAfter); window.saveCartPick(block, { date: dayAfterIso }); }
      });

      if (customBtn) {
        customBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (fp) {
            fp.open();
          } else if (calendarPicker) {
            calendarPicker.type = 'date';
            calendarPicker.focus();
            if (typeof calendarPicker.showPicker === 'function') calendarPicker.showPicker();
          }
        });
      }

      timeSelect.addEventListener('change', (e) => {
        filterTimeSlots(hiddenInput.value);
        if (e.isTrusted && timeSelect.value) window.saveCartPick(block, { time: timeSelect.value });
        else window.scheduleCartLineDateSync();
      });
    };

    // ---- Per-item delivery dates (items that need more notice than the shared picker) ----
    const GULF_SUNDAY_OK = ['AE', 'UAE', 'ID', 'SA', 'QA', 'OM', 'KW', 'BH'];

    function toISO(d) {
      return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    }

    // Earliest valid date for one item, never earlier than the date chosen in the shared picker
    window.getItemDeliveryDate = function(form, selectedISO) {
      if (!form || !selectedISO) return selectedISO;
      const adv = parseInt(form.dataset.effectiveAdvance, 10) || 0;
      if (adv <= (window.__cartPickerAdvance || 0)) return selectedISO;

      const mode = localStorage.getItem('delivery_mode') || 'india';
      const cc = (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
      const isIntl = mode === 'international' && cc !== 'IN';
      const noSunday = form.dataset.noSunday === 'true' || (isIntl && !GULF_SUNDAY_OK.includes(cc));
      const noWeekend = form.dataset.noWeekend === 'true';

      const now = new Date();
      const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + adv);
      const parts = selectedISO.split('-').map(Number);
      const sel = new Date(parts[0], parts[1] - 1, parts[2]);
      if (sel > d) d.setTime(sel.getTime());
      while ((noSunday && d.getDay() === 0) || (noWeekend && (d.getDay() === 0 || d.getDay() === 6))) {
        d.setDate(d.getDate() + 1);
      }
      return toISO(d);
    };

    function prettyDate(iso) {
      if (!iso) return '';
      const p = iso.split('-').map(Number);
      return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    // Category name shown on date boxes (never the product name)
    const CART_CATEGORY_NAMES = {
      cake: ['Cakes', 'cake'], flower: ['Flowers', 'flower'], hamper: ['Hampers', 'hamper'],
      chocolate: ['Chocolates', 'chocolate'], plant: ['Plants', 'plant'], idol: ['Idols', 'idol'], gift: ['Gifts', 'gift']
    };
    function cartFormCategories(form) {
      if (!form) return ['gift'];
      if (form.dataset.boxCategories) return form.dataset.boxCategories.split(',');
      return [form.dataset.category || (form.dataset.isCake === 'true' ? 'cake' : 'gift')];
    }
    function joinNames(list) {
      return list.length > 1 ? list.slice(0, -1).join(', ') + ' & ' + list[list.length - 1] : (list[0] || '');
    }
    // Category label for a date box, built from the items that actually share it (e.g. "Flowers & Hampers")
    window.cartDateCategoryLabel = function(form) {
      return joinNames(cartFormCategories(form).map(c => (CART_CATEGORY_NAMES[c] || CART_CATEGORY_NAMES.gift)[0]));
    };
    window.cartDateCategoryNoun = function(form) {
      return joinNames(cartFormCategories(form).map(c => (CART_CATEGORY_NAMES[c] || CART_CATEGORY_NAMES.gift)[1]));
    };

    // Per-item delivery date for a cart line: its own date box if it has one, else the main date.
    window.getLineDeliveryDate = function(form) {
      if (form && form.dataset.dateLeader) {
        const leader = document.querySelector(`.item-delivery-form[data-item-line="${form.dataset.dateLeader}"]`);
        if (leader && leader !== form) return window.getLineDeliveryDate(leader);
      }
      const main = document.querySelector('.item-delivery-form[data-line="all"]');
      if (form && form.dataset.ownDate === 'true') {
        const own = form.querySelector('.cart-date-input');
        return own ? (own.value || '').trim() : '';
      }
      const mainVal = main ? ((main.querySelector('.cart-date-input') || {}).value || '').trim() : '';
      return form ? window.getItemDeliveryDate(form, mainVal) : mainVal;
    };

    // When cakes and flowers have separate date boxes, show under each picked date what it is for
    function renderDateCategoryNotes(allForms, multi) {
      allForms.forEach(f => {
        const block = f.querySelector('.cart-date-picker-block');
        if (!block) return;
        let note = block.querySelector('.date-category-note');
        const isBox = f.dataset.line === 'all' || f.dataset.ownDate === 'true';
        const input = f.querySelector('.cart-date-input');
        const val = input ? (input.value || '').trim() : '';
        if (!multi || !isBox || !val) {
          if (note) note.style.display = 'none';
          return;
        }
        if (!note) {
          note = document.createElement('div');
          note.className = 'date-category-note';
          note.setAttribute('role', 'status');
          note.setAttribute('aria-live', 'polite');
          note.style.cssText = 'margin-top:10px;padding:8px 12px;border-radius:10px;font-size:13px;font-weight:600;background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0;transition:box-shadow .3s;';
          block.appendChild(note);
        }
        const text = 'This is for ' + window.cartDateCategoryNoun(f) + ' delivery.';
        note.textContent = '🛈 ' + text + ' (' + prettyDate(val) + ')';
        note.style.display = 'block';
        if (note.dataset.lastVal !== val) {
          note.dataset.lastVal = val;
          note.style.boxShadow = '0 0 0 3px rgba(16,185,129,.35)';
          setTimeout(() => { note.style.boxShadow = 'none'; }, 900);
        }
      });
    }

    // Keeps the "🚚 Delivery: <date>" badge under each cart row in sync with the date boxes
    function renderPerItemDateNotice(allForms) {
      document.querySelectorAll('.per-item-date-notice').forEach(el => el.remove());
      const multi = allForms.some(f => f.dataset.ownDate === 'true');
      renderDateCategoryNotes(allForms, multi);
      allForms.forEach(f => {
        const badge = document.querySelector(`.line-delivery-date[data-line="${f.dataset.itemLine}"]`);
        if (!badge) return;
        const d = window.getLineDeliveryDate(f);
        if (multi && d) {
          badge.textContent = `🚚 Delivery: ${prettyDate(d)}`;
          badge.style.display = 'block';
        } else {
          badge.style.display = 'none';
        }
      });

      // Refresh badges whenever any date box changes (pickers set hidden inputs programmatically)
      allForms.forEach(f => {
        const input = f.querySelector('.cart-date-input');
        if (!input || input.dataset.scheduleWatch) return;
        input.dataset.scheduleWatch = 'true';
        let last = input.value;
        setInterval(() => {
          if (input.value !== last) {
            last = input.value;
            renderPerItemDateNotice(Array.from(document.querySelectorAll('.item-delivery-form')).filter(x => {
              const t = (x.dataset.itemTitle || '').toLowerCase();
              return !t.includes('surcharge') && !t.includes('delivery charge');
            }));
          }
        }, 400);
      });
    }

    window.initAllCartDatePickers = function() {
      // Exclude any surcharge forms
      const allForms = Array.from(document.querySelectorAll('.item-delivery-form')).filter(form => {
        const title = (form.dataset.itemTitle || '').toLowerCase();
        return !title.includes('surcharge') && !title.includes('delivery charge');
      });
      if (allForms.length === 0) return;

      const deliveryMode = localStorage.getItem('delivery_mode') || 'india';
      const userCountryCode = (localStorage.getItem('user_country_code') || 'IN').toUpperCase().trim();
      const isIntl = (deliveryMode === 'international') && (userCountryCode !== 'IN');
      const isUsaOrUk = isIntl && (userCountryCode === 'US' || userCountryCode === 'GB');

      // Each item keeps its own advance-day rule (e.g. intl flowers next day, intl cakes 2 days).
      // The shared picker allows the EARLIEST date any item can make; items needing more notice
      // are moved to their own earliest date when saved (see getItemDeliveryDate).
      let maxAdv = null;
      let cartHasLondonSdd = false;
      allForms.forEach(form => {
        let adv = parseInt(form.dataset.advanceDays, 10) || 0;
        let isCake = form.dataset.isCake === 'true';
        if (isUsaOrUk && isCake) {
          adv = Math.max(adv, 2);
        }
        form.dataset.effectiveAdvance = adv;
        if (maxAdv === null || adv < maxAdv) maxAdv = adv;

        if (form.dataset.isLondon === 'true' && form.dataset.hasSdd === 'true') {
          cartHasLondonSdd = true;
        }
      });
      maxAdv = maxAdv || 0;

      const firstForm = allForms[0];
      const ukLoc = typeof checkUkDeliveryLocation === 'function' ? checkUkDeliveryLocation(firstForm) : { isUk: false, isLondon: false, isOtherUk: false };
      if (ukLoc.isUk && cartHasLondonSdd) {
        if (ukLoc.isOtherUk) {
          maxAdv = Math.max(maxAdv, 1);
        }
      }

      // One address form for the whole cart (first item). Items whose delivery rules differ from the
      // first item (e.g. cake 2 days vs flowers next day) get their OWN date box, showing only the date picker.
      // One date box per category (Cakes vs Flowers & Gifts). Items of the same category share a box;
      // a category with different rules (advance days / Sunday / weekend) gets its own box too.
      // Each category (cake / flower / hamper / chocolate / plant / idol / gift) gets its own date box
      const catOf = f => f.dataset.category || (f.dataset.isCake === 'true' ? 'cake' : 'gift');
      const ruleKey = f => [catOf(f), parseInt(f.dataset.effectiveAdvance, 10) || 0, f.dataset.noSunday, f.dataset.noWeekend].join('|');
      const mainKey = ruleKey(firstForm);
      const mainAdv = Math.max(parseInt(firstForm.dataset.effectiveAdvance, 10) || 0, (ukLoc.isUk && cartHasLondonSdd && ukLoc.isOtherUk) ? 1 : 0);
      window.__cartPickerAdvance = mainAdv;
      const leaders = {};
      leaders[mainKey] = firstForm;
      let hasOwnBox = false;

      // Which item categories share each date box, so its title/note names them correctly
      const boxCats = {};
      allForms.forEach(f => {
        const k = ruleKey(f);
        const c = f.dataset.category || (f.dataset.isCake === 'true' ? 'cake' : 'gift');
        (boxCats[k] = boxCats[k] || []).includes(c) || boxCats[k].push(c);
      });
      allForms.forEach(f => { f.dataset.boxCategories = boxCats[ruleKey(f)].join(','); });

      allForms.forEach((form, index) => {
        delete form.dataset.dateLeader;
        const key = ruleKey(form);
        if (index === 0) {
          form.style.display = 'block';
          form.dataset.line = 'all';
          form.dataset.ownDate = 'false';
          window.initCartDatePicker(form.querySelector('.cart-date-picker-block'), mainAdv);
        } else if (key === mainKey) {
          form.style.display = 'none';
          form.dataset.ownDate = 'false';
        } else if (!leaders[key]) {
          leaders[key] = form;
          hasOwnBox = true;
          showOwnDateBox(form);
          window.initCartDatePicker(form.querySelector('.cart-date-picker-block'), parseInt(form.dataset.effectiveAdvance, 10) || 0);
        } else {
          // Same category as an existing own box: follow that box's date
          form.style.display = 'none';
          form.dataset.ownDate = 'false';
          form.dataset.dateLeader = leaders[key].dataset.itemLine;
        }
      });

      const subtitle = firstForm.querySelector('.form-subtitle');
      if (subtitle) {
        subtitle.textContent = hasOwnBox
          ? 'Delivery date here applies to: ' + window.cartDateCategoryLabel(firstForm)
          : 'Applied to all items in cart';
      }
      const mainDateLabel = firstForm.querySelector('.cart-date-picker-block label');
      if (mainDateLabel) {
        mainDateLabel.textContent = hasOwnBox
          ? 'Date and Time of Delivery · ' + window.cartDateCategoryLabel(firstForm)
          : 'Date and Time of Delivery';
      }
      renderPerItemDateNotice(allForms);
      // Make the cart lines match what the boxes show (restored picks, enforced minimum dates)
      window.scheduleCartLineDateSync();
    };

    // Turn a hidden per-item form into a compact "Delivery date for <item>" box (date picker only)
    function showOwnDateBox(form) {
      form.dataset.ownDate = 'true';
      form.style.display = 'block';
      const block = form.querySelector('.cart-date-picker-block');
      const container = form.querySelector('.address-fields-container');
      if (container) {
        Array.from(container.children).forEach(child => {
          if (child !== block) child.style.display = 'none';
        });
      }
      const h3 = form.querySelector('.address-form-header h3');
      if (h3) {
        h3.dataset.ownDateTitle = 'true';
        h3.innerHTML = '<span style="font-size:18px;">📅</span> Delivery date for ' + window.cartDateCategoryLabel(form);
      }
      const adv = parseInt(form.dataset.effectiveAdvance, 10) || 0;
      const sub = form.querySelector('.form-subtitle');
      if (sub) sub.textContent = adv > 0 ? `Needs ${adv} day${adv > 1 ? 's' : ''} notice · same address as above` : 'Same address as above';
    }

    // Auto Pre-fill from line item properties
    document.querySelectorAll('.delivery-address-form').forEach(form => {
      let existingProps = {};
      try {
        if (form.dataset.existingProperties) {
          existingProps = JSON.parse(form.dataset.existingProperties);
        }
      } catch(e) {}

      const dateVal = existingProps['Delivery Date'] || existingProps['Delivery_Date'] || existingProps['Date'];
      const timeVal = existingProps['Delivery Time'] || existingProps['Delivery_Time'] || existingProps['Time'];

      if (dateVal) {
        const dateInput = form.querySelector('.cart-date-input');
        if (dateInput) dateInput.value = normalizeToISODate(dateVal);
      }
      if (timeVal) {
        const timeSelect = form.querySelector('.delivery-time-select');
        if (timeSelect) {
          for (let i = 0; i < timeSelect.options.length; i++) {
            const optVal = timeSelect.options[i].value;
            if (optVal && (optVal === timeVal || optVal.toLowerCase().includes(timeVal.toLowerCase()) || timeVal.toLowerCase().includes(optVal.toLowerCase()))) {
              timeSelect.selectedIndex = i;
              break;
            }
          }
        }
      }

      // Re-evaluate delivery date rules when delivery location fields change
      const cityInput = form.querySelector('[data-prop="Delivery_City"]');
      const postcodeInput = form.querySelector('[data-prop="Delivery_Postcode"]');
      if (cityInput && !cityInput._ukListener) {
        cityInput._ukListener = true;
        cityInput.addEventListener('change', () => {
          if (typeof window.initAllCartDatePickers === 'function') window.initAllCartDatePickers();
        });
      }
      if (postcodeInput && !postcodeInput._ukListener) {
        postcodeInput._ukListener = true;
        postcodeInput.addEventListener('change', () => {
          if (typeof window.initAllCartDatePickers === 'function') window.initAllCartDatePickers();
        });
      }
    });

    // Run Initialization
    window.initAllCartDatePickers();

    // Live Countdown Timer
    function updateCartCountdowns() {
      const now = new Date();
      const cutoff = new Date(now.getFullYear(), now.getMonth(), now.getDate(), SAMEDAY_CUTOFF, 0, 0);
      const diff   = cutoff - now;

      document.querySelectorAll('.cart-date-picker-block').forEach(block => {
        const el = block.querySelector('.delivery-countdown');
        const tabToday = block.querySelector('.date-tab-today');
        if (!el) return;

        const form = block.closest('.delivery-address-form');
        const ukLoc = typeof checkUkDeliveryLocation === 'function' ? checkUkDeliveryLocation(form) : { isUk: false, isLondon: false };
        const hasLondonSdd = form && form.dataset.isLondon === 'true' && form.dataset.hasSdd === 'true';

        if (tabToday && tabToday.disabled) {
          el.style.display = 'none';
          return;
        }

        const mode = localStorage.getItem('delivery_mode') || 'india';
        if (mode === 'international' && !(ukLoc.isLondon && hasLondonSdd)) {
          el.style.display = 'none';
          return;
        }

        el.style.display = 'inline';
        if (diff > 0) {
          const h = Math.floor(diff / 3600000);
          const m = Math.floor((diff % 3600000) / 60000);
          const s = Math.floor((diff % 60000) / 1000);
          el.innerHTML = '<span class="text-secondary font-bold">' + h + 'h ' + m + 'm ' + s + 's</span> left for today';
        } else {
          el.innerHTML = '<span class="text-rose-600 font-bold">Today\'s delivery closed</span>';
        }
      });
    }
    updateCartCountdowns();
    setInterval(updateCartCountdowns, 1000);

    // Run on initial load
    updateShipmentNotice();

    // Live sync address fields to hidden form inputs so discount apps (Scala) cannot wipe attributes
    function syncLiveCartAttributes() {
      const forms = document.querySelectorAll('.delivery-address-form');
      const mainCartForm = document.querySelector('form[action^="/cart"]') || document.querySelector('form#cart');
      if (!mainCartForm) return;

      forms.forEach((form, idx) => {
        const fields = form.querySelectorAll('.addr-field');
        const properties = {};
        fields.forEach(field => {
          const val = field.type === 'checkbox' ? (field.checked ? field.value : '') : (field.type === 'tel' && field.dataset.e164 ? field.dataset.e164 : field.value);
          if (val) properties[field.dataset.prop] = val;
        });

        const title = properties['Delivery_Title'] || '';
        const fName = properties['Delivery_FirstName'] || '';
        const lName = properties['Delivery_LastName'] || '';
        const address = properties['Delivery_Address'] || '';
        const landmark = properties['Delivery_Landmark_IN'] || '';
        const houseNo = properties['Delivery_HouseNo'] || '';
        const city = properties['Delivery_City'] || properties['City'] || '';
        const state = properties['Delivery_State'] || '';
        const postcode = properties['Delivery_Postcode'] || '';
        const mobile = properties['Delivery_Mobile'] || '';
        const giftMsg = properties['Delivery_GiftMessage'] || '';
        const senderName = properties['Sender_Name'] || '';
        const senderMobile = properties['Sender_Mobile'] || '';
        const senderEmail = properties['Sender_Email'] || '';
        const delDate = properties['Delivery Date'] || properties['Delivery_Date'] || '';
        const delTime = properties['Delivery Time'] || properties['Delivery_Time'] || '';

        if (idx === 0) {
          const rawCountry = properties['Delivery_Country'] || (getDeliveryMode() === 'india' ? 'India' : '');
          const isoCountry = (typeof normaliseCountryToIso === 'function' ? normaliseCountryToIso(rawCountry) : (rawCountry || 'IN')).toUpperCase();
          const fullCountryName = (isoCountry === 'IN' ? 'India' : (rawCountry || isoCountry));

          const attrs = {};
          attrs['Delivery_Country'] = isoCountry;
          attrs['Delivery Country'] = fullCountryName;
          attrs['Delivery_City'] = city;
          attrs['Delivery City'] = city;
          attrs['City'] = city;
          attrs['Delivery_State'] = state;
          attrs['Delivery State'] = state;
          attrs['Delivery_Postcode'] = postcode;
          attrs['Delivery Postcode'] = postcode;
          if (title) attrs['Delivery_Title'] = title;
          if (fName) attrs['Delivery_FirstName'] = fName;
          if (lName) attrs['Delivery_LastName'] = lName;
          if (houseNo) attrs['Delivery_HouseNo'] = houseNo;
          if (landmark) attrs['Delivery_Landmark_IN'] = landmark;
          if (mobile) attrs['Delivery_Mobile'] = mobile;
          if (giftMsg) attrs['Delivery_GiftMessage'] = giftMsg;
          if (senderName) attrs['Sender_Name'] = senderName;
          if (senderMobile) attrs['Sender_Mobile'] = senderMobile;
          if (senderEmail) attrs['Sender_Email'] = senderEmail;

          if (fName || lName) attrs[`Recipient Name`] = `${title} ${fName} ${lName}`.trim();
          if (address || houseNo) attrs[`Delivery Address`] = `${houseNo ? houseNo + ', ' : ''}${address}${landmark ? ', ' + landmark : ''}${city ? ', ' + city : ''}${state ? ', ' + state : ''}${postcode ? ' - ' + postcode : ''}`;
          if (mobile) attrs[`Recipient Phone`] = mobile;
          if (giftMsg) attrs[`Gift Message`] = giftMsg;
          if (senderName) attrs[`Sender Name`] = senderName;
          if (senderMobile) attrs[`Sender Phone`] = senderMobile;
          if (senderEmail) attrs[`Sender Email`] = senderEmail;
          if (delDate) attrs[`Delivery Date`] = delDate;
          if (delTime) attrs[`Delivery Time`] = delTime;

          Object.keys(attrs).forEach(attrKey => {
            let hiddenInput = mainCartForm.querySelector(`input[name="attributes[${CSS.escape(attrKey)}]"]`);
            if (!hiddenInput) {
              hiddenInput = document.createElement('input');
              hiddenInput.type = 'hidden';
              hiddenInput.name = `attributes[${attrKey}]`;
              mainCartForm.appendChild(hiddenInput);
            }
            hiddenInput.value = attrs[attrKey];
          });
        }
      });
    }

    document.querySelectorAll('.addr-field').forEach(field => {
      field.addEventListener('input', syncLiveCartAttributes);
      field.addEventListener('change', syncLiveCartAttributes);
    });
    syncLiveCartAttributes();

    // Guarantee server attributes immediately on cart page load
    (function autoSyncServerCartAttrs() {
      const serverCountry = '{{ cart.attributes.Delivery_Country | default: "" }}';
      if (!serverCountry) {
        const mode = getDeliveryMode();
        const iso = (mode === 'india' ? 'IN' : (localStorage.getItem('user_country_code') || 'IN')).toUpperCase();
        const full = (iso === 'IN' ? 'India' : (localStorage.getItem('user_country') || iso));
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ attributes: { 'Delivery_Country': iso, 'Delivery Country': full } })
        }).catch(() => {});
      }
    })();

    window.saveCartDeliveryDetailsToStorage = function() {
      const saveCb = document.getElementById('save-delivery-details-cb');
      const firstForm = document.querySelector('.delivery-address-form');
      if (!firstForm) return;
      
      const formData = {};
      firstForm.querySelectorAll('.addr-field').forEach(field => {
        const key = field.dataset.prop;
        if (!key) return;
        if (field.type === 'checkbox') {
          formData[key] = field.checked ? field.value : '';
        } else {
          formData[key] = field.value || '';
        }
      });

      const dateInput = firstForm.querySelector('.cart-date-input') || document.querySelector('.cart-date-input');
      if (dateInput && dateInput.value) formData['Delivery Date'] = dateInput.value;

      const timeSelect = firstForm.querySelector('.delivery-time-select') || document.querySelector('.delivery-time-select');
      if (timeSelect && timeSelect.value) formData['Delivery Time'] = timeSelect.value;

      // Always save to sessionStorage to survive redirects (e.g. login)
      try {
        sessionStorage.setItem('floral_session_delivery_details', JSON.stringify(formData));
      } catch(e) {}

      if (saveCb && !saveCb.checked) {
        try { localStorage.removeItem('floral_saved_delivery_details'); } catch(e) {}
      } else {
        try {
          localStorage.setItem('floral_saved_delivery_details', JSON.stringify(formData));
        } catch(e) {}

        const badge = document.getElementById('saved-details-badge');
        if (badge) {
          badge.classList.remove('hidden');
          setTimeout(() => badge.classList.add('hidden'), 2500);
        }
      }
    };

    function getFloralCookie(name) {
      if (typeof window.getFloralCookie === 'function') return window.getFloralCookie(name);
      let nameEQ = name + "=";
      let ca = document.cookie.split(';');
      for(let i = 0; i < ca.length; i++) {
        let c = ca[i];
        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) == 0) return decodeURIComponent(c.substring(nameEQ.length, c.length));
      }
      return null;
    }

    function setFloralCookie(name, value, days = 365) {
      if (typeof window.setFloralCookie === 'function') return window.setFloralCookie(name, value, days);
      let expires = "";
      if (days) {
        let date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toUTCString();
      }
      document.cookie = name + "=" + (encodeURIComponent(value) || "") + expires + "; path=/; SameSite=Lax";
    }

    // ---- Postcode guard: clears values that are not a real postal code for the selected country ----
    // (e.g. "bell" saved from a place name) and unlocks the field so the customer can type it.
    function postcodeCountryCode(form) {
      const mode = (localStorage.getItem('delivery_mode') || 'india').toLowerCase();
      if (mode === 'india') return 'IN';
      const cf = form.querySelector('[data-prop="Delivery_Country"]');
      const raw = (cf && cf.value) || localStorage.getItem('user_country_code') || '';
      const cc = typeof normaliseCountryToIso === 'function' ? normaliseCountryToIso(raw) : raw;
      return (cc || localStorage.getItem('user_country_code') || '').toUpperCase();
    }
    function isValidPostcode(z, cc) {
      z = (z || '').trim();
      if (!z) return false;
      if (cc === 'US') return /^\d{5}(-\d{4})?$/.test(z);
      if (cc === 'IN') return /^\d{6}$/.test(z);
      return /\d/.test(z) && /^[A-Za-z0-9 \-]{2,10}$/.test(z);
    }
    window.sanitizeCartPostcodes = function() {
      document.querySelectorAll('.delivery-address-form').forEach(form => {
        const pinField = form.querySelector('[data-prop="Delivery_Postcode"]');
        if (!pinField || !pinField.value.trim()) return;
        const cc = postcodeCountryCode(form);
        if (isValidPostcode(pinField.value, cc)) return;
        pinField.value = '';
        pinField.readOnly = false;
        pinField.classList.remove('bg-gray-100', 'bg-gray-50', 'text-gray-500', 'cursor-not-allowed');
        pinField.classList.add('bg-white', 'text-gray-900');
        pinField.placeholder = cc === 'US' ? 'ZIP code * (5 digits)' : 'Postcode *';
        if (cc !== 'IN') {
          localStorage.removeItem('user_intl_zip');
          if (typeof setFloralCookie === 'function') setFloralCookie('user_intl_zip', '', -1);
        }
      });
    };

    window.lockCartLocationFields = function() {
      const mode = (localStorage.getItem('delivery_mode') || getFloralCookie('delivery_mode') || 'india').toLowerCase();
      const uCity = (localStorage.getItem('user_city') || getFloralCookie('user_city') || '').trim();
      const uState = (localStorage.getItem('user_state') || getFloralCookie('user_state') || '').trim();
      const uPin = (localStorage.getItem('user_pincode') || getFloralCookie('user_pincode') || '').trim();
      const uCountry = mode === 'india' ? 'India' : (localStorage.getItem('user_country') || getFloralCookie('user_country') || 'United States').trim();
      const uLocation = (localStorage.getItem('user_location') || getFloralCookie('user_location') || '').trim();

      document.querySelectorAll('.delivery-address-form').forEach(form => {
        const cityField = form.querySelector('[data-prop="Delivery_City"]');
        const stateField = form.querySelector('[data-prop="Delivery_State"]');
        const pinField = form.querySelector('[data-prop="Delivery_Postcode"]');
        const countryField = form.querySelector('[data-prop="Delivery_Country"]');
        const addrInput = form.querySelector('[data-prop="Delivery_Address"]');
        const acInput = form.querySelector('.intl-location-input');

        const applyLock = (el, val) => {
          if (!el) return;
          if (val) {
            el.value = val;
            el.readOnly = true;
            el.classList.add('bg-gray-50', 'text-gray-500', 'cursor-not-allowed');
            el.classList.remove('bg-white');
            
            let wrapper = el.parentNode;
            if (!wrapper.classList.contains('locked-wrapper')) {
              const newWrapper = document.createElement('div');
              newWrapper.className = 'relative locked-wrapper w-full';
              wrapper.insertBefore(newWrapper, el);
              newWrapper.appendChild(el);
            }
          } else {
            el.readOnly = false;
            el.classList.remove('bg-gray-50', 'text-gray-500', 'cursor-not-allowed');
            el.classList.add('bg-white');
            let wrapper = el.parentNode;
            if (wrapper && wrapper.classList.contains('locked-wrapper')) {
              wrapper.outerHTML = wrapper.innerHTML; // Unwrap
            }
          }
        };

        if (mode === 'india') {
          applyLock(countryField, 'India');
          applyLock(cityField, uCity);
          applyLock(stateField, uState);
          applyLock(pinField, uPin);

          // Authoritative address for India pincode
          let targetAddress = uLocation;
          if (!targetAddress) {
            targetAddress = [uCity, uState].filter(Boolean).join(', ') + (uPin ? ' - ' + uPin : '');
          }

          if (targetAddress) {
            applyLock(addrInput, targetAddress);
            if (acInput) {
              const currVal = (acInput.value || '').trim();
              const isForeign = /united states|usa|\bus\b|canada|\buk\b|australia|county|\btx\b|\bny\b|\bca\b/i.test(currVal);
              if (!currVal || isForeign || (uPin && !currVal.includes(uPin) && !currVal.includes(uCity))) {
                acInput.value = targetAddress;
              }
            }
          }
        } else {
          // International Mode
          let uIntlZip = (localStorage.getItem('user_intl_zip') || getFloralCookie('user_intl_zip') || '').trim();
          // Discard a saved "ZIP" that is really a place name (e.g. "bell") from older popup versions
          const intlCC = (localStorage.getItem('user_country_code') || '').toUpperCase();
          const zipLooksValid = intlCC === 'US' ? /^\d{5}(-\d{4})?$/.test(uIntlZip) : (/\d/.test(uIntlZip) && /^[A-Za-z0-9 \-]{2,10}$/.test(uIntlZip));
          if (uIntlZip && !zipLooksValid) {
            uIntlZip = '';
            localStorage.removeItem('user_intl_zip');
            if (typeof setFloralCookie === 'function') setFloralCookie('user_intl_zip', '', -1);
          }
          const uIntlLocality = (localStorage.getItem('user_intl_locality') || getFloralCookie('user_intl_locality') || '').trim();
          const uIntlCity = (localStorage.getItem('user_intl_city') || getFloralCookie('user_intl_city') || '').trim();
          const uIntlState = (localStorage.getItem('user_intl_state') || getFloralCookie('user_intl_state') || '').trim();

          let iCity = uIntlCity || uIntlLocality;
          let iState = uIntlState;
          if (!iState && uIntlLocality.includes(',')) {
            const parts = uIntlLocality.split(',').map(p => p.trim());
            iState = parts.pop();
            iCity = parts.join(', ');
          }

          applyLock(countryField, uCountry || 'United States');
          applyLock(cityField, iCity);
          applyLock(stateField, iState);
          applyLock(pinField, uIntlZip);
          // No valid ZIP saved: let the customer type it here
          if (!uIntlZip && pinField) {
            const cur = (pinField.value || '').trim();
            const curValid = intlCC === 'US' ? /^\d{5}(-\d{4})?$/.test(cur) : (/\d/.test(cur) && /^[A-Za-z0-9 \-]{2,10}$/.test(cur));
            if (!curValid) pinField.value = '';
            pinField.readOnly = false;
            pinField.classList.remove('bg-gray-100', 'bg-gray-50', 'text-gray-500', 'cursor-not-allowed');
            pinField.classList.add('bg-white', 'text-gray-900');
            pinField.placeholder = intlCC === 'US' ? 'ZIP code * (5 digits)' : 'Postcode *';
          }

          let prefill = [uIntlLocality, iCity, iState, uIntlZip, uCountry].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i).join(', ');
          if (prefill) {
            applyLock(addrInput, prefill);
            if (acInput) {
              const currVal = (acInput.value || '').trim();
              const isIndiaVal = /india|\bdelhi\b|\bmumbai\b|\bkolkata\b|\bbangalore\b|\bchennai\b|\b1100\d\d\b/i.test(currVal);
              if (!currVal || isIndiaVal || (uIntlZip && !currVal.includes(uIntlZip))) {
                acInput.value = prefill;
              }
            }
          }
        }
      });
      syncLiveCartAttributes();
    };

    window.restoreCartDeliveryDetailsFromStorage = function() {
      const savedJSON = sessionStorage.getItem('floral_session_delivery_details') || localStorage.getItem('floral_saved_delivery_details');
      if (!savedJSON) return;

      try {
        const formData = JSON.parse(savedJSON);
        if (!formData || typeof formData !== 'object') return;

        const mode = (localStorage.getItem('delivery_mode') || getFloralCookie('delivery_mode') || 'india').toLowerCase();
        const activePin = (mode === 'india' ? (localStorage.getItem('user_pincode') || getFloralCookie('user_pincode') || '') : (localStorage.getItem('user_intl_zip') || getFloralCookie('user_intl_zip') || '')).trim();
        const activeCountry = (mode === 'india' ? 'india' : (localStorage.getItem('user_country') || getFloralCookie('user_country') || 'united states')).trim().toLowerCase();

        // Check if saved location data conflicts with the current active mode or pincode
        const savedCountry = (formData['Delivery_Country'] || '').trim().toLowerCase();
        const savedPin = (formData['Delivery_Postcode'] || '').trim();
        const isLocationMismatched = (mode === 'india' && savedCountry && savedCountry !== 'india' && savedCountry !== 'in') ||
                                     (mode === 'international' && savedCountry && (savedCountry === 'india' || savedCountry === 'in')) ||
                                     (activePin && savedPin && activePin !== savedPin);

        const locationProps = ['Delivery_Country', 'Delivery_State', 'Delivery_City', 'Delivery_Postcode', 'Delivery_Address', 'Delivery_Landmark', 'Delivery_Landmark_IN'];

        let restoredAny = false;
        document.querySelectorAll('.delivery-address-form').forEach(form => {
          form.querySelectorAll('.addr-field').forEach(field => {
            const key = field.dataset.prop;
            if (!key || formData[key] === undefined || formData[key] === null || formData[key] === '') return;

            // Delivery date/time belong to each item (saved on the line item from its product page).
            // Never overwrite them with the last saved date — that put the cake's date on the flowers.
            // An empty date is still filled below (main box only).
            if (key === 'Delivery Date' || key === 'Delivery Time') return;

            // Discard mismatched location fields so stale addresses never bleed into the form
            if (isLocationMismatched && locationProps.includes(key)) return;

            if (field.type === 'checkbox') {
              field.checked = (formData[key] === field.value || formData[key] === 'Yes');
              restoredAny = true;
            } else {
              field.value = formData[key];
              restoredAny = true;
            }
          });
        });

        if (formData['Delivery Date']) {
          const dateInput = document.querySelector('.cart-date-input');
          if (dateInput) {
            // Only restore if dateInput is empty, otherwise trust the product page line item properties
            if (!dateInput.value || dateInput.value.trim() === '') {
              dateInput.value = formData['Delivery Date'];
              restoredAny = true;
            }
          }
        }

        if (restoredAny) {
          if (typeof window.sanitizeCartPostcodes === 'function') window.sanitizeCartPostcodes();
          document.querySelectorAll('.delivery-address-form').forEach(form => {
            const charCount = form.querySelector('.word-count-display');
            const gMsg = form.querySelector('[data-prop="Delivery_GiftMessage"]');
            if (charCount && gMsg && gMsg.value) {
              charCount.textContent = `${gMsg.value.length} / 150 chars`;
            }
            form.querySelectorAll('.addr-field').forEach(field => {
              field.classList.remove('border-red-500', 'ring-2', 'ring-red-500');
              const wrapper = field.closest('.addr-wrapper') || field.parentNode;
              const err = wrapper ? wrapper.querySelector('.field-error-hint') : null;
              if (err) err.remove();
            });
          });
          if (window.syncAllTelInputs) window.syncAllTelInputs();
          syncLiveCartAttributes();
          if (window.initAllCartDatePickers) window.initAllCartDatePickers();
        }
      } catch (err) {
        console.error('Error restoring saved cart delivery details:', err);
      }
    };

    // Always re-check the postcode after location fields are (re)locked
    if (window.lockCartLocationFields && !window.lockCartLocationFields.__postcodeGuard) {
      const origLock = window.lockCartLocationFields;
      window.lockCartLocationFields = function() {
        const r = origLock.apply(this, arguments);
        window.sanitizeCartPostcodes();
        return r;
      };
      window.lockCartLocationFields.__postcodeGuard = true;
    }
    // Final pass after all async prefills (Liquid defaults, saved details, autocomplete) have run
    window.addEventListener('load', function() { setTimeout(window.sanitizeCartPostcodes, 800); });

    // Restore on load and pageshow
    restoreCartDeliveryDetailsFromStorage();
    if (window.lockCartLocationFields) window.lockCartLocationFields();
    if (window.syncAllTelInputs) window.syncAllTelInputs();

    window.addEventListener('pageshow', function() {
      restoreCartDeliveryDetailsFromStorage();
      if (window.lockCartLocationFields) window.lockCartLocationFields();
      if (window.syncAllTelInputs) window.syncAllTelInputs();
    });

    window.syncCartToGlobalState = function(prop, val) {
      if (!val) return;
      const mode = (localStorage.getItem('delivery_mode') || 'india').toLowerCase();
      if (mode === 'india') {
        if (prop === 'Delivery_City') { localStorage.setItem('user_city', val); setFloralCookie('user_city', val, 365); }
        if (prop === 'Delivery_State') { localStorage.setItem('user_state', val); setFloralCookie('user_state', val, 365); }
        if (prop === 'Delivery_Postcode') { localStorage.setItem('user_pincode', val); setFloralCookie('user_pincode', val, 365); }
        if (prop === 'Delivery_Address' || prop === 'Delivery_Landmark') { localStorage.setItem('user_location', val); setFloralCookie('user_location', val, 365); }
      } else {
        if (prop === 'Delivery_Country') { localStorage.setItem('user_country', val); setFloralCookie('user_country', val, 365); }
        if (prop === 'Delivery_City') { localStorage.setItem('user_intl_city', val); setFloralCookie('user_intl_city', val, 365); }
        if (prop === 'Delivery_State') { localStorage.setItem('user_intl_state', val); setFloralCookie('user_intl_state', val, 365); }
        if (prop === 'Delivery_Postcode') { localStorage.setItem('user_intl_zip', val); setFloralCookie('user_intl_zip', val, 365); }
        if (prop === 'Delivery_Address' || prop === 'Delivery_Landmark') { localStorage.setItem('user_intl_locality', val); setFloralCookie('user_intl_locality', val, 365); }
      }
      if (typeof syncDeliveryStateUI === 'function') syncDeliveryStateUI();
    };

    // Auto save on input change (delegated to document for dynamic cart re-renders)
    document.addEventListener('input', (e) => {
      if (e.target.classList && e.target.classList.contains('addr-field')) {
        syncLiveCartAttributes();
        saveCartDeliveryDetailsToStorage();
        if (window.syncCartToGlobalState) window.syncCartToGlobalState(e.target.dataset.prop, e.target.value);
      }
    });
    document.addEventListener('change', (e) => {
      if (e.target.classList && e.target.classList.contains('addr-field')) {
        syncLiveCartAttributes();
        saveCartDeliveryDetailsToStorage();
        if (window.syncCartToGlobalState) window.syncCartToGlobalState(e.target.dataset.prop, e.target.value);
      } else if (e.target.id === 'save-delivery-details-cb') {
        if (e.target.checked) {
