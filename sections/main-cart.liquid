    let _attrSaveTimer = null;
    function normaliseCountryToIso(raw) {
      if ((localStorage.getItem('delivery_mode') || 'india') === 'india') return 'IN';
      const lc = (raw || '').toLowerCase().replace(/[^a-z]/g, '');
      if (['unitedstatesofamerica','unitedstates','usa','us'].includes(lc)) return 'US';
      if (['india','ind','in'].includes(lc)) return 'IN';
      if (['unitedkingdom','uk','gb','greatbritain'].includes(lc)) return 'GB';
      if (['canada','can','ca'].includes(lc)) return 'CA';
      if (['australia','aus','au'].includes(lc)) return 'AU';
      if (['unitedarabemirates','uae','ae'].includes(lc)) return 'AE';
      if (['singapore','sg','sgp'].includes(lc)) return 'SG';
      if (['germany','de','deu'].includes(lc)) return 'DE';
      if (['france','fr','fra'].includes(lc)) return 'FR';
      if (['netherlands','nl','nld'].includes(lc)) return 'NL';
      const stored = (localStorage.getItem('user_country_code') || '').toUpperCase().trim();
