          <button type="submit" name="checkout" id="js-checkout-btn" class="w-full h-16 rounded-2xl bg-gradient-to-r from-primary via-primary-600 to-primary text-white text-lg font-bold hover:shadow-xl hover:shadow-primary/30 transition-all duration-300 flex items-center justify-center gap-3 mb-6 btn-gradient group relative">
            <span class="btn-text flex items-center gap-3">Proceed to Checkout</span>
