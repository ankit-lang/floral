  }
  .intl-location-dropdown li:last-child { border-bottom: none; }
  .intl-location-dropdown li:hover { background: #f0fdf4; color: #166534; }
  .intl-location-dropdown li .loc-icon { flex-shrink: 0; margin-top: 1px; }
  .intl-location-dropdown li .loc-main { font-weight: 600; }
  .intl-location-dropdown li .loc-sub { color: #9ca3af; font-size: 11px; }
  .intl-location-input { padding-left: 10px !important; }
