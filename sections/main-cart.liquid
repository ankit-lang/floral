                  <svg class="w-5 h-5 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                  </svg>
                  <select class="addr-field delivery-time-select flex-1 text-sm text-gray-700 bg-transparent border-none outline-none cursor-pointer font-medium" required data-prop="Delivery Time">
                    <option value="" disabled {% if p_time == blank %}selected{% endif %}>Select favourable time of delivery</option>
                    <option value="08:00 AM - 10:00 AM" data-start="8" {% if p_time == '08:00 AM - 10:00 AM' %}selected{% endif %}>08:00 AM - 10:00 AM</option>
                    <option value="10:00 AM - 1:00 PM" data-start="10" {% if p_time == '10:00 AM - 1:00 PM' %}selected{% endif %}>10:00 AM - 1:00 PM</option>
                    <option value="1:00 PM - 4:00 PM" data-start="13" {% if p_time == '1:00 PM - 4:00 PM' %}selected{% endif %}>1:00 PM - 4:00 PM</option>
                    <option value="4:00 PM - 7:00 PM" data-start="16" {% if p_time == '4:00 PM - 7:00 PM' %}selected{% endif %}>4:00 PM - 7:00 PM</option>
                    <option value="7:00 PM - 10:00 PM" data-start="19" {% if p_time == '7:00 PM - 10:00 PM' %}selected{% endif %}>7:00 PM - 10:00 PM</option>
                    <option value="10:00 PM - 12:00 AM (Midnight)" data-start="22" data-midnight="true" {% if p_time == '10:00 PM - 12:00 AM (Midnight)' %}selected{% endif %}>10:00 PM - 12:00 AM (Midnight)</option>
                  </select>
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="m6 9 6 6 6-6"/>
                  </svg>
                </div>
              </div>

              <!-- Sender Details Section -->
              <div class="md:col-span-12 mt-2 pt-4 border-t border-dashed border-gray-200 addr-wrapper">
                <h4 class="text-xs font-bold text-gray-600 uppercase tracking-wider mb-3">Sender Details</h4>
                <div class="grid grid-cols-1 md:grid-cols-12 gap-4">
                  <div class="md:col-span-4">
                    <input type="text" placeholder="Sender's Name *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Sender_Name" value="{{ cart.attributes.Sender_Name | default: cart.attributes['Sender Name'] | default: item.properties.Sender_Name | escape }}">
                  </div>
                  <div class="md:col-span-4">
                    <div class="phone-field-group">
                      <div class="relative flex items-center shadow-2xs rounded-md">
                        <div class="phone-dial-badge relative shrink-0 border border-r-0 border-gray-200 rounded-l-md bg-gray-100 transition-colors">
                          <div class="flex items-center gap-1 px-2.5 py-2 text-xs font-bold text-gray-700 pointer-events-none">
                            <span class="flag-icon">🇬🇧</span>
                            <span class="dial-code">+44</span>
                          </div>
                          <select disabled class="phone-country-select absolute inset-0 w-full h-full opacity-0 pointer-events-none">
                            <option value="GB">🇬🇧 UK (+44)</option>
                            <option value="IN">🇮🇳 India (+91)</option>
                            <option value="US">🇺🇸 USA (+1)</option>
                            <option value="CA">🇨🇦 Canada (+1)</option>
                            <option value="AE">🇦🇪 UAE (+971)</option>
                            <option value="AU">🇦🇺 Australia (+61)</option>
                            <option value="SG">🇸🇬 Singapore (+65)</option>
                            <option value="DE">🇩🇪 Germany (+49)</option>
                          </select>
                        </div>
                        <input type="tel" placeholder="Sender's Mobile Number *" class="w-full rounded-r-md rounded-l-none border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field tel-input" required data-prop="Sender_Mobile" value="{{ cart.attributes.Sender_Mobile | default: cart.attributes['Sender Phone'] | default: item.properties.Sender_Mobile | escape }}" inputmode="numeric">
                      </div>
                    </div>
                  </div>
                  <div class="md:col-span-4">
                    <input type="email" placeholder="Sender's Email Address *" class="w-full rounded-md border-gray-200 shadow-sm focus:border-primary focus:ring-primary text-sm p-2 bg-white addr-field" required data-prop="Sender_Email" value="{{ cart.attributes.Sender_Email | default: cart.attributes['Sender Email'] | default: item.properties.Sender_Email | escape }}">
                  </div>
                </div>
              </div>

              <!-- Sync Checkbox -->
              <div class="md:col-span-12 mt-3 pt-3 border-t border-gray-100 flex flex-wrap items-center justify-between gap-2">
                {% if forloop.index == 1 %}
                  <label class="flex items-center gap-2 text-xs font-semibold text-gray-700 cursor-pointer select-none">
                    <input type="checkbox" id="save-delivery-details-cb" class="rounded border-gray-300 text-primary focus:ring-primary h-4 w-4" checked>
                    <span>Save my delivery & sender details for future visits</span>
                  </label>
                  <span id="saved-details-badge" class="text-[11px] text-emerald-600 font-bold hidden flex items-center gap-1 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
