                  <option value="10:00 AM - 1:00 PM" data-start="10" {% if p_time == '10:00 AM - 1:00 PM' %}selected{% endif %}>10:00 AM - 1:00 PM</option>
                  <option value="1:00 PM - 4:00 PM" data-start="13" {% if p_time == '1:00 PM - 4:00 PM' %}selected{% endif %}>1:00 PM - 4:00 PM</option>
                  <option value="4:00 PM - 7:00 PM" data-start="16" {% if p_time == '4:00 PM - 7:00 PM' %}selected{% endif %}>4:00 PM - 7:00 PM</option>
                  <option value="7:00 PM - 10:00 PM" data-start="19" {% if p_time == '7:00 PM - 10:00 PM' %}selected{% endif %}>7:00 PM - 10:00 PM</option>
                  <option value="10:00 PM - 12:00 AM (Midnight)" data-start="22" data-midnight="true" {% if p_time == '10:00 PM - 12:00 AM (Midnight)' %}selected{% endif %}>10:00 PM - 12:00 AM (Midnight)</option>
