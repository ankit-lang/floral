<!-- Global Delivery Icons -->
<section class="max-w-7xl mx-auto px-4 py-10 anim-up">
  <div class="text-center mb-8">
    <h2 class="text-2xl font-serif font-bold text-gray-900">We Deliver Worldwide</h2>
    <p class="text-sm text-gray-500 mt-1">Spreading joy across borders</p>
  </div>
  <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
    {%- assign countries = 'India,UK,USA,UAE,Singapore,Australia' | split: ',' -%}
    
    {% for i in (0..5) %}
      <div class="flex flex-col items-center justify-center gap-3 p-4 rounded-2xl bg-gray-50 hover:bg-primary/5 hover:shadow-md transition-all duration-300 group anim-scale stagger-{{ forloop.index }}">
        <div class="w-12 h-8 rounded overflow-hidden shadow-sm group-hover:scale-110 transition-transform flex items-center justify-center bg-white">
          {% case countries[i] %}
            {% when 'India' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 600" class="w-full h-full object-cover">
                <rect width="900" height="200" fill="#FF9933"/>
                <rect y="200" width="900" height="200" fill="#FFFFFF"/>
                <rect y="400" width="900" height="200" fill="#138808"/>
                <circle cx="450" cy="300" r="70" fill="none" stroke="#000080" stroke-width="7"/>
                <circle cx="450" cy="300" r="12" fill="#000080"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(0,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(15,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(30,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(45,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(60,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(75,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(90,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(105,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(120,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(135,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(150,450,300)"/>
                <line x1="450" y1="230" x2="450" y2="370" stroke="#000080" stroke-width="2" transform="rotate(165,450,300)"/>
              </svg>
            {% when 'UK' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" class="w-full h-full object-cover">
                <rect width="60" height="30" fill="#012169"/>
                <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
                <path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/>
                <path d="M30,0 V30 M0,15 H60" stroke="#fff" stroke-width="10"/>
                <path d="M30,0 V30 M0,15 H60" stroke="#C8102E" stroke-width="6"/>
              </svg>
            {% when 'USA' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 190 100" class="w-full h-full object-cover">
                <rect width="190" height="100" fill="#B22234"/>
                <rect y="7.7" width="190" height="7.7" fill="#FFFFFF"/>
                <rect y="23.1" width="190" height="7.7" fill="#FFFFFF"/>
                <rect y="38.5" width="190" height="7.7" fill="#FFFFFF"/>
                <rect y="53.8" width="190" height="7.7" fill="#FFFFFF"/>
                <rect y="69.2" width="190" height="7.7" fill="#FFFFFF"/>
                <rect y="84.6" width="190" height="7.7" fill="#FFFFFF"/>
                <rect width="76" height="53.8" fill="#3C3B6E"/>
              </svg>
            {% when 'UAE' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 200" class="w-full h-full object-cover">
                <rect width="300" height="200" fill="#FFFFFF"/>
                <rect width="300" height="66" fill="#00732F"/>
                <rect y="134" width="300" height="66" fill="#000000"/>
                <rect width="80" height="200" fill="#FF0000"/>
              </svg>
            {% when 'Singapore' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 200" class="w-full h-full object-cover">
                <rect width="400" height="100" fill="#EF3340"/>
                <rect y="100" width="400" height="100" fill="#FFFFFF"/>
                <circle cx="95" cy="100" r="46" fill="#FFFFFF"/>
                <circle cx="116" cy="100" r="46" fill="#EF3340"/>
                <g fill="#FFFFFF" transform="translate(110,78)">
                  <polygon points="15,0 18,9 28,9 20,15 23,24 15,18 7,24 10,15 2,9 12,9" transform="translate(-10,0)"/>
                  <polygon points="15,0 18,9 28,9 20,15 23,24 15,18 7,24 10,15 2,9 12,9" transform="translate(6,-14)"/>
                  <polygon points="15,0 18,9 28,9 20,15 23,24 15,18 7,24 10,15 2,9 12,9" transform="translate(22,0)"/>
                  <polygon points="15,0 18,9 28,9 20,15 23,24 15,18 7,24 10,15 2,9 12,9" transform="translate(14,16)"/>
                  <polygon points="15,0 18,9 28,9 20,15 23,24 15,18 7,24 10,15 2,9 12,9" transform="translate(-2,16)"/>
                </g>
              </svg>
            {% when 'Australia' %}
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 60 30" class="w-full h-full object-cover">
                <rect width="60" height="30" fill="#00008B"/>
                <path d="M0,0 L30,15 M30,0 L0,15" stroke="#fff" stroke-width="4"/>
                <path d="M0,0 L30,15 M30,0 L0,15" stroke="#C8102E" stroke-width="2.5"/>
                <path d="M15,0 V15 M0,7.5 H30" stroke="#fff" stroke-width="7"/>
                <path d="M15,0 V15 M0,7.5 H30" stroke="#C8102E" stroke-width="4.5"/>
                <polygon points="44,4 45,7 49,7 46,9 47,12 44,10 41,12 42,9 39,7 43,7" fill="white"/>
                <polygon points="55,10 56,13 58,13 56,15 57,17 55,15 53,17 54,15 52,13 54,13" fill="white"/>
                <polygon points="48,20 49,23 51,23 49,25 50,27 48,25 46,27 47,25 45,23 47,23" fill="white"/>
                <polygon points="38,16 38.6,18 41,18 39,19.5 39.6,21.5 38,20.2 36.4,21.5 37,19.5 35,18 37.4,18" fill="white"/>
              </svg>
          {% endcase %}
        </div>
        <span class="text-xs font-semibold text-gray-600 group-hover:text-primary transition-colors">{{ countries[i] }}</span>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Global Delivery",
  "settings": [],
  "presets": [{ "name": "Global Delivery" }]
}
{% endschema %}

