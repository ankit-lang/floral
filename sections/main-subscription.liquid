{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap');

  :root {
    --color-emerald: #0b2c24;
    --color-charcoal: #151a1e;
    --color-ivory: #fdfbf7;
    --color-gold: #c5a059;
    --color-gold-light: #e6c888;
    --color-gold-dark: #9e7f41;
  }

  .font-editorial { font-family: 'Playfair Display', serif; }
  .font-modern { font-family: 'Inter', sans-serif; }

  .bg-emerald-dark { background-color: var(--color-emerald); }
  .bg-charcoal { background-color: var(--color-charcoal); }
  .bg-ivory { background-color: var(--color-ivory); }
  .text-gold { color: var(--color-gold); }
  .text-ivory { color: var(--color-ivory); }
  .border-gold { border-color: var(--color-gold); }

  /* Hero Parallax */
  .hero-parallax {
    background-image: url('https://cdn.shopify.com/s/files/1/0748/1766/7150/files/cellImage_1632884507_241.jpg?v=1783505578'); /* Placeholder high-end floral */
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    position: relative;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(21,26,30,0.85) 0%, rgba(11,44,36,0.75) 100%);
    mix-blend-mode: multiply;
  }

  /* Buttons */
  .btn-gold-outline {
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    transition: all 0.4s ease;
    background: transparent;
  }
  .btn-gold-outline:hover {
    background: var(--color-gold);
    color: var(--color-charcoal);
    box-shadow: 0 0 20px rgba(197, 160, 89, 0.4);
  }
  .btn-gold-solid {
    background: linear-gradient(135deg, var(--color-gold-light), var(--color-gold), var(--color-gold-dark));
    color: var(--color-charcoal);
    transition: all 0.4s ease;
  }
  .btn-gold-solid:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(197, 160, 89, 0.3);
  }

  /* Marquee */
  .marquee-container {
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    position: relative;
  }
  .marquee-content {
    display: flex;
    animation: marquee-scroll 30s linear infinite;
  }
  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Glass Cards */
  .glass-card {
    background: rgba(253, 251, 247, 0.03);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(197, 160, 89, 0.2);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .glass-card:hover {
    border-color: rgba(197, 160, 89, 0.6);
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    background: rgba(253, 251, 247, 0.06);
  }

  /* Elevated Card */
  .card-elevated {
    transform: scale(1.05);
    border-color: rgba(197, 160, 89, 0.5);
    background: rgba(253, 251, 247, 0.05);
    z-index: 10;
  }
  @media (max-width: 1024px) {
    .card-elevated { transform: none; }
  }

  /* Timeline */
  .timeline-line {
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(197, 160, 89, 0.3);
  }
  .timeline-step {
    opacity: 0;
    transform: translateX(-30px);
    transition: all 0.8s ease-out;
  }
  .timeline-step.in-view {
    opacity: 1;
    transform: translateX(0);
  }

  /* Accordion */
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease-out, opacity 0.3s ease-out, padding 0.4s ease-out;
    opacity: 0;
  }
  .faq-item.active .faq-answer {
    max-height: 200px;
    opacity: 1;
    padding-top: 1rem;
    padding-bottom: 0.5rem;
  }
  .faq-icon {
    transition: transform 0.3s ease;
    transform-origin: center;
  }
  .faq-item.active .faq-icon {
    transform: rotate(45deg);
    color: var(--color-gold);
  }

  /* Animations */
  .fade-up { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }
{% endstyle %}

<div class="bg-charcoal text-ivory font-modern min-h-screen overflow-hidden">

  <!-- 1. HERO SECTION -->
