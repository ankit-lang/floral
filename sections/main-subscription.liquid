        <!-- Placeholder for Lifestyle image -->
        <div class="aspect-[4/5] bg-emerald-dark rounded-sm overflow-hidden relative border border-gold/20">
          <img src="https://cdn.shopify.com/s/files/1/0748/1766/7150/files/cellImage_1632884507_241.jpg?v=1783505578" alt="Elegant floral arrangement" class="w-full h-full object-cover opacity-80 mix-blend-luminosity">
          <div class="absolute inset-0 border border-gold/40 m-4"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. PERFECT FOR (Marquee) -->
