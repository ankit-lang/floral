          </div>
        </button>
        <div class="faq-answer text-gray-400 text-sm font-light">
          <p>Yes. We provide customized flower subscription plans for offices, hotels, restaurants, retail stores, and corporate spaces.</p>
        </div>
      </div>
      <!-- FAQ 4 -->
      <div class="faq-item fade-up border-b border-gray-800">
        <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none">
          <span class="font-editorial text-xl text-ivory pr-8">Are flowers delivered in a vase?</span>
          <div class="faq-icon text-gold flex-shrink-0 ml-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          </div>
        </button>
        <div class="faq-answer text-gray-400 text-sm font-light">
          <p>Vase options are available upon request and can be included as part of your subscription plan.</p>
        </div>
      </div>
      <!-- FAQ 5 -->
      <div class="faq-item fade-up border-b border-gray-800">
        <button class="w-full py-6 flex justify-between items-center text-left focus:outline-none">
          <span class="font-editorial text-xl text-ivory pr-8">Which cities do you cover?</span>
          <div class="faq-icon text-gold flex-shrink-0 ml-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          </div>
        </button>
        <div class="faq-answer text-gray-400 text-sm font-light">
          <p>Flower subscription services are available in selected cities, with coverage expanding regularly. Please contact us to confirm availability in your location.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. FINAL CTA -->
  <section class="py-32 px-4 text-center relative overflow-hidden bg-emerald-dark border-t border-gold/20">
    <!-- Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[300px] bg-gold/10 rounded-[100%] blur-[100px] pointer-events-none z-0"></div>
    
    <div class="relative z-10 fade-up max-w-3xl mx-auto">
      <h2 class="font-editorial text-5xl md:text-6xl text-ivory mb-6">Let Your Space <span class="text-gold italic">Bloom</span> Every Day</h2>
      <p class="text-gray-400 font-light text-sm md:text-base leading-relaxed mb-10">
        Experience the joy of fresh flowers without the hassle of reordering. Whether for your home or business, Floral India's Flower Subscription service brings timeless elegance and lasting impressions—one beautiful arrangement at a time.
      </p>
      <button class="btn-gold-solid px-10 py-5 text-sm tracking-[0.2em] uppercase font-bold rounded-none">Start Your Subscription</button>
    </div>
  </section>

</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Scroll Animations (Fade up & Timeline)
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target); // Run once
        }
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -100px 0px" });
    
    document.querySelectorAll('.fade-up, .timeline-step').forEach(el => observer.observe(el));

    // 2. FAQ Accordion
    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const btn = item.querySelector('button');
      btn.addEventListener('click', () => {
        const isActive = item.classList.contains('active');
        // Close all
        faqItems.forEach(i => i.classList.remove('active'));
        // Open clicked if it wasn't open
        if (!isActive) item.classList.add('active');
      });
    });
  });
</script>

