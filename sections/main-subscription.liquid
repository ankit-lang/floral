        <!-- Badge -->
        <div class="absolute top-0 right-8 transform -translate-y-1/2 bg-gold text-charcoal text-[10px] font-bold uppercase tracking-widest py-1.5 px-4">
          Most Popular
        </div>
        <h3 class="font-editorial text-4xl text-gold mb-2">Fortnightly</h3>
        <div class="h-px bg-gradient-to-r from-gold to-transparent my-6"></div>
        <p class="text-gray-300 text-sm font-light leading-relaxed mb-10 h-24">
          Enjoy beautiful floral arrangements delivered every two weeks. An ideal balance between lasting freshness and effortless convenience.
        </p>
        <button class="w-full btn-gold-solid py-4 text-xs tracking-widest uppercase font-bold">Select Fortnightly</button>
      </div>

      <!-- Monthly -->
      <div class="glass-card p-10 fade-up" style="transition-delay: 0.4s;">
        <h3 class="font-editorial text-3xl text-ivory mb-2">Monthly</h3>
        <div class="h-px bg-gradient-to-r from-gold/50 to-transparent my-6"></div>
        <p class="text-gray-400 text-sm font-light leading-relaxed mb-10 h-24">
          A premium floral arrangement delivered once every month to refresh your home or workspace with the finest seasonal flowers.
        </p>
        <button class="w-full btn-gold-outline py-3 text-xs tracking-widest uppercase font-bold">Select Monthly</button>
      </div>

    </div>

    <!-- Corporate Plan (Full Width) -->
    <div class="glass-card p-10 md:p-14 relative z-10 fade-up">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-gold tracking-widest text-[10px] font-bold uppercase mb-4 block">For Business</span>
          <h3 class="font-editorial text-3xl md:text-4xl text-ivory mb-4">Corporate <span class="italic text-gray-400">Subscription</span></h3>
          <p class="text-gray-400 text-sm font-light leading-relaxed mb-8">
            Create an unforgettable first impression with professionally designed floral arrangements for your office, reception, boardroom, hotel, showroom, restaurant, or retail space.
          </p>
          <button class="btn-gold-outline px-8 py-3 text-xs tracking-widest uppercase font-bold">Inquire Now</button>
        </div>
        
        <div class="border-l border-gold/20 pl-8 md:pl-12">
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Reception flower arrangements</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Boardroom centrepieces</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Hotel lobby & Restaurant styling</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Event floral refresh</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Custom corporate plans</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Dedicated account management</li>
            <li class="flex items-center gap-3 text-sm text-gray-300"><span class="w-1.5 h-1.5 bg-gold rounded-full"></span> Flexible billing options</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. HOW IT WORKS (Timeline) -->
  <section class="py-24 bg-emerald-dark border-t border-gold/10 relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-20 fade-up">
        <h2 class="font-editorial text-4xl md:text-5xl mb-4">How It <span class="text-gold italic">Works</span></h2>
      </div>

      <div class="relative pl-12 md:pl-20">
        <!-- The Line -->
        <div class="timeline-line"></div>

        <!-- Step 1 -->
        <div class="timeline-step mb-16 relative">
          <div class="absolute -left-12 md:-left-20 top-1 w-6 h-6 rounded-full bg-charcoal border-2 border-gold z-10 flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-gold rounded-full"></div>
          </div>
          <span class="text-gold/50 font-editorial text-4xl absolute -left-16 md:-left-24 top-0 -translate-x-full">01</span>
          
          <h3 class="font-editorial text-2xl text-ivory mb-2">Choose Your Plan</h3>
          <p class="text-gray-400 font-light text-sm max-w-lg">Select a weekly, fortnightly or monthly flower subscription that perfectly fits your lifestyle and schedule.</p>
        </div>

        <!-- Step 2 -->
        <div class="timeline-step mb-16 relative" style="transition-delay: 0.2s;">
          <div class="absolute -left-12 md:-left-20 top-1 w-6 h-6 rounded-full bg-charcoal border-2 border-gold z-10 flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-gold rounded-full"></div>
          </div>
          <span class="text-gold/50 font-editorial text-4xl absolute -left-16 md:-left-24 top-0 -translate-x-full">02</span>
          
          <h3 class="font-editorial text-2xl text-ivory mb-2">Tell Us Your Preferences</h3>
          <p class="text-gray-400 font-light text-sm max-w-lg">Share your preferred colour palette, flower choices, vase requirements, and specific delivery schedule.</p>
        </div>

        <!-- Step 3 -->
        <div class="timeline-step mb-16 relative" style="transition-delay: 0.4s;">
          <div class="absolute -left-12 md:-left-20 top-1 w-6 h-6 rounded-full bg-charcoal border-2 border-gold z-10 flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-gold rounded-full"></div>
          </div>
          <span class="text-gold/50 font-editorial text-4xl absolute -left-16 md:-left-24 top-0 -translate-x-full">03</span>
          
          <h3 class="font-editorial text-2xl text-ivory mb-2">We Design & Deliver</h3>
          <p class="text-gray-400 font-light text-sm max-w-lg">Our expert florists create fresh arrangements using premium seasonal blooms and deliver them directly to your doorstep.</p>
        </div>

        <!-- Step 4 -->
        <div class="timeline-step relative" style="transition-delay: 0.6s;">
          <div class="absolute -left-12 md:-left-20 top-1 w-6 h-6 rounded-full bg-charcoal border-2 border-gold z-10 flex items-center justify-center">
            <div class="w-1.5 h-1.5 bg-gold rounded-full"></div>
          </div>
          <span class="text-gold/50 font-editorial text-4xl absolute -left-16 md:-left-24 top-0 -translate-x-full">04</span>
          
          <h3 class="font-editorial text-2xl text-ivory mb-2">Enjoy Fresh Flowers</h3>
          <p class="text-gray-400 font-light text-sm max-w-lg">Relax while we keep your space blooming with breathtaking fresh flowers throughout the year.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- 6. FAQS (Accordion) -->
