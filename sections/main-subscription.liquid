    <div class="text-center mb-8">
      <span class="text-gold tracking-[0.2em] text-[10px] font-bold uppercase">Perfect For</span>
    </div>
    <div class="marquee-container">
      <div class="marquee-content gap-12 px-6 items-center">
        <!-- We duplicate the items to make the infinite scroll seamless -->
        {%- assign marquee_items = "Homes,Corporate Offices,Hotels & Hospitality,Restaurants & Cafés,Retail Stores,Reception Areas,Luxury Apartments,Clinics & Salons,Events & Showrooms" | split: "," -%}
        
        {% for i in (1..2) %}
          {% for item in marquee_items %}
            <span class="font-editorial text-3xl md:text-5xl italic text-ivory/60 whitespace-nowrap">{{ item }}</span>
