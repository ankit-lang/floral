<style>
  .concierge-form-section {
    padding: 60px 20px;
    background-color: #fff;
    max-width: 800px;
    margin: 0 auto;
  }
  .concierge-header {
    text-align: center;
    margin-bottom: 40px;
  }
  .concierge-header h2 {
    font-size: 2rem;
    color: #333;
  }
  .concierge-header p {
    color: #666;
    margin-top: 10px;
  }
  .concierge-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .form-group {
    display: flex;
    flex-direction: column;
  }
  .form-group label {
    font-weight: 600;
    margin-bottom: 5px;
    color: #444;
  }
  .form-group input,
  .form-group select,
  .form-group textarea {
    padding: 12px;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 1rem;
    font-family: inherit;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #d15c7e;
    box-shadow: 0 0 0 2px rgba(209, 92, 126, 0.1);
  }
  .form-submit {
    margin-top: 10px;
  }
  .form-submit button {
    background-color: #d15c7e;
    color: #fff;
    border: none;
    padding: 15px 30px;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.2s;
    width: 100%;
  }
  .form-submit button:hover {
    background-color: #b04b68;
  }
  .form-message--success {
    background-color: #d4edda;
    color: #155724;
    padding: 15px;
    border-radius: 5px;
    margin-bottom: 20px;
    text-align: center;
  }
  .form-row {
    display: flex;
    gap: 20px;
  }
  .form-row .form-group {
    flex: 1;
  }
  @media (max-width: 600px) {
    .form-row {
      flex-direction: column;
    }
  }
</style>

<div class="concierge-form-section">
  <div class="concierge-header">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subheading | escape }}</p>
  </div>

  {%- form 'contact', id: 'ConciergeContactForm', class: 'concierge-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="form-message--success" tabindex="-1" autofocus>
        {{ 'contact.form.post_success' | t | default: 'Thanks for contacting us. We will get back to you as soon as possible.' }}
      </div>
    {%- elsif form.errors -%}
      <div class="form-message--error">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="form-row">
      <div class="form-group">
        <label for="ContactForm-name">Name</label>
        <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Name">
      </div>
      <div class="form-group">
        <label for="ContactForm-email">Email <span aria-hidden="true">*</span></label>
        <input
          autocomplete="email"
          type="email"
          id="ContactForm-email"
          class="field__input"
          name="contact[email]"
          spellcheck="false"
          autocapitalize="off"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          aria-required="true"
          {% if form.errors contains 'email' %}
            aria-invalid="true"
            aria-describedby="ContactForm-email-error"
          {% endif %}
          placeholder="Email"
          required
        >
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="ContactForm-phone">Phone Number</label>
        <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[phone]" pattern="[0-9]{10}" maxlength="10" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="Phone Number">
        <p id="ConciergeForm-phone-hint" style="font-size:11px; font-weight:600; margin-top:4px; display:none;"></p>
      </div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const conciergePhone = document.querySelector('#ConciergeContactForm #ContactForm-phone');
    const conciergeHint = document.getElementById('ConciergeForm-phone-hint');

    function updateConciergeHint() {
      if (!conciergePhone || !conciergeHint) return;
      const val = conciergePhone.value.replace(/[^0-9]/g, '');
      if (val.length === 9) {
        conciergeHint.textContent = '* Please enter 1 more digit to complete your 10-digit mobile number';
        conciergeHint.style.color = '#d97706';
        conciergeHint.style.display = 'block';
      } else if (val.length === 10) {
        conciergeHint.textContent = '✓ 10-digit mobile number completed';
        conciergeHint.style.color = '#059669';
        conciergeHint.style.display = 'block';
      } else {
        conciergeHint.textContent = '';
        conciergeHint.style.display = 'none';
      }
    }

    if (conciergePhone) {
      conciergePhone.addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
        updateConciergeHint();
      });
      conciergePhone.addEventListener('keydown', (e) => {
        const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Home', 'End'];
        if (allowedKeys.includes(e.key) || e.ctrlKey || e.metaKey) return;
        if (!/^[0-9]$/.test(e.key) || (e.target.value.length >= 10 && e.target.selectionStart === e.target.selectionEnd)) {
          e.preventDefault();
        }
      });
      updateConciergeHint();
    }
  });
</script>
      <div class="form-group">
        <label for="ContactForm-interest">Service of Interest</label>
        <select id="ContactForm-interest" name="contact[interest]">
          <option value="Corporate Gifting">Corporate Gifting</option>
          <option value="Wedding Services">Wedding Services</option>
          <option value="Party Planning">Party Planning</option>
          <option value="Bespoke/Concierge">Bespoke/Concierge</option>
        </select>
      </div>
    </div>
    
    <div class="form-group">
        <label for="ContactForm-company">Company Name (Optional)</label>
        <input type="text" id="ContactForm-company" name="contact[company]" placeholder="Company Name">
    </div>

    <div class="form-group">
      <label for="ContactForm-body">Your Requirements</label>
      <textarea
        rows="5"
        id="ContactForm-body"
        class="text-area field__input"
        name="contact[body]"
        placeholder="Please describe your event, budget, and gifting requirements..."
      >
        {{- form.body -}}
      </textarea>
    </div>

    <div class="form-submit">
      <button type="submit" class="button">
        {{ section.settings.button_label | escape }}
      </button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Concierge Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Connect with our Concierge"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fill out the form below and our experts will curate a bespoke experience for you."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Submit Request"
    }
  ],
  "presets": [
    {
      "name": "Concierge Contact Form"
    }
  ]
}
{% endschema %}
