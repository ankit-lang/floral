<script>
document.addEventListener('DOMContentLoaded', () => {
  const faqItems = document.querySelectorAll('.faq-item');
  const searchInput = document.getElementById('faqSearch');
  const filterBtns = document.querySelectorAll('.filter-btn');
  const noResults = document.getElementById('noResults');

  // Accordion Logic
  faqItems.forEach(item => {
    const btn = item.querySelector('.faq-toggle');
    const content = item.querySelector('.faq-content');
    const icon = item.querySelector('svg');

    btn.addEventListener('click', () => {
      const isOpen = content.style.gridTemplateRows === '1fr';
      
      // Close all others
      document.querySelectorAll('.faq-content').forEach(c => c.style.gridTemplateRows = '0fr');
      document.querySelectorAll('.faq-toggle svg').forEach(i => i.style.transform = 'rotate(0deg)');

      // Toggle current
      if (!isOpen) {
        content.style.gridTemplateRows = '1fr';
        icon.style.transform = 'rotate(45deg)';
      }
    });
  });

  // Filter Logic
  function applyFilters() {
    const searchTerm = searchInput.value.toLowerCase();
    const activeFilter = document.querySelector('.filter-btn.active').dataset.filter;
    let visibleCount = 0;

    faqItems.forEach(item => {
      const text = item.innerText.toLowerCase();
      const category = item.dataset.category;
      
      const matchesSearch = text.includes(searchTerm);
      const matchesCategory = activeFilter === 'all' || category === activeFilter;

      if (matchesSearch && matchesCategory) {
        item.style.display = 'block';
        // Add a slight fade in animation
        item.style.opacity = '0';
        setTimeout(() => item.style.opacity = '1', 50);
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    noResults.classList.toggle('hidden', visibleCount > 0);
  }

  // Bind Search
  searchInput.addEventListener('input', applyFilters);

  // Bind Category Buttons
  filterBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      // Update active state
      filterBtns.forEach(b => {
        b.classList.remove('active', 'bg-[#E07A5F]', 'text-white');
        b.classList.add('bg-white', 'text-gray-600');
      });
      e.target.classList.remove('bg-white', 'text-gray-600');
      e.target.classList.add('active', 'bg-[#E07A5F]', 'text-white');
      
      applyFilters();
    });
  });
});
</script>

