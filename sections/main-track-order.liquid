<div class="max-w-3xl mx-auto px-4 py-16 md:py-24">
  <div class="text-center mb-10">
    <h1 class="text-3xl md:text-5xl font-serif font-bold text-primary mb-4">{{ page.title | default: 'Track Your Order' }}</h1>
    <div class="w-16 h-1 bg-secondary mx-auto rounded-full mb-6"></div>
    <p class="text-gray-600">
      Enter your tracking details below to see the real-time status of your beautiful gift.
    </p>
  </div>

  <div class="bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-gray-100 p-8 md:p-12 relative overflow-hidden">
    <!-- Decorative background elements -->
    <div class="absolute -top-10 -right-10 w-32 h-32 bg-primary/5 rounded-full blur-2xl"></div>
    <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-secondary/5 rounded-full blur-2xl"></div>

    <form class="relative z-10 max-w-lg mx-auto" id="track-order-form">
      
      <div class="space-y-4">
        <div>
          <label for="tracking_order_id" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Order ID / Tracking Number</label>
          <input type="text" id="tracking_order_id" name="order_id" required 
                 class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder:text-gray-400 focus:outline-none focus:border-primary focus:bg-white transition-all" 
                 placeholder="e.g. FL-102948">
        </div>

        <div>
          <label for="tracking_email" class="block text-sm font-bold text-gray-700 mb-2 uppercase tracking-wide">Email or Phone Number</label>
          <input type="text" id="tracking_email" name="email_or_phone"
                 class="w-full px-5 py-3.5 bg-gray-50 border border-gray-200 rounded-xl text-gray-800 placeholder:text-gray-400 focus:outline-none focus:border-primary focus:bg-white transition-all" 
                 placeholder="Email or phone used during order">
        </div>

        <!-- reCAPTCHA -->
        {% render 'captcha-widget', widget_id: 'track-order' %}

        <button type="submit" class="w-full py-4 px-6 bg-primary text-white font-bold rounded-xl hover:bg-primary-600 hover:-translate-y-0.5 transition-all shadow-lg shadow-primary/20 flex items-center justify-center gap-2">
          <span>Track Order</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>

    </form>

    <!-- ========== ORDER STATUS TIMELINE (Hidden by default, shown after submission) ========== -->
    <div id="tracking-result" class="hidden relative z-10 mt-10 pt-8 border-t border-gray-100">
      
      <!-- Order Summary Header -->
      <div class="flex items-center justify-between mb-8 bg-gray-50 rounded-xl p-4">
        <div>
          <p class="text-xs text-gray-500 uppercase tracking-wider">Order</p>
          <p class="font-bold text-primary text-lg" id="result-order-id"></p>
        </div>
        <div class="text-right">
          <p class="text-xs text-gray-500 uppercase tracking-wider">Est. Delivery</p>
          <p class="font-bold text-gray-900" id="result-est-date">--</p>
        </div>
      </div>

      <!-- Visual Timeline -->
      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-[18px] top-2 bottom-2 w-0.5 bg-gray-200"></div>
        <div class="absolute left-[18px] top-2 w-0.5 bg-primary transition-all duration-700" id="timeline-progress" style="height: 0%;"></div>

        <!-- Step 1: Order Placed -->
        <div class="timeline-step flex items-start gap-4 mb-8 relative" data-step="1">
          <div class="timeline-dot w-[38px] h-[38px] rounded-full border-2 border-gray-200 bg-white flex items-center justify-center flex-shrink-0 z-10 transition-all">
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm">Order Placed</p>
            <p class="text-xs text-gray-500">Your order has been received and is being processed.</p>
          </div>
        </div>

        <!-- Step 2: Processing -->
        <div class="timeline-step flex items-start gap-4 mb-8 relative" data-step="2">
          <div class="timeline-dot w-[38px] h-[38px] rounded-full border-2 border-gray-200 bg-white flex items-center justify-center flex-shrink-0 z-10 transition-all">
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm">Processing</p>
            <p class="text-xs text-gray-500">Our team is carefully preparing your arrangement.</p>
          </div>
        </div>

        <!-- Step 3: Shipped -->
        <div class="timeline-step flex items-start gap-4 mb-8 relative" data-step="3">
          <div class="timeline-dot w-[38px] h-[38px] rounded-full border-2 border-gray-200 bg-white flex items-center justify-center flex-shrink-0 z-10 transition-all">
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
            </svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm">Shipped</p>
            <p class="text-xs text-gray-500">Your gift is on its way to the destination.</p>
          </div>
        </div>

        <!-- Step 4: Out for Delivery -->
        <div class="timeline-step flex items-start gap-4 mb-8 relative" data-step="4">
          <div class="timeline-dot w-[38px] h-[38px] rounded-full border-2 border-gray-200 bg-white flex items-center justify-center flex-shrink-0 z-10 transition-all">
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm">Out for Delivery</p>
            <p class="text-xs text-gray-500">Our delivery partner is heading to the recipient.</p>
          </div>
        </div>

        <!-- Step 5: Delivered -->
        <div class="timeline-step flex items-start gap-4 relative" data-step="5">
          <div class="timeline-dot w-[38px] h-[38px] rounded-full border-2 border-gray-200 bg-white flex items-center justify-center flex-shrink-0 z-10 transition-all">
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <div>
            <p class="font-bold text-gray-900 text-sm">Delivered</p>
            <p class="text-xs text-gray-500">Your gift has been delivered successfully! 🎉</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 text-center text-sm text-gray-500 border-t border-gray-100 pt-8 relative z-10">
      <p>Having trouble tracking your order?</p>
      <a href="/pages/contact" class="text-secondary font-bold hover:underline">Contact our Concierge Support</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('track-order-form');
    const result = document.getElementById('tracking-result');

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const orderId = document.getElementById('tracking_order_id').value.trim();
      if (!orderId) return;

      // Show result section
      result.classList.remove('hidden');
      document.getElementById('result-order-id').textContent = orderId;
      
      // Simulate a tracking status (in production, this would call your fulfillment API)
      // For demo, randomly pick a step between 1-5
      const currentStep = Math.floor(Math.random() * 5) + 1;
      animateTimeline(currentStep);

      // Smooth scroll to result
      result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    function animateTimeline(completedSteps) {
      const steps = document.querySelectorAll('.timeline-step');
      const progressBar = document.getElementById('timeline-progress');
      
      // Calculate progress percentage
      const progressPct = ((completedSteps - 1) / (steps.length - 1)) * 100;
      
      steps.forEach((step, index) => {
        const dot = step.querySelector('.timeline-dot');
        const icon = dot.querySelector('svg');
        
        setTimeout(() => {
          if (index < completedSteps) {
            // Completed step
            dot.classList.remove('border-gray-200', 'bg-white');
            dot.classList.add('border-primary', 'bg-primary');
            icon.classList.remove('text-gray-300');
            icon.classList.add('text-white');
          } else {
            // Future step
            dot.classList.remove('border-primary', 'bg-primary');
            dot.classList.add('border-gray-200', 'bg-white');
            icon.classList.remove('text-white');
            icon.classList.add('text-gray-300');
          }
        }, index * 200);
      });

      // Animate progress bar
      setTimeout(() => {
        progressBar.style.height = progressPct + '%';
      }, 100);
    }
  });
</script>

{% schema %}
{
  "name": "Track Order",
  "settings": []
}
{% endschema %}
