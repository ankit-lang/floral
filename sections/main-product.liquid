<section class="max-w-7xl mx-auto px-4 py-10 md:py-16">
  <div id="global-product-tiers" data-tiers="{{ product.tags | join: ',' }}" style="display:none;"></div>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 md:gap-16">
    
    <!-- Left Column: Product Image Gallery -->
    <div>
      
      <!-- Mobile View: Swipeable Carousel -->
      <div class="md:hidden flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4" style="scrollbar-width: none; -ms-overflow-style: none;">
        <style>
          .md\:hidden.flex::-webkit-scrollbar { display: none; }
        </style>
        {%- if product.images.size > 0 -%}
          {%- for image in product.images -%}
            <div class="snap-center w-full flex-shrink-0 relative rounded-3xl overflow-hidden bg-gray-50/40 border border-gray-100 p-2 flex items-center justify-center min-h-[350px]">
              <img src="{{ image | img_url: 'master' }}" alt="{{ image.alt | escape }}" class="w-full h-auto max-h-[70vh] rounded-2xl shadow-sm object-contain relative z-10">
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="snap-center w-full flex-shrink-0 relative rounded-3xl overflow-hidden bg-white border border-gray-100 shadow-lg p-4 flex items-center justify-center min-h-[350px]">
            {{ 'image' | placeholder_svg_tag: 'w-full h-full object-contain text-gray-200' }}
          </div>
        {%- endif -%}
      </div>

      <!-- Desktop View: Vertical Thumbnails & Main Image -->
      <div class="hidden md:flex gap-6 lg:sticky lg:top-24 items-start">
        
        <!-- Vertical Thumbnails -->
        {%- if product.images.size > 1 -%}
          <div class="flex flex-col gap-3 overflow-y-auto w-20 md:w-24 flex-shrink-0 max-h-[75vh]" style="scrollbar-width: none; -ms-overflow-style: none;">
            {%- for image in product.images -%}
              <div class="rounded-xl overflow-hidden border-2 border-transparent hover:border-primary cursor-pointer transition-all flex-shrink-0 bg-gray-50/80 p-1 flex items-center justify-center" onclick="document.getElementById('MainImage').src='{{ image | img_url: 'master' }}'">
                <img src="{{ image | img_url: '250x250' }}" alt="{{ image.alt | escape }}" class="w-full h-full object-contain aspect-square rounded-lg">
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Main Image -->
        <div class="relative w-full rounded-[2rem] overflow-hidden shadow-sm flex-1 bg-gray-50/40 border border-gray-100/80 flex items-center justify-center p-3">
          {%- if product.featured_image -%}
            <img id="MainImage" src="{{ product.featured_image | img_url: 'master' }}" alt="{{ product.featured_image.alt | escape }}" class="w-full h-auto max-h-[75vh] object-contain transition-transform duration-700 hover:scale-105 relative z-10 rounded-2xl">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'w-full h-full object-contain text-gray-200' }}
          {%- endif -%}
        </div>

        <!-- Reviews / Share bar (below image on desktop) -->
        <div class="hidden"><!-- Placeholder for reviews widget --></div>
      </div>
    </div>

    <!-- Right Column: Product Info & Actions -->
    <div class="flex flex-col relative h-full">
      <!-- 1. Breadcrumb -->
      <nav class="flex text-xs text-gray-500 mb-4" aria-label="Breadcrumb">
        <ol class="flex items-center space-x-2">
          <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href="/collections/all" class="hover:text-primary transition-colors">Products</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-gray-900 font-medium" aria-current="page">{{ product.title }}</li>
        </ol>
      </nav>

      <!-- 2. Title -->
      <h1 class="text-2xl md:text-4xl font-serif font-bold text-secondary mb-2 anim-up stagger-1">{{ product.title | default: 'Example Product Title' }}</h1>
      <a href="#product-description" class="text-xs text-primary hover:underline mb-3 inline-block">Click here to know product description</a>

      <!-- 3. Price -->
      <div class="flex items-center gap-4 mb-5 anim-up stagger-2">
        <span id="product-display-price" class="text-2xl font-bold text-gray-900" data-base-price="{{ product.selected_or_first_available_variant.price | default: product.price | default: 199900 }}">{{ product.price | default: 199900 | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <span class="text-lg text-gray-400 line-through" data-base-price="{{ product.compare_at_price }}">{{ product.compare_at_price | money }}</span>
          {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
          <span class="px-2 py-0.5 bg-green-100 text-green-800 text-xs font-bold rounded">{{ savings }}% off</span>
        {%- endif -%}
      </div>

      <!-- ========== ADD TO CART FORM ========== -->
      {%- form 'product', product, class: 'flex flex-col gap-0' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        
        <!-- 4. Delivery Location + Date/Time Picker -->
        {% render 'delivery-date-picker' %}

        <!-- 5. Product Variant Tabs (Size or Weight) -->
        {% render 'product-variant-tabs' %}

        <!-- 6. Quantity + Buttons Row -->
        <div class="flex items-center gap-3 mb-4">
          <label class="text-xs font-bold text-gray-500 uppercase tracking-widest">Quantity</label>
          <div class="flex items-center border border-gray-200 rounded-lg bg-gray-50 h-10 px-1">
            <button type="button" onclick="this.nextElementSibling.stepDown()" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-primary transition-colors text-lg">−</button>
            <input type="number" name="quantity" value="1" min="1" class="w-10 text-center bg-transparent border-none focus:outline-none font-bold text-gray-900 text-sm">
            <button type="button" onclick="this.previousElementSibling.stepUp()" class="w-8 h-8 flex items-center justify-center text-gray-500 hover:text-primary transition-colors text-lg">+</button>
          </div>
        </div>

        <!-- Cross-Sell / Add-On Section -->
        {%- if section.settings.show_cross_sell != false -%}
          {% render 'cross-sell', section_settings: section.settings %}
        {%- endif -%}

      <!-- 7. Horizontal Tabs -->
      <div id="product-description" class="mt-8 mb-6 anim-up stagger-4">
        
        <!-- Tab Headers -->
        <div class="flex border-b border-gray-200 text-sm">
          <button type="button" class="tab-button flex-1 py-3 text-center border-b-2 border-gray-900 font-bold text-gray-900 transition-colors" data-tab="tab-desc">Description</button>
          <button type="button" class="tab-button flex-1 py-3 text-center border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-900 transition-colors" data-tab="tab-info">Product Info</button>
          <button type="button" class="tab-button flex-1 py-3 text-center border-b-2 border-transparent font-medium text-gray-500 hover:text-gray-900 transition-colors" data-tab="tab-more">More Info</button>
        </div>

        <!-- Tab Contents -->
        <div class="py-4 text-sm text-gray-600 leading-relaxed min-h-[150px]">
          <div id="tab-desc" class="tab-content block">
            {%- if product.description != blank -%}
              {{ product.description }}
            {%- else -%}
              <p>Embrace a radiant blend of warmth and affection with this curated arrangement. Celebrate life's special moments with a bouquet that says it all.</p>
              <ul class="list-none mt-2 space-y-1">
                <li>- Total No. of Stems: 33</li>
                <li>- Orange Asiatic Lily, Pink Carnation, Pink Santini</li>
                <li>- Premium Wrap with White Ribbon</li>
                <li>- Dimensions: Height 66 cm / Width 53.5 cm</li>
              </ul>
            {%- endif -%}
          </div>
          
          <div id="tab-info" class="tab-content hidden">
            <p>Every arrangement is hand-delivered by our professional concierge. We ensure the highest quality blooms sourced directly from premium growers.</p>
          </div>
          
          <div id="tab-more" class="tab-content hidden">
            <p><strong>Substitution Policy:</strong> If the order is to be delivered in less than 48 hours, & in case of unavailability of the precise shade of the flower, we reserve the right to provide the next best available product option.</p>
          </div>
        </div>
      </div>


      <!-- Trust Badges -->
      <div class="grid grid-cols-3 gap-2 py-6 border-t border-gray-100 mt-4">
        <div class="flex flex-col items-center justify-center text-center gap-2">
          <div class="w-10 h-10 rounded-full bg-green-50 text-green-600 flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider text-gray-600">Secure<br>Payment</span>
        </div>
        <div class="flex flex-col items-center justify-center text-center gap-2 border-l border-gray-100">
          <div class="w-10 h-10 rounded-full bg-primary/10 text-primary flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider text-gray-600">Premium<br>Quality</span>
        </div>
        <div class="flex flex-col items-center justify-center text-center gap-2 border-l border-gray-100">
          <div class="w-10 h-10 rounded-full bg-secondary/10 text-secondary flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="16" height="16" x="4" y="4" rx="2"/><path d="M16 2v4M8 2v4M4 10h16"/></svg>
          </div>
          <span class="text-[10px] uppercase font-bold tracking-wider text-gray-600">On-Time<br>Delivery</span>
        </div>
      </div>

      <!-- Tier Unavailability Banner (hidden by default) -->
      <div id="tier-unavailability-warning" class="hidden mb-3 p-3 bg-red-50 border border-red-200 text-red-700 text-xs font-semibold rounded-xl flex items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-red-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <span id="tier-warning-text">This product is not deliverable to your location.</span>
        </div>
        <button type="button" onclick="document.getElementById('pincode-modal-overlay') && document.getElementById('pincode-modal-overlay').classList.remove('hidden')" class="underline font-bold hover:text-red-900 whitespace-nowrap">Change Pincode</button>
      </div>

      <!-- Sticky Bottom Action Bar -->
      <div class="sticky bottom-0 left-0 w-full bg-white border-t border-gray-100 shadow-[0_-10px_20px_rgba(255,255,255,0.9)] z-50 py-4 mt-auto flex gap-3 items-center">
        <div class="flex gap-3 w-full">
          <button type="button" id="make-extra-special-trigger" class="flex-1 h-12 bg-[#1a1a1a] text-white font-bold rounded hover:bg-black transition-all uppercase tracking-wider text-xs flex items-center justify-center">
            Make it extra special
          </button>
          <button type="submit" name="add" id="add-to-cart-btn" onclick="return window.checkDeliveryTimeBeforeSubmit(event)"
            class="flex-1 h-12 bg-[#1a1a1a] text-white font-bold rounded hover:bg-black transition-all uppercase tracking-wider text-xs flex items-center justify-center gap-2"
            {% if product.available == false %}disabled{% endif %}>
            {%- if product.available == false -%}
              Sold Out
            {%- else -%}
              Add to Cart
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
            {%- endif -%}
          </button>
        </div>
      </div>
      
      {%- endform -%}

<script>
  (function() {
    let pincodeMapData = null;

    function getTierNumber(str) {
      if (!str) return '';
      const s = str.trim().toLowerCase();
      if (s.includes('tier-all') || s.includes('tier all') || s.includes('all')) return 'all';
      if (s.includes('tier-1') || s.includes('tier 1') || s.includes('tier1') || s.includes('tier-i')) return '1';
      if (s.includes('tier-2') || s.includes('tier 2') || s.includes('tier2') || s.includes('tier-ii')) return '2';
      if (s.includes('tier-3') || s.includes('tier 3') || s.includes('tier3') || s.includes('tier-iii')) return '3';
      return '';
    }

    async function getOrFetchUserTier() {
      let userTier = localStorage.getItem('user_tier');
      let userPincode = localStorage.getItem('user_pincode') || '110001'; // default Delhi Tier-1 if none saved

      if (!userTier && userPincode) {
        if (!pincodeMapData) {
          try {
            const res = await fetch("{{ 'pincodes_tier_map.json' | asset_url }}");
            pincodeMapData = await res.json();
          } catch(e) {
            console.warn('Error fetching pincode map in main-product', e);
          }
        }
        if (pincodeMapData && pincodeMapData[userPincode]) {
          userTier = pincodeMapData[userPincode];
          localStorage.setItem('user_tier', userTier);
        } else {
          userTier = 'Tier-1'; // Default fallback
        }
      }
      return getTierNumber(userTier || 'Tier-1');
    }

    async function validateProductTier() {
      const tierContainer = document.getElementById('global-product-tiers');
      if (!tierContainer) return;

      const rawTags = tierContainer.dataset.tiers || '';
      const tagsArray = rawTags.split(',').map(t => t.trim());
      
      // Extract allowed tier numbers from product tags
      const allowedTierNums = tagsArray
        .map(getTierNumber)
        .filter(Boolean);

      const mainProductSection = tierContainer.closest('section');
      if (mainProductSection) {
        mainProductSection.style.display = '';
      }

      const addToCartBtn = document.getElementById('add-to-cart-btn');
      const warningEl = document.getElementById('tier-unavailability-warning');
      const warningText = document.getElementById('tier-warning-text');

      // If product has no tier tags at all or tier-all, treat as available everywhere
      if (allowedTierNums.length === 0 || allowedTierNums.includes('all')) {
        if (addToCartBtn && !addToCartBtn.dataset.soldOut) {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (warningEl) warningEl.classList.add('hidden');
        return;
      }

      const userTierNum = await getOrFetchUserTier();

      // Tier 1 users have full coverage for Tier 1, Tier 2, Tier 3 items
      let isAllowed = false;
      if (userTierNum === '1') {
        isAllowed = true;
      } else if (userTierNum === '2') {
        isAllowed = allowedTierNums.includes('2') || allowedTierNums.includes('3');
      } else if (userTierNum === '3') {
        isAllowed = allowedTierNums.includes('3');
      } else {
        isAllowed = allowedTierNums.includes(userTierNum);
      }

      if (!isAllowed) {
        if (addToCartBtn) {
          addToCartBtn.disabled = true;
          addToCartBtn.classList.add('opacity-50', 'cursor-not-allowed');
        }
        if (warningEl) {
          if (warningText) {
            warningText.textContent = `This product is not deliverable to your location (Tier ${userTierNum || 'Selected'}).`;
          }
          warningEl.classList.remove('hidden');
        }
      } else {
        if (addToCartBtn && !addToCartBtn.dataset.soldOut) {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
        if (warningEl) {
          warningEl.classList.add('hidden');
        }
        const notFoundNotice = document.getElementById('product-not-in-tier-notice');
        if (notFoundNotice) {
          notFoundNotice.remove();
        }
      }
    }

    document.addEventListener('DOMContentLoaded', validateProductTier);
    window.addEventListener('pincodeTierUpdated', validateProductTier);
    window.addEventListener('pincodeUpdated', validateProductTier);
  })();
</script>

    </div>
  </div>
</section>

<!-- Similar Products -->
<section class="max-w-7xl mx-auto px-4 py-8 border-t border-gray-200 mt-8">
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 border-b border-gray-100 pb-4">
    <h3 class="text-xl font-serif font-bold text-gray-900 tracking-wide">SIMILAR PRODUCTS</h3>
    {% render 'sort-by-box', target_grid_id: 'similar-products-grid' %}
  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 tier-product-grid product-grid" id="similar-products-grid" data-limit="9999">
    {% assign current_product = product %}
    {% assign count = 0 %}
    {% for p in current_product.collections.first.products limit: 12 %}
      {% if p.handle != current_product.handle and count < 8 %}
        <div class="anim-scale">
          {% render 'product-card', product_card_product: p %}
        </div>
        {% assign count = count | plus: 1 %}
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- Recently Viewed Section -->
<section class="max-w-7xl mx-auto px-4 py-8 mb-12">
  <h3 class="text-xl text-gray-400 font-bold uppercase tracking-widest mb-6 border-b border-gray-100 pb-2 text-center animate-pulse-soft">RECENTLY VIEWED PRODUCTS</h3>
  <div id="recently-viewed-container" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
    <!-- Products will be injected here via JS -->
  </div>
</section>

<!-- Inject peak season data from theme settings -->
<script>
  {% capture raw_festivals_list %}{% render 'festivals-list' %}{% endcapture %}
  {% assign all_festivals_list = raw_festivals_list | strip | split: ',' %}
  window.__peakSeasonDates = [
    {% for entry in all_festivals_list %}
      {% assign f_parts = entry | split: ':' %}
      { "date": "{{ f_parts[0] }}", "region": "{{ f_parts[5] | default: 'ALL' }}" }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  window.__peakProductSurcharge = {{ settings.peak_product_surcharge | default: 15 }};
  window.__peakDeliverySurcharge = {{ settings.peak_delivery_surcharge | default: 20 }};

  {%- assign surcharge_product = all_products['peak-season-delivery-surcharge'] -%}
  {%- if surcharge_product and surcharge_product.available -%}
    window.__surchargeVariantId = {{ surcharge_product.variants.first.id }};
  {%- else -%}
    window.__surchargeVariantId = null;
  {%- endif -%}
</script>
<script src="{{ 'surcharge-logic.js' | asset_url }}"></script>

<script>
  // Horizontal Tabs Logic
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');
  
  if (tabButtons.length > 0) {
    tabButtons.forEach(button => {
      button.addEventListener('click', () => {
        // Deactivate all
        tabButtons.forEach(btn => {
          btn.classList.remove('border-gray-900', 'text-gray-900', 'font-bold');
          btn.classList.add('border-transparent', 'text-gray-500', 'font-medium');
        });
        tabContents.forEach(content => {
          content.classList.remove('block');
          content.classList.add('hidden');
        });
        
        // Activate clicked
        button.classList.remove('border-transparent', 'text-gray-500', 'font-medium');
        button.classList.add('border-gray-900', 'text-gray-900', 'font-bold');
        
        const targetId = button.getAttribute('data-tab');
        document.getElementById(targetId).classList.remove('hidden');
        document.getElementById(targetId).classList.add('block');
      });
    });
  }

  // Mirror countdown under buttons
  setInterval(() => {
    const src = document.getElementById('delivery-countdown');
    const dest = document.getElementById('button-countdown-text');
    if (src && dest) dest.innerHTML = src.innerHTML;
  }, 1000);


  // Recently Viewed Logic
  document.addEventListener('DOMContentLoaded', () => {
    const currentProductHandle = {{ product.handle | json }};
    const currentProductUrl = {{ product.url | json }};
    
    if (!currentProductHandle) return;

    // Key for local storage
    const storageKey = 'floral_recently_viewed';
    let viewed = JSON.parse(localStorage.getItem(storageKey)) || [];

    // Add current product if not already first
    const newEntry = { handle: currentProductHandle, url: currentProductUrl };
    // Filter out the current product from the list so it doesn't duplicate
    viewed = viewed.filter(item => item.handle !== currentProductHandle);
    // Add it to the top
    viewed.unshift(newEntry);
    
    // Keep only last 8
    if (viewed.length > 8) {
      viewed = viewed.slice(0, 8);
    }
    
    localStorage.setItem(storageKey, JSON.stringify(viewed));

    // Render recently viewed (excluding current product)
    const renderProducts = viewed.filter(item => item.handle !== currentProductHandle).slice(0, 4);
    const container = document.getElementById('recently-viewed-container');

    if (renderProducts.length > 0 && container) {
      const rootUrl = window.Shopify ? window.Shopify.routes.root : '/';
      
      Promise.all(
        renderProducts.map(p => fetch(`${rootUrl}products/${p.handle}.js`).then(res => {
          if (!res.ok) throw new Error('Not found');
          return res.json();
        }).catch(e => null))
      ).then(productsData => {
        const products = productsData.filter(Boolean);
        if (products && products.length > 0) {
          let html = '';
          products.forEach(p => {
            const imgUrl = p.featured_image ? p.featured_image : '//cdn.shopify.com/s/images/themes/product-1.png';
            // Format price assuming INR for this store based on screenshot, dividing by 100 as Shopify returns cents
            const priceStr = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 0 }).format(p.price / 100);
            html += `
              <a href="${p.url}" class="group block relative rounded-2xl overflow-hidden bg-white shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 h-full flex flex-col">
                <div class="aspect-w-1 aspect-h-1 w-full overflow-hidden bg-gray-50 flex-shrink-0">
                  <img src="${imgUrl}" alt="${p.title}" class="h-full w-full object-cover object-center group-hover:scale-110 transition-transform duration-700 aspect-square">
                </div>
                <div class="p-4 flex flex-col justify-between flex-grow">
                  <h3 class="text-sm font-bold text-gray-900 truncate mb-1">${p.title}</h3>
                  <p class="text-sm font-semibold text-primary">${priceStr}</p>
                </div>
              </a>
            `;
          });
          container.innerHTML = html;
        } else {
          container.parentElement.style.display = 'none';
        }
      }).catch(e => {
        console.error("Error fetching recently viewed:", e);
        container.parentElement.style.display = 'none';
      });
    } else {
      if (container) container.parentElement.style.display = 'none';
    }
  });
</script>

{% schema %}
{
  "name": "Product Information",
  "settings": [
    {
      "type": "header",
      "content": "Add-Ons / Cross-Sell Settings"
    },
    {
      "type": "checkbox",
      "id": "show_cross_sell",
      "label": "Enable Add-Ons Section",
      "default": true
    },
    {
      "type": "text",
      "id": "cross_sell_heading",
      "label": "Section Heading",
      "default": "MAKE IT EXTRA SPECIAL"
    },
    {
      "type": "text",
      "id": "cross_sell_subtitle",
      "label": "Section Subtitle",
      "default": "Pair your flowers with delicious cakes & gourmet gifts"
    },
    {
      "type": "product_list",
      "id": "addon_products",
      "label": "Select Add-On Products",
      "limit": 20,
      "info": "Select specific products to display in the Add-ons shelf. If left blank, store products will be loaded automatically."
    },
    {
      "type": "collection",
