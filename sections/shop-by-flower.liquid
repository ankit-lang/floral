{% schema %}
{
  "name": "Shop by Flower",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Flower"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Beautifully curated premium blooms for every occasion"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "flower",
      "name": "Flower Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (Optional override)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (Optional override)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Flower",
      "blocks": [
        { "type": "flower", "settings": { "title": "Roses" } },
        { "type": "flower", "settings": { "title": "Lilies" } },
        { "type": "flower", "settings": { "title": "Orchids" } },
        { "type": "flower", "settings": { "title": "Carnations" } },
        { "type": "flower", "settings": { "title": "Sunflowers" } },
        { "type": "flower", "settings": { "title": "Daisies" } },
        { "type": "flower", "settings": { "title": "Hydrangea" } },
        { "type": "flower", "settings": { "title": "Mixed Flowers" } }
      ]
    }
  ]
}
{% endschema %}

<section id="ShopByFlower-{{ section.id }}" class="py-12 md:py-16" style="background-color: {{ section.settings.bg_color }};">
  <div class="page-width mx-auto px-4 sm:px-6 lg:px-8 max-w-[1400px]">
    
    <!-- Section Header -->
    <div class="text-center mb-10 md:mb-12">
      {% if section.settings.heading != blank %}
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-serif text-gray-900 mb-3 tracking-tight">
          {{ section.settings.heading | escape }}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="text-sm md:text-base text-gray-600 max-w-2xl mx-auto font-medium">
          {{ section.settings.subheading | escape }}
        </p>
      {% endif %}
    </div>

    <!-- Flower Categories Dropdown -->
    <div class="max-w-xs mx-auto mb-8">
      <div class="relative">
        <select 
          onchange="if (this.value) window.location.href=this.value"
          class="w-full h-12 px-5 py-2.5 bg-white border border-gray-300 rounded-full text-gray-700 text-sm md:text-base font-medium focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors appearance-none cursor-pointer shadow-sm hover:border-gray-400"
          style="background-image:url('data:image/svg+xml;utf8,<svg fill=\"%236b7280\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M7 10l5 5 5-5z\"/></svg>');background-repeat:no-repeat;background-position:right 16px center;background-size:24px;"
        >
          <option value="" disabled selected>Select a flower...</option>
          {% for block in section.blocks %}
            {%- assign collection = collections[block.settings.collection] -%}
            {%- assign title = block.settings.title | default: collection.title | default: 'Flower' -%}
            {%- assign link = collection.url | default: '#' -%}
            <option value="{{ link }}" {{ block.shopify_attributes }}>{{ title }}</option>
          {% endfor %}
        </select>
      </div>
    </div>

  </div>
</section>

