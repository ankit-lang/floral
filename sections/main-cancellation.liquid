<section class="min-h-screen bg-[#FDFBF7] text-gray-900 pb-24 relative overflow-hidden">
  
  <!-- Subtle Botanical Background Overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <pattern id="floral-pattern" x="0" y="0" width="400" height="400" patternUnits="userSpaceOnUse">
        <path d="M200 50 Q 250 100 200 200 Q 150 100 200 50 Z" fill="currentColor" />
        <path d="M100 250 Q 150 200 200 250 Q 150 300 100 250 Z" fill="currentColor" />
      </pattern>
      <rect x="0" y="0" width="100%" height="100%" fill="url(#floral-pattern)"></rect>
    </svg>
  </div>

  <!-- Hero Section -->
  <div class="bg-gradient-to-b from-[#EAEFE9] to-[#FDFBF7] pt-24 pb-20 text-center px-4 relative z-10">
    <span class="text-sm font-bold text-[#E07A5F] uppercase tracking-widest mb-4 block">Store Policies</span>
    <h1 class="text-4xl md:text-5xl font-serif font-bold text-[#1D3557] mb-6">Cancellation Policy</h1>
    <p class="text-gray-600 max-w-2xl mx-auto text-lg mb-4">At Floral India, customer satisfaction is our highest priority.</p>
  </div>

  <!-- Intro Block -->
  <div class="max-w-4xl mx-auto px-4 mb-12 relative z-10">
    <div class="bg-white rounded-2xl p-6 text-center shadow-sm border border-gray-100">
      <p class="text-gray-600 leading-relaxed text-sm md:text-base">Every flower bouquet, cake, gift hamper, plant, and personalized gift is carefully prepared to ensure it reaches its destination in the best possible condition. As many of our products are fresh, perishable, or made specifically for each order, please read our Return, Refund & Cancellation Policy carefully before placing your order.</p>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="max-w-6xl mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      
      <!-- Card 1: Before Preparation -->
      <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-500 mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h2 class="text-2xl font-serif font-bold text-[#1D3557] mb-4">Before Order Preparation</h2>
        <p class="text-gray-600 mb-4 leading-relaxed">Orders may be cancelled if they have not yet entered the preparation or dispatch process.</p>
        <ul class="space-y-3">
          <li class="flex items-start gap-3 text-gray-700">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 mt-2 shrink-0"></span>
            <span>Cancellation requests should be submitted as soon as possible by contacting our Customer Support team via email or phone.</span>
          </li>
          <li class="flex items-start gap-3 text-gray-700">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 mt-2 shrink-0"></span>
            <span>Approved cancellations will be refunded using the original payment method after applicable payment gateway charges, if any.</span>
          </li>
        </ul>
      </div>

      <!-- Card 2: Express Orders -->
      <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-14 h-14 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <h2 class="text-2xl font-serif font-bold text-[#1D3557] mb-4">Same-Day & Express Delivery</h2>
        <p class="text-gray-600 mb-4 leading-relaxed">Orders placed for same-day, express, or fixed-time delivery are processed immediately.</p>
        <div class="bg-amber-50/50 border border-amber-100 p-4 rounded-xl text-amber-800 text-sm font-medium flex gap-3 items-start">
          <svg class="w-5 h-5 shrink-0 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
          <p>Once preparation has begun, these orders cannot be cancelled, modified, or refunded.</p>
        </div>
      </div>

      <!-- Card 3: Custom Orders -->
      <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-14 h-14 bg-purple-50 rounded-2xl flex items-center justify-center text-purple-500 mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
        </div>
        <h2 class="text-2xl font-serif font-bold text-[#1D3557] mb-4">Personalized & Custom Orders</h2>
        <p class="text-gray-600 mb-4 leading-relaxed">Personalized products, custom gift hampers, customized flower arrangements, printed items, engraved gifts, and other made-to-order products cannot be cancelled once production has started.</p>
      </div>

      <!-- Card 4: Order Modification -->
      <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
        <div class="w-14 h-14 bg-green-50 rounded-2xl flex items-center justify-center text-green-500 mb-6 group-hover:scale-110 transition-transform">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        </div>
        <h2 class="text-2xl font-serif font-bold text-[#1D3557] mb-4">Order Modification</h2>
        <p class="text-gray-600 mb-4 leading-relaxed">If you need to change any of the following details, please contact us immediately:</p>
        <ul class="grid grid-cols-2 gap-2 mb-6">
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Recipient name</li>
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Delivery address</li>
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Delivery date</li>
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Gift message</li>
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Contact number</li>
          <li class="flex items-center gap-2 text-sm text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-green-400"></span> Product selection</li>
        </ul>
        <div class="bg-gray-50 p-4 rounded-xl text-sm text-gray-600 font-medium">
          We will do our best to accommodate your request; however, changes cannot be guaranteed once the order has been prepared or dispatched.
        </div>
      </div>

    </div>
  </div>

  <!-- Support Footer -->
  <div class="max-w-4xl mx-auto mt-20 px-4 relative z-10">
    <div class="bg-[#1D3557] rounded-3xl p-10 md:p-12 text-center text-white overflow-hidden shadow-2xl relative">
      <div class="absolute inset-0 bg-[#E07A5F] opacity-10 mix-blend-overlay"></div>
      <h3 class="text-3xl font-serif font-bold mb-4 relative z-10">Need to cancel or modify an order?</h3>
      <p class="text-gray-300 mb-8 max-w-lg mx-auto relative z-10">Please reach out to our Customer Support team as quickly as possible so we can assist you before your order enters production.</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4 relative z-10">
        <a href="mailto:info@floralindia.com" class="inline-flex items-center justify-center gap-2 bg-white text-[#1D3557] font-bold px-8 py-4 rounded-full hover:bg-gray-100 transition-colors shadow-lg">
          Email Support
        </a>
        <a href="tel:+919811400051" class="inline-flex items-center justify-center gap-2 bg-transparent border-2 border-white/30 text-white font-bold px-8 py-4 rounded-full hover:bg-white/10 transition-colors">
          Call Us
        </a>
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Cancellation Policy",
  "settings": [],
  "presets": [{ "name": "Cancellation Policy" }]
}
{% endschema %}
