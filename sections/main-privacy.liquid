{% style %}
  :root {
    --color-cream: #fbfbf9;
    --color-sage: #9caf88;
    --color-terracotta: #e2725b;
    --color-navy: #1a2421;
  }
  
  .bg-cream { background-color: var(--color-cream); }
  .bg-sage { background-color: var(--color-sage); }
  .bg-terracotta { background-color: var(--color-terracotta); }
  .bg-navy { background-color: var(--color-navy); }
  
  .text-cream { color: var(--color-cream); }
  .text-sage { color: var(--color-sage); }
  .text-terracotta { color: var(--color-terracotta); }
  .text-navy { color: var(--color-navy); }
  
  .border-sage { border-color: var(--color-sage); }
  
  /* Abstract Watercolor Background */
  .watercolor-bg {
    background: radial-gradient(circle at 10% 20%, rgba(156, 175, 136, 0.15) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(226, 114, 91, 0.1) 0%, transparent 40%),
                radial-gradient(circle at 50% 50%, rgba(251, 251, 249, 1) 0%, var(--color-cream) 100%);
  }

  /* Glassmorphism */
  .glass-card {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 8px 32px 0 rgba(26, 36, 33, 0.05);
  }

  /* Animations */
  .fade-up { opacity: 0; transform: translateY(40px); transition: all 1s ease-out; }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }
  
  .slide-in-left { opacity: 0; transform: translateX(-50px); transition: all 1s ease-out; }
  .slide-in-left.in-view { opacity: 1; transform: translateX(0); }
  
  .slide-in-right { opacity: 0; transform: translateX(50px); transition: all 1s ease-out; }
  .slide-in-right.in-view { opacity: 1; transform: translateX(0); }

  /* Map pins */
  .pulse-pin {
    animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.5); opacity: 0; }
    50% { opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Sticky TOC styling */
  .toc-link.active {
    color: var(--color-terracotta);
    font-weight: 700;
    border-left: 2px solid var(--color-terracotta);
  }

  /* Accordion override for mobile */
  @media (max-width: 768px) {
    .content-section {
      border-bottom: 1px solid rgba(156, 175, 136, 0.3);
      padding: 1rem 0;
    }
    .content-body {
      display: none;
      padding-top: 1rem;
    }
    .content-section.open .content-body {
      display: block;
    }
    .content-section.open .toggle-icon {
      transform: rotate(180deg);
    }
  }
{% endstyle %}

