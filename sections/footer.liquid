<!-- ============================================ -->
<!-- TOP FOOTER: BADGES & SERVICE INFO            -->
<!-- ============================================ -->
<section class="bg-gray-50 border-t border-gray-200 py-6">
  <div class="max-w-7xl mx-auto px-4">
    <!-- Delivery Features -->
    <div class="flex flex-wrap items-center justify-center gap-3 mb-4">
      <span class="inline-flex items-center gap-2 bg-primary/10 text-primary text-xs font-bold px-4 py-2 rounded-full">Same Day Delivery</span>
      <span class="inline-flex items-center gap-2 bg-violet-100 text-violet-700 text-xs font-bold px-4 py-2 rounded-full transition-all" id="footer-midnight-badge">Midnight Delivery</span>
      <span class="inline-flex items-center gap-2 bg-amber-100 text-amber-700 text-xs font-bold px-4 py-2 rounded-full uppercase" id="footer-catering-badge">Service catering to INDIA</span>
    </div>
    <!-- Trust Badges -->
    <div class="flex flex-wrap items-center justify-center gap-4 md:gap-8 mb-4">
      <span class="flex items-center gap-2 text-sm text-gray-600 font-medium">Contactless Delivery</span>
      <span class="flex items-center gap-2 text-sm text-gray-600 font-medium">24×7 Customer Service</span>
      <span class="flex items-center gap-2 text-sm text-gray-600 font-medium">Guaranteed Satisfaction</span>
    </div>
    <!-- Country Toggles -->
    <div class="flex items-center justify-center gap-2" id="footer-country-toggles">
      <button type="button" class="footer-country-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer bg-primary text-white" data-country="INDIA" data-code="IN">INDIA</button>
      <button type="button" class="footer-country-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer bg-gray-200 text-gray-600 hover:bg-gray-300" data-country="UK" data-code="GB">UK</button>
      <button type="button" class="footer-country-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer bg-gray-200 text-gray-600 hover:bg-gray-300" data-country="USA" data-code="US">USA</button>
    </div>
  </div>
</section>

<script>
  (function() {
    function updateFooterDeliveryBadges() {
      const midnightBadge = document.getElementById('footer-midnight-badge');
      const cateringBadge = document.getElementById('footer-catering-badge');
      const countryBtns = document.querySelectorAll('.footer-country-btn');

      const savedCountry = (localStorage.getItem('user_country') || getFooterCookie('user_country') || 'India').trim();
      const countryUpper = savedCountry.toUpperCase();
      const isIndia = (countryUpper === 'INDIA' || countryUpper === 'IN' || countryUpper === 'DOMESTIC');

      // 1. Show Midnight Delivery badge ONLY for India, hide for International locations
      if (midnightBadge) {
        if (isIndia) {
          midnightBadge.style.display = 'inline-flex';
        } else {
          midnightBadge.style.display = 'none';
        }
      }

      // 2. Update catering text
      if (cateringBadge) {
        let displayCountry = savedCountry.toUpperCase();
        if (displayCountry === 'UNITED KINGDOM' || displayCountry === 'GB') displayCountry = 'UK';
        if (displayCountry === 'UNITED STATES' || displayCountry === 'US') displayCountry = 'USA';
        if (!displayCountry) displayCountry = 'INDIA';
        cateringBadge.textContent = `Service catering to ${displayCountry}`;
      }

      // 3. Highlight active footer country button
      countryBtns.forEach(btn => {
        const btnCountry = btn.dataset.country.toUpperCase();
        let isActive = false;
        if (btnCountry === 'INDIA' && isIndia) isActive = true;
        if (btnCountry === 'UK' && (countryUpper === 'UK' || countryUpper === 'UNITED KINGDOM' || countryUpper === 'GB')) isActive = true;
        if (btnCountry === 'USA' && (countryUpper === 'USA' || countryUpper === 'UNITED STATES' || countryUpper === 'US')) isActive = true;

        if (isActive) {
          btn.className = "footer-country-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer bg-primary text-white shadow-xs";
        } else {
          btn.className = "footer-country-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer bg-gray-200 text-gray-600 hover:bg-gray-300";
        }
      });
    }

    function setFooterCountry(country, code) {
      if (country === 'INDIA') {
        localStorage.setItem('delivery_mode', 'india');
        localStorage.setItem('user_country', 'India');
        localStorage.setItem('user_country_code', 'IN');
        setFooterCookie('user_country', 'India', 365);
        setFooterCookie('user_country_code', 'IN', 365);
        if (window.FloralCurrencyManager) window.FloralCurrencyManager.setCurrency('INR', true);
      } else if (country === 'UK') {
        localStorage.setItem('delivery_mode', 'international');
        localStorage.setItem('user_country', 'UK');
        localStorage.setItem('user_country_code', 'GB');
        setFooterCookie('user_country', 'UK', 365);
        setFooterCookie('user_country_code', 'GB', 365);
        if (window.FloralCurrencyManager) window.FloralCurrencyManager.setCurrency('GBP', true);
      } else if (country === 'USA') {
        localStorage.setItem('delivery_mode', 'international');
        localStorage.setItem('user_country', 'USA');
        localStorage.setItem('user_country_code', 'US');
        setFooterCookie('user_country', 'USA', 365);
        setFooterCookie('user_country_code', 'US', 365);
        if (window.FloralCurrencyManager) window.FloralCurrencyManager.setCurrency('USD', true);
      }

      window.dispatchEvent(new CustomEvent('pincodeUpdated', {
        detail: { country: country, countryCode: code }
      }));

      updateFooterDeliveryBadges();
    }

    function setFooterCookie(name, value, days) {
      let expires = "";
      if (days) {
        let date = new Date();
        date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
        expires = "; expires=" + date.toUTCString();
      }
      document.cookie = name + "=" + (value || "") + expires + "; path=/";
    }

    function getFooterCookie(name) {
      let nameEQ = name + "=";
      let ca = document.cookie.split(';');
      for (let i = 0; i < ca.length; i++) {
        let c = ca[i];
        while (c.charAt(0) == ' ') c = c.substring(1, c.length);
        if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
      }
      return null;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateFooterDeliveryBadges);
    } else {
      updateFooterDeliveryBadges();
    }

    const countryBtns = document.querySelectorAll('.footer-country-btn');
    countryBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        setFooterCountry(this.dataset.country, this.dataset.code);
      });
    });

    window.addEventListener('pincodeUpdated', updateFooterDeliveryBadges);
  })();
</script>

