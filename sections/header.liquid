<!-- ============================================ -->
<div id="intl-active-banner" class="hidden bg-gradient-to-r from-amber-700 via-pink-700 to-primary text-white text-xs font-semibold py-2 px-3 sm:px-4 shadow-md">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
    <div class="flex items-center justify-center sm:justify-start gap-1.5 flex-wrap text-xs">
      <span class="bg-white/20 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider shrink-0">International Active</span>
      <span>Delivering <strong class="text-amber-200 underline">Flowers & Cakes</strong> to <span id="intl-banner-country-name" class="font-bold">Worldwide</span>. <span class="text-amber-200/80 text-[10px] sm:text-xs">(Gifts available for India Delivery only)</span></span>
