<style>
  @keyframes headerIn { from{opacity:0;transform:translateY(-20px)} to{opacity:1;transform:translateY(0)} }
  .custom-scroll::-webkit-scrollbar { width: 3px; }
  .custom-scroll::-webkit-scrollbar-track { background: transparent; }
  .custom-scroll::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 10px; }
  .accordion-trigger[aria-expanded="true"] .accordion-arrow { transform: rotate(180deg); }

  .nav-bloom::after {
    content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%) scaleX(0);
    width: 60%; height: 2px; background: #0e7040; border-radius: 2px;
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .nav-bloom:hover::after { transform: translateX(-50%) scaleX(1); }

  @media (min-width: 768px) {
    .group:hover .md\:group-hover\:opacity-100 { opacity: 1 !important; }
    .group:hover .md\:group-hover\:visible { visibility: visible !important; }
  }
</style>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Mobile Search */
    const searchBtn = document.getElementById('mobile-search-btn');
    const searchDrawer = document.getElementById('mobile-search');
    const closeSearch = document.getElementById('close-search');
    if(searchBtn && searchDrawer) searchBtn.addEventListener('click', () => searchDrawer.classList.toggle('-translate-y-full'));
    if(closeSearch && searchDrawer) closeSearch.addEventListener('click', () => searchDrawer.classList.add('-translate-y-full'));

    /* Mobile Menu */
    const menuBtn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const overlay = document.getElementById('mobile-menu-overlay');
    if(menuBtn) menuBtn.addEventListener('click', () => { 
      menu.classList.remove('translate-x-full'); 
      overlay.classList.remove('opacity-0','invisible'); 
      overlay.classList.add('opacity-100','visible');
    });
    window.closeMobileMenu = () => { 
      menu.classList.add('translate-x-full'); 
      overlay.classList.add('opacity-0','invisible'); 
      overlay.classList.remove('opacity-100','visible');
    };

    window.toggleSubAccordion = (id) => {
      const target = document.getElementById(id);
      if (target) {
        target.classList.toggle('hidden');
      }
    };

    /* Accordion */
    document.querySelectorAll('.accordion-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const target = document.getElementById(btn.dataset.target);
        const isOpen = !target.classList.contains('hidden');
        document.querySelectorAll('.accordion-content').forEach(c => c.classList.add('hidden'));
        document.querySelectorAll('.accordion-trigger').forEach(b => b.setAttribute('aria-expanded','false'));
        if(!isOpen) { target.classList.remove('hidden'); btn.setAttribute('aria-expanded','true'); }
      });
    });

    /* Nav Dropdowns (Click Toggle for both Desktop & Mobile) */
    document.querySelectorAll('.group > button, .group > a').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const panel = btn.nextElementSibling;
        if (!panel || !panel.classList.contains('mobile-dropdown-panel')) return;

        // If Desktop and tag is A, allow redirect without toggling mobile dropdown
        if (window.innerWidth >= 768 && btn.tagName.toLowerCase() === 'a') {
          return;
        }

        e.preventDefault();
        e.stopPropagation(); // prevent outside click from instantly closing
        
        const isOpen = panel.classList.contains('opacity-100');
        
        // Close all dropdowns first
        document.querySelectorAll('.mobile-dropdown-panel').forEach(p => {
          p.classList.remove('opacity-100', 'visible');
          p.classList.add('opacity-0', 'invisible');
        });
        
        // If it was not open, open it
        if (!isOpen) {
          panel.classList.remove('opacity-0', 'invisible');
          panel.classList.add('opacity-100', 'visible');
        }
      });
      
      // Stop clicks inside the panel from closing it
      const panel = btn.nextElementSibling;
      if (panel && panel.classList.contains('mobile-dropdown-panel')) {
        panel.addEventListener('click', (e) => e.stopPropagation());
      }
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('.mobile-dropdown-panel').forEach(p => {
        p.classList.remove('opacity-100', 'visible');
        p.classList.add('opacity-0', 'invisible');
      });
    });
  });

  /* Header scroll effect */
  window.addEventListener('scroll', () => {
    const header = document.getElementById('main-header');
    if(window.scrollY > 50) {
      header.classList.replace('bg-white/95', 'bg-white/70');
      header.classList.add('shadow-md');
    } else {
      header.classList.replace('bg-white/70', 'bg-white/95');
      header.classList.remove('shadow-md');
    }
  });

  /* ===== HOVER CART DROPDOWN ===== */
  (function() {
    const wrapper  = document.getElementById('cart-hover-wrapper');
    const dropdown = document.getElementById('cart-hover-dropdown');
    if (!wrapper || !dropdown) return;

    let hideTimer = null;

    function showDropdown() {
      clearTimeout(hideTimer);
      dropdown.classList.remove('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
      dropdown.classList.add('opacity-100', 'visible', 'translate-y-0');
    }

    function hideDropdown() {
      hideTimer = setTimeout(function() {
        dropdown.classList.add('opacity-0', 'invisible', 'translate-y-2', 'pointer-events-none');
        dropdown.classList.remove('opacity-100', 'visible', 'translate-y-0');
      }, 180);
    }

    wrapper.addEventListener('mouseenter', showDropdown);
    wrapper.addEventListener('mouseleave', hideDropdown);
    dropdown.addEventListener('mouseenter', showDropdown);
    dropdown.addEventListener('mouseleave', hideDropdown);

    /* ---- Remove item via AJAX ---- */
    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.cart-remove-btn');
      if (!btn) return;
      e.preventDefault();

      const key = btn.dataset.key;
      const row = btn.closest('.cart-item-row');
      if (row) {
        row.style.opacity = '0.4';
        row.style.pointerEvents = 'none';
      }

      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: 0 })
      })
      .then(r => r.json())
      .then(function(cart) {
        let realCount = 0;
        cart.items.forEach(item => {
          if (item.handle !== 'peak-season-delivery-surcharge' && item.handle !== 'international-delivery-charge') {
            realCount += item.quantity;
          }
        });

        // Update badge count
        const badge = document.getElementById('cart-count-badge');
        if (badge) badge.textContent = realCount;

        // Update dropdown count text
        const countEl = document.getElementById('cart-dropdown-count');
        if (countEl) countEl.textContent = realCount + (realCount === 1 ? ' item' : ' items');

        // Update total
        const totalEl = document.getElementById('cart-dropdown-total');
        if (totalEl) {
          const rupees = (cart.total_price / 100).toFixed(2);
          totalEl.textContent = '₹' + parseFloat(rupees).toLocaleString('en-IN');
        }

        // Remove row
        if (row) row.remove();

        // If cart is now empty, show empty state
        const itemsContainer = document.getElementById('cart-dropdown-items');
        if (realCount === 0 && itemsContainer) {
          itemsContainer.innerHTML = '<div class="py-8 text-center text-gray-400 text-sm"><div class="text-4xl mb-2">🛒</div><p>Your cart is empty</p><a href="/collections/all" class="mt-3 inline-block text-xs font-bold text-primary hover:underline">Shop Now →</a></div>';
          // Hide footer buttons
          const footer = dropdown.querySelector('.border-t.border-gray-100.px-4.pb-4');
          if (footer) footer.remove();
        }

        // Also update any other cart count on page (mobile badge etc.)
        document.querySelectorAll('[data-cart-count]').forEach(el => el.textContent = realCount);
      })
      .catch(function() {
        if (row) { row.style.opacity = '1'; row.style.pointerEvents = ''; }
      });
    });

    window.triggerFlitsRewardsWidget = function() {
      const isLoggedIn = {% if customer %}true{% else %}false{% endif %};
      if (!isLoggedIn) {
        if (typeof window.openLoginModal === 'function') {
          window.openLoginModal();
        } else {
          window.location.href = '{{ routes.account_login_url }}';
        }
        return;
      }

      if (window.Flits && typeof window.Flits.openLoyaltyWidget === 'function') {
        window.Flits.openLoyaltyWidget();
        return;
      }

      const launcherBtn = document.querySelector('.flits-launcher-parent, [data-flits-launcher], #flits-loyalty-launcher, .flits-widget-launcher-btn, .flits-rewards-btn');
      if (launcherBtn) {
        launcherBtn.click();
      } else {
        window.location.href = '{{ routes.account_url }}';
      }
    };

    function updateHeaderDeliveryBadge() {
      const el = document.getElementById('header-topbar-delivery-badge');
      const navTexts = document.querySelectorAll('.header-sameday-nav-text');
      const country = (localStorage.getItem('user_country') || 'India').toUpperCase();
      const isIndia = (country === 'INDIA' || country === 'IN' || country === 'DOMESTIC');
      
      if (el) {
        if (isIndia) {
          el.textContent = 'Same Day & Midnight Delivery';
        } else {
          el.textContent = 'International Express Delivery';
        }
      }

      navTexts.forEach(t => {
        if (isIndia) {
          t.textContent = 'Same Day / Midnight';
        } else {
          t.textContent = 'Same Day Delivery';
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateHeaderDeliveryBadge);
    } else {
      updateHeaderDeliveryBadge();
    }
    window.addEventListener('pincodeUpdated', updateHeaderDeliveryBadge);
  })();
</script>


