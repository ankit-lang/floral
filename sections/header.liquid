<!-- MOBILE SEARCH DRAWER                         -->
<!-- ============================================ -->
<div id="mobile-search" class="fixed inset-x-0 top-0 z-[60] bg-white p-4 shadow-lg -translate-y-full transition-transform duration-300 lg:hidden">
  <form action="/search" method="get" class="flex gap-2">
    <input type="text" name="q" placeholder="Search flowers, cakes, gifts..." class="flex-1 h-11 pl-4 rounded-full border-2 border-gray-200 text-sm focus:outline-none focus:border-primary">
    <button type="button" id="close-search" class="w-11 h-11 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 text-lg hover:bg-gray-200 transition-colors" title="Close">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </form>
</div>

<!-- ============================================ -->
<!-- MOBILE SLIDE-OUT MENU                        -->
<!-- ============================================ -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/40 z-[70] opacity-0 invisible transition-all duration-300 lg:hidden" onclick="closeMobileMenu()"></div>
<aside id="mobile-menu" class="fixed top-0 right-0 bottom-0 w-[320px] max-w-[85vw] bg-white z-[80] translate-x-full transition-transform duration-300 lg:hidden flex flex-col shadow-2xl">

  <!-- Mobile Menu Header -->
  <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
    <span class="font-serif text-xl font-bold text-primary">Menu</span>
    <button onclick="closeMobileMenu()" class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-gray-600 hover:bg-gray-200 transition-colors" title="Close Menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Mobile Menu Links -->
  <div class="flex-1 overflow-y-auto py-4">

    <!-- Mobile Delivery Options (Stacked India Delivery & International Delivery) -->
    <div class="px-5 pb-3 space-y-2">
      <div class="text-[11px] font-bold uppercase tracking-wider text-gray-400">Select Delivery Destination</div>
      
      <!-- India Delivery Button -->
      <button type="button" onclick="closeMobileMenu(); openPincodeModal('india');" class="flex items-center justify-between w-full p-2.5 bg-emerald-50/60 border border-emerald-200 rounded-xl text-left cursor-pointer">
        <div class="flex items-center gap-2.5">
          <span class="w-5 h-3.5 rounded-xs overflow-hidden shrink-0 border border-gray-300 shadow-2xs flex flex-col justify-between">
            <span class="h-1/3 bg-[#FF9933] w-full block"></span>
            <span class="h-1/3 bg-white w-full flex items-center justify-center"></span>
            <span class="h-1/3 bg-[#138808] w-full block"></span>
          </span>
          <div>
            <div class="text-xs font-bold text-gray-900">India Delivery</div>
            <div class="text-[10px] text-gray-500 header-city-display">Delhi (Enter Pincode)</div>
          </div>
        </div>
        <span class="text-xs text-emerald-700 font-bold">Select ›</span>
      </button>

      <!-- International Delivery Button -->
      <button type="button" onclick="closeMobileMenu(); openPincodeModal('international');" class="flex items-center justify-between w-full p-2.5 bg-gradient-to-r from-amber-50 to-pink-50 border border-amber-200 rounded-xl text-left cursor-pointer">
        <div class="flex items-center gap-2.5">
          <span class="text-base">🌐</span>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-amber-900">International Delivery</span>
              <span class="text-[9px] font-bold text-pink-700 bg-pink-100 px-1.5 py-0.2 rounded-full">Flowers & Cakes</span>
            </div>
            <div class="text-[10px] text-pink-700 header-intl-country-display font-medium">Select Country</div>
          </div>
        </div>
        <span class="text-xs text-amber-800 font-bold">Select ›</span>
      </button>
    </div>

    <!-- My Wallet Mobile Drawer Button -->
    <div class="px-5 pb-3">
      {% if customer %}
        <a href="https://shopify.com/74817667150/account/pages/3e8a5ac3-0805-4b8e-a799-cf65451fab29" class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#fdf8f0] border border-[#c5a67c]/50 text-[#0e7040] rounded-xl text-sm font-semibold shadow-sm" onclick="closeMobileMenu()">
          <span class="font-serif">My Wallet & Rewards</span>
        </a>
      {% else %}
        <button onclick="closeMobileMenu(); openLoginModal();" class="flex items-center justify-center gap-2 w-full py-2.5 px-4 bg-[#fdf8f0] border border-[#c5a67c]/50 text-[#0e7040] rounded-xl text-sm font-semibold shadow-sm cursor-pointer">
          <span class="font-serif">My Wallet & Rewards</span>
        </button>
      {% endif %}
    </div>

    <!-- Mobile Festival Accordion -->
    {% assign today_num = 'now' | date: '%Y%m%d' | plus: 0 %}
    {% assign current_month = 'now' | date: '%m' %}
    {% capture raw_festivals_list %}{% render 'festivals-list' %}{% endcapture %}
    {% assign all_festivals_list = raw_festivals_list | strip | split: ',' %}
    <script>
      window.__allFestivalsData = [
        {% for entry in all_festivals_list %}
          {% assign f_parts = entry | split: ':' %}
          { 
            date: "{{ f_parts[0] }}", 
            title: "{{ f_parts[1] }}", 
            short: "{{ f_parts[2] }}", 
            icon: "{{ f_parts[3] }}", 
            handle: "{{ f_parts[4] }}",
            region: "{{ f_parts[5] | default: 'ALL' }}"
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ];
    </script>

    {% assign mob_active_fest_name = 'Independence Day' %}
    {% assign mob_active_fest_icon = '🇮🇳' %}
    {% assign mob_found_active = false %}

    {% for entry in all_festivals_list %}
      {% assign f_parts = entry | split: ':' %}
      {% assign f_date  = f_parts[0] %}
      {% assign f_short = f_parts[2] %}
      {% assign f_icon  = f_parts[3] %}
      {% assign f_num   = f_date | remove: '-' | plus: 0 %}

      {% if f_num >= today_num and mob_found_active == false %}
        {% assign mob_active_fest_name = f_short %}
        {% assign mob_active_fest_icon = f_icon %}
        {% assign mob_found_active = true %}
      {% endif %}
    {% endfor %}

    {% if mob_found_active == false %}
      {% assign mob_first_entry = all_festivals_list.first | split: ':' %}
      {% assign mob_active_fest_name = mob_first_entry[2] %}
      {% assign mob_active_fest_icon = mob_first_entry[3] %}
    {% endif %}

    <div class="mobile-accordion">
      <button class="accordion-trigger flex items-center justify-between w-full px-5 py-3 text-sm font-bold text-amber-900 bg-amber-50/60 hover:bg-amber-100/60 transition-colors" data-target="mob-festivals">
        <span class="flex items-center gap-2">
          <span class="text-base animate-pulse">{{ mob_active_fest_icon }}</span>
          <span>{{ mob_active_fest_name }}</span>
        </span>
        <svg class="w-4 h-4 text-gray-400 accordion-arrow transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </button>

      <div id="mob-festivals" class="accordion-content hidden bg-amber-50/20 divide-y divide-amber-100/60 max-h-96 overflow-y-auto">
        {% for entry in all_festivals_list %}
          {% assign f_parts = entry | split: ':' %}
          {% assign f_date  = f_parts[0] %}
          {% assign f_title = f_parts[1] %}
          {% assign f_short = f_parts[2] %}
          {% assign f_icon  = f_parts[3] %}
          {% assign f_handle= f_parts[4] %}
          {% assign f_num   = f_date | remove: '-' | plus: 0 %}
          {% assign mob_show_festival = false %}
          {% if f_num >= today_num %}
            {% assign mob_show_festival = true %}
          {% endif %}

          {% if mob_show_festival %}
            <div class="py-1 fest-nav-li"
                 data-festival-region="{{ f_parts[5] | default: 'ALL' }}" 
                 data-festival-date="{{ f_date }}" 
                 data-festival-short="{{ f_short }}" 
                 data-festival-icon="{{ f_icon }}">
              <button type="button" class="flex items-center justify-between w-full px-6 py-2.5 text-xs text-gray-800 font-semibold hover:text-amber-800 text-left cursor-pointer" onclick="toggleSubAccordion('mob-fest-sub-{{ forloop.index }}')">
                <span class="flex items-center gap-2">
                  <span>{{ f_icon }}</span>
                  <span>{{ f_short }}</span>
                </span>
                <div class="flex items-center gap-1.5">
                  <span class="text-[10px] text-gray-500 font-bold bg-white px-1.5 py-0.5 rounded border border-gray-200">{{ f_date | date: '%b %d' }}</span>
                  <svg class="w-3 h-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
                </div>
              </button>

              <!-- Festival Subcategories Accordion Content -->
              <div id="mob-fest-sub-{{ forloop.index }}" class="hidden pl-10 pr-4 py-1.5 space-y-1 bg-white/80 border-t border-amber-100/40">
                {% if f_handle == 'diwali' or f_short == 'Diwali' %}
                  <a href="/collections/diwali-hampers" class="flex items-center gap-2 py-1.5 px-2 text-[11px] text-gray-700 font-medium hover:text-amber-800" onclick="closeMobileMenu()">
                    <span>🪔 Diwali Hampers</span>
                  </a>
                  <a href="/collections/diwali-idol" class="flex items-center gap-2 py-1.5 px-2 text-[11px] text-gray-700 font-medium hover:text-amber-800" onclick="closeMobileMenu()">
                    <span>✨ Diwali Idol & Statues</span>
                  </a>
                {% elsif f_handle == 'rakhi' or f_short == 'Rakhi' %}
                  <a href="/collections/rakhihampers" class="flex items-center gap-2 py-1.5 px-2 text-[11px] text-gray-700 font-medium hover:text-amber-800" onclick="closeMobileMenu()">
                    <span>🪢 Rakhi Hampers</span>
                  </a>
                {% else %}
