{%- comment -%}
  Related Articles / Recommended Blogs Section
  Recommends related stories from the same blog based on matching tags or recency.
  Displays featured image, title, date of addition, excerpt, and link.
{%- endcomment -%}

{%- if blog.articles.size > 1 -%}
<section class="bg-gray-50/70 py-12 sm:py-16 border-t border-gray-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-12">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-primary uppercase tracking-wider mb-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          <span>Recommended Reading</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif font-bold text-gray-900 tracking-tight">
          {{ section.settings.heading | default: "Related Stories & Recommended Guides" }}
        </h2>
        <p class="text-xs sm:text-sm text-gray-600 mt-2 max-w-2xl leading-relaxed">
          {{ section.settings.subheading | default: "Explore more floral insights, gift inspiration, and celebration trends carefully chosen for you." }}
        </p>
      </div>

      {%- if section.settings.show_view_all and blog -%}
        <div class="shrink-0">
          <a href="{{ blog.url }}" class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-primary hover:text-primary-700 bg-white border border-gray-200 hover:border-primary px-4 py-2 rounded-xl transition-all shadow-2xs">
            <span>View All Posts</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Related Articles Grid -->
    {%- assign max_posts = section.settings.posts_to_show | default: 3 -%}
    {%- assign related_count = 0 -%}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {%- if blog.articles.size > 1 -%}
        <!-- Pass 1: Match articles with same tags -->
        {%- for a in blog.articles -%}
          {%- if a.id != article.id -%}
            {%- assign is_tag_match = false -%}
            {%- for t in a.tags -%}
              {%- if article.tags contains t -%}
                {%- assign is_tag_match = true -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if is_tag_match and related_count < max_posts -%}
              {% render 'article-card',
                article: a,
                show_date: section.settings.show_date,
                show_author: false,
                show_excerpt: true
              %}
              {%- assign related_count = related_count | plus: 1 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <!-- Pass 2: Backfill with other recent articles if count < max_posts -->
        {%- if related_count < max_posts -%}
          {%- for a in blog.articles -%}
            {%- if a.id != article.id -%}
              {%- assign is_tag_match = false -%}
              {%- for t in a.tags -%}
                {%- if article.tags contains t -%}
                  {%- assign is_tag_match = true -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}

              {%- unless is_tag_match -%}
                {%- if related_count < max_posts -%}
                  {% render 'article-card',
                    article: a,
                    show_date: section.settings.show_date,
                    show_author: false,
                    show_excerpt: true
                  %}
                  {%- assign related_count = related_count | plus: 1 -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}

    </div>

  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Related Articles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Stories & Recommended Guides"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore more floral insights, gift inspiration, and celebration trends carefully chosen for you."
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Number of Posts to Show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show Publication Date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    }
  ]
}
{% endschema %}
