<style>
  .gifting-models {
    padding: 60px 20px;
    background-color: #f4f6f8;
    text-align: center;
  }
  .gifting-models__header h2 {
    font-size: 2.2rem;
    color: #333;
    margin-bottom: 15px;
  }
  .gifting-models__header p {
    color: #666;
    max-width: 700px;
    margin: 0 auto 40px;
  }
  .models-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .model-card {
    background: #fff;
    border-radius: 10px;
    padding: 40px 30px;
    flex: 1 1 300px;
    max-width: 380px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    text-align: left;
    display: flex;
    flex-direction: column;
    border-top: 5px solid #ccc;
    transition: transform 0.3s;
  }
  .model-card:hover {
    transform: translateY(-5px);
  }
  .model-card--featured {
    border-top-color: #d15c7e;
    transform: scale(1.05);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .model-card--featured:hover {
    transform: scale(1.05) translateY(-5px);
  }
  .model-title {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 15px;
    color: #222;
  }
  .model-desc {
    font-size: 0.95rem;
    color: #666;
    margin-bottom: 25px;
    line-height: 1.5;
  }
  .model-features {
    list-style: none;
    padding: 0;
    margin: 0 0 30px 0;
    flex-grow: 1;
  }
  .model-feature {
    font-size: 0.95rem;
    color: #444;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    display: flex;
    align-items: flex-start;
  }
  .model-feature strong {
    display: block;
    margin-bottom: 3px;
    color: #333;
  }
  .model-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 12px;
    background-color: #333;
    color: #fff;
    text-decoration: none;
    border-radius: 5px;
    font-weight: 600;
    transition: background-color 0.2s;
  }
  .model-card--featured .model-btn {
    background-color: #d15c7e;
  }
  .model-btn:hover {
    background-color: #222;
  }
  .model-card--featured .model-btn:hover {
    background-color: #b04b68;
  }
  @media (max-width: 900px) {
    .model-card--featured {
      transform: none;
    }
    .model-card--featured:hover {
      transform: translateY(-5px);
    }
  }
</style>

<div class="gifting-models">
  <div class="gifting-models__header">
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.subheading | escape }}</p>
  </div>

  <div class="models-grid">
    {% for block in section.blocks %}
      <div class="model-card {% if block.settings.is_featured %}model-card--featured{% endif %}" {{ block.shopify_attributes }}>
        <h3 class="model-title">{{ block.settings.title | escape }}</h3>
        <p class="model-desc">{{ block.settings.description | escape }}</p>
        
        <ul class="model-features">
          <li class="model-feature">
            <div>
              <strong>Eligibility / Min. Order:</strong>
              {{ block.settings.eligibility | escape }}
            </div>
          </li>
          <li class="model-feature">
            <div>
              <strong>Branding Options:</strong>
              {{ block.settings.branding | escape }}
            </div>
          </li>
          <li class="model-feature">
            <div>
              <strong>Gift Items:</strong>
              {{ block.settings.gift_items | escape }}
            </div>
          </li>
        </ul>
        
        <a href="{{ block.settings.button_link }}" class="model-btn">{{ block.settings.button_text | escape }}</a>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Gifting Models Pricing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our 3 Models For Gifting Solutions"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose the perfect approach for your event needs and budget."
    }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Gifting Model",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Highlight as Featured",
          "default": false
        },
        {
          "type": "text",
          "id": "title",
          "label": "Model Name",
          "default": "TAILOREDMADE"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "A seamless blend of our superior quality branded products packed in a custom Tailormade packaging specified by the client."
        },
        {
          "type": "text",
          "id": "eligibility",
          "label": "Eligibility / Min Order",
          "default": "A minimum order of 25 readymade gifts"
        },
        {
          "type": "textarea",
          "id": "branding",
          "label": "Branding Options",
          "default": "Ribbon, Gift Boxes, Labelling customizations available."
        },
        {
          "type": "textarea",
          "id": "gift_items",
          "label": "Gift Items Modification",
          "default": "Content can be modified within budget."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Inquire Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gifting Models Pricing",
      "blocks": [
        {
          "type": "model",
          "settings": {
            "title": "READYMADE",
            "description": "Our product team offers a range of readymade gift hampers for your special occasion.",
            "eligibility": "Any number as they are available on website",
            "branding": "No customisations with respect to ribbons, boxes, or labelling.",
            "gift_items": "Content remains as indicated on the website.",
            "is_featured": false
          }
        },
        {
          "type": "model",
          "settings": {
            "title": "TAILOREDMADE",
            "description": "A seamless blend of our superior quality branded products packed in a custom packaging.",
            "eligibility": "Min. Order: 25 hampers",
            "branding": "Brand logo on ribbon, coloured boxes, customised labelling.",
            "gift_items": "Content can be modified within the realm of your budget.",
            "is_featured": true
          }
        },
        {
          "type": "model",
          "settings": {
            "title": "BESPOKE",
            "description": "A specially curated experience from packaging to product only for our clients.",
            "eligibility": "Orders of minimum budget Rs. 2000",
            "branding": "Theme based customisation for ribbon, boxes, and labelling.",
            "gift_items": "Content will be customised from scratch in-keeping with your budget.",
            "is_featured": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
