<section class="py-20 bg-[#FDFBF7] text-gray-900 relative overflow-hidden">
  
  <!-- Subtle Botanical Background Overlay -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.03]">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <pattern id="floral-pattern-home" x="0" y="0" width="400" height="400" patternUnits="userSpaceOnUse">
        <path d="M200 50 Q 250 100 200 200 Q 150 100 200 50 Z" fill="currentColor" />
        <path d="M100 250 Q 150 200 200 250 Q 150 300 100 250 Z" fill="currentColor" />
      </pattern>
      <rect x="0" y="0" width="100%" height="100%" fill="url(#floral-pattern-home)"></rect>
    </svg>
  </div>

  <div class="max-w-4xl mx-auto px-4 relative z-10 text-center mb-12">
    <span class="text-sm font-bold text-[#E07A5F] uppercase tracking-widest mb-4 block">Help Center</span>
    <h2 class="text-3xl md:text-4xl font-serif font-bold text-[#1D3557] mb-4">Frequently Asked Questions</h2>
    <p class="text-gray-600 max-w-2xl mx-auto">Everything you need to know about our flowers, gifts, and deliveries.</p>
  </div>

  <!-- FAQ Accordion List -->
  <div class="max-w-3xl mx-auto px-4 relative z-10 space-y-4" id="homeFaqList">
    
    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">What is Floral India?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">Floral India is an online flower and gifting service offering fresh flowers, cakes, gift hampers, plants, personalized gifts, and luxury gifting solutions for customers in India and international destinations.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">What can I send through Floral India?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">You can send fresh flowers, bouquets, cakes, gourmet hampers, chocolates, plants, personalized gifts, balloons, greeting cards, and other gifting products through Floral India.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">Does Floral India offer online flower delivery in India?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">Yes. Floral India provides online flower delivery across India, with delivery coverage across 25,000+ PIN codes and same-day and midnight delivery options in eligible locations.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">Does Floral India provide same-day flower delivery?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">Yes, same-day flower delivery is available for selected cities and products, subject to product availability and applicable order cut-off times.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">Can I schedule flower delivery for a future date?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">Yes. You can select a preferred delivery date while placing your order for occasions such as birthdays, anniversaries, weddings, and other celebrations.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">How can I track my Floral India order?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">After your order is confirmed, Floral India provides order confirmation and delivery updates through available communication channels such as email, phone, or WhatsApp, depending on the order and destination.</p>
        </div>
      </div>
    </div>

    <div class="home-faq-item group bg-white border border-gray-100 rounded-2xl shadow-sm hover:shadow-md transition-all duration-300">
      <button class="home-faq-toggle w-full px-6 py-5 flex items-center justify-between text-left focus:outline-none">
        <span class="font-serif font-bold text-lg text-[#1D3557] group-hover:text-[#E07A5F] transition-colors pr-8">Why choose Floral India for online flower and gift delivery?</span>
        <svg class="w-6 h-6 text-gray-400 shrink-0 transform transition-transform duration-300 group-hover:text-[#E07A5F]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </button>
      <div class="home-faq-content grid grid-rows-[0fr] transition-all duration-300 ease-in-out">
        <div class="overflow-hidden">
          <p class="px-6 pb-6 text-gray-600 leading-relaxed pt-2 border-t border-gray-50">Floral India combines online flower delivery, premium gifting options, domestic and international delivery, personalized gifting, secure payments, customer support, and scheduled delivery services to make celebrations easier.</p>
        </div>
      </div>
    </div>
    
  </div>
  
  <div class="text-center mt-10">
    <a href="/pages/faq" class="inline-block text-[#E07A5F] font-bold border-b-2 border-[#E07A5F] hover:text-[#c45a3f] hover:border-[#c45a3f] transition-colors pb-1">View all FAQs</a>
  </div>

</section>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const homeFaqItems = document.querySelectorAll('.home-faq-item');

  homeFaqItems.forEach(item => {
    const btn = item.querySelector('.home-faq-toggle');
    const content = item.querySelector('.home-faq-content');
    const icon = item.querySelector('svg');

    btn.addEventListener('click', () => {
      const isOpen = content.style.gridTemplateRows === '1fr';
      
      // Close all others
      document.querySelectorAll('.home-faq-content').forEach(c => c.style.gridTemplateRows = '0fr');
      document.querySelectorAll('.home-faq-toggle svg').forEach(i => i.style.transform = 'rotate(0deg)');

      // Toggle current
      if (!isOpen) {
        content.style.gridTemplateRows = '1fr';
        icon.style.transform = 'rotate(45deg)';
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "Homepage FAQ",
  "settings": [],
  "presets": [{ "name": "Homepage FAQ" }]
}
{% endschema %}
