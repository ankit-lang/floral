{% style %}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap');

  :root {
    --color-navy: #0d1521;
    --color-charcoal: #151a1e;
    --color-gold: #c5a059;
    --color-ivory: #fdfbf7;
    --color-gold-light: #e6c888;
  }

  .font-legal { font-family: 'Cormorant Garamond', serif; }
  .font-modern { font-family: 'Inter', sans-serif; }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: var(--color-navy);
    color: var(--color-ivory);
  }

  /* Cards */
  .legal-card {
    background: rgba(253, 251, 247, 0.03);
    border: 1px solid rgba(197, 160, 89, 0.15);
    border-left: 2px solid transparent;
    transition: all 0.4s ease;
  }
  .legal-card:hover {
    border-left-color: var(--color-gold);
    transform: translateY(-4px);
    background: rgba(253, 251, 247, 0.05);
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  /* Pills */
  .trust-pill {
    background: rgba(197, 160, 89, 0.1);
    border: 1px solid rgba(197, 160, 89, 0.3);
    color: var(--color-gold-light);
  }

  /* Sidebar */
  .sidebar-link {
    transition: all 0.3s ease;
    border-left: 1px solid rgba(197, 160, 89, 0.2);
  }
  .sidebar-link:hover {
    color: var(--color-ivory);
    border-left-color: var(--color-gold-light);
  }
  .sidebar-link.active {
    color: var(--color-gold);
    border-left-color: var(--color-gold);
    font-weight: 500;
  }

  /* Mobile Select */
  .mobile-select {
    background: rgba(253, 251, 247, 0.05);
    border: 1px solid rgba(197, 160, 89, 0.3);
    color: var(--color-ivory);
    appearance: none;
  }
  .mobile-select:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  /* Animations */
  .fade-up { opacity: 0; transform: translateY(30px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }
{% endstyle %}

