<section class="max-w-5xl mx-auto px-4 py-12 md:py-20 relative">
  
  <!-- Main Dual-Panel Container -->
  <div id="auth-container" class="relative bg-white rounded-3xl shadow-2xl overflow-hidden min-h-[600px] w-full flex flex-col md:flex-row transition-all duration-700 mx-auto border border-gray-100" style="background-image: url('https://www.transparenttextures.com/patterns/floral-flourish.png');">
    
    <!-- ========================================== -->
    <!-- LEFT SIDE: SIGN IN / RECOVER FORM -->
    <!-- ========================================== -->
    <div id="sign-in-panel" class="form-panel absolute top-0 left-0 w-full md:w-1/2 h-full z-20 flex flex-col justify-center items-center px-8 sm:px-16 transition-all duration-700 ease-in-out bg-white/90 backdrop-blur-sm">
      
      <!-- Login Form -->
      <div id="login-form-wrap" class="w-full max-w-sm transition-all duration-300">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-serif font-bold text-gray-900 mb-2">Welcome back,</h1>
        </div>

        {% form 'customer_login', class: 'space-y-6 w-full', id: 'customer-login-form' %}
          {%- if form.errors -%}
            <div class="p-3 bg-red-50 text-red-700 text-sm font-semibold rounded-lg border border-red-200">
              {{ form.errors | default_errors }}
            </div>
            <!-- Auto-trigger login view on error -->
            <script>window.location.hash = '#login';</script>
          {%- endif -%}

          <!-- Smart redirect: back to cart if came from cart, else home -->
          <input type="hidden" name="return_to" id="login-return-to" value="/">
          <script>
            (function() {
              var ref = document.referrer || '';
              var returnTo = '/';
              if (ref.indexOf('/cart') !== -1) {
                returnTo = '/cart';
              } else if (ref.indexOf('/collections') !== -1 || ref.indexOf('/products') !== -1) {
                returnTo = ref.replace(window.location.origin, '');
              }
              var input = document.getElementById('login-return-to');
              if (input) input.value = returnTo;
            })();
          </script>

          <div class="relative">
            <input type="email" name="customer[email]" id="CustomerEmail" placeholder="Email" autocomplete="email" required 
              class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2">
          </div>

          {%- if form.password_needed -%}
            <div class="relative">
              <input type="password" name="customer[password]" id="CustomerPassword" placeholder="Password" autocomplete="current-password" required 
                class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2 pr-10">
              <button type="button" onclick="togglePassword('CustomerPassword', this)" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
              </button>
            </div>
            
            <div class="text-center mt-2">
              <a href="#recover" onclick="showRecoverForm(event)" class="text-xs font-medium text-pink-400 hover:text-pink-600 transition-colors">Forgot password?</a>
            </div>
          {%- endif -%}

          <button type="submit" class="w-full h-12 mt-6 rounded-full bg-[#95b89a] text-white font-bold tracking-wider hover:bg-[#7fa384] transition-colors shadow-lg shadow-green-900/10 uppercase">
            Sign In
          </button>
        {% endform %}

        <!-- Or Divider -->
        <div class="relative flex items-center justify-center my-4">
          <div class="border-t border-gray-200 w-full"></div>
          <span class="bg-white/90 px-3 text-xs text-gray-400 font-light">or</span>
          <div class="border-t border-gray-200 w-full"></div>
        </div>

        <p class="text-xs text-gray-500 mb-3 text-center font-medium">Connect with</p>

        <!-- Social Icons -->
        <div class="flex items-center justify-center gap-3">
          <a href="{{ routes.account_login_url }}" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center bg-white shadow-sm hover:border-gray-300 hover:shadow transition-all" title="Sign in with Google">
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.62z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
          </a>
          <a href="{{ routes.account_login_url }}" class="w-8 h-8 rounded-full border border-gray-200 flex items-center justify-center bg-white shadow-sm hover:border-gray-300 hover:shadow transition-all" title="Sign in with Facebook">
            <svg class="w-4 h-4 fill-[#1877F2]" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Recover Password Form (Hidden by default) -->
      <div id="recover-form-wrap" class="w-full max-w-sm hidden opacity-0 transition-all duration-300 absolute">
        <div class="text-center mb-8">
          <h2 class="text-3xl font-serif font-bold text-gray-900 mb-2">Reset Password</h2>
          <p class="text-sm text-gray-500">We will send you an email to reset your password.</p>
        </div>

        {% form 'recover_customer_password', class: 'space-y-6 w-full' %}
          {%- if form.errors -%}
            <div class="p-3 bg-red-50 text-red-700 text-sm font-semibold rounded-lg border border-red-200">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <div class="p-3 bg-green-50 text-green-700 text-sm font-semibold rounded-lg border border-green-200">
              We've sent you an email with a link to update your password.
            </div>
          {%- endif -%}

          <div class="relative">
            <input type="email" name="email" id="RecoverEmail" placeholder="Email Address" autocomplete="email" required 
              class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2">
          </div>

          <button type="submit" class="w-full h-12 mt-6 rounded-full bg-[#95b89a] text-white font-bold tracking-wider hover:bg-[#7fa384] transition-colors shadow-lg uppercase">
            Submit
          </button>
          
          <div class="text-center mt-4">
            <a href="#login" onclick="hideRecoverForm(event)" class="text-xs font-medium text-gray-500 hover:text-gray-800 transition-colors">Cancel</a>
          </div>
        {% endform %}
      </div>
      
      <!-- Mobile Toggle Button (Only visible on small screens) -->
      <div class="md:hidden mt-8 text-center w-full border-t border-gray-100 pt-6">
        <p class="text-sm text-gray-600 mb-3">New here?</p>
        <button onclick="togglePanel()" class="w-full h-12 rounded-full border-2 border-[#95b89a] text-[#95b89a] font-bold tracking-wider uppercase">
          Sign Up
        </button>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- RIGHT SIDE: SIGN UP FORM -->
    <!-- ========================================== -->
    <div id="sign-up-panel" class="form-panel absolute top-0 left-0 w-full md:w-1/2 h-full flex flex-col justify-center items-center px-8 sm:px-16 transition-all duration-700 ease-in-out bg-white/90 backdrop-blur-sm opacity-0 z-10 hidden md:flex">
      
      <div class="w-full max-w-sm">
        <div class="text-center mb-8">
          <h1 class="text-3xl font-serif font-bold text-gray-900 mb-2">Create Account</h1>
        </div>

        {% form 'create_customer', class: 'space-y-5 w-full' %}
          {%- if form.errors -%}
            <div class="p-3 bg-red-50 text-red-700 text-sm font-semibold rounded-lg border border-red-200">
              {{ form.errors | default_errors }}
            </div>
            <!-- Auto-trigger signup view on error -->
            <script>window.location.hash = '#register';</script>
          {%- endif -%}

          <div class="flex gap-4">
            <div class="relative w-1/2">
              <input type="text" name="customer[first_name]" id="RegisterForm-FirstName" placeholder="First Name" autocomplete="given-name" 
                class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2">
            </div>
            <div class="relative w-1/2">
              <input type="text" name="customer[last_name]" id="RegisterForm-LastName" placeholder="Last Name" autocomplete="family-name" 
                class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2">
            </div>
          </div>

          <div class="relative">
            <input type="email" name="customer[email]" id="RegisterForm-email" placeholder="Email" autocomplete="email" required 
              class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2">
          </div>

          <div class="relative">
            <input type="password" name="customer[password]" id="RegisterForm-password" placeholder="Password" autocomplete="new-password" required 
              class="w-full h-12 bg-transparent border-0 border-b-2 border-gray-200 text-sm text-gray-900 placeholder-gray-400 focus:ring-0 focus:border-sage-500 transition-colors px-2 pr-10">
            <button type="button" onclick="togglePassword('RegisterForm-password', this)" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>
            </button>
          </div>

          <button type="submit" class="w-full h-12 mt-8 rounded-full bg-[#95b89a] text-white font-bold tracking-wider hover:bg-[#7fa384] transition-colors shadow-lg shadow-green-900/10 uppercase">
            Sign Up
          </button>
        {% endform %}
      </div>
      
      <!-- Mobile Toggle Button (Only visible on small screens) -->
      <div class="md:hidden mt-8 text-center w-full border-t border-gray-100 pt-6">
        <p class="text-sm text-gray-600 mb-3">Already have an account?</p>
        <button onclick="togglePanel()" class="w-full h-12 rounded-full border-2 border-[#95b89a] text-[#95b89a] font-bold tracking-wider uppercase">
          Sign In
        </button>
      </div>

    </div>

    <!-- ========================================== -->
    <!-- OVERLAY PANELS (DESKTOP ONLY)              -->
    <!-- ========================================== -->
    <div id="overlay-container" class="hidden md:block absolute top-0 left-1/2 w-1/2 h-full overflow-hidden transition-transform duration-700 z-50">
      
      <!-- The image that moves opposite to the container to stay in place -->
      <div id="overlay-bg" class="absolute top-0 left-[-100%] w-[200%] h-full bg-cover bg-center transition-transform duration-700 text-white" 
           style="background-image: url('{{ 'login_modal_banner.png' | asset_url }}');">
        
        <div class="absolute inset-0 bg-black/30"></div> <!-- Darkening overlay for text legibility -->

        <!-- Left Overlay (Shown when SignUp is active) -->
        <div id="overlay-left" class="absolute top-0 left-0 w-1/2 h-full flex flex-col justify-center items-center text-center px-12 transition-transform duration-700 translate-x-[-20%]">
          <h2 class="text-4xl font-serif font-bold mb-4 drop-shadow-md">Welcome Back!</h2>
          <p class="mb-8 text-sm md:text-base drop-shadow-md">To keep connected with us please login with your personal info</p>
          <button onclick="togglePanel()" class="rounded-full border-2 border-white px-10 py-3 font-bold uppercase tracking-widest text-sm hover:bg-white hover:text-black transition-colors backdrop-blur-sm">
            Sign In
          </button>
        </div>

        <!-- Right Overlay (Shown when SignIn is active) -->
        <div id="overlay-right" class="absolute top-0 right-0 w-1/2 h-full flex flex-col justify-center items-center text-center px-12 transition-transform duration-700 translate-x-0">
          <h2 class="text-4xl font-serif font-bold mb-4 drop-shadow-md">New here?</h2>
          <p class="mb-8 text-sm md:text-base drop-shadow-md">Sign up and discover a great amount of new opportunities!</p>
          <button onclick="togglePanel()" class="rounded-full border-2 border-white px-10 py-3 font-bold uppercase tracking-widest text-sm hover:bg-white hover:text-black transition-colors backdrop-blur-sm">
            Sign Up
          </button>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- ========================================== -->
<!-- CSS ANIMATIONS AND STYLES                  -->
<!-- ========================================== -->
<style>
  /* Base transitions */
  .form-panel, #overlay-container, #overlay-bg, #overlay-left, #overlay-right {
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* When "Right Panel Active" (Registration State) */
  #auth-container.right-panel-active #sign-in-panel {
    transform: translateX(100%);
    opacity: 0;
  }
  
  #auth-container.right-panel-active #sign-up-panel {
    transform: translateX(100%);
    opacity: 1;
    z-index: 30;
  }
  
  #auth-container.right-panel-active #overlay-container {
    transform: translateX(-100%);
  }
  
  #auth-container.right-panel-active #overlay-bg {
    transform: translateX(50%);
  }
  
  #auth-container.right-panel-active #overlay-left {
    transform: translateX(0);
  }
  
  #auth-container.right-panel-active #overlay-right {
    transform: translateX(20%);
  }

  /* Mobile overrides */
  @media (max-width: 767px) {
    #sign-up-panel {
      transform: none !important;
      position: relative;
    }
    #sign-in-panel {
      transform: none !important;
      position: relative;
    }
    
    #auth-container.right-panel-active #sign-in-panel {
      display: none;
    }
    
    #auth-container:not(.right-panel-active) #sign-up-panel {
      display: none;
    }
  }
</style>

<!-- ========================================== -->
<!-- JAVASCRIPT LOGIC                           -->
<!-- ========================================== -->
<script>
  // Panel Toggle Logic
  function togglePanel() {
    const container = document.getElementById('auth-container');
    container.classList.toggle('right-panel-active');
    
    // Update hash so URL is sharable
    if (container.classList.contains('right-panel-active')) {
      window.history.pushState(null, null, '#register');
    } else {
      window.history.pushState(null, null, '#login');
    }
  }

  // Handle URL hashes on page load for initial state (e.g., failed registration redirects)
  document.addEventListener('DOMContentLoaded', () => {
    if (window.location.hash === '#register') {
      document.getElementById('auth-container').classList.add('right-panel-active');
      
      // Ensure mobile view displays correctly
      if (window.innerWidth < 768) {
        document.getElementById('sign-up-panel').classList.remove('hidden');
        document.getElementById('sign-up-panel').classList.add('flex');
      }
    }
    
    if (window.location.hash === '#recover') {
      showRecoverForm();
    }
  });

  // Password Visibility Toggle
  function togglePassword(inputId, btn) {
    const input = document.getElementById(inputId);
    if (input.type === 'password') {
      input.type = 'text';
      btn.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" /></svg>';
    } else {
      input.type = 'password';
      btn.innerHTML = '<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" /></svg>';
    }
  }

  // Recover Password Transitions
  function showRecoverForm(e) {
    if(e) e.preventDefault();
    const loginWrap = document.getElementById('login-form-wrap');
    const recoverWrap = document.getElementById('recover-form-wrap');
    
    loginWrap.classList.add('opacity-0');
    setTimeout(() => {
      loginWrap.classList.add('hidden');
      loginWrap.classList.remove('absolute'); // ensure positioning is removed
      
      recoverWrap.classList.remove('hidden');
      // allow display block to apply before animating opacity
      setTimeout(() => {
        recoverWrap.classList.remove('absolute');
        recoverWrap.classList.remove('opacity-0');
      }, 50);
    }, 300);
    
    window.history.pushState(null, null, '#recover');
  }

  function hideRecoverForm(e) {
    if(e) e.preventDefault();
    const loginWrap = document.getElementById('login-form-wrap');
    const recoverWrap = document.getElementById('recover-form-wrap');
    
    recoverWrap.classList.add('opacity-0');
    setTimeout(() => {
      recoverWrap.classList.add('hidden', 'absolute');
      
      loginWrap.classList.remove('hidden', 'absolute');
      setTimeout(() => {
        loginWrap.classList.remove('opacity-0');
      }, 50);
    }, 300);
    
    window.history.pushState(null, null, '#login');
  }
</script>

{% schema %}
{
  "name": "Login Page",
  "settings": []
}
{% endschema %}
