<section class="max-w-7xl mx-auto px-4 py-24 overflow-hidden">
  <div class="bg-gradient-to-br from-blush to-champagne rounded-3xl overflow-hidden shadow-xl border border-white/50">
    <div class="flex flex-col md:flex-row">
      <!-- Left: Text & CTA -->
      <div class="md:w-1/2 p-12 md:p-16 flex flex-col justify-center anim-fade stagger-1">
        <div class="flex items-center gap-3 mb-4">
          <!-- Animated Bell -->
          <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-md group hover:bg-gold transition-colors cursor-pointer origin-top animate-[leaf-sway_3s_ease-in-out_infinite] hover:animate-none hover:rotate-[15deg]">
            <svg class="w-6 h-6 text-gold group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
          </div>
          <span class="text-sm font-bold text-gray-500 uppercase tracking-widest">Concierge & Branding</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl font-serif font-bold text-gray-900 mb-6 leading-tight">Unlisted Gifts? <br>Consider it done.</h2>
        <p class="text-gray-700 text-lg mb-8 leading-relaxed">Have your logo or branding seamlessly integrated on our merchandise, or request bespoke products not currently listed on the portal. Simply let our concierge know, and we'll arrange it flawlessly.</p>
        
        <a href="#callback" class="inline-flex items-center justify-center h-14 px-8 rounded-full bg-gray-900 text-white font-semibold text-lg hover:bg-gold transition-all duration-300 shadow-lg hover:shadow-gold/40 hover:-translate-y-1 w-fit group">
          Contact Concierge
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </a>
      </div>

      <!-- Right: Mockup Visual -->
      <div class="md:w-1/2 relative bg-white/40 p-8 md:p-12 flex items-center justify-center anim-left stagger-2">
        <div class="absolute inset-0 bg-gradient-to-l from-transparent to-white/20 pointer-events-none"></div>
        <div class="relative w-full aspect-square max-w-md bg-white rounded-2xl shadow-2xl p-6 transform rotate-3 hover:rotate-0 transition-transform duration-500">
          <!-- Abstract Merchandise Mockup -->
          <div class="w-full h-full border-2 border-dashed border-gold/30 rounded-xl flex flex-col items-center justify-center bg-gray-50 relative overflow-hidden group">
            <div class="absolute inset-0 bg-cover bg-center opacity-10" style="background-image: url('https://cdn.shopify.com/s/files/1/0748/1766/7150/files/hero-banner.png');"></div>
            <svg class="w-20 h-20 text-gold mb-4 group-hover:scale-110 transition-transform duration-500 relative z-10" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="12" rx="2" ry="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H10a2 2 0 0 0-2 2v2"></path></svg>
            <span class="text-gray-400 font-serif font-bold text-xl relative z-10">Your Logo Here</span>
            <!-- Shimmer -->
            <div class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/60 to-transparent skew-x-[-20deg] group-hover:animate-[shimmer_1.5s_infinite]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Corporate Concierge",
  "settings": [],
  "presets": [{ "name": "Corporate Concierge" }]
}
{% endschema %}
