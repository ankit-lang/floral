<!-- Social Proof: Modern Carousel -->
<style>
  .testimonial-carousel-container {
    padding: 6rem 1rem;
    overflow: hidden;
    position: relative;
  }
  
  .testimonial-carousel {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 2rem;
    padding-left: max(1rem, calc((100vw - 1280px) / 2));
    padding-right: 1rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none; /* Firefox */
  }
  
  .testimonial-carousel::-webkit-scrollbar {
    display: none; /* Chrome/Safari */
  }
  
  .testimonial-card {
    flex: 0 0 85%;
    max-width: 400px;
    scroll-snap-align: center;
    position: relative;
    border-radius: 1.5rem;
    background: #fff;
    padding: 2.5rem;
    box-shadow: 0 10px 40px -10px rgba(0,0,0,0.08);
    border: 1px solid rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  
  .testimonial-card:hover {
    transform: translateY(-5px);
  }
  
  @media (min-width: 768px) {
    .testimonial-card {
      flex: 0 0 45%;
      scroll-snap-align: start;
    }
  }
  
  @media (min-width: 1024px) {
    .testimonial-card {
      flex: 0 0 30%;
    }
  }

  .carousel-wrapper {
    position: relative;
    max-width: 1400px;
    margin: 0 auto;
  }

  .carousel-nav {
    position: absolute;
    top: calc(50% - 1rem); /* Center relative to cards, offset padding */
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 0.5rem;
    pointer-events: none;
    z-index: 10;
  }
  
  .carousel-btn {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background-color: white;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4b5563;
    cursor: pointer;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    transition: all 0.2s ease;
    pointer-events: auto; /* Re-enable clicks */
  }
  
  .carousel-btn:hover {
    background-color: #f9fafb;
    color: #111827;
    transform: scale(1.05);
  }

  @media (min-width: 1440px) {
    .carousel-nav {
      width: calc(100% + 4rem);
      left: -2rem;
    }
  }
</style>

<section class="testimonial-carousel-container bg-gradient-to-b from-cream to-white" id="social-proof-{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 text-center mb-12 anim-up">
    <h2 class="text-3xl md:text-5xl font-serif text-gray-900 mb-4">Loved by Thousands</h2>
    <p class="text-gray-500 max-w-2xl mx-auto">See why over 50,000 customers across India choose us for their most precious moments.</p>
  </div>
  
  <div class="carousel-wrapper">
    <div class="testimonial-carousel drag-scroll anim-fade">
      {%- assign reviews = 'Absolutely stunning arrangement! Delivered on time and fresh.,The cake was delicious and beautifully decorated. Made her birthday special!,Best gifting service in India. The plants were healthy and well-packed.,Incredible attention to detail. The luxury orchids were breathtaking.,Very reliable and the same day delivery saved my anniversary!' | split: ',' -%}
      {%- assign reviewers = 'Priya M.,Rahul S.,Meera K.,Ananya T.,Vikram D.' | split: ',' -%}
      
      {% for i in (0..4) %}
        <div class="testimonial-card magic-glow stagger-{{ forloop.index }}">
          <!-- Quote Icon -->
          <div class="text-rose-200 mb-4">
            <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 32 32" aria-hidden="true">
              <path d="M9.352 4C4.456 7.456 1 13.12 1 19.36c0 5.088 3.072 8.064 6.624 8.064 3.36 0 5.856-2.688 5.856-5.856 0-3.168-2.208-5.472-5.088-5.472-.576 0-1.344.096-1.536.192.48-3.264 3.552-7.104 6.624-9.024L9.352 4zm16.512 0c-4.8 3.456-8.256 9.12-8.256 15.36 0 5.088 3.072 8.064 6.624 8.064 3.264 0 5.856-2.688 5.856-5.856 0-3.168-2.304-5.472-5.184-5.472-.576 0-1.248.096-1.44.192.48-3.264 3.456-7.104 6.528-9.024L25.864 4z"/>
            </svg>
          </div>
          
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {% for s in (1..5) %}<svg class="w-5 h-5 text-amber-400" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>{% endfor %}
          </div>
          
          <p class="text-base text-gray-700 leading-relaxed mb-6 font-medium flex-1">"{{ reviews[i] }}"</p>
          
          <div class="flex items-center gap-3 mt-auto">
            <div class="w-10 h-10 rounded-full bg-rose-100 flex items-center justify-center text-rose-800 font-bold shadow-inner">
              {{ reviewers[i] | slice: 0 }}
            </div>
            <span class="text-sm font-bold text-gray-900">{{ reviewers[i] }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
    
    <div class="carousel-nav anim-fade">
      <button class="carousel-btn" onclick="document.querySelector('#social-proof-{{ section.id }} .testimonial-carousel').scrollBy({left: -350, behavior: 'smooth'})" aria-label="Previous">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      </button>
      <button class="carousel-btn" onclick="document.querySelector('#social-proof-{{ section.id }} .testimonial-carousel').scrollBy({left: 350, behavior: 'smooth'})" aria-label="Next">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social Proof Carousel",
  "settings": [],
  "presets": [{ "name": "Social Proof Carousel" }]
}
{% endschema %}
