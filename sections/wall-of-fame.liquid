  "name": "Wall of Fame",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1 (Left Bottom)"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2 (Left Top)"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3 (Left Mid)"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4 (Center Tall)"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5 (Right Top)"
    },
    {
      "type": "image_picker",
      "id": "image_6",
