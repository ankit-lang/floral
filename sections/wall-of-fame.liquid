<!-- sections/wall-of-fame.liquid -->
<style>
  .wall-of-fame-container {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 6rem 1rem;
    overflow: hidden;
    background-color: #faf9f6; /* Soft cream background */
  }
  
  .wall-of-fame-header {
    text-align: center;
    margin-bottom: 4rem;
  }
  
  .wall-of-fame-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 80px;
    gap: 1rem;
    position: relative;
    z-index: 2;
  }
  
  .wof-img {
    border-radius: 1.5rem;
    overflow: hidden;
    position: relative;
    box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1);
    background-color: #eee;
  }
  
  .wof-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .wof-img:hover img {
    transform: scale(1.05);
  }
  
  /* Layout mimicking the reference image */
  @media (min-width: 768px) {
    .wof-item-1 { grid-column: 1 / 4; grid-row: 3 / 8; }
    .wof-item-2 { grid-column: 3 / 6; grid-row: 1 / 5; }
    .wof-item-3 { grid-column: 3 / 6; grid-row: 5 / 9; }
    .wof-item-4 { grid-column: 6 / 9; grid-row: 1 / 10; }
    .wof-item-5 { grid-column: 9 / 12; grid-row: 1 / 5; }
    .wof-item-6 { grid-column: 10 / 13; grid-row: 3 / 8; z-index: -1; }
    .wof-item-7 { grid-column: 9 / 12; grid-row: 5 / 9; }
  }

  /* Layered Typography */
  .wof-typography {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: clamp(4rem, 10vw, 14rem);
    font-family: serif;
    color: #fff;
    z-index: 5;
    pointer-events: none;
    line-height: 0.85;
    text-align: center;
    font-weight: 400;
    text-shadow: 0 10px 30px rgba(0,0,0,0.15);
    mix-blend-mode: overlay; /* Creates the beautiful integration effect */
    display: flex;
    flex-direction: column;
  }
  
  .wof-typography span:nth-child(1) { margin-left: -2em; }
  .wof-typography span:nth-child(2) { margin-left: 2em; text-indent: 1em; }
  
  /* Background Watermark */
  .wof-watermark {
    position: absolute;
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 20rem;
    font-family: serif;
    color: rgba(200, 190, 180, 0.1);
    z-index: 1;
    pointer-events: none;
    white-space: nowrap;
    letter-spacing: -0.05em;
  }
  
  .wof-watermark.bottom {
    top: auto;
    bottom: -5%;
    left: 10%;
    transform: none;
  }
  
  @media (max-width: 767px) {
    .wall-of-fame-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 150px;
    }
    .wof-item-1 { grid-column: 1 / 2; grid-row: 1 / 3; }
    .wof-item-2 { display: none; }
    .wof-item-3 { grid-column: 2 / 3; grid-row: 2 / 4; }
    .wof-item-4 { grid-column: 1 / 3; grid-row: 4 / 7; }
    .wof-item-5 { display: none; }
    .wof-item-6 { grid-column: 1 / 2; grid-row: 7 / 9; }
    .wof-item-7 { grid-column: 2 / 3; grid-row: 6 / 8; }
    
    .wof-typography {
      mix-blend-mode: normal;
      color: white;
      text-shadow: 0 4px 10px rgba(0,0,0,0.5);
    }
    .wof-typography span:nth-child(1) { margin-left: 0; }
    .wof-typography span:nth-child(2) { margin-left: 0; text-indent: 0; }
  }
</style>

<section class="wall-of-fame-container anim-up">
  <div class="wof-watermark anim-fade stagger-1">WALL OF FAME</div>
  <div class="wof-watermark bottom anim-fade stagger-2">WALL OF FAME</div>
  
  <div class="wall-of-fame-grid">
    <!-- Item 1: Left Bottom -->
    <div class="wof-img wof-item-1 anim-scale stagger-1">
      {% if section.settings.image_1 %}
        <img src="{{ section.settings.image_1 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 2: Left Top Small -->
    <div class="wof-img wof-item-2 anim-scale stagger-2">
      {% if section.settings.image_2 %}
        <img src="{{ section.settings.image_2 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 3: Left Mid -->
    <div class="wof-img wof-item-3 anim-scale stagger-3">
      {% if section.settings.image_3 %}
        <img src="{{ section.settings.image_3 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 4: Center Main -->
    <div class="wof-img wof-item-4 anim-scale stagger-1">
      {% if section.settings.image_4 %}
        <img src="{{ section.settings.image_4 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 5: Right Top -->
    <div class="wof-img wof-item-5 anim-scale stagger-2">
      {% if section.settings.image_5 %}
        <img src="{{ section.settings.image_5 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 6: Right Mid -->
    <div class="wof-img wof-item-6 anim-scale stagger-4">
      {% if section.settings.image_6 %}
        <img src="{{ section.settings.image_6 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>
    
    <!-- Item 7: Right Bottom -->
    <div class="wof-img wof-item-7 anim-scale stagger-3">
      {% if section.settings.image_7 %}
        <img src="{{ section.settings.image_7 | img_url: 'master' }}" alt="Wall of Fame" loading="lazy">
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover text-gray-300' }}
      {% endif %}
    </div>

    <!-- Floating Typography -->
    <div class="wof-typography">
      <span>WALL</span>
      <span>OF FAME</span>
    </div>
  </div>
</section>

