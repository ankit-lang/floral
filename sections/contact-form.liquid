{% style %}
  .fade-up { opacity: 1; transform: translateY(0); transition: all 0.6s ease-out; }
  .fade-up.in-view { opacity: 1; transform: translateY(0); }
  
  .form-input-focus:focus-within {
    border-color: #e2725b !important;
    box-shadow: 0 0 0 2px rgba(226, 114, 91, 0.2);
  }
{% endstyle %}

<section class="max-w-7xl mx-auto px-4 py-16 md:py-24">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24">
    
    <!-- Left Column: Info & Details -->
    <div class="space-y-10">
      
      <div class="fade-up">
        <h1 class="text-3xl md:text-5xl font-serif text-[#1a2421] mb-4 font-bold">{{ section.settings.title | default: 'Contact Us' }}</h1>
        <p class="text-gray-600 text-sm md:text-base leading-relaxed max-w-md">{{ section.settings.subtitle | default: "Have a query? Need assistance? Simply reach out for answers. We love staying in touch with you!" }}</p>
      </div>

      <!-- WhatsApp Card -->
      <a href="https://wa.me/919910200043" target="_blank" class="block fade-up bg-[#ecf7f0] border-l-4 border-[#25D366] rounded-r-lg p-6 flex items-center justify-between shadow-sm hover:shadow-md transition-shadow group" style="transition-delay: 0.1s;">
        <div>
          <div class="w-8 h-8 rounded-full bg-[#25D366] text-white flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.01 2.012A9.98 9.98 0 0 0 2.03 12c0 1.943.518 3.824 1.503 5.502L2 22l4.63-1.46A9.97 9.97 0 0 0 12.01 22a9.982 9.982 0 0 0 0-19.988zm0 18.371a8.33 8.33 0 0 1-4.27-1.182l-.307-.181-3.172 1.001 1.018-3.093-.199-.317A8.347 8.347 0 0 1 3.666 12 8.358 8.358 0 0 1 12.01 3.642 8.358 8.358 0 0 1 20.354 12a8.358 8.358 0 0 1-8.344 8.383z"/><path d="M16.666 14.88c-.23-.115-1.378-.68-1.593-.758-.215-.077-.37-.115-.526.115-.155.23-.604.757-.74.912-.136.153-.272.172-.502.057-.23-.115-.983-.362-1.872-1.154-.693-.616-1.161-1.378-1.298-1.608-.137-.23-.015-.355.101-.47.104-.103.23-.268.345-.402.115-.134.153-.23.23-.383.076-.153.038-.287-.019-.402-.057-.115-.526-1.264-.72-1.724-.19-.45-.382-.389-.526-.396l-.448-.007c-.155 0-.404.057-.614.287-.21.23-.804.785-.804 1.915 0 1.13.824 2.221.939 2.375.115.153 1.628 2.486 3.94 3.483.552.238.983.383 1.32.49.553.176 1.056.15 1.455.092.447-.065 1.378-.563 1.57-1.11.191-.548.191-1.015.134-1.11-.057-.096-.21-.153-.44-.268z"/></svg>
          </div>
          <h3 class="text-base font-bold text-[#1a2421]">Fastest way to reach us.</h3>
          <p class="text-sm text-gray-700 mt-1">Send us a message on WhatsApp.</p>
        </div>
      </a>

      <!-- Contact Details Blocks -->
      <div class="space-y-8">
        
        <div class="fade-up border-l-4 border-[#1a2421] pl-5" style="transition-delay: 0.2s;">
          <h4 class="text-sm font-bold text-[#1a2421] uppercase tracking-wider mb-2">Email:</h4>
          <a href="mailto:info@floralindia.com" class="text-gray-700 text-sm hover:text-[#e2725b] transition-colors">info@floralindia.com</a>
        </div>

        <div class="fade-up border-l-4 border-[#1a2421] pl-5" style="transition-delay: 0.3s;">
          <h4 class="text-sm font-bold text-[#1a2421] uppercase tracking-wider mb-2">Phone:</h4>
          <p class="text-gray-700 text-sm font-medium"><a href="tel:01141050051" class="hover:underline">011-41050051</a> , <a href="tel:+919910200043" class="hover:underline">+91 9910200043</a></p>
          <p class="text-xs text-gray-500 mt-1">(Mon-Sat 9 AM to 6 PM IST)</p>
        </div>

        <div class="fade-up border-l-4 border-[#1a2421] pl-5" style="transition-delay: 0.4s;">
          <h4 class="text-sm font-bold text-[#1a2421] uppercase tracking-wider mb-2">Address:</h4>
          <p class="text-gray-700 text-sm leading-relaxed">
            D 851 New Friends Colony,<br>
            New Delhi 110025,<br>
            India
          </p>
        </div>
        
      </div>

      <!-- Socials -->
      <div class="fade-up pt-4" style="transition-delay: 0.5s;">
        <h4 class="text-sm font-bold text-[#1a2421] mb-4">Socials:</h4>
        <div class="flex gap-4">
          <!-- Facebook -->
          <a href="https://www.facebook.com/FloralIndiaOfficial?rdid=Je7MqA1sVd0Q5rfS&share_url=https%3A%2F%2Fwww.facebook.com%2Fshare%2F1DsNfwENxh%2F#" target="_blank" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:text-white hover:bg-[#1877F2] hover:border-[#1877F2] transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" fill-rule="evenodd"/></svg>
          </a>
          <!-- Instagram -->
          <a href="https://www.instagram.com/floralindiaofficial" target="_blank" class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center text-gray-500 hover:text-white hover:bg-gradient-to-tr hover:from-[#f9ce34] hover:via-[#ee2a7b] hover:to-[#6228d7] hover:border-transparent transition-all">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Contact Form -->
    <div class="fade-up relative" style="transition-delay: 0.3s;">
      
      <!-- Paper Plane Graphic -->
      <div class="absolute -top-12 right-4 md:-right-6 w-32 h-32 opacity-80 z-10 pointer-events-none">
        <svg viewBox="0 0 100 100" fill="none" class="w-full h-full text-[#d4af37]" stroke="currentColor" stroke-width="1.5">
          <path d="M85 25L20 45L40 55L75 30L45 60L55 85L85 25Z" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M40 55v15l10-8" stroke-linejoin="round" stroke-linecap="round"/>
          <!-- Drawing trail -->
          <path d="M85 25C95 10 90 0 75 10C65 15 80 20 85 25" stroke-dasharray="2 4"/>
        </svg>
      </div>

      <div class="border border-gray-300 bg-white p-8 md:p-10 relative z-20">
        <h2 class="text-2xl font-serif text-[#1a2421] mb-8 font-bold">Send us a message</h2>
        
        {% form 'contact', class: 'space-y-6' %}
          {%- if form.posted_successfully? -%}
            <div class="p-4 bg-green-50 text-green-700 text-sm font-medium border border-green-200 mb-6">
              Thank you for reaching out! We have received your message and will get back to you shortly.
            </div>
          {%- elsif form.errors -%}
            <div class="p-4 bg-red-50 text-red-700 text-sm font-medium border border-red-200 mb-6">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <!-- Type of Query -->
          <div class="form-input-focus border border-gray-300 rounded-sm overflow-hidden transition-all">
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider pt-2 px-3 pb-1" for="ContactForm-query">Type of Query *</label>
            <input type="text" id="ContactForm-query" name="contact[query_type]" class="w-full h-10 px-3 pb-2 text-sm text-gray-900 bg-transparent focus:outline-none placeholder-gray-300" placeholder="e.g. Order Tracking, Support" required>
          </div>

          <!-- Full Name -->
          <div class="form-input-focus border border-gray-300 rounded-sm overflow-hidden transition-all">
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider pt-2 px-3 pb-1" for="ContactForm-name">Full Name *</label>
            <input type="text" id="ContactForm-name" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" class="w-full h-10 px-3 pb-2 text-sm text-gray-900 bg-transparent focus:outline-none placeholder-gray-300" placeholder="Your Name" required>
          </div>

          <!-- Email -->
          <div class="form-input-focus border border-gray-300 rounded-sm overflow-hidden transition-all">
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider pt-2 px-3 pb-1" for="ContactForm-email">Email *</label>
            <input type="email" id="ContactForm-email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" class="w-full h-10 px-3 pb-2 text-sm text-gray-900 bg-transparent focus:outline-none placeholder-gray-300" placeholder="yourname@domain.com" required>
          </div>

          <!-- Mobile Number -->
          <div>
            <div class="form-input-focus border border-gray-300 rounded-sm overflow-hidden transition-all">
              <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider pt-2 px-3 pb-1" for="ContactForm-phone">Mobile Number *</label>
              <input type="tel" id="ContactForm-phone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" class="w-full h-10 px-3 pb-2 text-sm text-gray-900 bg-transparent focus:outline-none placeholder-gray-300" placeholder="Mobile Number" required maxlength="10" inputmode="numeric" pattern="[0-9]{10}" oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10);">
            </div>
            <p id="ContactForm-phone-hint" class="text-[11px] font-semibold mt-1 hidden transition-all"></p>
          </div>

          <!-- Message -->
          <div class="form-input-focus border border-gray-300 rounded-sm overflow-hidden transition-all">
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider pt-2 px-3 pb-1" for="ContactForm-body">Message *</label>
            <textarea id="ContactForm-body" name="contact[body]" rows="4" class="w-full p-3 text-sm text-gray-900 bg-transparent focus:outline-none resize-none placeholder-gray-300" placeholder="Enter Message" required>{%- if form.body -%}{{ form.body }}{%- endif -%}</textarea>
          </div>

          <!-- reCAPTCHA -->
          {% render 'captcha-widget', widget_id: 'contact' %}

          <!-- Submit Button -->
          <button type="submit" class="w-full py-4 bg-[#1a2421] text-white text-xs font-bold tracking-widest uppercase hover:bg-gray-800 transition-colors mt-2">
            Send Request
          </button>
          
        {% endform %}
      </div>
    </div>
    
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll('.fade-up').forEach(el => el.classList.add('in-view'));

    const phoneInput = document.getElementById('ContactForm-phone');
    const hintEl = document.getElementById('ContactForm-phone-hint');

    function updateHint() {
      if (!phoneInput || !hintEl) return;
      const val = phoneInput.value.replace(/[^0-9]/g, '');
      if (val.length === 9) {
        hintEl.textContent = '* Please enter 1 more digit to complete your 10-digit mobile number';
        hintEl.className = 'text-[11px] font-semibold mt-1 text-amber-600 block';
      } else if (val.length === 10) {
        hintEl.textContent = '✓ 10-digit mobile number completed';
        hintEl.className = 'text-[11px] font-semibold mt-1 text-emerald-600 block';
      } else {
        hintEl.textContent = '';
        hintEl.className = 'text-[11px] font-semibold mt-1 hidden';
      }
    }

    if (phoneInput) {
      phoneInput.addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/[^0-9]/g, '').slice(0, 10);
        updateHint();
      });
      phoneInput.addEventListener('keydown', (e) => {
        const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Home', 'End'];
        if (allowedKeys.includes(e.key) || e.ctrlKey || e.metaKey) return;
        if (!/^[0-9]$/.test(e.key) || (e.target.value.length >= 10 && e.target.selectionStart === e.target.selectionEnd)) {
          e.preventDefault();
        }
      });
      updateHint();
    }
  });
</script>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Have a query? Need assistance? Simply reach out for answers. We love staying in touch with you!"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
